  const DevicePlanDetailPage({super.key, this.args});
  @override
  State<DevicePlanDetailPage> createState() => _DevicePlanDetailPageState();
}
class _DevicePlanDetailPageState extends State<DevicePlanDetailPage> {
  late final DevicePlanDetailController _controller;
  Map<String, dynamic> _device = const {};
  String? _customerPhone;
  @override
  void initState() {
    super.initState();
    _controller = DevicePlanDetailController();
    if (widget.args != null) {
      _device = widget.args!.device;
      _customerPhone = widget.args!.customerPhone;
      _initAdvance();
    }
  }
  void _initAdvance() {
    final int initAdv = (_device['userCustomAdvance'] as int?) ??
        (_device['minAdvanceRequired'] as int?) ??
        (_device['minAdvance'] as int?) ??
        0;
    _controller.init(initAdv);
  }
  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    if (_device.isEmpty) {
      final rawArgs = ModalRoute.of(context)?.settings.arguments;
      if (rawArgs is DevicePlanDetailArgs) {
        _device = rawArgs.device;
        _customerPhone = rawArgs.customerPhone;
        _initAdvance();
      } else if (rawArgs is Map<String, dynamic>) {
        final parsed = DevicePlanDetailArgs.fromMap(rawArgs);
        _device = parsed.device;
        _customerPhone = parsed.customerPhone;
        _initAdvance();
      }
    }
  }
  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }
  String? _checkLiveStockLockMessage(String imei) {
    final cleanImei = imei.trim();
    if (cleanImei.isEmpty || cleanImei == 'null') return null;
    try {
      final box = HiveBoxManager.getBox(BoxNames.stockBox);
      for (final key in box.keys) {
        final raw = box.get(key);
        if (raw is Map && raw['imeiNo']?.toString().trim() == cleanImei) {
          final status =
              (raw['status']?.toString() ?? 'AVAILABLE').trim().toUpperCase();
          if (status == 'RESERVED') {
            final who = raw['reservedCustomerInfo']?.toString().trim() ?? '';
            return who.isNotEmpty
                ? '🔒 یہ موبائل "$who" کے نام بُک (زیرِ معاہدہ) ہو چکا ہے!'
                : '🔒 یہ موبائل فی الحال بُک (زیرِ معاہدہ) ہو چکا ہے!';
          }
          if (status == 'SOLD') {
            return '🔒 یہ موبائل فروخت (Sold) ہو چکا ہے!';
          }
          if (raw['isDeleted'] == true || status == 'DELETED') {
            return '🔒 یہ موبائل اسٹاک سے حذف کر دیا گیا ہے!';
          }
          break;
        }
      }
    } catch (_) {}
    return null;
  }
  @override
  Widget build(BuildContext context) {
    final int baseValue = (_device['baseValue'] as int?) ?? 0;
    final List<String> images =
        (_device['images'] as List?)?.cast<String>() ?? [];
    final bool isCustomEstimate = _device['isCustomEstimate'] == true;
    final String imei =
        _device['imeiNo']?.toString() ?? _device['imei']?.toString() ?? '';
    return Directionality(
      textDirection: TextDirection.rtl,
      child: ValueListenableBuilder(
        valueListenable: HiveBoxManager.listenToBox(BoxNames.appConfigBox),
        builder: (context, _, _) {
          return ValueListenableBuilder(
            valueListenable: HiveBoxManager.listenToBox(BoxNames.stockBox),
            builder: (context, _, _) {
              final String? liveLockMessage =
                  isCustomEstimate ? null : _checkLiveStockLockMessage(imei);
              final bool isStockLocked = liveLockMessage != null;
              return AnimatedBuilder(
                animation: _controller,
                builder: (context, _) {
                  // اگر کنفیگ میں سے منتخب کردہ مدت ہٹا دی گئی ہو تو فلٹر کو خودکار 'تمام مدتیں' (0) پر لے آئیں
                  if (_controller.selectedDuration != 0 &&
                      !_controller.config.allowedDurations
                          .contains(_controller.selectedDuration)) {
                    _controller.selectedDuration = 0;
                  }
                  final rawPlans = _controller.getAllRawPlans(baseValue);
                  final plans = _controller.getFilteredPlans(rawPlans);
                  final int calculatedMinAdv =
                      _controller.getDynamicMinAdvance(baseValue);
                  final int displayedAdv = _controller.userCustomAdvance > 0
                      ? _controller.userCustomAdvance
                      : calculatedMinAdv;
                  return Scaffold(
                    backgroundColor: const Color(0xFFF1F5F9),
                    appBar: DetailAppBarUi(
                      title: _device['name'] ?? 'موبائل پلان',
                      subtitle:
                          'نایاب قسط پوائنٹ • ${rawPlans.length} سمارٹ اقساطی پیکجز',
                    ),
                    body: SingleChildScrollView(
                      physics: const BouncingScrollPhysics(),
                      padding: const EdgeInsets.all(12),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          if (isStockLocked) ...[
                            Container(
                              width: double.infinity,
                              margin: const EdgeInsets.only(bottom: 10),
                              padding: const EdgeInsets.all(10),
                              decoration: BoxDecoration(
                                color: Colors.orange.shade100,
                                borderRadius: BorderRadius.circular(10),
                                border: Border.all(
                                    color: Colors.orange.shade600, width: 1.3),
                              ),
                              child: Text(
                                liveLockMessage,
                                style: TextStyle(
                                  fontSize: 12.5,
                                  fontWeight: FontWeight.bold,
                                  color: Colors.orange.shade900,
                                ),
                              ),
                            ),
                          ],
                          if (!isCustomEstimate)
                            StockDeviceHeroCardUi(
                                device: _device, images: images)
                          else
                            CustomEstimateHeroCardUi(
                              title: _device['name'] ??
                                  'اپنی مرضی کی قیمت کا تخمینہ',
                              baseValue: baseValue,
                              displayedAdvance: displayedAdv,
                            ),
                          const SizedBox(height: 14),
                          Vip28PromotionalBannerUi(
                            totalCount: rawPlans.length,
                            durationCount:
                                _controller.config.allowedDurations.length,
                          ),
                          const SizedBox(height: 10),
                          PlanFilterSectionCardUi(
                            controller: _controller,
                            totalPossiblePlans: rawPlans.length,
                            chequeCount: rawPlans
                                .where((p) => p['guarantee'] == 'BANK_CHEQUE')
                                .length,
                            stampCount: rawPlans
                                .where((p) => p['guarantee'] == 'LEGAL_STAMP')
                                .length,
                            zeroAdvCount: rawPlans
                                .where((p) => p['hasAdvance'] == false)
                                .length,
                            withAdvCount: rawPlans
                                .where((p) => p['hasAdvance'] == true)
                                .length,
                            calculatedMinAdv: calculatedMinAdv,
                          ),
                          const SizedBox(height: 12),
                          PlanSortingToolbarUi(
                            activeSort: _controller.activeSort,
                            onSortChanged: _controller.setSort,
                          ),
                          const SizedBox(height: 10),
                          BillStyleScheduleHeaderUi(count: plans.length),
                          const SizedBox(height: 8),
                          ...plans.map(
                            (plan) => IndividualPlanRowUi(
                              plan: plan,
                              isLocked: isStockLocked,
                              onOrderTap: () => _controller.openOrderReceiptPage(
                                context: context,
                                plan: plan,
                                device: _device,
                                customerPhone: _customerPhone,
                              ),
                            ),
                          ),
                          const SizedBox(height: 60),
                        ],
                      ),
                    ),
                  );
                },
              );
            },
          );
        },
      ),
    );
  }
}
