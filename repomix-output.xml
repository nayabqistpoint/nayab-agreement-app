<file path="../nayab_shop_pos/lib/features/purchase_market/services/market_filter_service.dart">
import '../../../core/constants/app_colors.dart';
class MarketFilterService {
  static List<DataMap> filterByCategory(
      List<DataMap> all, String selectedCategory) {
    if (selectedCategory == 'ALL') return all;
    return all.where((d) {
      final cat = (d['productCategory']?.toString() ?? 'MOBILE').toUpperCase();
      return cat == selectedCategory;
    }).toList();
  }
  static List<DataMap> filterByStatusAndSearch({
    required List<DataMap> categoryList,
    required String statusFilter,
    required String searchQuery,
  }) {
    final q = searchQuery.trim().toLowerCase();
    return categoryList.where((d) {
      final st = (d['statusCode']?.toString() ?? 'AVAILABLE').toUpperCase();
      if (statusFilter != 'ALL' && st != statusFilter) return false;
      if (q.isEmpty) return true;
      final name = (d['name']?.toString() ?? '').toLowerCase();
      final ram = (d['ramRom']?.toString() ?? '').toLowerCase();
      final color = (d['color']?.toString() ?? '').toLowerCase();
      final stockId = (d['stockId']?.toString() ?? '').toLowerCase();
      final idsStr = (d['availableStockIds'] is List)
          ? (d['availableStockIds'] as List).join(' ').toLowerCase()
          : '';
      return name.contains(q) ||
          ram.contains(q) ||
          color.contains(q) ||
          stockId.contains(q) ||
          idsStr.contains(q);
    }).toList();
  }
}
