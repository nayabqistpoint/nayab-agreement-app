<file path="../nayab_shop_pos/lib/core/security/device_license_service.dart">
import 'dart:async';
import 'dart:io';
import 'dart:math';
import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:flutter/foundation.dart';
import 'package:geolocator/geolocator.dart';
import '../../features/device_plan_detail/services/calculator_config_service.dart';
import '../constants/box_names.dart';
import '../database/hive_box_manager.dart';
import '../network/connectivity_service.dart';
import '../time/time_status_service.dart';
class DeviceLicenseService {
  static const String _deviceIdKey = 'current_device_id';
  static const String _cachedStatusKey = 'cached_license_status';
  static Timer? _heartbeatTimer;
  static String getOrCreateDeviceId() {
    final vault = HiveBoxManager.getBox(BoxNames.localVaultBox);
    final existing = vault.get(_deviceIdKey)?.toString().trim() ?? '';
    if (existing.isNotEmpty) return existing;
    final rand = Random.secure();
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    final p1 =
        List.generate(4, (_) => chars[rand.nextInt(chars.length)]).join();
    final p2 =
        List.generate(4, (_) => chars[rand.nextInt(chars.length)]).join();
    final newId = 'NQP-$p1-$p2';
    vault.put(_deviceIdKey, newId);
    return newId;
  }
  static String getCurrentSellerLabel() {
    final deviceId = getOrCreateDeviceId();
    try {
      final devBox = HiveBoxManager.getBox(BoxNames.posDevicesBox);
      final raw = devBox.get(deviceId);
      if (raw is Map) {
        final empName = raw['employeeLabel']?.toString().trim() ?? '';
        if (empName.isNotEmpty && empName != 'null') {
          return '$empName ($deviceId)';
        }
      }
    } catch (_) {}
    return 'کاؤنٹر ڈیوائس ($deviceId)';
  }
  static String getDeviceModelLabel() {
    if (kIsWeb) return 'Web Browser POS';
    try {
      return '${Platform.operatingSystem.toUpperCase()} (${Platform.localHostname})';
    } catch (_) {
      return 'Android POS Device';
    }
  }
  static bool isDeviceLockEnabledInConfig() {
    try {
      final cfgBox = HiveBoxManager.getBox(BoxNames.appConfigBox);
      final raw = cfgBox.get('calculator_config');
      if (raw is Map) {
        return raw['requireDeviceActivation'] != false;
      }
    } catch (_) {}
    return true;
  }
  static String? getGeofenceViolationReason() {
    final cfg = CalculatorConfigService().getConfig();
    if (!cfg.geofenceEnabled) return null;
    final shopLat = cfg.shopLatitude;
    final shopLng = cfg.shopLongitude;
    if (shopLat == null || shopLng == null) return null;
    try {
      final deviceId = getOrCreateDeviceId();
      final devBox = HiveBoxManager.getBox(BoxNames.posDevicesBox);
      final raw = devBox.get(deviceId);
      if (raw is Map) {
        if (raw['bypassGeofence'] == true) return null;
        final devLat = (raw['latitude'] as num?)?.toDouble();
        final devLng = (raw['longitude'] as num?)?.toDouble();
        if (devLat == null ||
            devLng == null ||
            (devLat == 0.0 && devLng == 0.0)) {
          return 'جیو فینسنگ سیکیورٹی فعال ہے؛ برائے مہربانی موبائل کی GPS لوکیشن آن کریں تاکہ دکان کی حدود کی تصدیق ہو سکے۔';
        }
        final meters =
            Geolocator.distanceBetween(shopLat, shopLng, devLat, devLng);
        if (meters > cfg.geofenceRadiusMeters) {
          return 'آپ دکان کی مقررہ حدود (${cfg.geofenceRadiusMeters} میٹر) سے باہر (${meters.round()} میٹر دور) ہیں۔';
        }
      }
    } catch (_) {}
    return null;
  }
  static String getCurrentLicenseStatus() {
    final deviceId = getOrCreateDeviceId();
    final devBox = HiveBoxManager.getBox(BoxNames.posDevicesBox);
    final vault = HiveBoxManager.getBox(BoxNames.localVaultBox);
    final raw = devBox.get(deviceId);
    if (raw is Map) {
      final st = (raw['status']?.toString() ?? 'PENDING').trim().toUpperCase();
      vault.put(_cachedStatusKey, st);
      return st;
    }
    return vault.get(_cachedStatusKey)?.toString().toUpperCase() ?? 'PENDING';
  }
  static void startPeriodicLocationTracking() {
    _heartbeatTimer?.cancel();
    _heartbeatTimer = Timer.periodic(const Duration(minutes: 3), (_) {
      registerOrHeartbeatDevice();
    });
  }
  static Future<({double? lat, double? lng, String? error})>
      _captureSafeGps() async {
    try {
      if (!kIsWeb) {
        final serviceEnabled = await Geolocator.isLocationServiceEnabled();
        if (!serviceEnabled) {
          return (
            lat: null,
            lng: null,
            error: 'موبائل کی GPS / Location سروس بند ہے'
          );
        }
      }
      LocationPermission permission = await Geolocator.checkPermission();
      if (permission == LocationPermission.denied) {
        permission = await Geolocator.requestPermission();
      }
      if (permission == LocationPermission.denied) {
        return (
          lat: null,
          lng: null,
          error: 'صارف نے لوکیشن کی اجازت (Allow) نہیں دی'
        );
      }
      if (permission == LocationPermission.deniedForever) {
        return (
          lat: null,
          lng: null,
          error: 'سیٹنگز سے لوکیشن کی اجازت مستقل بلاک ہے'
        );
      }
      final pos = await Geolocator.getCurrentPosition(
        locationSettings: const LocationSettings(
          accuracy: LocationAccuracy.medium,
          timeLimit: Duration(seconds: 10),
        ),
      );
      return (lat: pos.latitude, lng: pos.longitude, error: null);
    } catch (_) {
      return (
        lat: null,
        lng: null,
        error: 'لوکیشن سگنل موصول نہیں ہوا (GPS / براؤزر چیک کریں)'
      );
    }
  }
  static Future<void> registerOrHeartbeatDevice({String? employeeNote}) async {
    final deviceId = getOrCreateDeviceId();
    final devBox = HiveBoxManager.getBox(BoxNames.posDevicesBox);
    final now = TimeStatusService.nowUtcIso();
    final rawLocal = devBox.get(deviceId);
    final Map<String, dynamic> payload = rawLocal is Map
        ? Map<String, dynamic>.from(rawLocal)
        : {
            'deviceId': deviceId,
            'deviceModel': getDeviceModelLabel(),
            'status': 'PENDING',
            'requestedAt': now,
          };
    if (employeeNote != null && employeeNote.trim().isNotEmpty) {
      payload['employeeLabel'] = employeeNote.trim();
    }
    final gps = await _captureSafeGps();
    if (gps.lat != null && gps.lng != null) {
      payload['latitude'] = gps.lat;
      payload['longitude'] = gps.lng;
      payload['locationUpdatedAt'] = now;
      payload['locationError'] = null;
    } else if (gps.error != null) {
      payload['locationError'] = gps.error;
    }
    payload['lastSeenAt'] = now;
    payload['updatedAt'] = now;
    payload['isDeleted'] = false;
    await HiveBoxManager.putBatch(
      boxName: BoxNames.posDevicesBox,
      entries: {deviceId: payload},
    );
    if (await ConnectivityService.isOnline) {
      try {
        final docRef = FirebaseFirestore.instance
            .collection(BoxNames.posDevicesBox)
            .doc(deviceId);
        final snap = await docRef.get().timeout(const Duration(seconds: 6));
        final Map<String, dynamic> syncPatch = {
          'lastSeenAt': now,
          if (gps.lat != null && gps.lng != null) ...{
            'latitude': gps.lat,
            'longitude': gps.lng,
            'locationUpdatedAt': now,
            'locationError': null,
          } else if (gps.error != null)
            'locationError': gps.error,
          if (employeeNote != null && employeeNote.trim().isNotEmpty)
            'employeeLabel': employeeNote.trim(),
        };
        if (snap.exists && snap.data() != null) {
          final cloudData = Map<String, dynamic>.from(snap.data()!);
          cloudData.addAll(syncPatch);
          await HiveBoxManager.putBatch(
            boxName: BoxNames.posDevicesBox,
            entries: {deviceId: cloudData},
          );
          await docRef
              .set(syncPatch, SetOptions(merge: true))
              .timeout(const Duration(seconds: 6));
        } else {
          await docRef
              .set(payload, SetOptions(merge: true))
              .timeout(const Duration(seconds: 6));
        }
      } catch (_) {}
    }
  }
}
