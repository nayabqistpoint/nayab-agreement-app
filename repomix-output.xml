import 'package:flutter/material.dart';
import '../../core/constants/app_colors.dart';
import '../../core/network/connectivity_service.dart';
import '../../core/services/pos_cloudinary_service.dart';
import '../device_plan_detail/models/calculator_config_model.dart';
import '../device_plan_detail/services/calculator_config_service.dart';
import '../device_plan_detail/services/plan_math_service.dart';
import '../device_plan_detail/services/plan_schedule_service.dart';
import '../device_plan_detail/services/stock_live_status_service.dart';
import 'components/agreement_qr_dialog_ui.dart';
import 'components/security_barrier_checklist_card_ui.dart';
import 'services/agreement_qr_payload_service.dart';
import 'services/order_receipt_storage_handler_service.dart';
import 'services/security_barrier_service.dart';
class OrderReceiptController extends ChangeNotifier {
  final DataMap plan;
  final int baseValue;
  final bool isBoxPackNew;
  final String? stockId;
  final String? imeiNo;
  final String? serialNo;
  final ScrollController scrollController = ScrollController();
  final TextEditingController bankNameCtrl = TextEditingController();
  final TextEditingController chequeNoCtrl = TextEditingController();
  final TextEditingController customerNameCtrl = TextEditingController();
  final TextEditingController customerFatherNameCtrl = TextEditingController();
  final TextEditingController customerCasteCtrl = TextEditingController();
  final TextEditingController customerPhoneCtrl = TextEditingController();
  final TextEditingController customerCnicCtrl = TextEditingController();
  final TextEditingController customerAddressCtrl = TextEditingController();
  final TextEditingController guarantorNameCtrl = TextEditingController();
  final TextEditingController guarantorFatherNameCtrl = TextEditingController();
  final TextEditingController guarantorCasteCtrl = TextEditingController();
  final TextEditingController guarantorPhoneCtrl = TextEditingController();
  final TextEditingController guarantorCnicCtrl = TextEditingController();
  final TextEditingController guarantorAddressCtrl = TextEditingController();
  final TextEditingController guarantorRelationCtrl = TextEditingController();
  final TextEditingController guardianPhoneCtrl = TextEditingController();
  String? customerPhotoPath;
  String? guarantorPhotoPath;
  late final int initialAdvance;
  late final int initialMonthly;
  late final int months;
  late final int initialTotalInstallmentSum;
  late final bool isChequePlan;
  late final bool isZeroAdvance;
  late final bool isGeneral;
  late final bool isCustomEstimate;
  late final String zoneType;
  late final String productCategory;
  late final String tokenNo;
  final Set<String> _checkedBarrierIds = {};
  bool isAdminOverrideApproved = false;
  bool isGuardianNoticeSent = false;
  String? localError;
  bool isSubmitting = false;
  bool showValidationErrors = false;
  OrderReceiptController({
    required this.plan,
    String? initialPhone,
    this.baseValue = 0,
    this.isBoxPackNew = true,
    this.stockId,
    this.imeiNo,
    this.serialNo,
  }) {
    initialAdvance = (plan['advance'] as num?)?.toInt() ?? 0;
    initialMonthly = (plan['monthly'] as num?)?.toInt() ?? 0;
    months = (plan['months'] as num?)?.toInt() ?? 6;
    final int remainingMonths = (months - 1) > 0 ? (months - 1) : 1;
    initialTotalInstallmentSum = (plan['totalContract'] as num?)?.toInt() ??
        (initialAdvance + (initialMonthly * remainingMonths));
    isChequePlan = plan['guarantee'] == 'BANK_CHEQUE';
    isZeroAdvance = initialAdvance == 0;
    isCustomEstimate = plan['isCustomEstimate'] == true ||
        (stockId == null || stockId!.trim().isEmpty);
    zoneType = (plan['zoneType']?.toString().trim().isNotEmpty == true)
        ? plan['zoneType'].toString().trim().toUpperCase()
        : (plan['isGeneral'] == true
            ? 'ELECTRONICS'
            : (isCustomEstimate ? 'CUSTOM_ESTIMATE' : 'MOBILE'));
    productCategory =
        (plan['productCategory']?.toString().trim().isNotEmpty == true)
            ? plan['productCategory'].toString().trim().toUpperCase()
            : (zoneType == 'ELECTRONICS' ? 'ELECTRONICS' : 'MOBILE');
    isGeneral = productCategory == 'ELECTRONICS';
    tokenNo =
        'NQP-${DateTime.now().millisecondsSinceEpoch.toString().substring(7)}';
    if (initialPhone != null && initialPhone.isNotEmpty) {
      customerPhoneCtrl.text = initialPhone;
    }
    guardianPhoneCtrl.addListener(_onGuardianPhoneChanged);
  }
  void setCustomerPhoto(String? path) {
    customerPhotoPath = path;
    notifyListeners();
  }
  void setGuarantorPhoto(String? path) {
    guarantorPhotoPath = path;
    notifyListeners();
  }
  CalculatorConfigModel get config => CalculatorConfigService().getConfig();
  int get effectiveBaseValue {
    final cleanStockId = stockId?.trim() ?? '';
    if (cleanStockId.isNotEmpty && cleanStockId != 'null') {
      final live =
          StockLiveStatusService.resolveLiveBaseValue(0, cleanStockId);
      if (live > 0) return live;
    }
    if (baseValue > 0) return baseValue;
    final planBase = (plan['baseValue'] as num?)?.toInt() ?? 0;
    if (planBase > 0) return planBase;
    return initialTotalInstallmentSum;
  }
  int get liveTotalContractPrice {
    if (effectiveBaseValue <= 0) return initialTotalInstallmentSum;
    final cfg = config;
    final principal = PlanMathService.calculatePrincipal(
      baseValue: effectiveBaseValue,
      config: cfg,
      zoneType: zoneType,
    );
    return PlanMathService.calculateTotalContractPrice(
      principal: principal,
      months: months,
      isCheque: isChequePlan,
      config: cfg,
      zoneType: zoneType,
    );
  }
  int get advance => initialAdvance;
  int get monthly {
    if (effectiveBaseValue <= 0) return initialMonthly;
    return PlanMathService.calculateMonthlyEmi(
      totalContractPrice: liveTotalContractPrice,
      advancePaid: advance,
      months: months,
      config: config,
      zoneType: zoneType,
    );
  }
  int get totalInstallmentSum {
    final int remainingMonths = (months - 1) > 0 ? (months - 1) : 1;
    return advance + (monthly * remainingMonths);
  }
  bool get hasLiveRateChanged =>
      monthly != initialMonthly ||
      totalInstallmentSum != initialTotalInstallmentSum;
  List<DataMap> get liveInstallmentSchedule =>
      PlanScheduleService.generateSchedule(
        totalMonths: months,
        monthlyAmount: monthly,
        advancePaid: advance,
        config: config,
        zoneType: zoneType,
      );
  bool get isGuarantorMandatory => !isChequePlan;
  bool get requiresGuarantorMdmLock => !isChequePlan && isZeroAdvance;
  void _onGuardianPhoneChanged() {
    final digits =
        guardianPhoneCtrl.text.trim().replaceAll(RegExp(r'[^0-9]'), '');
    if (digits.length < 10 && isGuardianNoticeSent) {
      isGuardianNoticeSent = false;
      notifyListeners();
    }
  }
  void markGuardianNoticeSent() {
    final digits =
        guardianPhoneCtrl.text.trim().replaceAll(RegExp(r'[^0-9]'), '');
    if (digits.length >= 10) {
      isGuardianNoticeSent = true;
      notifyListeners();
    }
  }
  int get netRiskAmount =>
      (effectiveBaseValue - advance) > 0 ? (effectiveBaseValue - advance) : 0;
  int get activeMaxRiskLimit {
    final cfg = config;
    final z = zoneType.toUpperCase();
    if (z == 'CUSTOM_ESTIMATE' || isCustomEstimate) {
      return cfg.customMaxRiskLimit > 0
          ? cfg.customMaxRiskLimit
          : cfg.maxRiskLimit;
    }
    if (z == 'ELECTRONICS' || isGeneral) {
      return cfg.generalMaxRiskLimit > 0
          ? cfg.generalMaxRiskLimit
          : cfg.maxRiskLimit;
    }
    return cfg.maxRiskLimit;
  }
  bool get isRiskOverLimit {
    final limit = activeMaxRiskLimit;
    if (limit <= 0) return false;
    return netRiskAmount > limit;
  }
  String get openBoxDeductionText {
    final cfg = config;
    final dType = cfg.openBoxTypeForZone(zoneType);
    final dVal = cfg.openBoxValForZone(zoneType);
    if (dType == 'FIXED') {
      return 'Rs. $dVal فکس کٹوتی';
    }
    return '$dVal% کٹوتی';
  }
  List<SecurityBarrierItem> get barrierItems =>
      SecurityBarrierService.buildChecklist(
        config: config,
        zoneType: zoneType,
        isGeneral: isGeneral,
        isCustomEstimate: isCustomEstimate,
        isChequePlan: isChequePlan,
        isZeroAdvance: isZeroAdvance,
        isBoxPackNew: isBoxPackNew,
        openBoxDeductionText: openBoxDeductionText,
        checkedIds: _checkedBarrierIds,
      );
  bool get isBarrierSatisfied {
    if (isRiskOverLimit && !isAdminOverrideApproved) return false;
    final guardianDigits =
        guardianPhoneCtrl.text.trim().replaceAll(RegExp(r'[^0-9]'), '');
    if (!isGuardianNoticeSent || guardianDigits.length < 10) return false;
    return barrierItems.every((item) => item.isChecked);
  }
  void toggleBarrierItem(String id) {
    if (_checkedBarrierIds.contains(id)) {
      _checkedBarrierIds.remove(id);
    } else {
      _checkedBarrierIds.add(id);
    }
    notifyListeners();
  }
  void showAdminOverrideDialog(BuildContext context) {
    final pinCtrl = TextEditingController();
    String? pinError;
    final activeLimit = activeMaxRiskLimit;
    final expectedPin = config.adminPinForZone(zoneType);
    showDialog(
      context: context,
      builder: (ctx) => StatefulBuilder(
        builder: (ctx, setDialogState) => Directionality(
          textDirection: TextDirection.rtl,
          child: AlertDialog(
            backgroundColor: AppColors.cardSurface,
            title: const Text(
              'انتظامی خصوصی منظوری (Admin PIN)',
              style: TextStyle(fontWeight: FontWeight.bold, fontSize: 16.5),
            ),
            content: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: [
                Text(
                  'اس سودے میں نیٹ ادھار رسک رقم (قیمت Rs. $effectiveBaseValue - ایڈوانس Rs. $advance = Rs. $netRiskAmount) مقررہ رسک حد (Rs. $activeLimit) سے زائد ہے۔ انتظامیہ اپنا خفیہ پن کوڈ درج کر کے منظوری دیں:',
                  style: const TextStyle(fontSize: 13.5, height: 1.45),
                ),
                const SizedBox(height: 12),
                TextField(
                  controller: pinCtrl,
                  obscureText: true,
                  keyboardType: TextInputType.number,
                  textAlign: TextAlign.center,
                  style: const TextStyle(
                    fontSize: 18,
                    fontWeight: FontWeight.bold,
                    letterSpacing: 4,
                  ),
                  decoration: InputDecoration(
                    labelText: 'خفیہ پن کوڈ (PIN)',
                    errorText: pinError,
                    border: OutlineInputBorder(
                      borderRadius: BorderRadius.circular(10),
                    ),
                  ),
                ),
              ],
            ),
            actions: [
              TextButton(
                onPressed: () => Navigator.pop(ctx),
                child: const Text('منسوخ'),
              ),
              ElevatedButton(
                onPressed: () {
                  final entered = pinCtrl.text.trim();
                  if (entered == expectedPin) {
                    isAdminOverrideApproved = true;
                    Navigator.pop(ctx);
                    notifyListeners();
                  } else {
                    setDialogState(() {
                      pinError = 'غلط پن کوڈ! دوبارہ کوشش کریں';
                    });
                  }
                },
                style: ElevatedButton.styleFrom(
                  backgroundColor: AppColors.primaryEmerald,
                  foregroundColor: Colors.white,
                ),
                child: const Text('منظوری دیں'),
              ),
            ],
          ),
        ),
      ),
    ).then((_) => pinCtrl.dispose());
  }
  @override
  void dispose() {
    guardianPhoneCtrl.removeListener(_onGuardianPhoneChanged);
    scrollController.dispose();
    bankNameCtrl.dispose();
    chequeNoCtrl.dispose();
    customerNameCtrl.dispose();
    customerFatherNameCtrl.dispose();
    customerCasteCtrl.dispose();
    customerPhoneCtrl.dispose();
    customerCnicCtrl.dispose();
    customerAddressCtrl.dispose();
    guarantorNameCtrl.dispose();
    guarantorFatherNameCtrl.dispose();
    guarantorCasteCtrl.dispose();
    guarantorPhoneCtrl.dispose();
    guarantorCnicCtrl.dispose();
    guarantorAddressCtrl.dispose();
    guarantorRelationCtrl.dispose();
    guardianPhoneCtrl.dispose();
    super.dispose();
  }
  void _scrollToValidationArea() {
    if (scrollController.hasClients) {
      scrollController.animateTo(
        180.0,
        duration: const Duration(milliseconds: 300),
        curve: Curves.easeOut,
      );
    }
  }
  bool _validateCommonFields({required bool requireCustomerInfo}) {
    if (!isBarrierSatisfied) {
      localError =
          'برائے مہربانی تمام سیکیورٹی شرائط پر ٹِک لگائیں اور سرپرست کے نمبر پر واٹس ایپ اطلاع مکمل کریں!';
      notifyListeners();
      return false;
    }
    if (isChequePlan &&
        (bankNameCtrl.text.trim().isEmpty ||
            chequeNoCtrl.text.trim().isEmpty)) {
      showValidationErrors = true;
      localError = 'برائے مہربانی بینک کا نام اور چیک نمبر درج کریں!';
      notifyListeners();
      _scrollToValidationArea();
      return false;
    }
    if (requireCustomerInfo &&
        (customerNameCtrl.text.trim().isEmpty ||
            customerFatherNameCtrl.text.trim().isEmpty ||
            customerCasteCtrl.text.trim().isEmpty ||
            customerPhoneCtrl.text.trim().isEmpty ||
            customerCnicCtrl.text.trim().isEmpty ||
            customerAddressCtrl.text.trim().isEmpty)) {
      showValidationErrors = true;
      localError =
          'برائے مہربانی خریدار کے تمام کوائف (نام، ولدیت، قوم، فون، شناختی کارڈ اور پتہ) مکمل درج کریں!';
      notifyListeners();
      _scrollToValidationArea();
      return false;
    }
    if (requireCustomerInfo &&
        isGuarantorMandatory &&
        (guarantorNameCtrl.text.trim().isEmpty ||
            guarantorFatherNameCtrl.text.trim().isEmpty ||
            guarantorCasteCtrl.text.trim().isEmpty ||
            guarantorPhoneCtrl.text.trim().isEmpty ||
            guarantorCnicCtrl.text.trim().isEmpty ||
            guarantorRelationCtrl.text.trim().isEmpty ||
            guarantorAddressCtrl.text.trim().isEmpty)) {
      showValidationErrors = true;
      localError =
          'اشٹام پرنوٹ پیکج کیلئے ضامن کے تمام کوائف (نام، ولدیت، قوم، فون، شناختی کارڈ، تعلق اور پتہ) درج کرنا لازمی ہے!';
      notifyListeners();
      _scrollToValidationArea();
      return false;
    }
    showValidationErrors = false;
    localError = null;
    notifyListeners();
    return true;
  }
  void showOfflineQrCode({
    required BuildContext context,
    required String deviceName,
    String? imeiNo,
    required List<DataMap> schedule,
  }) {
    if (!_validateCommonFields(requireCustomerInfo: false)) return;
    final activeSchedule = liveInstallmentSchedule;
    final String? firstDue = activeSchedule.length > 1
        ? activeSchedule[1]['dueDate']?.toString()
        : null;
    final jsonPayload = AgreementQrPayloadService.buildJsonPayload(
      stockId: stockId,
      deviceName: deviceName,
      imeiNo: imeiNo,
      serialNo: serialNo,
      totalContractAmount: totalInstallmentSum,
      advance: advance,
      monthlyAmount: monthly,
      totalMonths: months,
      guaranteeType: plan['guarantee']?.toString() ?? 'LEGAL_STAMP',
      bankName: bankNameCtrl.text,
      chequeNo: chequeNoCtrl.text,
      customerName: customerNameCtrl.text,
      customerFatherName: customerFatherNameCtrl.text,
      customerCaste: customerCasteCtrl.text,
      customerPhone: customerPhoneCtrl.text,
      customerCnic: customerCnicCtrl.text,
      customerAddress: customerAddressCtrl.text,
      guarantorName: guarantorNameCtrl.text,
      guarantorFatherName: guarantorFatherNameCtrl.text,
      guarantorCaste: guarantorCasteCtrl.text,
      guarantorPhone: guarantorPhoneCtrl.text,
      guarantorCnic: guarantorCnicCtrl.text,
      guarantorAddress: guarantorAddressCtrl.text,
      guarantorRelation: guarantorRelationCtrl.text,
      guardianPhone: guardianPhoneCtrl.text,
      mdmLockFee: config.mdmFeeForZone(zoneType),
      openBoxDeductionRule: openBoxDeductionText,
      firstDueDate: firstDue,
    );
    AgreementQrDialogUi.show(
      context,
      qrPayload: jsonPayload,
      deviceName: deviceName,
      monthlyAmount: monthly,
      totalMonths: months,
    );
  }
  Future<void> submitOrder({
    required BuildContext context,
    required String deviceName,
    String? sourceMode,
    String? imeiNo,
  }) async {
    if (!_validateCommonFields(requireCustomerInfo: true)) return;
    final List<String> planStockIds = (plan['stockIds'] as List?)
            ?.map((e) => e.toString().trim())
            .where((e) => e.isNotEmpty)
            .toList() ??
        (stockId != null && stockId!.trim().isNotEmpty
            ? [stockId!.trim()]
            : <String>[]);
    final int orderQty = (plan['quantity'] as num?)?.toInt() ??
        (planStockIds.isNotEmpty ? planStockIds.length : 1);
    final availabilityError =
        OrderReceiptStorageHandlerService.checkStockAvailabilityError(
      stockId: stockId,
      stockIds: planStockIds,
    );
    if (availabilityError != null) {
      localError = availabilityError;
      notifyListeners();
      _scrollToValidationArea();
      return;
    }
    final messenger = ScaffoldMessenger.of(context);
    final navigator = Navigator.of(context);
    isSubmitting = true;
    localError = null;
    notifyListeners();
    try {
      final isOnline = await ConnectivityService.isOnline;
      String? finalCustomerPhotoUrl = customerPhotoPath;
      if (finalCustomerPhotoUrl != null &&
          finalCustomerPhotoUrl.isNotEmpty &&
          !finalCustomerPhotoUrl.startsWith('http') &&
          isOnline) {
        final uploaded = await PosCloudinaryService.uploadCustomerSelfie(
          customerCnic: customerCnicCtrl.text,
          pathOrDataUrl: finalCustomerPhotoUrl,
        );
        if (uploaded != null) {
          finalCustomerPhotoUrl = uploaded;
        }
      }
      String? finalGuarantorPhotoUrl = guarantorPhotoPath;
      if (finalGuarantorPhotoUrl != null &&
          finalGuarantorPhotoUrl.isNotEmpty &&
          !finalGuarantorPhotoUrl.startsWith('http') &&
          isOnline) {
        final uploadedG = await PosCloudinaryService.uploadCustomerSelfie(
          customerCnic: guarantorCnicCtrl.text,
          pathOrDataUrl: finalGuarantorPhotoUrl,
        );
        if (uploadedG != null) {
          finalGuarantorPhotoUrl = uploadedG;
        }
      }
      final acceptedTexts =
          barrierItems.where((i) => i.isChecked).map((i) => i.text).toList();
      final payload = OrderReceiptStorageHandlerService.buildOrderPayload(
        docId: tokenNo,
        customerName: customerNameCtrl.text,
        customerFatherName: customerFatherNameCtrl.text,
        customerCaste: customerCasteCtrl.text,
        customerPhone: customerPhoneCtrl.text,
        customerCnic: customerCnicCtrl.text,
        customerAddress: customerAddressCtrl.text,
        customerPhotoUrl: finalCustomerPhotoUrl,
        guarantorName: guarantorNameCtrl.text,
        guarantorFatherName: guarantorFatherNameCtrl.text,
        guarantorCaste: guarantorCasteCtrl.text,
        guarantorPhone: guarantorPhoneCtrl.text,
        guarantorCnic: guarantorCnicCtrl.text,
        guarantorAddress: guarantorAddressCtrl.text,
        guarantorRelation: guarantorRelationCtrl.text,
        guarantorPhotoUrl: finalGuarantorPhotoUrl,
        guardianPhone: guardianPhoneCtrl.text,
        sourceMode: sourceMode ?? (isCustomEstimate ? 'CUSTOM_ESTIMATE' : 'STOCK'),
        stockId: stockId,
        itemName: deviceName,
        imeiNo: imeiNo,
        serialNo: serialNo,
        guaranteeType: plan['guarantee']?.toString() ?? 'LEGAL_STAMP',
        bankName: bankNameCtrl.text,
        chequeNo: chequeNoCtrl.text,
        totalMonths: months,
        advance: advance,
        monthlyAmount: monthly,
        totalContractAmount: totalInstallmentSum,
        orderDateTime: DateTime.now(),
        acceptedSecurityConditions: acceptedTexts,
        mdmLockFee: config.mdmFeeForZone(zoneType),
        openBoxDeductionRule: openBoxDeductionText,
        adminOverrideApplied: isAdminOverrideApproved,
      );
      payload['isCustomEstimate'] = isCustomEstimate;
      payload['zoneType'] = zoneType;
      payload['productCategory'] = productCategory;
      payload['baseValue'] = effectiveBaseValue;
      payload['quantity'] = orderQty;
      payload['stockIds'] = planStockIds;
      final isSaved = await OrderReceiptStorageHandlerService.saveOrderRecord(
        tokenNo: tokenNo,
        payload: payload,
      );
      if (!context.mounted) return;
      if (isSaved) {
        navigator.pop();
        messenger.showSnackBar(
          SnackBar(
            content: Text(
              'آرڈر $tokenNo مکمل ہو گیا اور کاؤنٹر پر بھیج دیا گیا!',
              style: const TextStyle(fontWeight: FontWeight.bold),
            ),
            backgroundColor: AppColors.primaryEmerald,
          ),
        );
      } else {
        isSubmitting = false;
        localError = 'آرڈر محفوظ کرتے وقت مسئلہ پیش آیا، دوبارہ کوشش کریں۔';
        notifyListeners();
      }
    } catch (_) {
      isSubmitting = false;
      localError = 'غیر متوقع خرابی پیش آئی، دوبارہ کوشش کریں۔';
      notifyListeners();
    }
  }
}
