import 'dart:convert';
import 'package:flutter/foundation.dart';
class AgreementQrPayloadService {
  static const String _secretSalt = 'NQP_QIST_2026_SECURE_KEY';
  static String _xorEncrypt(String plainText) {
    final plainBytes = utf8.encode(plainText);
    final keyBytes = utf8.encode(_secretSalt);
    final cipher = List<int>.generate(
      plainBytes.length,
      (i) => plainBytes[i] ^ keyBytes[i % keyBytes.length],
    );
    return base64Encode(cipher);
  }
  static String buildJsonPayload({
    String? stockId,
    required String deviceName,
    String? imeiNo,
    String? serialNo,
    required int totalContractAmount,
    required int advance,
    required int monthlyAmount,
    required int totalMonths,
    required String guaranteeType,
    String? bankName,
    String? chequeNo,
    String? customerName,
    String? customerFatherName,
    String? customerCaste,
    String? customerPhone,
    String? customerCnic,
    String? customerAddress,
    String? guarantorName,
    String? guarantorFatherName,
    String? guarantorCaste,
    String? guarantorPhone,
    String? guarantorCnic,
    String? guarantorAddress,
    String? guarantorRelation,
    String? guardianPhone,
    int? mdmLockFee,
    String? openBoxDeductionRule,
    String? firstDueDate,
  }) {
    final bool isCheque = guaranteeType == 'BANK_CHEQUE';
    final Map<String, String> payload = {
      'موبائل ماڈل': deviceName.trim(),
      'ٹوٹل رقم': totalContractAmount.toString(),
      'ایڈوانس رقم': advance.toString(),
      'ماہانہ قسط': monthlyAmount.toString(),
      'مدت': '$totalMonths ماہ',
      'ضمانت': isCheque ? 'بینک چیک گارنٹی' : 'قانونی اشٹام و پرنوٹ',
    };
    void addIfNotEmpty(String key, String? val) {
      if (val != null && val.trim().isNotEmpty && val.trim() != 'null') {
        payload[key] = val.trim();
      }
    }
    addIfNotEmpty('اسٹاک آئی ڈی', stockId);
    addIfNotEmpty('IMEI نمبر', imeiNo);
    addIfNotEmpty('سیریل نمبر', serialNo);
    addIfNotEmpty('کسٹمر کا نام', customerName);
    addIfNotEmpty('ولدیت', customerFatherName);
    addIfNotEmpty('قومیت', customerCaste);
    addIfNotEmpty('رابطہ نمبر', customerPhone);
    addIfNotEmpty('شناختی کارڈ', customerCnic);
    addIfNotEmpty('مستقل پتہ', customerAddress);
    addIfNotEmpty('ضامن کا نام', guarantorName);
    addIfNotEmpty('ضامن ولدیت', guarantorFatherName);
    addIfNotEmpty('ضامن قومیت', guarantorCaste);
    addIfNotEmpty('ضامن موبائل نمبر', guarantorPhone);
    addIfNotEmpty('ضامن شناختی کارڈ', guarantorCnic);
    addIfNotEmpty('ضامن پتہ', guarantorAddress);
    addIfNotEmpty('ضامن رشتہ', guarantorRelation);
    addIfNotEmpty('سرپرست فون', guardianPhone);
    if (isCheque) {
      addIfNotEmpty('بینک کا نام', bankName);
      addIfNotEmpty('چیک نمبر', chequeNo);
    }
    if (mdmLockFee != null && mdmLockFee > 0) {
      payload['MDM لاک فیس'] = mdmLockFee.toString();
    }
    addIfNotEmpty('اوپن باکس کٹوتی', openBoxDeductionRule);
    addIfNotEmpty('تاریخ ادائیگی', firstDueDate);
    final jsonString = jsonEncode(payload);
    final encryptedCipher = _xorEncrypt(jsonString);
    final securePayload = 'NQP_SEC_V1:$encryptedCipher';
    debugPrint('🔐 خفیہ انکرپٹڈ QR تیار ہوا (${payload.length} فیلڈز)');
    return securePayload;
  }
}
