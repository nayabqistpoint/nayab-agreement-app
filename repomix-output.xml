import 'package:flutter/material.dart';
import '../../core/constants/app_colors.dart';
import '../../core/constants/box_names.dart';
import '../../core/database/hive_box_manager.dart';
import 'args/order_receipt_args.dart';
import 'components/bank_cheque_input_box_ui.dart';
import 'components/customer_quick_info_box_ui.dart';
import 'components/grace_period_note_ui.dart';
import 'components/guarantor_info_card_ui.dart';
import 'components/receipt_schedule_table_ui.dart';
import 'components/receipt_summary_rows_ui.dart';
import 'components/receipt_token_header_ui.dart';
import 'components/security_barrier_checklist_card_ui.dart';
import 'components/submit_order_button_ui.dart';
import 'order_receipt_controller.dart';
class OrderReceiptPage extends StatefulWidget {
  final OrderReceiptArgs? args;
  const OrderReceiptPage({super.key, this.args});
  @override
  State<OrderReceiptPage> createState() => _OrderReceiptPageState();
}
class _OrderReceiptPageState extends State<OrderReceiptPage> {
  OrderReceiptController? _controller;
  OrderReceiptArgs? _effectiveArgs;
  @override
  void initState() {
    super.initState();
    if (widget.args != null) {
      _effectiveArgs = widget.args;
      _controller = OrderReceiptController(
        plan: widget.args!.plan,
        initialPhone: widget.args!.customerPhone,
        baseValue: widget.args!.baseValue,
        isBoxPackNew: widget.args!.isBoxPackNew,
      );
    }
  }
  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    if (_controller == null) {
      final rawArgs = ModalRoute.of(context)?.settings.arguments;
      if (rawArgs is OrderReceiptArgs) {
        _effectiveArgs = rawArgs;
      } else if (rawArgs is Map<String, dynamic>) {
        _effectiveArgs = OrderReceiptArgs.fromMap(rawArgs);
      }
      if (_effectiveArgs != null) {
        setState(() {
          _controller = OrderReceiptController(
            plan: _effectiveArgs!.plan,
            initialPhone: _effectiveArgs!.customerPhone,
            baseValue: _effectiveArgs!.baseValue,
            isBoxPackNew: _effectiveArgs!.isBoxPackNew,
          );
        });
      }
    }
  }
  @override
  void dispose() {
    _controller?.dispose();
    super.dispose();
  }
  @override
  Widget build(BuildContext context) {
    if (_controller == null || _effectiveArgs == null) {
      return const Scaffold(
        body: Center(child: CircularProgressIndicator()),
      );
    }
    final c = _controller!;
    final args = _effectiveArgs!;
    return Directionality(
      textDirection: TextDirection.rtl,
      child: ValueListenableBuilder(
        valueListenable: HiveBoxManager.listenToBox(BoxNames.appConfigBox),
        builder: (context, _, _) {
          return Scaffold(
            backgroundColor: const Color(0xFFF1F5F9),
            appBar: AppBar(
              elevation: 0,
              backgroundColor: AppColors.primaryEmerald,
              leading: IconButton(
                icon: const Icon(
                  Icons.arrow_back_ios_new_rounded,
                  color: Colors.white,
                  size: 18,
                ),
                onPressed: () => Navigator.pop(context),
              ),
              title: const Text(
                'آرڈر رسید، شیڈول اور سیکیورٹی تصدیق',
                style: TextStyle(
                  fontSize: 15,
                  fontWeight: FontWeight.bold,
                  color: Colors.white,
                ),
              ),
            ),
            body: ListenableBuilder(
              listenable: c,
              builder: (context, _) => SingleChildScrollView(
                controller: c.scrollController,
                physics: const BouncingScrollPhysics(),
                padding: const EdgeInsets.all(12),
                child: Container(
                  padding: const EdgeInsets.all(16),
                  decoration: BoxDecoration(
                    color: Colors.white,
                    borderRadius: BorderRadius.circular(16),
                    border: Border.all(color: const Color(0xFFCBD5E1)),
                  ),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      ReceiptTokenHeaderUi(tokenNo: c.tokenNo),
                      const Divider(height: 20, color: Color(0xFFE2E8F0)),
                      ReceiptSummaryRowsUi(
                        deviceName: args.deviceName,
                        guaranteeTitle: c.isChequePlan
                            ? 'بینک چیک گارنٹی'
                            : 'اشٹام پرنوٹ ضمانت',
                        months: c.months,
                        advance: c.advance,
                        monthly: c.monthly,
                        totalInstallmentSum: c.totalInstallmentSum,
                      ),
                      const SizedBox(height: 14),
                      CustomerQuickInfoBoxUi(
                        customerNameCtrl: c.customerNameCtrl,
                        customerFatherNameCtrl: c.customerFatherNameCtrl,
                        customerCasteCtrl: c.customerCasteCtrl,
                        customerPhoneCtrl: c.customerPhoneCtrl,
                        customerCnicCtrl: c.customerCnicCtrl,
                        customerAddressCtrl: c.customerAddressCtrl,
                        showValidationErrors: c.showValidationErrors,
                      ),
                      const SizedBox(height: 12),
                      GuarantorInfoCardUi(
                        guarantorNameCtrl: c.guarantorNameCtrl,
                        guarantorFatherNameCtrl: c.guarantorFatherNameCtrl,
                        guarantorCasteCtrl: c.guarantorCasteCtrl,
                        guarantorPhoneCtrl: c.guarantorPhoneCtrl,
                        guarantorCnicCtrl: c.guarantorCnicCtrl,
                        guarantorAddressCtrl: c.guarantorAddressCtrl,
                        guarantorRelationCtrl: c.guarantorRelationCtrl,
                        isMandatory: c.isGuarantorMandatory,
                        requiresGuarantorMdmLock: c.requiresGuarantorMdmLock,
                        mdmLockFee: c.config.mdmLockFee,
                        showValidationErrors: c.showValidationErrors,
                      ),
                      if (c.isChequePlan) ...[
                        const SizedBox(height: 12),
                        BankChequeInputBoxUi(
                          bankNameCtrl: c.bankNameCtrl,
                          chequeNoCtrl: c.chequeNoCtrl,
                        ),
                      ],
                      const SizedBox(height: 14),
                      SecurityBarrierChecklistCardUi(
                        items: c.barrierItems,
                        onToggleItem: c.toggleBarrierItem,
                        isRiskOverLimit: c.isRiskOverLimit,
                        isAdminOverrideApproved: c.isAdminOverrideApproved,
                        maxRiskLimit: c.config.zeroAdvanceMaxLimit,
                        baseValue: c.baseValue,
                        advancePaid: c.advance,
                        netRiskAmount: c.netRiskAmount,
                        guardianPhoneCtrl: c.guardianPhoneCtrl,
                        isGuardianNoticeSent: c.isGuardianNoticeSent,
                        onGuardianNoticeTriggered: c.markGuardianNoticeSent,
                        customerName: c.customerNameCtrl.text,
                        deviceName: args.deviceName,
                        onOpenAdminOverrideDialog: () =>
                            c.showAdminOverrideDialog(context),
                      ),
                      const SizedBox(height: 14),
                      ReceiptScheduleTableUi(
                        installmentSchedule: args.installmentSchedule,
                      ),
                      if (c.localError != null) ...[
                        const SizedBox(height: 8),
                        Text(
                          c.localError!,
                          style: const TextStyle(
                            fontSize: 11,
                            color: AppColors.errorRed,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                      ],
                      const SizedBox(height: 12),
                      const GracePeriodNoteUi(),
                      const SizedBox(height: 10),
                    ],
                  ),
                ),
              ),
            ),
            bottomNavigationBar: ListenableBuilder(
              listenable: c,
              builder: (context, _) => Container(
                padding:
                    const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
                decoration: const BoxDecoration(
                  color: Colors.white,
                  border: Border(top: BorderSide(color: Color(0xFFE2E8F0))),
                ),
                child: SafeArea(
                  child: SubmitOrderButtonUi(
                    isEnabled: c.isBarrierSatisfied,
                    onSubmitCloud: c.isSubmitting
                        ? () {}
                        : () => c.submitOrder(
                              context: context,
                              deviceName: args.deviceName,
                              sourceMode: args.sourceMode,
                              imeiNo: args.imeiNo,
                            ),
                    onGenerateQr: () => c.showOfflineQrCode(
                      context: context,
                      deviceName: args.deviceName,
                      imeiNo: args.imeiNo,
                      schedule: args.installmentSchedule,
                    ),
                  ),
                ),
              ),
            ),
          );
        },
      ),
    );
  }
}
