import 'dart:async';
import 'package:flutter/material.dart';
import '../../../core/constants/app_colors.dart';
class LiveNewsTickerUi extends StatefulWidget {
  final bool enabled;
  final String text;
  const LiveNewsTickerUi({
    super.key,
    required this.enabled,
    required this.text,
  });
  @override
  State<LiveNewsTickerUi> createState() => _LiveNewsTickerUiState();
}
class _LiveNewsTickerUiState extends State<LiveNewsTickerUi> {
  final ScrollController _scrollCtrl = ScrollController();
  Timer? _timer;
  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addPostFrameCallback((_) => _startMarquee());
  }
  void _startMarquee() {
    _timer?.cancel();
    _timer = Timer.periodic(const Duration(milliseconds: 45), (_) {
      if (!mounted || !_scrollCtrl.hasClients) return;
      final maxScroll = _scrollCtrl.position.maxScrollExtent;
      if (maxScroll <= 0) return;
      final nextOffset = _scrollCtrl.offset + 1.4;
      if (nextOffset >= maxScroll) {
        _scrollCtrl.jumpTo(0);
      } else {
        _scrollCtrl.jumpTo(nextOffset);
      }
    });
  }
  @override
  void dispose() {
    _timer?.cancel();
    _scrollCtrl.dispose();
    super.dispose();
  }
  @override
  Widget build(BuildContext context) {
    final cleanText = widget.text.trim();
    if (!widget.enabled || cleanText.isEmpty) {
      return const SizedBox.shrink();
    }
    final repeated = '$cleanText     ✦     $cleanText     ✦     $cleanText';
    return Container(
      width: double.infinity,
      height: 36,
      decoration: const BoxDecoration(
        color: Color(0xFF004D40),
        border: Border(
          bottom: BorderSide(color: AppColors.goldHighlight, width: 1.2),
        ),
      ),
      child: Row(
        children: [
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 11),
            height: double.infinity,
            color: AppColors.goldDeepBadge,
            alignment: Alignment.center,
            child: const Row(
              mainAxisSize: MainAxisSize.min,
              children: [
                Icon(
                  Icons.campaign_rounded,
                  size: 17,
                  color: AppColors.textDark,
                ),
                SizedBox(width: 4),
                Text(
                  'اعلان',
                  style: TextStyle(
                    fontSize: 13,
                    fontWeight: FontWeight.w900,
                    color: AppColors.textDark,
                  ),
                ),
              ],
            ),
          ),
          Expanded(
            child: ListView(
              controller: _scrollCtrl,
              scrollDirection: Axis.horizontal,
              physics: const NeverScrollableScrollPhysics(),
              children: [
                Center(
                  child: Padding(
                    padding: const EdgeInsets.symmetric(horizontal: 16),
                    child: Text(
                      repeated,
                      style: const TextStyle(
                        fontSize: 13.5,
                        fontWeight: FontWeight.w900,
                        color: AppColors.goldHighlight,
                      ),
                    ),
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }
}
