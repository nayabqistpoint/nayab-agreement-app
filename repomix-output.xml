import 'package:flutter/material.dart';
import '../../../core/constants/app_colors.dart';
class StockCardVisualTheme {
  final Color cardBg;
  final Color borderColor;
  final Color badgeColor;
  final Color innerPillBg;
  final Color innerPillBorder;
  final Color innerTextColor;
  const StockCardVisualTheme({
    required this.cardBg,
    required this.borderColor,
    required this.badgeColor,
    required this.innerPillBg,
    required this.innerPillBorder,
    required this.innerTextColor,
  });
}
class StockCardThemeHelper {
  static StockCardVisualTheme resolve({
    required String statusCode,
    required bool isSelectedInCart,
    required bool isRibbonExpanded,
  }) {
    final isReserved = statusCode == 'RESERVED';
    final isSold = statusCode == 'SOLD';
    final isOnOrder = statusCode == 'ON_ORDER';
    Color cardBg = isSelectedInCart
        ? AppColors.warmTintEmerald
        : AppColors.cardSurface;
    Color borderColor = isSelectedInCart
        ? AppColors.primaryEmerald
        : (isRibbonExpanded
            ? AppColors.primaryEmerald
            : AppColors.borderLight);
    Color badgeColor = AppColors.primaryEmerald;
    if (isReserved) {
      cardBg = AppColors.reservedCardBg;
      borderColor = AppColors.reservedCardBorder;
      badgeColor = AppColors.reservedAccent;
    } else if (isSold) {
      cardBg = AppColors.soldCardBg;
      borderColor = AppColors.emeraldPillBorder;
      badgeColor = AppColors.primaryEmerald;
    } else if (isOnOrder) {
      badgeColor = const Color(0xFF0F766E);
    }
    return StockCardVisualTheme(
      cardBg: cardBg,
      borderColor: borderColor,
      badgeColor: badgeColor,
      innerPillBg: isSold ? AppColors.warmTintEmerald : AppColors.reservedPillBg,
      innerPillBorder:
          isSold ? AppColors.emeraldPillBorder : AppColors.reservedCardBorder,
      innerTextColor:
          isSold ? AppColors.primaryEmerald : AppColors.reservedAccent,
    );
  }
  static void showLockedWarning(
      BuildContext context, bool isSold, String ownerInfo) {
    final msg = isSold
        ? (ownerInfo.isNotEmpty
            ? '🔒 یہ آئٹم پہلے ہی "$ownerInfo" کو فروخت (Sold) ہو چکا ہے!'
            : '🔒 یہ آئٹم پہلے ہی فروخت (Sold) ہو چکا ہے!')
        : (ownerInfo.isNotEmpty
            ? '🔒 یہ آئٹم پہلے ہی "$ownerInfo" کے نام بُک (زیرِ معاہدہ) ہے!'
            : '🔒 یہ آئٹم پہلے ہی کسی گاہک کے نام بُک (زیرِ معاہدہ) ہے!');
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(msg, style: const TextStyle(fontWeight: FontWeight.bold)),
        backgroundColor:
            isSold ? AppColors.primaryEmerald : AppColors.reservedAccent,
      ),
    );
  }
}
