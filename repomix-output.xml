import '../../../core/constants/box_names.dart';
import '../../../core/database/hive_box_manager.dart';
import '../../../core/time/time_status_service.dart';
class CounterStorageHandlerService {
  static Map<dynamic, dynamic> getDraft() {
    try {
      final box = HiveBoxManager.getBox(BoxNames.agreementDraftBox);
      return box.toMap();
    } catch (_) {
      return {};
    }
  }
  static Future<void> saveDraftBatch(Map<String, dynamic> payload) async {
    try {
      final box = HiveBoxManager.getBox(BoxNames.agreementDraftBox);
      await box.putAll(payload);
    } catch (e) {
      debugPrint('CounterStorageHandlerService saveDraft Error: $e');
    }
  }
  static ValueListenable listenToDraft() {
    return HiveBoxManager.listenToBox(BoxNames.agreementDraftBox);
  }
  static ValueListenable listenToTemplates() {
    return HiveBoxManager.listenToBox(BoxNames.templatesBox);
  }
  static Map<String, Map<String, dynamic>> getAllTemplates() {
    try {
      final box = HiveBoxManager.getBox(BoxNames.templatesBox);
      final Map<String, Map<String, dynamic>> map = {};
      for (var key in box.keys) {
        final val = box.get(key);
        if (val is Map && val['isDeleted'] != true) {
          map[key.toString()] = Map<String, dynamic>.from(val);
        }
      }
      return map;
    } catch (_) {
      return {};
    }
  }
  static Future<bool> deleteTemplate(String title) async {
    try {
      final cleanTitle = title.trim();
      final box = HiveBoxManager.getBox(BoxNames.templatesBox);
      final raw = box.get(cleanTitle);
      if (raw is Map) {
        final map = Map<String, dynamic>.from(raw);
        map['isDeleted'] = true;
        map['isSynced'] = false;
        map['updatedAt'] = TimeStatusService.nowUtcIso();
        await box.put(cleanTitle, map);
      } else {
        await box.delete(cleanTitle);
      }
      final draftBox = HiveBoxManager.getBox(BoxNames.agreementDraftBox);
      if (draftBox.get('selected_template') == cleanTitle) {
        await draftBox.delete('selected_template');
      }
      return true;
    } catch (e) {
      debugPrint('CounterStorageHandlerService deleteTemplate Error: $e');
      return false;
    }
  }
}
</file>

<file path="lib/features/customer_directory/customer_directory_page.dart">
import 'package:flutter/material.dart';
import '../../core/constants/app_colors.dart';
import '../../core/constants/box_names.dart';
import '../../core/database/hive_box_manager.dart';
import '../../core/models/customer_profile_model.dart';
import '../customer_detail/args/customer_detail_args.dart';
import '../customer_detail/customer_detail_page.dart';
import 'components/customer_profile_tile_ui.dart';
import 'services/customer_directory_service.dart';
class CustomerDirectoryPage extends StatefulWidget {
  const CustomerDirectoryPage({super.key});
  @override
  State<CustomerDirectoryPage> createState() => _CustomerDirectoryPageState();
}
class _CustomerDirectoryPageState extends State<CustomerDirectoryPage> {
  final TextEditingController _searchCtrl = TextEditingController();
  String _searchQuery = '';
  bool _isSelectionMode = false;
  final Set<String> _selectedIds = {};
  @override
  void dispose() {
    _searchCtrl.dispose();
    super.dispose();
  }
  void _applyCnicToSearch(String cnic) {
    final clean = cnic.trim();
    if (clean.isEmpty) return;
    _searchCtrl.text = clean;
    setState(() {
      _searchQuery = clean;
    });
  }
  List<CustomerProfileModel> _getFilteredList() {
    final all = CustomerDirectoryService.getAllActiveProfiles();
    final q = _searchQuery.trim().toLowerCase();
    if (q.isEmpty) return all;
    final cleanQ = q.replaceAll('-', '');
    final custBox = HiveBoxManager.getBox(BoxNames.customersBox);
    return all.where((c) {
      final nameMatch = c.fullName.toLowerCase().contains(q);
      final cnicMatch = c.cnic.replaceAll('-', '').toLowerCase().contains(cleanQ);
      final phoneMatch = c.phone.contains(q);
      bool linkedGuarantorMatch = false;
      final raw = custBox.get(c.id);
      if (raw is Map) {
        final gCnic = (raw['linkedGuarantorCnic']?.toString() ?? '')
            .replaceAll('-', '')
            .toLowerCase();
        final gName =
            (raw['linkedGuarantorName']?.toString() ?? '').toLowerCase();
        linkedGuarantorMatch =
            gCnic.contains(cleanQ) || gName.contains(q);
      }
      return nameMatch || cnicMatch || phoneMatch || linkedGuarantorMatch;
    }).toList();
  }
  void _toggleSelection(String id) {
    setState(() {
      if (_selectedIds.contains(id)) {
        _selectedIds.remove(id);
        if (_selectedIds.isEmpty) _isSelectionMode = false;
      } else {
        _selectedIds.add(id);
        _isSelectionMode = true;
      }
    });
  }
  void _selectAll(List<CustomerProfileModel> visibleList) {
    setState(() {
      _isSelectionMode = true;
      _selectedIds.addAll(visibleList.map((e) => e.id));
    });
  }
  void _exitSelectionMode() {
    setState(() {
      _isSelectionMode = false;
      _selectedIds.clear();
    });
  }
  void _confirmBatchDelete() {
    if (_selectedIds.isEmpty) return;
    final count = _selectedIds.length;
    showDialog(
      context: context,
      builder: (ctx) => Directionality(
        textDirection: TextDirection.rtl,
        child: AlertDialog(
          title: Text(
            '$count منتخب ریکارڈز حذف کریں؟',
            style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 16),
          ),
          content: const Text(
            'کیا آپ واقعی منتخب کردہ تمام افراد اور ان کے منسلک معاہدات کو ہمیشہ کے لیے حذف کرنا چاہتے ہیں؟',
            style: TextStyle(fontSize: 13.5),
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(ctx),
              child: const Text('منسوخ'),
            ),
            ElevatedButton(
              onPressed: () async {
                final dialogNav = Navigator.of(ctx);
                final messenger = ScaffoldMessenger.of(context);
                final toDelete = Set<String>.from(_selectedIds);
                await CustomerDirectoryService.deleteCustomersAndDeals(
                    toDelete);
                if (ctx.mounted) dialogNav.pop();
                if (!mounted) return;
                _exitSelectionMode();
                messenger.showSnackBar(
                  SnackBar(
                    content: Text('✅ $count ریکارڈز کامیابی سے حذف کر دیے گئے'),
                    backgroundColor: AppColors.successGreen,
                  ),
                );
              },
              style: ElevatedButton.styleFrom(
                backgroundColor: Colors.red.shade700,
                foregroundColor: Colors.white,
              ),
              child: const Text('ہاں، حذف کریں'),
            ),
          ],
        ),
      ),
    );
  }
  @override
  Widget build(BuildContext context) {
    return ValueListenableBuilder(
      valueListenable: HiveBoxManager.listenToBox(BoxNames.customersBox),
      builder: (context, custBox, child) {
        final list = _getFilteredList();
        return Directionality(
          textDirection: TextDirection.rtl,
          child: Scaffold(
            backgroundColor: AppColors.backgroundLight,
            appBar: AppBar(
              title: Text(
                _isSelectionMode
                    ? '${_selectedIds.length} منتخب شدہ'
                    : 'کسٹمر و ضامن ڈائریکٹری (${list.length})',
                style:
                    const TextStyle(fontWeight: FontWeight.bold, fontSize: 18),
              ),
              backgroundColor: _isSelectionMode
                  ? Colors.blueGrey.shade800
                  : AppColors.primaryEmerald,
              foregroundColor: Colors.white,
              leading: _isSelectionMode
                  ? IconButton(
                      icon: const Icon(Icons.close),
                      onPressed: _exitSelectionMode,
                    )
                  : null,
              actions: [
                if (_isSelectionMode) ...[
                  IconButton(
                    icon: const Icon(Icons.select_all),
                    tooltip: 'سب منتخب کریں',
                    onPressed: () => _selectAll(list),
                  ),
                  IconButton(
                    icon: const Icon(Icons.delete_outline),
                    tooltip: 'منتخب حذف کریں',
                    onPressed: _confirmBatchDelete,
                  ),
                ] else if (list.isNotEmpty)
                  IconButton(
                    icon: const Icon(Icons.checklist_rtl),
                    tooltip: 'ملٹی سلیکٹ / حذف موڈ',
                    onPressed: () => setState(() => _isSelectionMode = true),
                  ),
              ],
            ),
            body: Column(
              children: [
                Padding(
                  padding: const EdgeInsets.all(12.0),
                  child: TextField(
                    controller: _searchCtrl,
                    textAlign: TextAlign.right,
                    onChanged: (val) => setState(() => _searchQuery = val),
                    decoration: InputDecoration(
                      hintText: 'نام، شناختی کارڈ یا فون سے تلاش کریں...',
                      prefixIcon: const Icon(Icons.search),
                      suffixIcon: _searchQuery.isNotEmpty
                          ? IconButton(
                              icon: const Icon(Icons.clear, size: 18),
                              onPressed: () {
                                _searchCtrl.clear();
                                setState(() => _searchQuery = '');
                              },
                            )
                          : null,
                      border: OutlineInputBorder(
                          borderRadius: BorderRadius.circular(8)),
                      filled: true,
                      fillColor: Colors.white,
                    ),
                  ),
                ),
                Expanded(
                  child: list.isEmpty
                      ? const Center(
                          child: Text(
                            'کوئی ریکارڈ نہیں ملا۔',
                            style: TextStyle(color: AppColors.textMuted),
                          ),
                        )
                      : ListView.builder(
                          itemCount: list.length,
                          itemBuilder: (context, index) {
                            final p = list[index];
                            final isSelected = _selectedIds.contains(p.id);
                            return CustomerProfileTileUi(
                              customer: p,
                              isSelectionMode: _isSelectionMode,
                              isSelected: isSelected,
                              onCnicTap: _applyCnicToSearch,
                              onLongPress: () => _toggleSelection(p.id),
                              onTap: () {
                                if (_isSelectionMode) {
                                  _toggleSelection(p.id);
                                } else {
                                  Navigator.push(
                                    context,
                                    MaterialPageRoute(
                                      builder: (_) => CustomerDetailPage(
                                        args: CustomerDetailArgs(
                                          customerId: p.id,
                                          customerCnic: p.cnic,
                                        ),
                                      ),
                                    ),
                                  );
                                }
                              },
                            );
                          },
                        ),
                ),
              ],
            ),
          ),
        );
      },
    );
  }
}
