<file path="../nayab_shop_pos/lib/features/device_plan_detail/services/direct_cash_sale_service.dart">
import '../../../core/constants/app_colors.dart';
import '../../../core/constants/box_names.dart';
import '../../../core/database/hive_box_manager.dart';
import '../../../core/security/device_license_service.dart';
import '../../../core/time/time_status_service.dart';
import '../components/direct_cash_sale_card_ui.dart';
class DirectCashSaleService {
  static Future<bool> executeCashSale({
    required List<({CashSaleLineItem line, int finalUnitPrice})> pricedLines,
    required int totalCashPrice,
    required String customerName,
    required String customerPhone,
  }) async {
    if (pricedLines.isEmpty) return false;
    try {
      final stockBox = HiveBoxManager.getBox(BoxNames.stockBox);
      final now = TimeStatusService.nowUtcIso();
      final sellerLabel = DeviceLicenseService.getCurrentSellerLabel();
      final sellerDeviceId = DeviceLicenseService.getOrCreateDeviceId();
      final DataMap stockUpdates = {};
      final List<String> soldIds = [];
      final List<String> soldImeis = [];
      final List<String> itemSummaries = [];
      int totalPurchaseCost = 0;
      final buyerLabel = customerName.isNotEmpty
          ? (customerPhone.isNotEmpty
              ? '$customerName ($customerPhone) - نقد'
              : '$customerName - نقد')
          : 'نقد کسٹمر (Net Cash)';
      for (final entry in pricedLines) {
        final line = entry.line;
        final unitCash = entry.finalUnitPrice;
        int actualCountForLine = 0;
        for (final sid in line.stockIds) {
          if (sid.isEmpty) continue;
          final raw = stockBox.get(sid);
          if (raw is Map) {
            final stMap = DataMap.from(raw);
            final stUpper =
                (stMap['status']?.toString() ?? 'AVAILABLE').toUpperCase();
            if (stUpper != 'AVAILABLE') continue;
            actualCountForLine++;
            soldIds.add(sid);
            totalPurchaseCost += (stMap['purchasePrice'] as num?)?.toInt() ?? 0;
            final im =
                (stMap['imeiNo'] ?? stMap['serialNo'] ?? '').toString().trim();
            if (im.isNotEmpty && im != 'null') soldImeis.add(im);
            stMap['status'] = 'SOLD';
            stMap['soldToName'] = buyerLabel;
            stMap['soldPlanSummary'] = '💵 نقد فروخت (Net Cash Sold)';
            stMap['cashSalePrice'] = unitCash;
            stMap['soldByLabel'] = sellerLabel;
            stMap['updatedAt'] = now;
            stMap['isSynced'] = false;
            stockUpdates[sid] = stMap;
          }
        }
        if (actualCountForLine > 0) {
          itemSummaries.add(actualCountForLine > 1
              ? '${line.itemName} (×$actualCountForLine @ Rs.$unitCash)'
              : '${line.itemName} (@ Rs.$unitCash)');
        }
      }
      if (soldIds.isEmpty) return false;
      final int qty = soldIds.length;
      final String combinedName =
          itemSummaries.isNotEmpty ? itemSummaries.join(' + ') : 'نقد آئٹم';
      final String cashLogId = 'CASH_${DateTime.now().millisecondsSinceEpoch}';
      final DataMap cashAuditRecord = {
        'id': cashLogId,
        'docId': cashLogId,
        'status': 'CASH_SALE_COMPLETED',
        'isCashSale': true,
        'isCashSaleRead': false,
        'stockId': soldIds.join(', '),
        'stockIds': soldIds,
        'itemName': combinedName,
        'imeiNo': soldImeis.join(', '),
        'quantity': qty,
        'unitCashPrice': qty > 0 ? (totalCashPrice ~/ qty) : totalCashPrice,
        'totalPurchasePrice': totalPurchaseCost,
        'totalContractAmount': totalCashPrice,
        'advance': totalCashPrice,
        'monthlyAmount': 0,
        'totalMonths': 0,
        'customerName':
            customerName.isNotEmpty ? customerName : 'نقد کسٹمر (Net Cash)',
        'customerPhone': customerPhone,
        'soldByLabel': sellerLabel,
        'soldByDeviceId': sellerDeviceId,
        'createdAt': now,
        'updatedAt': now,
        'isSynced': false,
        'isDeleted': false,
      };
      await HiveBoxManager.putBatch(
        boxName: BoxNames.stockBox,
        entries: stockUpdates,
      );
      await HiveBoxManager.putBatch(
        boxName: BoxNames.shopOrdersBox,
        entries: {cashLogId: cashAuditRecord},
      );
      return true;
    } catch (_) {
      return false;
    }
  }
}
