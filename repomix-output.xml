import '../device_plan_detail/services/stock_live_status_service.dart';
import 'components/security_barrier_checklist_card_ui.dart';
import 'models/order_receipt_form_controllers.dart';
import 'services/order_submission_service.dart';
import 'services/order_validation_service.dart';
import 'services/security_barrier_service.dart';
class OrderReceiptController extends ChangeNotifier {
  final DataMap plan;
  final int baseValue;
  final bool isBoxPackNew;
  final String? stockId, imeiNo, serialNo;
  final OrderReceiptFormControllers forms = OrderReceiptFormControllers();
  String? customerPhotoPath, guarantorPhotoPath, localError;
  late final int initialAdvance, initialMonthly, months, initialTotalSum;
  late final bool isChequePlan, isZeroAdvance, isGeneral, isCustomEstimate;
  late final String zoneType, productCategory, tokenNo;
  final Set<String> _checkedBarrierIds = {};
  bool isAdminOverrideApproved = false, isGuardianNoticeSent = false;
  bool isSubmitting = false, showValidationErrors = false, _isDisposed = false;
  OrderReceiptController({
    required this.plan,
    String? initialPhone,
    this.baseValue = 0,
    this.isBoxPackNew = true,
    this.stockId,
    this.imeiNo,
    this.serialNo,
  }) {
    initialAdvance = (plan['advance'] as num?)?.toInt() ?? 0;
    initialMonthly = (plan['monthly'] as num?)?.toInt() ?? 0;
    months = (plan['months'] as num?)?.toInt() ?? 6;
    initialTotalSum = (plan['totalContract'] as num?)?.toInt() ??
        (initialAdvance + (initialMonthly * ((months - 1) > 0 ? months - 1 : 1)));
    isChequePlan = plan['guarantee'] == 'BANK_CHEQUE';
    isZeroAdvance = initialAdvance == 0;
    isCustomEstimate = plan['isCustomEstimate'] == true ||
        (stockId == null || stockId!.trim().isEmpty);
    zoneType = (plan['zoneType']?.toString().trim().isNotEmpty == true)
        ? plan['zoneType'].toString().trim().toUpperCase()
        : (isCustomEstimate ? 'CUSTOM_ESTIMATE' : 'MOBILE');
    productCategory = zoneType == 'ELECTRONICS' ? 'ELECTRONICS' : 'MOBILE';
    isGeneral = productCategory == 'ELECTRONICS';
    tokenNo = 'NQP-${DateTime.now().millisecondsSinceEpoch.toString().substring(7)}';
    if (initialPhone != null && initialPhone.isNotEmpty) {
      forms.customerPhoneCtrl.text = initialPhone;
    }
    forms.guardianPhoneCtrl.addListener(_onGuardianPhoneChanged);
  }
  void _safeNotify() { if (!_isDisposed) notifyListeners(); }
  void setCustomerPhoto(String? p) { customerPhotoPath = p; _safeNotify(); }
  void setGuarantorPhoto(String? p) { guarantorPhotoPath = p; _safeNotify(); }
  void approveAdminOverride() { isAdminOverrideApproved = true; _safeNotify(); }
  CalculatorConfigModel get config => CalculatorConfigService().getConfig();
  int get advance => initialAdvance;
  bool get isGuarantorMandatory => !isChequePlan;
  bool get requiresGuarantorMdmLock => !isChequePlan && isZeroAdvance;
  int get effectiveBaseValue {
    final cleanId = stockId?.trim() ?? '';
    if (cleanId.isNotEmpty && cleanId != 'null') {
      final live = StockLiveStatusService.resolveLiveBaseValue(0, cleanId);
      if (live > 0) return live;
    }
    return baseValue > 0 ? baseValue : ((plan['baseValue'] as num?)?.toInt() ?? initialTotalSum);
  }
  int get monthly {
    if (effectiveBaseValue <= 0) return initialMonthly;
    final principal = PlanMathService.calculatePrincipal(
        baseValue: effectiveBaseValue, config: config, zoneType: zoneType);
    final total = PlanMathService.calculateTotalContractPrice(
        principal: principal, months: months, isCheque: isChequePlan, config: config, zoneType: zoneType);
    return PlanMathService.calculateMonthlyEmi(
        totalContractPrice: total, advancePaid: advance, months: months, config: config, zoneType: zoneType);
  }
  int get totalInstallmentSum =>
      advance + (monthly * ((months - 1) > 0 ? months - 1 : 1));
  bool get hasLiveRateChanged =>
      monthly != initialMonthly || totalInstallmentSum != initialTotalSum;
  List<DataMap> get liveInstallmentSchedule => PlanScheduleService.generateSchedule(
      totalMonths: months, monthlyAmount: monthly, advancePaid: advance, config: config, zoneType: zoneType);
  void _onGuardianPhoneChanged() {
    if (forms.guardianPhoneCtrl.text.replaceAll(RegExp(r'[^0-9]'), '').length < 10 && isGuardianNoticeSent) {
      isGuardianNoticeSent = false;
      _safeNotify();
    }
  }
  void markGuardianNoticeSent() {
    if (forms.guardianPhoneCtrl.text.replaceAll(RegExp(r'[^0-9]'), '').length >= 10) {
      isGuardianNoticeSent = true;
      _safeNotify();
    }
  }
  int get netRiskAmount => (effectiveBaseValue - advance) > 0 ? (effectiveBaseValue - advance) : 0;
  int get activeMaxRiskLimit => config.maxRiskForZone(zoneType);
  bool get isRiskOverLimit => activeMaxRiskLimit > 0 && netRiskAmount > activeMaxRiskLimit;
  String get openBoxDeductionText => config.openBoxTypeForZone(zoneType) == 'FIXED'
      ? 'Rs. ${config.openBoxValForZone(zoneType)} فکس کٹوتی'
      : '${config.openBoxValForZone(zoneType)}% کٹوتی';
  List<SecurityBarrierItem> get barrierItems => SecurityBarrierService.buildChecklist(
      config: config, zoneType: zoneType, isGeneral: isGeneral, isCustomEstimate: isCustomEstimate,
      isChequePlan: isChequePlan, isZeroAdvance: isZeroAdvance, isBoxPackNew: isBoxPackNew,
      openBoxDeductionText: openBoxDeductionText, checkedIds: _checkedBarrierIds);
  bool get isBarrierSatisfied {
    if (isRiskOverLimit && !isAdminOverrideApproved) return false;
    if (!isGuardianNoticeSent || forms.guardianPhoneCtrl.text.replaceAll(RegExp(r'[^0-9]'), '').length < 10) return false;
    return barrierItems.every((item) => item.isChecked);
  }
  void toggleBarrierItem(String id) {
    _checkedBarrierIds.contains(id) ? _checkedBarrierIds.remove(id) : _checkedBarrierIds.add(id);
    _safeNotify();
  }
  Future<void> submitOrder({required BuildContext context, required String deviceName, String? sourceMode, String? imeiNo}) async {
    final val = OrderValidationService.validate(
      isBarrierSatisfied: isBarrierSatisfied, isChequePlan: isChequePlan, bankName: forms.bankNameCtrl.text,
      chequeNo: forms.chequeNoCtrl.text, customerName: forms.customerNameCtrl.text, customerFatherName: forms.customerFatherNameCtrl.text,
      customerCaste: forms.customerCasteCtrl.text, customerPhone: forms.customerPhoneCtrl.text, customerCnic: forms.customerCnicCtrl.text,
      customerAddress: forms.customerAddressCtrl.text, isGuarantorMandatory: isGuarantorMandatory,
      guarantorName: forms.guarantorNameCtrl.text, guarantorFatherName: forms.guarantorFatherNameCtrl.text,
      guarantorCaste: forms.guarantorCasteCtrl.text, guarantorPhone: forms.guarantorPhoneCtrl.text,
      guarantorCnic: forms.guarantorCnicCtrl.text, guarantorRelation: forms.guarantorRelationCtrl.text, guarantorAddress: forms.guarantorAddressCtrl.text,
    );
    if (!val.isValid) {
      showValidationErrors = val.showFieldErrors; localError = val.errorMessage; _safeNotify();
      if (val.showFieldErrors && forms.scrollController.hasClients) {
        forms.scrollController.animateTo(180.0, duration: const Duration(milliseconds: 300), curve: Curves.easeOut);
      }
      return;
    }
    showValidationErrors = false; localError = null; isSubmitting = true; _safeNotify();
    final messenger = ScaffoldMessenger.maybeOf(context);
    final navigator = Navigator.of(context);
    final res = await OrderSubmissionService.submitFullOrder(
      tokenNo: tokenNo, plan: plan, deviceName: deviceName, stockId: stockId, imeiNo: imeiNo, serialNo: serialNo,
      sourceMode: sourceMode, isCustomEstimate: isCustomEstimate, zoneType: zoneType, productCategory: productCategory,
      effectiveBaseValue: effectiveBaseValue, months: months, advance: advance, monthly: monthly,
      totalInstallmentSum: totalInstallmentSum, mdmLockFee: config.mdmFeeForZone(zoneType),
      openBoxDeductionText: openBoxDeductionText, adminOverrideApplied: isAdminOverrideApproved,
      acceptedConditions: barrierItems.where((i) => i.isChecked).map((i) => i.text).toList(),
      customerName: forms.customerNameCtrl.text, customerFatherName: forms.customerFatherNameCtrl.text,
      customerCaste: forms.customerCasteCtrl.text, customerPhone: forms.customerPhoneCtrl.text, customerCnic: forms.customerCnicCtrl.text,
      customerAddress: forms.customerAddressCtrl.text, customerPhotoPath: customerPhotoPath, guarantorName: forms.guarantorNameCtrl.text,
      guarantorFatherName: forms.guarantorFatherNameCtrl.text, guarantorCaste: forms.guarantorCasteCtrl.text,
      guarantorPhone: forms.guarantorPhoneCtrl.text, guarantorCnic: forms.guarantorCnicCtrl.text, guarantorAddress: forms.guarantorAddressCtrl.text,
      guarantorRelation: forms.guarantorRelationCtrl.text, guarantorPhotoPath: guarantorPhotoPath,
      guardianPhone: forms.guardianPhoneCtrl.text, bankName: forms.bankNameCtrl.text, chequeNo: forms.chequeNoCtrl.text,
    );
    if (res.success) {
      if (context.mounted && navigator.canPop()) navigator.pop();
      messenger?.showSnackBar(SnackBar(
          content: Text('آرڈر $tokenNo مکمل ہو گیا اور کاؤنٹر پر بھیج دیا گیا!', style: const TextStyle(fontWeight: FontWeight.bold)),
          backgroundColor: AppColors.primaryEmerald));
    } else {
      isSubmitting = false; localError = res.error; _safeNotify();
    }
  }
  @override
  void dispose() {
    _isDisposed = true;
    forms.guardianPhoneCtrl.removeListener(_onGuardianPhoneChanged);
    forms.disposeAll();
    super.dispose();
  }
}
