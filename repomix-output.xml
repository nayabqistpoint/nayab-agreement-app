import 'package:flutter/material.dart';
import '../../../core/constants/app_colors.dart';
class CashSaleLineItem {
  final String itemName;
  final int quantity;
  final int defaultUnitCashPrice;
  final int minAllowedUnitCashPrice;
  final List<String> stockIds;
  final List<String> imeis;
  const CashSaleLineItem({
    required this.itemName,
    required this.quantity,
    required this.defaultUnitCashPrice,
    this.minAllowedUnitCashPrice = 1,
    required this.stockIds,
    required this.imeis,
  });
}
class DirectCashSaleCardUi extends StatefulWidget {
  final List<CashSaleLineItem> lineItems;
  final bool allowPriceEdit;
  final String sellerLabel;
  final bool isLocked;
  final Future<void> Function({
    required List<({CashSaleLineItem line, int finalUnitPrice})> pricedLines,
    required int totalCashPrice,
    required String customerName,
    required String customerPhone,
  }) onCompleteCashSale;
  const DirectCashSaleCardUi({
    super.key,
    required this.lineItems,
    this.allowPriceEdit = true,
    required this.sellerLabel,
    required this.isLocked,
    required this.onCompleteCashSale,
  });
  @override
  State<DirectCashSaleCardUi> createState() => _DirectCashSaleCardUiState();
}
class _DirectCashSaleCardUiState extends State<DirectCashSaleCardUi> {
  final List<TextEditingController> _unitPriceCtrls = [];
  final TextEditingController _custNameCtrl = TextEditingController();
  final TextEditingController _custPhoneCtrl = TextEditingController();
  bool _isSaving = false;
  @override
  void initState() {
    super.initState();
    _syncControllers();
  }
  @override
  void didUpdateWidget(covariant DirectCashSaleCardUi oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (oldWidget.lineItems.length != widget.lineItems.length) {
      _syncControllers();
    } else {
      for (int i = 0; i < widget.lineItems.length; i++) {
        if (oldWidget.lineItems[i].defaultUnitCashPrice !=
            widget.lineItems[i].defaultUnitCashPrice) {
          _unitPriceCtrls[i].text =
              widget.lineItems[i].defaultUnitCashPrice.toString();
        }
      }
    }
  }
  void _syncControllers() {
    for (final c in _unitPriceCtrls) {
      c.dispose();
    }
    _unitPriceCtrls.clear();
    for (final line in widget.lineItems) {
      final ctrl =
          TextEditingController(text: line.defaultUnitCashPrice.toString());
      ctrl.addListener(() {
        if (mounted) setState(() {});
      });
      _unitPriceCtrls.add(ctrl);
    }
  }
  @override
  void dispose() {
    for (final c in _unitPriceCtrls) {
      c.dispose();
    }
    _custNameCtrl.dispose();
    _custPhoneCtrl.dispose();
    super.dispose();
  }
  int _unitPriceAt(int index) {
    final line = widget.lineItems[index];
    if (!widget.allowPriceEdit || index >= _unitPriceCtrls.length) {
      return line.defaultUnitCashPrice;
    }
    return int.tryParse(_unitPriceCtrls[index].text.trim()) ?? 0;
  }
  bool _isBelowMinAt(int index) {
    final line = widget.lineItems[index];
    final uPrice = _unitPriceAt(index);
    return uPrice < line.minAllowedUnitCashPrice;
  }
  bool get _hasAnyFloorViolation {
    for (int i = 0; i < widget.lineItems.length; i++) {
      if (_isBelowMinAt(i)) return true;
    }
    return false;
  }
  int get _totalPieces =>
      widget.lineItems.fold<int>(0, (sum, l) => sum + l.quantity);
  int get _grandTotal {
    int sum = 0;
    for (int i = 0; i < widget.lineItems.length; i++) {
      sum += _unitPriceAt(i) * widget.lineItems[i].quantity;
    }
    return sum;
  }
  Future<void> _submit() async {
    final List<({CashSaleLineItem line, int finalUnitPrice})> priced = [];
    for (int i = 0; i < widget.lineItems.length; i++) {
      final line = widget.lineItems[i];
      final uPrice = _unitPriceAt(i);
      if (uPrice <= 0) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(
                'براہ کرم "${line.itemName}" کی درست فی پیس نقد قیمت درج کریں!'),
            backgroundColor: AppColors.errorRed,
          ),
        );
        return;
      }
      if (uPrice < line.minAllowedUnitCashPrice) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(
                '⚠️ "${line.itemName}" کی مقررہ کم از کم نقد قیمت Rs. ${line.minAllowedUnitCashPrice} ہے؛ اس سے کم پر فروخت کی اجازت نہیں!'),
            backgroundColor: AppColors.errorRed,
          ),
        );
        return;
      }
      priced.add((line: line, finalUnitPrice: uPrice));
    }
    setState(() => _isSaving = true);
    await widget.onCompleteCashSale(
      pricedLines: priced,
      totalCashPrice: _grandTotal,
      customerName: _custNameCtrl.text.trim(),
      customerPhone: _custPhoneCtrl.text.trim(),
    );
    if (mounted) setState(() => _isSaving = false);
  }
  @override
  Widget build(BuildContext context) {
    final bool disableSubmit =
        widget.isLocked || _isSaving || _hasAnyFloorViolation;
    return Container(
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        color: AppColors.cardSurface,
        borderRadius: BorderRadius.circular(14),
