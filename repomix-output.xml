<file path="lib/features/pos_pending_orders/pos_pending_orders_controller.dart">
import 'package:flutter/material.dart';
import '../../core/constants/box_names.dart';
import '../../core/database/hive_box_manager.dart';
import 'services/pos_pending_orders_service.dart';
class PosPendingOrdersController extends ChangeNotifier {
  String statusFilter = 'ALL';
  String searchQuery = '';
  PosPendingOrdersController({String? initialFilter}) {
    if (initialFilter != null && initialFilter.isNotEmpty) {
      statusFilter = initialFilter;
    } else {
      final pendingCount = PosPendingOrdersService.getPendingOrders().length;
      final unreadCash = PosPendingOrdersService.getUnreadCashSalesCount();
      if (pendingCount > 0) {
        statusFilter = 'PENDING';
      } else if (unreadCash > 0) {
        statusFilter = 'CASH';
      } else {
        statusFilter = 'ALL';
      }
    }
  }
  String? get activeOrderId {
    final draftBox = HiveBoxManager.getBox(BoxNames.agreementDraftBox);
    return draftBox.get('activePosOrderId')?.toString();
  }
  void setStatusFilter(String filter) {
    statusFilter = filter;
    notifyListeners();
  }
  void updateSearch(String q) {
    searchQuery = q;
    notifyListeners();
  }
  List<PosOrderRecord> getFilteredOrders() {
    List<PosOrderRecord> baseList;
    if (statusFilter == 'CASH') {
      baseList = PosPendingOrdersService.getCashSaleOrders();
    } else if (statusFilter == 'PENDING') {
      baseList = PosPendingOrdersService.getPendingOrders();
    } else if (statusFilter == 'HISTORY') {
      baseList = PosPendingOrdersService.getInstallmentOrders().where((map) {
        final st = (map['status']?.toString() ?? '').trim().toUpperCase();
        return st == 'AGREEMENT_COMPLETED' ||
            st == 'DISMISSED_BY_COUNTER' ||
            st == 'CANCELLED';
      }).toList();
    } else {
      baseList = PosPendingOrdersService.getInstallmentOrders();
    }
    final q = searchQuery.trim().toLowerCase();
    if (q.isEmpty) return baseList;
    final cleanQ = q.replaceAll('-', '');
    return baseList.where((order) {
      final name = (order['customerName']?.toString() ?? '').toLowerCase();
      final cnic = (order['customerCnic']?.toString() ?? '')
          .replaceAll('-', '')
          .toLowerCase();
      final gName = (order['guarantorName']?.toString() ?? '').toLowerCase();
      final gCnic = (order['guarantorCnic']?.toString() ?? '')
          .replaceAll('-', '')
          .toLowerCase();
      final phone = (order['customerPhone']?.toString() ?? '').toLowerCase();
      final model = (order['itemName']?.toString() ?? '').toLowerCase();
      final stkId = (order['stockId']?.toString() ?? '').toLowerCase();
      return name.contains(q) ||
          cnic.contains(cleanQ) ||
          gName.contains(q) ||
          gCnic.contains(cleanQ) ||
          phone.contains(q) ||
          model.contains(q) ||
          stkId.contains(q);
    }).toList();
  }
  Future<void> selectOrderForCounter(PosOrderRecord order) async {
    await PosPendingOrdersService.applyOrderToDraftBucket(order);
  }
  Future<void> dismissOrder(String orderId) async {
    await PosPendingOrdersService.dismissOrder(orderId);
    notifyListeners();
  }
}
</file>

<file path="lib/features/pos_pending_orders/pos_pending_orders_page.dart">
import 'package:flutter/material.dart';
import '../../core/constants/app_colors.dart';
import '../../core/constants/box_names.dart';
import '../../core/database/hive_box_manager.dart';
import 'components/pos_pending_order_card_ui.dart';
import 'pos_order_full_profile_page.dart';
import 'pos_pending_orders_controller.dart';
import 'services/pos_pending_orders_service.dart';
class PosPendingOrdersPage extends StatefulWidget {
  final String? initialFilter;
  const PosPendingOrdersPage({super.key, this.initialFilter});
  @override
  State<PosPendingOrdersPage> createState() => _PosPendingOrdersPageState();
}
class _PosPendingOrdersPageState extends State<PosPendingOrdersPage> {
  late final PosPendingOrdersController _controller;
  @override
  void initState() {
    super.initState();
    _controller =
        PosPendingOrdersController(initialFilter: widget.initialFilter);
    _controller.addListener(() {
      if (mounted) setState(() {});
    });
  }
  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }
  bool _requiresStockPurchaseFirst(PosOrderRecord order) {
    final stockId = order['stockId']?.toString().trim() ?? '';
    final sourceMode = (order['sourceMode']?.toString() ?? '').toUpperCase();
    final isCustom = order['isCustomEstimate'] == true ||
        sourceMode == 'CUSTOM_ESTIMATE' ||
        sourceMode == 'ON_ORDER';
    if (stockId.isEmpty || stockId == 'null') return true;
    if (isCustom) {
      final stockBox = HiveBoxManager.getBox(BoxNames.stockBox);
      final rawStock = stockBox.get(stockId);
      if (rawStock is Map) {
        final st = (rawStock['status']?.toString() ?? '').toUpperCase();
        if (st == 'ON_ORDER' || rawStock['isOnOrder'] == true) {
          return true;
        }
        return false;
      }
      return true;
    }
    return false;
  }
  Future<void> _handleOrderSelection(PosOrderRecord selectedOrder) async {
    final id = selectedOrder['id']?.toString() ?? '';
    final customer = selectedOrder['customerName']?.toString() ?? 'کسٹمر';
    if (_requiresStockPurchaseFirst(selectedOrder)) {
      Navigator.push(
        context,
        MaterialPageRoute(
          builder: (_) => PosOrderFullProfilePage(
            order: selectedOrder,
            onLoadToCounter: (updatedOrder) =>
                _handleOrderSelection(updatedOrder),
            onDismissOrder: () => _confirmDismiss(id, customer),
          ),
        ),
      );
      return;
    }
    final nav = Navigator.of(context);
    final messenger = ScaffoldMessenger.of(context);
    await _controller.selectOrderForCounter(selectedOrder);
    if (!mounted) return;
    nav.pop(true);
    messenger.showSnackBar(
      SnackBar(
        content: Text(
          '$customer کی معلومات ایگریمنٹ بالٹی میں لوڈ ہو گئی ہیں!',
        ),
        backgroundColor: AppColors.primaryEmerald,
      ),
    );
  }
  void _confirmDismiss(String orderId, String customerName) {
    showDialog(
      context: context,
      builder: (ctx) => Directionality(
        textDirection: TextDirection.rtl,
        child: AlertDialog(
          title: const Text(
            'آرڈر پینڈنگ لسٹ سے ہٹائیں؟',
            style: TextStyle(fontWeight: FontWeight.bold, fontSize: 16),
          ),
          content: Text(
            'کیا آپ "$customerName" کا یہ آرڈر کاؤنٹر کی پینڈنگ لسٹ سے ختم کرنا چاہتے ہیں؟ (ریکارڈ ہسٹری میں محفوظ رہے گا)',
            style: const TextStyle(fontSize: 13.5),
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(ctx),
              child: const Text('منسوخ'),
            ),
            ElevatedButton(
              onPressed: () async {
                final dialogNav = Navigator.of(ctx);
                final messenger = ScaffoldMessenger.of(context);
                await _controller.dismissOrder(orderId);
                if (ctx.mounted) dialogNav.pop();
                if (!mounted) return;
                messenger.showSnackBar(
                  const SnackBar(
                    content: Text('آرڈر پینڈنگ لسٹ سے ختم کر دیا گیا ہے'),
                  ),
                );
              },
              style: ElevatedButton.styleFrom(
                backgroundColor: Colors.red.shade700,
                foregroundColor: Colors.white,
              ),
              child: const Text('ہاں، ختم کریں'),
            ),
          ],
        ),
      ),
    );
  }
  Widget _buildFilterTab(
    String key,
    String label,
    int count, {
    int badgeCount = 0,
  }) {
    final isSelected = _controller.statusFilter == key;
    return Expanded(
      child: GestureDetector(
        onTap: () => _controller.setStatusFilter(key),
        child: Container(
          padding: const EdgeInsets.symmetric(vertical: 8, horizontal: 4),
          decoration: BoxDecoration(
            color: isSelected ? AppColors.primaryEmerald : Colors.white,
            borderRadius: BorderRadius.circular(8),
            border: Border.all(
              color: isSelected
                  ? AppColors.primaryEmerald
                  : (badgeCount > 0
                      ? Colors.amber.shade700
                      : const Color(0xFFCBD5E1)),
              width: badgeCount > 0 ? 1.6 : 1.2,
            ),
          ),
          alignment: Alignment.center,
          child: Row(
            mainAxisAlignment: MainAxisAlignment.center,
            mainAxisSize: MainAxisSize.min,
            children: [
              Flexible(
                child: Text(
                  '$label ($count)',
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: TextStyle(
                    fontSize: 11.5,
                    fontWeight: FontWeight.w900,
                    color: isSelected ? Colors.white : const Color(0xFF1E293B),
                  ),
                ),
              ),
              if (badgeCount > 0) ...[
                const SizedBox(width: 4),
                Container(
                  padding:
                      const EdgeInsets.symmetric(horizontal: 5, vertical: 1),
                  decoration: BoxDecoration(
                    color: AppColors.errorRed,
                    borderRadius: BorderRadius.circular(8),
                  ),
                  child: Text(
                    '$badgeCount',
                    style: const TextStyle(
                      color: Colors.white,
                      fontSize: 10,
                      fontWeight: FontWeight.w900,
                    ),
                  ),
                ),
              ],
            ],
          ),
        ),
      ),
    );
  }
  Widget _invoiceRow(String label, String value,
      {Color? valueColor, bool isBold = false}) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 3.5),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Text(
            label,
            style: const TextStyle(
              fontSize: 12.5,
              fontWeight: FontWeight.w700,
              color: AppColors.textMuted,
            ),
          ),
          const SizedBox(width: 8),
          Flexible(
            child: Text(
              value,
              textAlign: TextAlign.left,
              style: TextStyle(
                fontSize: isBold ? 14.5 : 13,
                fontWeight: isBold ? FontWeight.w900 : FontWeight.w800,
                color: valueColor ?? AppColors.textDark,
              ),
            ),
          ),
        ],
      ),
    );
  }
  Widget _buildCashSaleCard(PosOrderRecord order) {
    final id = order['id']?.toString() ?? '';
    final itemName = order['itemName']?.toString() ?? 'آئٹم';
    final stockId = order['stockId']?.toString() ?? '';
    final imei = order['imeiNo']?.toString() ?? '';
    final int qty = (order['quantity'] as num?)?.toInt() ?? 1;
    final int unitPrice = (order['unitCashPrice'] as num?)?.toInt() ??
        ((int.tryParse(order['totalContractAmount']?.toString() ?? '0') ?? 0) ~/
            (qty > 0 ? qty : 1));
    final int totalSale =
        (order['totalContractAmount'] as num?)?.toInt() ?? (unitPrice * qty);
    final int totalPurchase =
        (order['totalPurchasePrice'] as num?)?.toInt() ?? 0;
    final int netProfit = totalPurchase > 0 ? (totalSale - totalPurchase) : 0;
    final customer = order['customerName']?.toString() ?? 'نقد کسٹمر';
    final phone = order['customerPhone']?.toString() ?? '';
    final sellerLabel = order['soldByLabel']?.toString() ??
        (order['soldByDeviceId']?.toString() ?? 'POS کاؤنٹر');
    final createdAt = (order['createdAt']?.toString() ?? '').split('T').first;
    final bool isRead = order['isCashSaleRead'] == true;
    return Container(
      margin: const EdgeInsets.only(bottom: 12),
      decoration: BoxDecoration(
        color: isRead ? AppColors.cardSurface : const Color(0xFFFFFBEB),
        borderRadius: BorderRadius.circular(14),
        border: Border.all(
          color: isRead ? AppColors.borderLight : Colors.amber.shade700,
          width: isRead ? 1.3 : 2.0,
        ),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withValues(alpha: 0.05),
            blurRadius: 6,
            offset: const Offset(0, 2),
          ),
        ],
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 9),
            decoration: BoxDecoration(
              color:
                  isRead ? AppColors.primaryEmerald : const Color(0xFF004D40),
              borderRadius: const BorderRadius.only(
                topLeft: Radius.circular(12.5),
                topRight: Radius.circular(12.5),
              ),
            ),
            child: Row(
              children: [
                const Icon(
                  Icons.receipt_long_rounded,
                  color: AppColors.goldHighlight,
                  size: 20,
                ),
                const SizedBox(width: 7),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        'نقد فروخت انوائس ($id)',
                        style: const TextStyle(
                          fontSize: 13.5,
                          fontWeight: FontWeight.w900,
                          color: Colors.white,
                        ),
                      ),
                      Text(
                        'تاریخ: $createdAt • سیلز مین: $sellerLabel',
                        maxLines: 1,
                        overflow: TextOverflow.ellipsis,
                        style: const TextStyle(
                          fontSize: 11.5,
                          fontWeight: FontWeight.w800,
                          color: AppColors.goldHighlight,
                        ),
                      ),
                    ],
                  ),
                ),
                Container(
                  padding:
                      const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
                  decoration: BoxDecoration(
                    color: isRead ? Colors.white : AppColors.errorRed,
                    borderRadius: BorderRadius.circular(6),
                  ),
                  child: Text(
                    isRead ? '✓ تصدیق شدہ' : '● نئی انوائس',
                    style: TextStyle(
                      fontSize: 11,
                      fontWeight: FontWeight.w900,
                      color: isRead ? AppColors.primaryEmerald : Colors.white,
                    ),
                  ),
                ),
              ],
            ),
          ),
          Padding(
            padding: const EdgeInsets.all(11),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: [
                Container(
                  padding:
                      const EdgeInsets.symmetric(horizontal: 10, vertical: 8),
                  decoration: BoxDecoration(
                    color: AppColors.warmTintEmerald,
                    borderRadius: BorderRadius.circular(9),
                    border: Border.all(color: AppColors.emeraldPillBorder),
                  ),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Row(
                        children: [
                          Expanded(
                            child: Text(
                              itemName,
                              style: const TextStyle(
                                fontSize: 15,
                                fontWeight: FontWeight.w900,
                                color: AppColors.textDark,
                              ),
                            ),
                          ),
                          Container(
                            padding: const EdgeInsets.symmetric(
                                horizontal: 8, vertical: 2),
                            decoration: BoxDecoration(
                              color: AppColors.primaryEmerald,
                              borderRadius: BorderRadius.circular(6),
                            ),
                            child: Text(
                              '$qty پیس',
                              style: const TextStyle(
                                color: Colors.white,
                                fontSize: 12,
                                fontWeight: FontWeight.w900,
                              ),
                            ),
                          ),
                        ],
                      ),
                      if (stockId.isNotEmpty) ...[
                        const SizedBox(height: 4),
                        Text(
                          'اسٹاک IDs: $stockId',
                          style: const TextStyle(
                            fontSize: 12,
                            fontWeight: FontWeight.w800,
                            color: AppColors.primaryEmerald,
                          ),
                        ),
                      ],
                      if (imei.isNotEmpty) ...[
                        const SizedBox(height: 2),
                        Text(
                          'IMEI / سیریل: $imei',
                          style: const TextStyle(
                            fontSize: 12,
                            fontWeight: FontWeight.w700,
