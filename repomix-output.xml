import 'package:flutter/material.dart';
import '../../../core/constants/app_colors.dart';
import '../../../core/services/cloudinary_image_helper.dart';
import '../../../core/widgets/portable_image_ui.dart';
import 'full_screen_zoom_gallery_ui.dart';
class HeroImageSwiperUi extends StatefulWidget {
  final List<String> images;
  final List<String> imageLabels;
  const HeroImageSwiperUi({
    super.key,
    required this.images,
    this.imageLabels = const [],
  });
  @override
  State<HeroImageSwiperUi> createState() => _HeroImageSwiperUiState();
}
class _HeroImageSwiperUiState extends State<HeroImageSwiperUi> {
  int _currentPage = 0;
  @override
  Widget build(BuildContext context) {
    final List<String> validImages = [];
    final List<String> validLabels = [];
    for (int i = 0; i < widget.images.length; i++) {
      final clean = widget.images[i].trim();
      if (clean.isNotEmpty && clean != 'null') {
        validImages.add(clean);
        validLabels.add(
          i < widget.imageLabels.length ? widget.imageLabels[i].trim() : '',
        );
      }
    }
    final int safePage =
        validImages.isEmpty ? 0 : _currentPage.clamp(0, validImages.length - 1);
    final String activeLabel =
        validLabels.isNotEmpty ? validLabels[safePage] : '';
    return Stack(
      children: [
        SizedBox(
          height: 205,
          child: PageView.builder(
            itemCount: validImages.isNotEmpty ? validImages.length : 1,
            onPageChanged: (idx) => setState(() => _currentPage = idx),
            itemBuilder: (ctx, i) {
              final String url = validImages.isNotEmpty
                  ? CloudinaryImageHelper.toFullHdUrl(validImages[i])
                  : '';
              return InkWell(
                onTap: validImages.isEmpty
                    ? null
                    : () => FullScreenZoomGalleryUi.show(
                          context,
                          i,
                          validImages,
                          imageLabels: validLabels,
                        ),
                child: Container(
                  color: AppColors.warmSubtleSurface,
                  child: PortableImageUi(
                    pathOrUrl: url,
                    fit: BoxFit.contain,
                    fallbackIcon: Icons.phone_android_rounded,
                    fallbackIconSize: 70,
                    showLoader: true,
                  ),
                ),
              );
            },
          ),
        ),
        if (activeLabel.isNotEmpty)
          Positioned(
            top: 8,
            left: 10,
            child: Container(
              padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
              decoration: BoxDecoration(
                color: AppColors.primaryEmerald.withValues(alpha: 0.92),
                borderRadius: BorderRadius.circular(10),
                border: Border.all(color: AppColors.goldHighlight, width: 1.2),
              ),
              child: Row(
                mainAxisSize: MainAxisSize.min,
                children: [
                  const Icon(
                    Icons.label_important_rounded,
                    size: 14,
                    color: AppColors.goldHighlight,
                  ),
                  const SizedBox(width: 4),
                  Text(
                    activeLabel,
                    style: const TextStyle(
                      color: Colors.white,
                      fontSize: 12,
                      fontWeight: FontWeight.w900,
                    ),
                  ),
                ],
              ),
            ),
          ),
        if (validImages.length > 1)
          Positioned(
            top: 8,
            right: 10,
            child: Container(
              padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
              decoration: BoxDecoration(
                color: Colors.black.withValues(alpha: 0.65),
                borderRadius: BorderRadius.circular(12),
              ),
              child: Text(
                '${safePage + 1} / ${validImages.length}',
                style: const TextStyle(
                  color: Colors.white,
                  fontSize: 11.5,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
          ),
        if (validImages.isNotEmpty)
          Positioned(
            bottom: 8,
            left: 10,
            child: Container(
              padding: const EdgeInsets.symmetric(horizontal: 9, vertical: 4),
              decoration: BoxDecoration(
                color: Colors.black.withValues(alpha: 0.65),
                borderRadius: BorderRadius.circular(20),
              ),
              child: const Row(
                children: [
                  Icon(Icons.zoom_in_rounded, size: 14, color: Colors.white),
                  SizedBox(width: 4),
                  Text(
                    'HD زوم دیکھنے کے لیے ٹیپ کریں',
                    style: TextStyle(color: Colors.white, fontSize: 11),
                  ),
                ],
              ),
            ),
          ),
      ],
    );
  }
}
