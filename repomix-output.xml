                    final item = updatedList.removeAt(oldIndex);
                    updatedList.insert(newIndex, item);
                    await TagsBankService.saveReorderedTags(updatedList);
                  },
                  children: [
                    for (int i = 0; i < allTags.length; i++)
                      _buildTagChip(allTags[i], i),
                  ],
                ),
              );
            },
          ),
        ],
      ),
    );
  }
}
