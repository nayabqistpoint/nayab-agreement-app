import '../../core/time/time_status_service.dart';
import '../status/sync_status_service.dart';
class StockPullService {
  static StreamSubscription? _stockSub;
  static Map<String, DataMap> _defaultSeedStock() {
    final now = TimeStatusService.nowUtcIso();
    return {
      'STK_001': {
        'id': 'STK_001',
        'itemId': 'STK_001',
        'itemName': 'Vivo Y200',
        'salePrice': 52000,
        'ramRom': '8GB / 256GB',
        'conditionType': 'NEW',
        'conditionRating': '10/10',
        'warranty': 12,
        'color': 'Emerald Green',
        'imeiNo': '354892104567891',
        'status': 'AVAILABLE',
        'images': <String>[],
        'isSynced': true,
        'isDeleted': false,
        'updatedAt': now,
      },
      'STK_002': {
        'id': 'STK_002',
        'itemId': 'STK_002',
        'itemName': 'Infinix Note 40 Pro',
        'salePrice': 65000,
        'ramRom': '12GB / 256GB',
        'conditionType': 'NEW',
        'conditionRating': '10/10',
        'warranty': 12,
        'color': 'Titan Gold',
        'imeiNo': '354892104567892',
        'status': 'AVAILABLE',
        'images': <String>[],
        'isSynced': true,
        'isDeleted': false,
        'updatedAt': now,
      },
      'STK_003': {
        'id': 'STK_003',
        'itemId': 'STK_003',
        'itemName': 'Samsung Galaxy A15',
        'salePrice': 44000,
        'ramRom': '6GB / 128GB',
        'conditionType': 'USED',
        'conditionRating': '9.5/10',
        'warranty': 6,
        'color': 'Blue Black',
        'imeiNo': '354892104567893',
        'status': 'AVAILABLE',
        'images': <String>[],
        'isSynced': true,
        'isDeleted': false,
        'updatedAt': now,
      },
    };
  }
  static Future<void> _applyFullSnapshotToHive(List docs) async {
    final box = HiveBoxManager.getBox(BoxNames.stockBox);
    final Map<String, DataMap> fullMirrorBatch = {};
    final Set<String> activeCloudIds = {};
    for (final doc in docs) {
      final rawData = doc.data();
      if (rawData is! Map) continue;
      final data = Map<String, dynamic>.from(rawData);
      final statusUpper =
          (data['status']?.toString() ?? 'AVAILABLE').trim().toUpperCase();
      if (data['isDeleted'] == true || statusUpper == 'DELETED') continue;
      final String docId = doc.id.toString();
      activeCloudIds.add(docId);
      final existingLocal = box.get(docId);
      if (existingLocal is Map && existingLocal['isSynced'] == false) {
        continue;
      }
      data['id'] = docId;
      data['itemId'] = data['itemId'] ?? docId;
      data['status'] = statusUpper;
      data['isSynced'] = true;
      fullMirrorBatch[docId] = data;
    }
    for (final existingKey in box.keys.toList()) {
      final keyStr = existingKey.toString();
      final existingLocal = box.get(keyStr);
      if (existingLocal is Map && existingLocal['isSynced'] == false) {
        continue;
      }
      if (!activeCloudIds.contains(keyStr)) {
        await HiveBoxManager.deleteKey(
          boxName: BoxNames.stockBox,
          key: keyStr,
        );
      }
    }
    if (fullMirrorBatch.isNotEmpty) {
      await HiveBoxManager.putBatch(
        boxName: BoxNames.stockBox,
        entries: fullMirrorBatch,
      );
    }
  }
  static Future<void> pullStock() async {
    try {
      final box = HiveBoxManager.getBox(BoxNames.stockBox);
      if (box.isEmpty) {
        await HiveBoxManager.putBatch(
          boxName: BoxNames.stockBox,
          entries: _defaultSeedStock(),
        );
      }
      if (!await ConnectivityService.isOnline) return;
      final collection =
          FirebaseFirestore.instance.collection(BoxNames.stockBox);
      final querySnap = await collection.get();
      if (querySnap.docs.isNotEmpty) {
        await _applyFullSnapshotToHive(querySnap.docs);
      } else {
        final batch = FirebaseFirestore.instance.batch();
        for (final key in box.keys) {
          final raw = box.get(key);
          if (raw is Map) {
            final payload = Map<String, dynamic>.from(raw);
            payload['id'] = key.toString();
            payload['isSynced'] = true;
            batch.set(
              collection.doc(key.toString()),
              payload,
              SetOptions(merge: true),
            );
          }
        }
        await batch.commit();
      }
    } catch (e) {
      debugPrint('StockPullService Error: $e');
    }
  }
  static void startRealtimeListener() {
    _stockSub?.cancel();
    _stockSub = FirebaseFirestore.instance
        .collection(BoxNames.stockBox)
        .snapshots()
        .listen(
      (snapshot) async {
        try {
          await _applyFullSnapshotToHive(snapshot.docs);
          SyncStatusService.setState(SyncState.synced);
          debugPrint(
            'StockPullService [LIVE]: Mirror synced ${snapshot.docs.length} stock docs to Hive',
          );
        } catch (e) {
          debugPrint('StockPullService Snapshot Parse Error: $e');
        }
      },
      onError: (e) {
        debugPrint('StockPullService Stream Error: $e');
        SyncStatusService.setState(SyncState.offline);
      },
    );
  }
  static Future<void> stopRealtimeListener() async {
    await _stockSub?.cancel();
    _stockSub = null;
  }
}
