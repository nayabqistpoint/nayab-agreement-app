                  onChanged: (v) {
                    setMState(() => _bottomMargin = v);
                    setState(() => _bottomMargin = v);
                  },
                ),
                Text('دائیں بائیں حاشیہ: ${_sideMargin.toInt()} pt'),
                Slider(
                  value: _sideMargin,
                  min: 15,
                  max: 150,
                  onChanged: (v) {
                    setMState(() => _sideMargin = v);
