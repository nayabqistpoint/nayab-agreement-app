<file path="../nayab_shop_pos/lib/core/services/permanent_image_cache_service.dart">
import 'dart:convert';
import 'dart:io';
import 'package:flutter/foundation.dart';
import 'package:http/http.dart' as http;
import 'package:path_provider/path_provider.dart';
import '../constants/box_names.dart';
import '../database/hive_box_manager.dart';
class PermanentImageCacheService {
  static Directory? _cacheDir;
  static final Set<String> _inFlightDownloads = {};
  static Future<void> initialize() async {
    if (kIsWeb) return;
    try {
      final baseDir = await getApplicationDocumentsDirectory();
      final dir = Directory('${baseDir.path}/nqp_permanent_images');
      if (!await dir.exists()) {
        await dir.create(recursive: true);
      }
      _cacheDir = dir;
    } catch (e) {
      debugPrint('PermanentImageCache Init Error: $e');
    }
  }
  static String _urlToSafeKey(String url) {
    final encoded = base64Url.encode(utf8.encode(url)).replaceAll('=', '');
    return encoded.length > 90
        ? '${encoded.substring(0, 45)}_${encoded.substring(encoded.length - 45)}'
        : encoded;
  }
  /// ویب / کروم پر مستقل Hive IndexedDB سے تصویر نکالتا ہے
  static String? getCachedWebDataUrlSync(String url) {
    if (!kIsWeb) return null;
    final clean = url.trim();
    if (!clean.startsWith('http:
      return null;
    }
    try {
      final vault = HiveBoxManager.getBox(BoxNames.localVaultBox);
      final cached = vault.get('img_${_urlToSafeKey(clean)}');
      if (cached is String && cached.startsWith('data:image')) {
        return cached;
      }
    } catch (_) {}
    return null;
  }
  static File? getCachedFileSync(String url) {
    if (kIsWeb || _cacheDir == null) return null;
    final clean = url.trim();
    if (!clean.startsWith('http://') && !clean.startsWith('https://')) {
      return null;
    }
    try {
      final file = File('${_cacheDir!.path}/${_urlToSafeKey(clean)}.img');
      if (file.existsSync() && file.lengthSync() > 100) {
        return file;
      }
    } catch (_) {}
    return null;
  }
  static Future<bool> downloadAndCache(String url) async {
    final clean = url.trim();
    if (!clean.startsWith('http://') && !clean.startsWith('https://')) {
      return false;
    }
    if (kIsWeb) {
      if (getCachedWebDataUrlSync(clean) != null) return true;
    } else {
      if (getCachedFileSync(clean) != null) return true;
    }
    if (_inFlightDownloads.contains(clean)) return false;
    _inFlightDownloads.add(clean);
    try {
      final response = await http
          .get(Uri.parse(clean))
          .timeout(const Duration(seconds: 20));
      if (response.statusCode == 200 && response.bodyBytes.length > 100) {
        if (kIsWeb) {
          final vault = HiveBoxManager.getBox(BoxNames.localVaultBox);
          final b64 = base64Encode(response.bodyBytes);
          await vault.put(
            'img_${_urlToSafeKey(clean)}',
            'data:image/jpeg;base64,$b64',
          );
          return true;
        } else if (_cacheDir != null) {
          final file = File('${_cacheDir!.path}/${_urlToSafeKey(clean)}.img');
          await file.writeAsBytes(response.bodyBytes, flush: true);
          return true;
        }
      }
    } catch (_) {
    } finally {
      _inFlightDownloads.remove(clean);
    }
    return false;
  }
}
</file>

<file path="../nayab_shop_pos/lib/core/services/pos_cloudinary_service.dart">
import 'dart:convert';
import 'package:flutter/foundation.dart';
import 'package:http/http.dart' as http;
import 'package:image_picker/image_picker.dart';
class PosCloudinaryService {
  static const String cloudName = 'snioixz8';
  static const String uploadPreset = 'nayab_unsigned';
  static const String rootFolder = 'nayab_qist_point';
  static Uri get _uploadUri =>
      Uri.parse('https://api.cloudinary.com/v1_1/$cloudName/image/upload');
  static Future<String?> uploadCustomerSelfie({
    required String customerCnic,
    required String pathOrDataUrl,
  }) async {
    final clean = pathOrDataUrl.trim();
    if (clean.isEmpty) return null;
    if (clean.startsWith('http://') || clean.startsWith('https://')) {
      return clean;
    }
    try {
      Uint8List bytes;
      if (clean.startsWith('data:image')) {
        final commaIdx = clean.indexOf(',');
        if (commaIdx == -1) return null;
        bytes = base64Decode(clean.substring(commaIdx + 1));
      } else {
        bytes = await XFile(clean).readAsBytes();
      }
      final cleanCnic = customerCnic.replaceAll(RegExp(r'[^0-9]'), '');
      final folderCnic = cleanCnic.isEmpty ? 'temp_customers' : cleanCnic;
      final fullFolder = '$rootFolder/customers/$folderCnic/profile';
      final request = http.MultipartRequest('POST', _uploadUri)
        ..fields['upload_preset'] = uploadPreset
        ..fields['folder'] = fullFolder
        ..fields['public_id'] =
            'selfie_${DateTime.now().millisecondsSinceEpoch}';
      request.files.add(
        http.MultipartFile.fromBytes(
          'file',
          bytes,
          filename: 'customer_selfie.jpg',
        ),
      );
      final streamed =
          await request.send().timeout(const Duration(seconds: 25));
      final body = await streamed.stream.bytesToString();
      if (streamed.statusCode >= 200 && streamed.statusCode < 300) {
        final decoded = jsonDecode(body);
        if (decoded is Map && decoded['secure_url'] != null) {
          return decoded['secure_url'].toString();
        }
      }
    } catch (e) {
      debugPrint('PosCloudinaryService Selfie Upload Error: $e');
    }
    return null;
  }
}
