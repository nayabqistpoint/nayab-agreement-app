import 'zone_rate_profile.dart';
class CustomFieldDef {
  final String key;
  final String urduLabel;
  const CustomFieldDef({required this.key, required this.urduLabel});
}
class CalculatorConfigModel {
  final ZoneRateProfile mobileZone;
  final ZoneRateProfile generalZone;
  final ZoneRateProfile customZone;
  final bool generalEnabled;
  final List<String> customAllowedZones;
  final bool geofenceEnabled;
  final int geofenceRadiusMeters;
  final double? shopLatitude;
  final double? shopLongitude;
  final String status;
  final String shopName;
  final String shopSubtitle;
  final String shopLogoUrl;
  final String ownerPhotoUrl;
  final bool showShopLogo;
  final bool showOwnerPhoto;
  final bool tickerEnabled;
  final String tickerText;
  final bool showReservedItems;
  final bool showSoldItems;
  final bool showOnOrderItems;
  final List<CustomFieldDef> mobileCustomFields;
  final List<CustomFieldDef> generalCustomFields;
  final List<String> mobileGroupingMatchKeys;
  final List<String> generalGroupingMatchKeys;
  final bool cashSaleEnabled;
  final String cashMarkupType;
  final double cashMarkupValue;
  final bool allowCashPriceEdit;
  const CalculatorConfigModel({
    this.mobileZone = const ZoneRateProfile(),
    this.generalZone = const ZoneRateProfile(
      advancePercentage: 0.75,
      allowedDurations: [6, 8, 10, 12, 15, 18],
    ),
    this.customZone = const ZoneRateProfile(),
    this.generalEnabled = true,
    this.customAllowedZones = const ['MOBILE', 'ELECTRONICS', 'CUSTOM_ESTIMATE'],
    this.geofenceEnabled = false,
    this.geofenceRadiusMeters = 150,
    this.shopLatitude,
    this.shopLongitude,
    this.status = 'approved',
    this.shopName = 'نایاب قسط پوائنٹ',
    this.shopSubtitle = 'آسان اقساط سینٹر',
    this.shopLogoUrl = '',
    this.ownerPhotoUrl = '',
    this.showShopLogo = true,
    this.showOwnerPhoto = true,
    this.tickerEnabled = true,
    this.tickerText =
        'نایاب قسط پوائنٹ میں خوش آمدید • بغیر ایڈوانس اور آسان ماہانہ اقساط پر موبائل اور گھریلو اشیاء دستیاب ہیں',
    this.showReservedItems = true,
    this.showSoldItems = true,
    this.showOnOrderItems = true,
    this.mobileCustomFields = const [],
    this.generalCustomFields = const [],
    this.mobileGroupingMatchKeys = const ['itemName', 'salePrice', 'specs', 'condition'],
    this.generalGroupingMatchKeys = const ['itemName', 'salePrice', 'specs', 'condition'],
    this.cashSaleEnabled = true,
    this.cashMarkupType = 'NONE',
    this.cashMarkupValue = 0,
    this.allowCashPriceEdit = true,
  });
  factory CalculatorConfigModel.fallback() => const CalculatorConfigModel();
  static List<CustomFieldDef> _parseFields(dynamic raw) {
    if (raw is! List) return const [];
    return raw
        .whereType()
        .map((m) => CustomFieldDef(
              key: m['key']?.toString().trim() ?? '',
              urduLabel: m['urduLabel']?.toString().trim() ?? '',
            ))
        .where((f) => f.key.isNotEmpty && f.urduLabel.isNotEmpty)
        .toList();
  }
  static List<String> _parseStrList(dynamic raw, List<String> fallback) {
    if (raw is List) {
      final parsed =
          raw.map((e) => e.toString().trim()).where((e) => e.isNotEmpty).toList();
      if (parsed.isNotEmpty) return parsed;
    }
    return fallback;
  }
  factory CalculatorConfigModel.fromMap(Map<dynamic, dynamic>? map) {
    if (map == null) return CalculatorConfigModel.fallback();
    final mob = ZoneRateProfile.fromPrefixedMap(map, prefix: '');
    final gen = ZoneRateProfile.fromPrefixedMap(
      map,
      prefix: 'general',
      fallback: mob,
      defaultAdvance: 0.75,
      defaultDurations: const [6, 8, 10, 12, 15, 18],
    );
    final cust = ZoneRateProfile.fromPrefixedMap(
      map,
      prefix: 'custom',
      fallback: mob,
      defaultAdvance: mob.advancePercentage,
      defaultDurations: mob.allowedDurations,
    );
    final rawCash = (map['cashMarkupType']?.toString() ?? 'NONE').toUpperCase();
    return CalculatorConfigModel(
      mobileZone: mob,
      generalZone: gen,
      customZone: cust,
      generalEnabled: map['generalEnabled'] != false,
      customAllowedZones: _parseStrList(map['customAllowedZones'],
          const ['MOBILE', 'ELECTRONICS', 'CUSTOM_ESTIMATE']),
      geofenceEnabled: map['geofenceEnabled'] == true,
      geofenceRadiusMeters:
          (map['geofenceRadiusMeters'] as num?)?.toInt() ?? 150,
      shopLatitude: (map['shopLatitude'] as num?)?.toDouble(),
      shopLongitude: (map['shopLongitude'] as num?)?.toDouble(),
      status: map['status']?.toString() ?? 'approved',
      shopName: (map['shopName']?.toString().trim().isNotEmpty == true)
          ? map['shopName'].toString().trim()
          : 'نایاب قسط پوائنٹ',
      shopSubtitle: (map['shopSubtitle']?.toString().trim().isNotEmpty == true)
          ? map['shopSubtitle'].toString().trim()
          : 'آسان اقساط سینٹر',
      shopLogoUrl: map['shopLogoUrl']?.toString().trim() ?? '',
      ownerPhotoUrl: map['ownerPhotoUrl']?.toString().trim() ?? '',
      showShopLogo: map['showShopLogo'] != false,
      showOwnerPhoto: map['showOwnerPhoto'] != false,
      tickerEnabled: map['tickerEnabled'] != false,
      tickerText: (map['tickerText']?.toString().trim().isNotEmpty == true)
          ? map['tickerText'].toString().trim()
          : 'نایاب قسط پوائنٹ میں خوش آمدید • بغیر ایڈوانس اور آسان ماہانہ اقساط پر موبائل اور گھریلو اشیاء دستیاب ہیں',
      showReservedItems: map['showReservedItems'] != false,
      showSoldItems: map['showSoldItems'] != false,
      showOnOrderItems: map['showOnOrderItems'] != false,
      mobileCustomFields: _parseFields(map['mobileCustomFields']),
      generalCustomFields: _parseFields(map['generalCustomFields']),
      mobileGroupingMatchKeys: _parseStrList(
          map['mobileGroupingMatchKeys'] ?? map['groupingMatchKeys'],
          const ['itemName', 'salePrice', 'specs', 'condition']),
      generalGroupingMatchKeys: _parseStrList(
          map['generalGroupingMatchKeys'] ?? map['groupingMatchKeys'],
          const ['itemName', 'salePrice', 'specs', 'condition']),
      cashSaleEnabled: map['cashSaleEnabled'] != false,
      cashMarkupType:
          (rawCash == 'PERCENT' || rawCash == 'FIXED') ? rawCash : 'NONE',
      cashMarkupValue: (map['cashMarkupValue'] as num?)?.toDouble() ?? 0,
      allowCashPriceEdit: map['allowCashPriceEdit'] != false,
    );
  }
  ZoneRateProfile zoneProfile(String zoneType) {
    final z = zoneType.toUpperCase();
    if (z == 'ELECTRONICS' || z == 'GENERAL') return generalZone;
    if (z == 'CUSTOM_ESTIMATE' || z == 'CUSTOM') return customZone;
    return mobileZone;
  }
  int computeEffectiveCashUnitPrice(int basePrice) {
    if (basePrice <= 0) return 0;
    if (cashMarkupType == 'PERCENT' && cashMarkupValue > 0) {
      return (basePrice * (1.0 + (cashMarkupValue / 100.0))).round();
    }
    if (cashMarkupType == 'FIXED' && cashMarkupValue > 0) {
      return basePrice + cashMarkupValue.round();
    }
    return basePrice;
  }
  double get advancePercentage => mobileZone.advancePercentage;
  double get profitWithCheck => mobileZone.profitWithCheck;
  double get profitWithoutCheck => mobileZone.profitWithoutCheck;
  double get perMonthIncrement => mobileZone.perMonthIncrement;
  int get processingFee => mobileZone.processingFee;
  int get roundToNearest => mobileZone.roundToNearest;
  bool get isCompoundingProfit => mobileZone.isCompoundingProfit;
  bool get addProcessingFeeToPrincipal => mobileZone.addProcessingFeeToPrincipal;
  List<int> get allowedDurations => mobileZone.allowedDurations;
  int get maxRiskLimit => mobileZone.maxRiskLimit;
  double get generalAdvancePercentage => generalZone.advancePercentage;
  double get generalProfitWithCheck => generalZone.profitWithCheck;
  double get generalProfitWithoutCheck => generalZone.profitWithoutCheck;
  double get generalPerMonthIncrement => generalZone.perMonthIncrement;
  int get generalProcessingFee => generalZone.processingFee;
  int get generalRoundToNearest => generalZone.roundToNearest;
  bool get generalIsCompoundingProfit => generalZone.isCompoundingProfit;
  bool get generalAddProcessingFeeToPrincipal =>
      generalZone.addProcessingFeeToPrincipal;
  List<int> get generalAllowedDurations => generalZone.allowedDurations;
  int get generalMaxRiskLimit => generalZone.maxRiskLimit;
  bool get generalRequireCustomerMobileMdm =>
      generalZone.requireCustomerMobileMdm;
  double get customAdvancePercentage => customZone.advancePercentage;
  double get customProfitWithCheck => customZone.profitWithCheck;
  double get customProfitWithoutCheck => customZone.profitWithoutCheck;
  double get customPerMonthIncrement => customZone.perMonthIncrement;
  int get customProcessingFee => customZone.processingFee;
  int get customRoundToNearest => customZone.roundToNearest;
  bool get customIsCompoundingProfit => customZone.isCompoundingProfit;
  bool get customAddProcessingFeeToPrincipal =>
      customZone.addProcessingFeeToPrincipal;
  List<int> get customAllowedDurations => customZone.allowedDurations;
  int get customMaxRiskLimit => customZone.maxRiskLimit;
  bool get customRequireCustomerMobileMdm =>
      customZone.requireCustomerMobileMdm;
  int processingFeeForZone(String z) => zoneProfile(z).processingFee;
  List<int> durationsForZone(String z) => zoneProfile(z).allowedDurations;
  int maxRiskForZone(String z) => zoneProfile(z).maxRiskLimit;
  int dueDayForZone(String z) => zoneProfile(z).installmentDueDay;
  int graceDaysForZone(String z) => zoneProfile(z).gracePeriodDays;
  int roundToForZone(String z) => zoneProfile(z).roundToNearest;
  int mdmFeeForZone(String z) => zoneProfile(z).mdmLockFee;
  String openBoxTypeForZone(String z) => zoneProfile(z).openBoxDeductionType;
  int openBoxValForZone(String z) => zoneProfile(z).openBoxDeductionValue;
  String adminPinForZone(String z) => zoneProfile(z).adminOverridePin;
}
