import 'components/vip_28_promotional_banner_ui.dart';
import 'device_plan_detail_controller.dart';
import 'services/stock_live_status_service.dart';
class DevicePlanDetailPage extends StatefulWidget {
  final DevicePlanDetailArgs? args;
  const DevicePlanDetailPage({super.key, this.args});
  @override
  State<DevicePlanDetailPage> createState() => _DevicePlanDetailPageState();
}
class _DevicePlanDetailPageState extends State<DevicePlanDetailPage> {
  late final DevicePlanDetailController _controller;
  DataMap _device = const {};
  String? _customerPhone;
  @override
  void initState() {
    super.initState();
    _controller = DevicePlanDetailController();
    if (widget.args != null) {
      _device = widget.args!.device;
      _customerPhone = widget.args!.customerPhone;
      _initAdvance();
    }
  }
  void _initAdvance() {
    final int initAdv = (_device['userCustomAdvance'] as num?)?.toInt() ??
        (_device['minAdvanceRequired'] as num?)?.toInt() ??
        (_device['minAdvance'] as num?)?.toInt() ??
        0;
    _controller.init(initAdv);
  }
  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    if (_device.isEmpty) {
      final rawArgs = ModalRoute.of(context)?.settings.arguments;
      if (rawArgs is DevicePlanDetailArgs) {
        _device = rawArgs.device;
        _customerPhone = rawArgs.customerPhone;
        _initAdvance();
      } else if (rawArgs is Map<String, dynamic>) {
        final parsed = DevicePlanDetailArgs.fromMap(rawArgs);
        _device = parsed.device;
        _customerPhone = parsed.customerPhone;
        _initAdvance();
      }
    }
  }
  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }
  String _resolveZoneType() {
    if (_device['zoneType'] != null &&
        _device['zoneType'].toString().trim().isNotEmpty) {
      return _device['zoneType'].toString().trim().toUpperCase();
    }
    if (_device['isGeneral'] == true ||
        (_device['productCategory']?.toString() ?? '') == 'ELECTRONICS') {
      return 'ELECTRONICS';
    }
    if (_device['isCustomEstimate'] == true) {
      return 'CUSTOM_ESTIMATE';
    }
    return 'MOBILE';
  }
  @override
  Widget build(BuildContext context) {
    final int initialBaseValue = (_device['baseValue'] as num?)?.toInt() ??
        int.tryParse(_device['baseValue']?.toString() ?? '0') ??
        0;
    final List<String> images =
        (_device['images'] as List?)?.cast<String>() ?? [];
    final bool isCustomEstimate = _device['isCustomEstimate'] == true;
    final bool isOnOrderItem = _device['isOnOrder'] == true;
    final String zoneType = _resolveZoneType();
    final String fallbackStockId =
        _device['stockId']?.toString() ?? _device['id']?.toString() ?? '';
    return Directionality(
      textDirection: TextDirection.rtl,
      child: ValueListenableBuilder(
        valueListenable: HiveBoxManager.listenToBox(BoxNames.appConfigBox),
        builder: (context, configBox, _) {
          return ValueListenableBuilder(
            valueListenable: HiveBoxManager.listenToBox(BoxNames.stockBox),
            builder: (context, stockBox, _) {
              final StockUnitList allAvailableUnits = isCustomEstimate
                  ? const []
                  : StockLiveStatusService.resolveAllAvailableUnitsForGroup(
                      _device);
              final int maxAvailableQty = isCustomEstimate
                  ? 10
                  : (allAvailableUnits.isNotEmpty
                      ? allAvailableUnits.length
                      : 1);
              final firstUnit = allAvailableUnits.isNotEmpty
                  ? allAvailableUnits.first
                  : null;
              final String activeStockId = firstUnit != null
                  ? (firstUnit['stockId']?.toString() ??
                      firstUnit['id']?.toString() ??
                      fallbackStockId)
                  : fallbackStockId;
              final int unitBaseValue = isCustomEstimate
                  ? initialBaseValue
                  : StockLiveStatusService.resolveLiveBaseValue(
                      initialBaseValue,
                      activeStockId,
                    );
              final lockState = isCustomEstimate
                  ? (message: null, buttonLabel: '')
                  : StockLiveStatusService.checkLiveStockLock(
                      activeStockId,
                      deviceGroup: _device,
                    );
              final String? liveLockMessage = lockState.message;
              final bool isStockLocked = liveLockMessage != null;
              return AnimatedBuilder(
                animation: _controller,
                builder: (context, _) {
                  if (_controller.selectedQuantity > maxAvailableQty) {
                    _controller.selectedQuantity = maxAvailableQty;
                  }
                  final int qty = _controller.selectedQuantity;
                  final StockUnitList allocatedUnits =
                      allAvailableUnits.take(qty).toList();
                  final List<String> allocatedIds = allocatedUnits
                      .map((u) => (u['stockId']?.toString() ?? '').trim())
                      .where((e) => e.isNotEmpty)
                      .toList();
                  final List<String> allocatedImeis = allocatedUnits
                      .map((u) => (u['imeiNo']?.toString() ?? '').trim())
                      .where((e) => e.isNotEmpty && e != 'null')
                      .toList();
                  final int totalBaseValue = unitBaseValue * qty;
                  final DataMap activeDevice = {
                    ..._device,
                    'id': activeStockId,
                    'stockId': activeStockId,
                    'imeiNo': allocatedImeis.join(', '),
                    'baseValue': unitBaseValue,
                    'zoneType': zoneType,
                  };
                  final allowedList =
                      _controller.config.durationsForZone(zoneType);
                  if (_controller.selectedDuration != 0 &&
                      !allowedList.contains(_controller.selectedDuration)) {
                    _controller.selectedDuration = 0;
                  }
                  final rawPlans = _controller.getAllRawPlans(
                    totalBaseValue,
                    zoneType: zoneType,
                  );
                  final plans = _controller.getFilteredPlans(rawPlans);
                  final int calculatedMinAdv = _controller.getDynamicMinAdvance(
                    totalBaseValue,
                    zoneType: zoneType,
                  );
                  final int displayedAdv = _controller.userCustomAdvance > 0
                      ? _controller.userCustomAdvance
                      : calculatedMinAdv;
                  final bool canShowCashToggle =
                      !isCustomEstimate && !isOnOrderItem && !isStockLocked;
                  return Scaffold(
                    backgroundColor: AppColors.backgroundLight,
                    appBar: DetailAppBarUi(
                      title: _device['name'] ?? 'اقساطی پلان',
                      subtitle:
                          '${_controller.config.shopName} • ${rawPlans.length} سمارٹ اقساطی پیکجز',
                    ),
                    body: SingleChildScrollView(
                      physics: const BouncingScrollPhysics(),
                      padding: const EdgeInsets.all(12),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          if (isStockLocked) ...[
                            Container(
                              width: double.infinity,
                              margin: const EdgeInsets.only(bottom: 10),
                              padding: const EdgeInsets.all(11),
                              decoration: BoxDecoration(
                                color: const Color(0xFFFEF2F2),
                                borderRadius: BorderRadius.circular(10),
                                border: Border.all(
                                  color: Colors.red.shade400,
                                  width: 1.3,
                                ),
                              ),
                              child: Text(
                                liveLockMessage,
                                style: TextStyle(
                                  fontSize: 13.5,
                                  fontWeight: FontWeight.bold,
                                  color: Colors.red.shade900,
                                ),
                              ),
                            ),
                          ],
                          if (!isCustomEstimate)
                            StockDeviceHeroCardUi(
                              device: activeDevice,
                              images: images,
                            )
                          else
                            CustomEstimateHeroCardUi(
                              title: _device['name'] ??
                                  'اپنی مرضی کی قیمت کا تخمینہ',
                              baseValue: totalBaseValue,
                              displayedAdvance: displayedAdv,
                            ),
                          const SizedBox(height: 10),
                          Container(
                            padding: const EdgeInsets.all(11),
                            decoration: BoxDecoration(
                              color: AppColors.cardSurface,
                              borderRadius: BorderRadius.circular(12),
                              border: Border.all(
                                color: AppColors.emeraldPillBorder,
                                width: 1.3,
                              ),
                            ),
                            child: Column(
                              children: [
                                if (maxAvailableQty > 1) ...[
                                  Row(
                                    children: [
                                      const Icon(
                                        Icons.layers_rounded,
                                        color: AppColors.primaryEmerald,
                                        size: 20,
                                      ),
                                      const SizedBox(width: 6),
                                      Expanded(
                                        child: Text(
                                          'تعداد منتخب کریں (کل $maxAvailableQty دستیاب):',
                                          style: const TextStyle(
                                            fontSize: 14,
                                            fontWeight: FontWeight.w900,
                                            color: AppColors.textDark,
                                          ),
                                        ),
                                      ),
                                      Container(
                                        decoration: BoxDecoration(
                                          color: AppColors.warmTintEmerald,
                                          borderRadius:
                                              BorderRadius.circular(9),
                                          border: Border.all(
                                            color: AppColors.primaryEmerald,
                                          ),
