  final TextEditingController customerCasteCtrl;
  final TextEditingController customerPhoneCtrl;
  final TextEditingController customerCnicCtrl;
  final TextEditingController customerAddressCtrl;
  final String? customerPhotoPath;
  final ValueChanged<String?> onPhotoChanged;
  final bool showValidationErrors;
  const CustomerQuickInfoBoxUi({
    super.key,
    required this.customerNameCtrl,
    required this.customerFatherNameCtrl,
    required this.customerCasteCtrl,
    required this.customerPhoneCtrl,
    required this.customerCnicCtrl,
    required this.customerAddressCtrl,
    this.customerPhotoPath,
    required this.onPhotoChanged,
    this.showValidationErrors = false,
  });
  Future<void> _pickPhoto(ImageSource source) async {
    try {
      final picker = ImagePicker();
      final XFile? file = await picker.pickImage(
        source: source,
        preferredCameraDevice: CameraDevice.front,
        imageQuality: 85,
      );
      if (file == null) return;
      if (kIsWeb) {
        final bytes = await file.readAsBytes();
        onPhotoChanged('data:image/jpeg;base64,${base64Encode(bytes)}');
      } else {
        onPhotoChanged(file.path);
      }
    } catch (_) {}
  }
  Widget _smartActionChip({
    required IconData icon,
    required String label,
    required VoidCallback onTap,
    required bool isPrimary,
  }) {
    return InkWell(
      onTap: onTap,
      borderRadius: BorderRadius.circular(8),
      child: Container(
        padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 6.5),
        decoration: BoxDecoration(
          color: isPrimary ? AppColors.primaryEmerald : AppColors.warmTintEmerald,
          borderRadius: BorderRadius.circular(8),
          border: Border.all(
            color: AppColors.primaryEmerald,
            width: 1.1,
          ),
        ),
        child: Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            Icon(
              icon,
              size: 15,
              color: isPrimary ? Colors.white : AppColors.primaryEmerald,
            ),
            const SizedBox(width: 5),
            Text(
              label,
              style: TextStyle(
                fontSize: 12.5,
                fontWeight: FontWeight.w800,
                color: isPrimary ? Colors.white : AppColors.primaryEmerald,
              ),
            ),
          ],
        ),
      ),
    );
  }
  Widget _field({
    required TextEditingController ctrl,
    required String label,
    required IconData icon,
    required TextInputType type,
    int maxLines = 1,
    TextAlign textAlign = TextAlign.right,
  }) {
    final bool hasError = showValidationErrors && ctrl.text.trim().isEmpty;
    return TextField(
      controller: ctrl,
      keyboardType: type,
      maxLines: maxLines,
      textAlign: textAlign,
      style: const TextStyle(fontSize: 15.5, fontWeight: FontWeight.w900),
