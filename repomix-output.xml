                ),
              ),
              ElevatedButton.icon(
                onPressed: fieldDefs.length >= 10
                    ? null
                    : () => _showAddFieldDialog(context),
                icon: const Icon(Icons.add_circle_outline, size: 18),
                label: const Text(
                  'نئی فیلڈ',
                  style: TextStyle(fontSize: 13.5, fontWeight: FontWeight.w900),
