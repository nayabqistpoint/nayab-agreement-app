import 'package:flutter/material.dart';
import '../../core/constants/app_colors.dart';
import 'components/direct_cash_sale_card_ui.dart';
import 'components/multi_cart_bundle_card_ui.dart';
import 'models/calculator_config_model.dart';
import 'services/calculator_config_service.dart';
import 'services/detail_state_resolver_service.dart';
import 'services/direct_cash_sale_service.dart';
import 'services/order_receipt_navigator_service.dart';
import 'services/plan_filter_sort_service.dart';
import 'services/plan_generator_service.dart';
import 'services/plan_math_service.dart';
import 'services/stock_live_status_service.dart';
class DevicePlanDetailController extends ChangeNotifier {
  int selectedDuration = 0;
  String selectedGuaranteeFilter = 'ALL';
  String selectedAdvanceFilter = 'ALL';
  int userCustomAdvance = 0;
  String activeSort = 'DEFAULT';
  int selectedQuantity = 1;
  final Map<int, int> cartQuantities = {};
  bool isCashSaleMode = false;
  final TextEditingController customAdvanceCtrl = TextEditingController();
  CalculatorConfigModel get config => CalculatorConfigService().getConfig();
  void init(int initialAdvance) {
    userCustomAdvance = initialAdvance;
    customAdvanceCtrl.text = initialAdvance > 0 ? initialAdvance.toString() : '';
  }
  void _syncAdvance(int newTotalBase, String zoneType) {
    if (userCustomAdvance <= 0) return;
    final newMin = getDynamicMinAdvance(newTotalBase, zoneType: zoneType);
    if (newMin > 0) {
      userCustomAdvance = newMin;
      customAdvanceCtrl.text = newMin.toString();
    }
  }
  void setQuantity(int qty, int maxAvail,
      {int unitBaseValue = 0, String zoneType = 'MOBILE'}) {
    final clamped = qty.clamp(1, maxAvail > 0 ? maxAvail : 1);
    if (selectedQuantity != clamped) {
      selectedQuantity = clamped;
      if (unitBaseValue > 0) _syncAdvance(unitBaseValue * clamped, zoneType);
      notifyListeners();
    }
  }
  int getCartItemQuantity(int idx) => cartQuantities[idx] ?? 1;
  void updateBundleItemQuantity(
      int idx, int newQ, List<MultiCartItemRowData> rows, String zoneType) {
    final clamped = newQ.clamp(1, rows[idx].maxAvailable);
    if (cartQuantities[idx] == clamped) return;
    cartQuantities[idx] = clamped;
    int newSum = 0;
    for (int j = 0; j < rows.length; j++) {
      newSum += rows[j].unitBasePrice * (j == idx ? clamped : rows[j].chosenQty);
    }
    _syncAdvance(newSum, zoneType);
    notifyListeners();
  }
  void setCashSaleMode(bool v) { isCashSaleMode = v; notifyListeners(); }
  void setGuaranteeFilter(String f) { selectedGuaranteeFilter = f; notifyListeners(); }
  void setAdvanceFilter(String f) { selectedAdvanceFilter = f; notifyListeners(); }
  void setDuration(int d) { selectedDuration = d; notifyListeners(); }
  void updateCustomAdvance(int amt) { userCustomAdvance = amt; notifyListeners(); }
  void setSort(String k) { activeSort = k; notifyListeners(); }
  int getDynamicMinAdvance(int baseValue, {String zoneType = 'MOBILE'}) {
    final cfg = config;
    final principal = PlanMathService.calculatePrincipal(
        baseValue: baseValue, config: cfg, zoneType: zoneType);
    final durs = cfg.durationsForZone(zoneType);
    final minDur = durs.isNotEmpty ? durs.first : 6;
    final total = PlanMathService.calculateTotalContractPrice(
        principal: principal, months: minDur, isCheque: true, config: cfg, zoneType: zoneType);
    return PlanMathService.calculateMinAdvance(
        totalContractPrice: total, months: minDur, config: cfg, zoneType: zoneType);
  }
  List<DataMap> getAllRawPlans(int totalBase, {String zoneType = 'MOBILE'}) =>
      PlanGeneratorService.generateAllPlans(
          baseValue: totalBase, userCustomAdvance: userCustomAdvance, config: config, zoneType: zoneType);
  List<DataMap> getFilteredPlans(List<DataMap> allPlans) =>
      PlanFilterSortService.filterAndSort(
          allPlans: allPlans, guaranteeFilter: selectedGuaranteeFilter,
          advanceFilter: selectedAdvanceFilter, durationFilter: selectedDuration, sortKey: activeSort);
  DetailResolvedState resolveState(DataMap device, String zoneType) {
    final st = DetailStateResolverService.resolve(
        device: device, zoneType: zoneType, config: config,
        selectedQuantity: selectedQuantity, getCartQty: getCartItemQuantity);
    if (selectedQuantity > st.maxAvailableQty) selectedQuantity = st.maxAvailableQty;
    return st;
  }
  Future<void> handleCashSaleSubmit({
    required BuildContext context,
    required List<({CashSaleLineItem line, int finalUnitPrice})> pricedLines,
    required int totalCashPrice,
    required String customerName,
    required String customerPhone,
    required int totalQty,
  }) async {
    final nav = Navigator.of(context);
    final messenger = ScaffoldMessenger.of(context);
    final ok = await DirectCashSaleService.executeCashSale(
        pricedLines: pricedLines, totalCashPrice: totalCashPrice,
        customerName: customerName, customerPhone: customerPhone);
    if (!context.mounted || !ok) return;
    nav.pop();
    messenger.showSnackBar(SnackBar(
      content: Text('✅ $totalQty پیس کی نقد فروخت مکمل ہو گئی اور ایڈمن کو اطلاع بھیج دی گئی!',
          style: const TextStyle(fontWeight: FontWeight.bold)),
      backgroundColor: AppColors.successGreen,
    ));
  }
  void openOrderReceiptPage({
    required BuildContext context,
    required DataMap plan,
    required DataMap device,
    required StockUnitList allocatedUnits,
    required String? customerPhone,
    String? customDisplayName,
    int? customTotalBaseVal,
  }) =>
      OrderReceiptNavigatorService.open(
        context: context, plan: plan, device: device, allocatedUnits: allocatedUnits,
        selectedQuantity: selectedQuantity, config: config, customerPhone: customerPhone,
        customDisplayName: customDisplayName, customTotalBaseVal: customTotalBaseVal,
      );
  @override
  void dispose() {
    customAdvanceCtrl.dispose();
    super.dispose();
  }
}
