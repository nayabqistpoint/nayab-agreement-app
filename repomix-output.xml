import 'package:flutter/material.dart';
import '../../../core/constants/app_colors.dart';
class MarketStatusSearchBarUi extends StatelessWidget {
  final String selectedStatus;
  final ValueChanged<String> onStatusChanged;
  final TextEditingController searchController;
  final String searchQuery;
  final ValueChanged<String> onSearchChanged;
  final VoidCallback onClearSearch;
  final int allCount;
  final int availableCount;
  final int onOrderCount;
  final int reservedCount;
  final int soldCount;
  const MarketStatusSearchBarUi({
    super.key,
    required this.selectedStatus,
    required this.onStatusChanged,
    required this.searchController,
    required this.searchQuery,
    required this.onSearchChanged,
    required this.onClearSearch,
    required this.allCount,
    required this.availableCount,
    required this.onOrderCount,
    required this.reservedCount,
    required this.soldCount,
  });
  Widget _statusChip({
    required String keyCode,
    required String label,
    required int count,
    required Color activeColor,
  }) {
    final bool isSelected = selectedStatus == keyCode;
    return Padding(
      padding: const EdgeInsets.only(left: 6),
      child: InkWell(
        onTap: () => onStatusChanged(keyCode),
        borderRadius: BorderRadius.circular(9),
        child: Container(
          padding: const EdgeInsets.symmetric(horizontal: 11, vertical: 7.5),
          decoration: BoxDecoration(
            color: isSelected ? activeColor : AppColors.cardSurface,
            borderRadius: BorderRadius.circular(9),
            border: Border.all(
              color: isSelected ? activeColor : AppColors.borderLight,
              width: 1.3,
            ),
          ),
          child: Text(
            '$label ($count)',
            style: TextStyle(
              fontSize: 12.5,
              fontWeight: FontWeight.w900,
              color: isSelected ? Colors.white : AppColors.textDark,
            ),
          ),
        ),
      ),
    );
  }
  @override
  Widget build(BuildContext context) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        TextField(
          controller: searchController,
          textAlign: TextAlign.right,
          onChanged: onSearchChanged,
          style: const TextStyle(fontSize: 14, fontWeight: FontWeight.w800),
          decoration: InputDecoration(
            isDense: true,
            hintText: 'ماڈل نام، میموری یا ID سے تلاش کریں...',
            hintStyle: const TextStyle(
              fontSize: 13,
              color: AppColors.textMuted,
              fontWeight: FontWeight.w700,
            ),
            prefixIcon: const Icon(
              Icons.search_rounded,
              color: AppColors.primaryEmerald,
              size: 21,
            ),
            suffixIcon: searchQuery.isNotEmpty
                ? IconButton(
                    icon: const Icon(Icons.close_rounded, size: 19),
                    onPressed: onClearSearch,
                  )
                : null,
            filled: true,
            fillColor: Colors.white,
            contentPadding: const EdgeInsets.symmetric(
              horizontal: 12,
              vertical: 10,
            ),
            enabledBorder: OutlineInputBorder(
              borderRadius: BorderRadius.circular(11),
              borderSide: const BorderSide(
                color: AppColors.emeraldPillBorder,
                width: 1.2,
              ),
            ),
            focusedBorder: OutlineInputBorder(
              borderRadius: BorderRadius.circular(11),
              borderSide: const BorderSide(
                color: AppColors.primaryEmerald,
                width: 1.6,
              ),
            ),
          ),
        ),
        const SizedBox(height: 8),
        SingleChildScrollView(
          scrollDirection: Axis.horizontal,
          child: Row(
            children: [
              _statusChip(
                keyCode: 'ALL',
                label: 'سب',
                count: allCount,
                activeColor: AppColors.primaryEmerald,
              ),
              _statusChip(
                keyCode: 'AVAILABLE',
                label: '✅ دستیاب',
                count: availableCount,
                activeColor: AppColors.successGreen,
              ),
              _statusChip(
                keyCode: 'ON_ORDER',
                label: '📦 آرڈر پر',
                count: onOrderCount,
                activeColor: const Color(0xFF0F766E),
              ),
              _statusChip(
                keyCode: 'RESERVED',
                label: '🔒 بُک شدہ',
                count: reservedCount,
                activeColor: AppColors.errorRed,
              ),
              _statusChip(
                keyCode: 'SOLD',
                label: '✔️ فروخت شدہ',
                count: soldCount,
                activeColor: Colors.indigo.shade800,
              ),
            ],
          ),
        ),
        const SizedBox(height: 10),
      ],
    );
  }
}
