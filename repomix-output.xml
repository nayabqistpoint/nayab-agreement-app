                const SizedBox(width: 6),
                ElevatedButton.icon(
                  onPressed: () => _showAddCustomTagDialog(context),
                  icon: const Icon(Icons.add, size: 14),
                  label: const Text(
                    'نیا ٹیگ',
                    style: TextStyle(
                      fontSize: 11.5,
                      fontWeight: FontWeight.bold,
                    ),
