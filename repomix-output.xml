<file path="../nayab_shop_pos/lib/features/device_plan_detail/services/stock_live_status_service.dart">
import '../../../core/constants/app_colors.dart';
import '../../../core/constants/box_names.dart';
import '../../../core/database/hive_box_manager.dart';
typedef StockUnitList = List<DataMap>;
class StockLiveStatusService {
  static DataMap? findActiveStockRecord(String stockId) {
    final cleanId = stockId.trim();
    if (cleanId.isEmpty) return null;
    try {
      final box = HiveBoxManager.getBox(BoxNames.stockBox);
      final direct = box.get(cleanId);
      if (direct is Map && direct['isDeleted'] != true) {
        return DataMap.from(direct);
      }
      for (final key in box.keys) {
        final raw = box.get(key);
        if (raw is Map && raw['isDeleted'] != true) {
          final rowId = raw['stockId']?.toString().trim() ??
              raw['id']?.toString().trim() ??
              key.toString();
          if (rowId == cleanId) {
            return DataMap.from(raw);
          }
        }
      }
    } catch (_) {}
    return null;
  }
  static StockUnitList resolveAllAvailableUnitsForGroup(DataMap device) {
    final List<String> candidateIds = [];
    final rawIds = device['availableStockIds'];
    if (rawIds is List) {
      for (final id in rawIds) {
        final clean = id.toString().trim();
        if (clean.isNotEmpty) candidateIds.add(clean);
      }
    }
    final primaryId = device['stockId']?.toString().trim() ??
        device['id']?.toString().trim() ??
        '';
    if (primaryId.isNotEmpty && !candidateIds.contains(primaryId)) {
      candidateIds.insert(0, primaryId);
    }
    candidateIds.sort();
    final StockUnitList availableUnits = [];
    for (final id in candidateIds) {
      final rec = findActiveStockRecord(id);
      if (rec != null) {
        final st = (rec['status']?.toString() ?? 'AVAILABLE').toUpperCase();
        if (st == 'AVAILABLE' || st == 'ON_ORDER') {
          rec['stockId'] = rec['stockId']?.toString() ?? id;
          availableUnits.add(rec);
        }
      }
    }
    return availableUnits;
  }
  static DataMap? resolveAvailableUnitForGroup(DataMap device) {
    final units = resolveAllAvailableUnitsForGroup(device);
    return units.isNotEmpty ? units.first : null;
  }
  static int resolveLiveBaseValue(int fallbackValue, String stockId) {
    final record = findActiveStockRecord(stockId);
    if (record != null) {
      final livePrice = (record['salePrice'] as num?)?.toInt() ?? 0;
      if (livePrice > 0) return livePrice;
    }
    return fallbackValue;
  }
  static ({String? message, String buttonLabel}) checkLiveStockLock(
    String stockId, {
    DataMap? deviceGroup,
  }) {
    if (deviceGroup != null) {
      final availableUnits = resolveAllAvailableUnitsForGroup(deviceGroup);
      if (availableUnits.isNotEmpty) {
        return (message: null, buttonLabel: '');
      }
    }
    final record = findActiveStockRecord(stockId);
    if (record == null) {
      return (message: null, buttonLabel: '');
    }
    final status =
        (record['status']?.toString() ?? 'AVAILABLE').trim().toUpperCase();
    if (status == 'AVAILABLE' || status == 'ON_ORDER') {
      return (message: null, buttonLabel: '');
    }
    if (status == 'RESERVED') {
      final who = record['reservedCustomerInfo']?.toString().trim() ?? '';
      return (
        message: who.isNotEmpty
            ? '🔒 یہ آئٹم "$who" کے نام بُک (زیرِ معاہدہ) ہو چکا ہے!'
            : '🔒 یہ آئٹم فی الحال بُک (زیرِ معاہدہ) ہو چکا ہے!',
        buttonLabel: '🔒 بُک شدہ',
      );
    }
    if (status == 'SOLD') {
      final who = record['soldToName']?.toString().trim() ?? '';
      return (
        message: who.isNotEmpty
            ? '🔒 یہ آئٹم "$who" کو فروخت (Sold) ہو چکا ہے!'
            : '🔒 یہ آئٹم فروخت (Sold) ہو چکا ہے!',
        buttonLabel: '🔒 فروخت شدہ',
      );
    }
    if (status == 'DELETED') {
      return (
        message: '🔒 یہ آئٹم اسٹاک سے حذف کر دیا گیا ہے!',
        buttonLabel: '🔒 دستیاب نہیں',
      );
    }
    return (message: null, buttonLabel: '');
  }
}
