import 'dart:async';
import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:flutter/foundation.dart';
import '../../core/constants/app_colors.dart';
import '../../core/constants/box_names.dart';
import '../../core/database/hive_box_manager.dart';
import '../../core/network/connectivity_service.dart';
import '../../core/services/cloudinary_image_helper.dart';
import '../../core/services/permanent_image_cache_service.dart';
import '../status/sync_status_service.dart';
class StockPullService {
  static StreamSubscription? _stockSub;
  static void _precacheImagesInBackground(List<dynamic> imgs) {
    if (kIsWeb) return;
    for (final rawUrl in imgs) {
      final url = rawUrl.toString().trim();
      if (url.startsWith('http://') || url.startsWith('https://')) {
        PermanentImageCacheService.downloadAndCache(
          CloudinaryImageHelper.toCardThumbnailUrl(url),
        );
        PermanentImageCacheService.downloadAndCache(
          CloudinaryImageHelper.toFullHdUrl(url),
        );
      }
    }
  }
  static Future<void> _applyFullSnapshotToHive(List docs) async {
    final box = HiveBoxManager.getBox(BoxNames.stockBox);
    final Map<String, DataMap> fullMirrorBatch = {};
    final Set<String> activeCloudIds = {};
    for (final doc in docs) {
      final rawData = doc.data();
      if (rawData is! Map) continue;
      final data = Map<String, dynamic>.from(rawData);
      final statusUpper =
          (data['status']?.toString() ?? 'AVAILABLE').trim().toUpperCase();
      if (data['isDeleted'] == true || statusUpper == 'DELETED') continue;
      final String docId = doc.id.toString();
      activeCloudIds.add(docId);
      final existingLocal = box.get(docId);
      if (existingLocal is Map && existingLocal['isSynced'] == false) {
        continue;
      }
      data['id'] = docId;
      data['itemId'] = data['itemId'] ?? docId;
      data['status'] = statusUpper;
      data['isSynced'] = true;
      fullMirrorBatch[docId] = data;
      if (data['images'] is List) {
        _precacheImagesInBackground(data['images'] as List);
      }
    }
    for (final existingKey in box.keys.toList()) {
      final keyStr = existingKey.toString();
      final existingLocal = box.get(keyStr);
      if (existingLocal is Map && existingLocal['isSynced'] == false) {
        continue;
      }
      if (!activeCloudIds.contains(keyStr)) {
        await HiveBoxManager.deleteKey(
          boxName: BoxNames.stockBox,
          key: keyStr,
        );
      }
    }
    if (fullMirrorBatch.isNotEmpty) {
      await HiveBoxManager.putBatch(
        boxName: BoxNames.stockBox,
        entries: fullMirrorBatch,
      );
    }
  }
  static Future<void> pullStock() async {
    try {
      if (!await ConnectivityService.isOnline) return;
      final collection =
          FirebaseFirestore.instance.collection(BoxNames.stockBox);
      final querySnap =
          await collection.get().timeout(const Duration(seconds: 5));
      await _applyFullSnapshotToHive(querySnap.docs);
    } catch (e) {
      debugPrint('StockPullService Error: $e');
    }
  }
  static void startRealtimeListener() {
    _stockSub?.cancel();
    _stockSub = FirebaseFirestore.instance
        .collection(BoxNames.stockBox)
        .snapshots()
        .listen(
      (snapshot) async {
        try {
          await _applyFullSnapshotToHive(snapshot.docs);
          SyncStatusService.setState(SyncState.synced);
        } catch (_) {}
      },
      onError: (_) => SyncStatusService.setState(SyncState.offline),
    );
  }
  static Future<void> stopRealtimeListener() async {
    await _stockSub?.cancel();
    _stockSub = null;
  }
}
