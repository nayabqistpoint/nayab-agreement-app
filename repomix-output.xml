              ? AppColors.primaryEmerald.withValues(alpha: 0.45)
              : (isRibbonExpanded
                  ? AppColors.primaryEmerald
                  : const Color(0xFFCBD5E1)),
          width: isRibbonExpanded ? 1.6 : 1.2,
        ),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withValues(alpha: 0.04),
            blurRadius: 8,
            offset: const Offset(0, 2),
          ),
        ],
