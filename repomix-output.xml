                            backgroundColor: AppColors.primaryEmerald,
                            foregroundColor: Colors.white,
                            visualDensity: VisualDensity.compact,
                          ),
                        ),
                        OutlinedButton.icon(
                          onPressed: () =>
                              _pickImage(ImageSource.camera, onUrlChanged),
