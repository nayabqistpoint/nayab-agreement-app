        backgroundColor: AppColors.primaryEmerald,
      ),
    );
  }
  @override
  Widget build(BuildContext context) {
    final List images = (item['images'] as List?) ?? const [];
    final bool hasValidImage =
        images.isNotEmpty && images.first.toString().trim().isNotEmpty;
    final bool isReserved = item['isReserved'] == true;
    final String reservedInfo =
        item['reservedCustomerInfo']?.toString().trim() ?? '';
    final String reservedPlan =
        item['reservedPlanSummary']?.toString().trim() ?? '';
