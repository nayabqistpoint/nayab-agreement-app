import '../../../core/constants/box_names.dart';
import '../../../core/database/hive_box_manager.dart';
import '../../../core/time/time_status_service.dart';
import 'payload_builders/purchase_order_payload_builder.dart';
class OrderReceiptStorageHandlerService {
  static Map<String, dynamic> buildOrderPayload({
    required String docId,
    required String customerName,
    String customerFatherName = '',
    String customerCaste = '',
    required String customerPhone,
    required String customerCnic,
    String customerAddress = '',
    required String guarantorName,
    String guarantorFatherName = '',
    String guarantorCaste = '',
    required String guarantorPhone,
    String guarantorCnic = '',
    String guarantorAddress = '',
    String guarantorRelation = '',
    String? guardianPhone,
    required String sourceMode,
    required String itemName,
    String? imeiNo,
    required String guaranteeType,
    String? bankName,
    String? chequeNo,
    required int totalMonths,
    required int advance,
    required int monthlyAmount,
    required int totalContractAmount,
    required DateTime orderDateTime,
    List<String> acceptedSecurityConditions = const [],
    int mdmLockFee = 1000,
    String openBoxDeductionRule = '',
    bool adminOverrideApplied = false,
  }) {
    return PurchaseOrderPayloadBuilder.buildOrderPayload(
      docId: docId,
      customerName: customerName,
      customerFatherName: customerFatherName,
      customerCaste: customerCaste,
      customerPhone: customerPhone,
      customerCnic: customerCnic,
      customerAddress: customerAddress,
      guarantorName: guarantorName,
      guarantorFatherName: guarantorFatherName,
      guarantorCaste: guarantorCaste,
      guarantorPhone: guarantorPhone,
      guarantorCnic: guarantorCnic,
      guarantorAddress: guarantorAddress,
      guarantorRelation: guarantorRelation,
      guardianPhone: guardianPhone,
      sourceMode: sourceMode,
      itemName: itemName,
      imeiNo: imeiNo,
      guaranteeType: guaranteeType,
      bankName: bankName,
      chequeNo: chequeNo,
      totalMonths: totalMonths,
      advance: advance,
      monthlyAmount: monthlyAmount,
      totalContractAmount: totalContractAmount,
      orderDateTime: orderDateTime,
      acceptedSecurityConditions: acceptedSecurityConditions,
      mdmLockFee: mdmLockFee,
      openBoxDeductionRule: openBoxDeductionRule,
      adminOverrideApplied: adminOverrideApplied,
    );
  }
  static String? checkImeiAvailabilityError(String? imeiNo) {
    final cleanImei = imeiNo?.trim() ?? '';
    if (cleanImei.isEmpty || cleanImei == 'null') return null;
    try {
      final stockBox = HiveBoxManager.getBox(BoxNames.stockBox);
      for (final key in stockBox.keys) {
        final raw = stockBox.get(key);
        if (raw is Map) {
          final stockImei = raw['imeiNo']?.toString().trim() ?? '';
          if (stockImei == cleanImei) {
            final status =
                (raw['status']?.toString() ?? 'AVAILABLE').trim().toUpperCase();
            if (status == 'RESERVED') {
              final who =
                  raw['reservedCustomerInfo']?.toString() ?? 'کسی اور گاہک';
              return 'یہ موبائل پہلے ہی "$who" کے نام بُک (Reserved) ہو چکا ہے!';
            }
            if (status == 'SOLD') {
              return 'یہ موبائل پہلے ہی فروخت (Sold) ہو چکا ہے!';
            }
            if (raw['isDeleted'] == true || status == 'DELETED') {
              return 'یہ موبائل اسٹاک سے حذف کر دیا گیا ہے!';
            }
            break;
          }
        }
      }
    } catch (_) {}
    return null;
  }
  static Future<bool> saveOrderRecord({
    required String tokenNo,
    required Map<String, dynamic> payload,
  }) async {
    try {
      await HiveBoxManager.putBatch(
        boxName: BoxNames.shopOrdersBox,
        entries: {tokenNo: payload},
      );
      final imei = payload['imeiNo']?.toString().trim() ?? '';
      if (imei.isNotEmpty && imei != 'null') {
        final cName = payload['customerName']?.toString().trim() ?? '';
        final cCnic = payload['customerCnic']?.toString().trim() ?? '';
        final customerSummary =
            cCnic.isNotEmpty ? '$cName ($cCnic)' : cName;
        final int months = (payload['totalMonths'] as num?)?.toInt() ?? 0;
        final int adv = (payload['advance'] as num?)?.toInt() ?? 0;
        final int monthly = (payload['monthlyAmount'] as num?)?.toInt() ?? 0;
        final String gType =
            (payload['guaranteeType']?.toString() ?? '') == 'BANK_CHEQUE'
                ? 'بینک چیک'
                : 'اشٹام پرنوٹ';
        final String advText =
            adv > 0 ? 'ایڈوانس: Rs. $adv' : '⭐ بغیر ایڈوانس';
        final String planSummary =
            '$months ماہ • $advText • قسط: Rs. $monthly/ماہ ($gType)';
        await _markStockReservedByImei(
          imei: imei,
          orderId: tokenNo,
          customerInfo: customerSummary,
          planSummary: planSummary,
        );
      }
      return true;
    } catch (_) {
      return false;
    }
  }
  static Future<void> _markStockReservedByImei({
    required String imei,
    required String orderId,
    required String customerInfo,
    required String planSummary,
  }) async {
    try {
      final stockBox = HiveBoxManager.getBox(BoxNames.stockBox);
      final now = TimeStatusService.nowUtcIso();
      for (final key in stockBox.keys) {
        final rawStock = stockBox.get(key);
        if (rawStock is Map) {
          final stockImei = rawStock['imeiNo']?.toString().trim() ?? '';
          if (stockImei == imei) {
            final updatedStock = Map<String, dynamic>.from(rawStock);
            updatedStock['status'] = 'RESERVED';
            updatedStock['reservedOrderId'] = orderId;
            updatedStock['reservedCustomerInfo'] = customerInfo;
            updatedStock['reservedPlanSummary'] = planSummary;
            updatedStock['updatedAt'] = now;
            updatedStock['isSynced'] = false;
            await HiveBoxManager.putBatch(
              boxName: BoxNames.stockBox,
              entries: {key.toString(): updatedStock},
            );
            break;
          }
        }
      }
    } catch (_) {}
  }
}
