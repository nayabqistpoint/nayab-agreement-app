        'نایاب قسط پوائنٹ میں خوش آمدید • بغیر ایڈوانس اور آسان ماہانہ اقساط پر موبائل اور گھریلو اشیاء دستیاب ہیں',
    this.showReservedItems = true,
    this.showSoldItems = true,
    this.showOnOrderItems = true,
    this.mobileCustomFields = const [],
    this.generalCustomFields = const [],
