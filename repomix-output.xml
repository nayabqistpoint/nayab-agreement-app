<file path="lib/features/pos_control_panel/components/pos_config_tab_ui.dart">
import 'package:flutter/material.dart';
import '../../../core/constants/app_colors.dart';
import '../services/pos_control_storage_service.dart';
class PosConfigTabUi extends StatefulWidget {
  const PosConfigTabUi({super.key});
  @override
  State<PosConfigTabUi> createState() => _PosConfigTabUiState();
}
class _PosConfigTabUiState extends State<PosConfigTabUi> {
  late final TextEditingController _advanceCtrl;
  late final TextEditingController _profitCheckCtrl;
  late final TextEditingController _profitNoCheckCtrl;
  late final TextEditingController _incrementCtrl;
  late final TextEditingController _dueDayCtrl;
  late final TextEditingController _graceDaysCtrl;
  late final TextEditingController _feeCtrl;
  late final TextEditingController _roundCtrl;
  late final TextEditingController _mdmFeeCtrl;
  late final TextEditingController _openBoxValCtrl;
  late final TextEditingController _maxRiskLimitCtrl;
  late final TextEditingController _adminPinCtrl;
  String _openBoxType = 'PERCENT';
  bool _isCompounding = false;
  bool _addFeeToPrincipal = false;
  List<int> _selectedDurations = [6, 7, 8, 9, 10, 11, 12];
  int _maxMonthLimit = 15;
  String? _inlineSaveMessage;
  bool _isSaveError = false;
  @override
  void initState() {
    super.initState();
    final cfg = PosControlStorageService.getCalculatorConfig();
    _advanceCtrl = TextEditingController(
      text: ((cfg['advancePercentage'] as num?)?.toDouble() ?? 0.8).toString(),
    );
    _profitCheckCtrl = TextEditingController(
      text: ((cfg['profitWithCheck'] as num?)?.toDouble() ?? 0.25).toString(),
    );
    _profitNoCheckCtrl = TextEditingController(
      text:
          ((cfg['profitWithoutCheck'] as num?)?.toDouble() ?? 0.35).toString(),
    );
    _incrementCtrl = TextEditingController(
      text:
          ((cfg['perMonthIncrement'] as num?)?.toDouble() ?? 0.05).toString(),
    );
    _dueDayCtrl = TextEditingController(
      text: ((cfg['installmentDueDay'] as num?)?.toInt() ?? 5).toString(),
    );
    _graceDaysCtrl = TextEditingController(
      text: ((cfg['gracePeriodDays'] as num?)?.toInt() ?? 15).toString(),
    );
    _feeCtrl = TextEditingController(
      text: ((cfg['processingFee'] as num?)?.toInt() ?? 0).toString(),
    );
    _roundCtrl = TextEditingController(
      text: ((cfg['roundToNearest'] as num?)?.toInt() ?? 100).toString(),
    );
    _mdmFeeCtrl = TextEditingController(
      text: ((cfg['mdmLockFee'] as num?)?.toInt() ?? 1000).toString(),
    );
    _openBoxType =
        (cfg['openBoxDeductionType']?.toString() ?? 'PERCENT') == 'FIXED'
            ? 'FIXED'
            : 'PERCENT';
    _openBoxValCtrl = TextEditingController(
      text: ((cfg['openBoxDeductionValue'] as num?)?.toInt() ?? 10).toString(),
    );
    _maxRiskLimitCtrl = TextEditingController(
      text: ((cfg['maxRiskLimit'] as num?)?.toInt() ?? 0).toString(),
    );
    _adminPinCtrl = TextEditingController(
      text: cfg['adminOverridePin']?.toString() ?? '7860',
    );
    _isCompounding = cfg['isCompoundingProfit'] == true;
    _addFeeToPrincipal = cfg['addProcessingFeeToPrincipal'] == true;
    final rawDurations = cfg['allowedDurations'];
    if (rawDurations is List && rawDurations.isNotEmpty) {
      _selectedDurations = rawDurations
          .map((e) => int.tryParse(e.toString()) ?? 0)
          .where((e) => e >= 3)
          .toList()
        ..sort();
      if (_selectedDurations.isNotEmpty &&
          _selectedDurations.last > _maxMonthLimit) {
        _maxMonthLimit = _selectedDurations.last;
      }
    }
  }
  @override
  void dispose() {
    _advanceCtrl.dispose();
    _profitCheckCtrl.dispose();
    _profitNoCheckCtrl.dispose();
    _incrementCtrl.dispose();
    _dueDayCtrl.dispose();
    _graceDaysCtrl.dispose();
    _feeCtrl.dispose();
    _roundCtrl.dispose();
    _mdmFeeCtrl.dispose();
    _openBoxValCtrl.dispose();
    _maxRiskLimitCtrl.dispose();
    _adminPinCtrl.dispose();
    super.dispose();
  }
  Future<void> _saveConfig() async {
    if (_selectedDurations.isEmpty) {
      setState(() {
        _isSaveError = true;
        _inlineSaveMessage = '⚠️ کم از کم ایک مدت (ماہ) منتخب کریں!';
      });
      return;
    }
    final sortedDurations = List<int>.from(_selectedDurations)..sort();
    final saved = await PosControlStorageService.saveCalculatorConfig(
      advancePercentage: double.tryParse(_advanceCtrl.text.trim()) ?? 0.8,
      profitWithCheck: double.tryParse(_profitCheckCtrl.text.trim()) ?? 0.25,
      profitWithoutCheck:
          double.tryParse(_profitNoCheckCtrl.text.trim()) ?? 0.35,
      perMonthIncrement: double.tryParse(_incrementCtrl.text.trim()) ?? 0.05,
      gracePeriodDays: int.tryParse(_graceDaysCtrl.text.trim()) ?? 15,
      installmentDueDay: int.tryParse(_dueDayCtrl.text.trim()) ?? 5,
      processingFee: int.tryParse(_feeCtrl.text.trim()) ?? 0,
      roundToNearest: int.tryParse(_roundCtrl.text.trim()) ?? 100,
      isCompoundingProfit: _isCompounding,
      addProcessingFeeToPrincipal: _addFeeToPrincipal,
      allowedDurations: sortedDurations,
      mdmLockFee: int.tryParse(_mdmFeeCtrl.text.trim()) ?? 1000,
      openBoxDeductionType: _openBoxType,
      openBoxDeductionValue: int.tryParse(_openBoxValCtrl.text.trim()) ?? 10,
      maxRiskLimit: int.tryParse(_maxRiskLimitCtrl.text.trim()) ?? 0,
      adminOverridePin: _adminPinCtrl.text.trim(),
    );
    if (!mounted) return;
    setState(() {
      if (saved) {
        _isSaveError = false;
        _inlineSaveMessage =
            '✅ تمام ریٹس اور سیکیورٹی رسک سیٹنگز محفوظ ہو کر POS ایپ پر سنک ہو گئیں!';
      } else {
        _isSaveError = true;
        _inlineSaveMessage =
            '⚠️ سیٹنگز محفوظ کرتے وقت مسئلہ پیش آیا، دوبارہ کوشش کریں۔';
      }
    });
  }
  Widget _buildNumberField(
    String label,
    TextEditingController ctrl, {
    String? helper,
    bool isDecimal = true,
  }) {
    return TextField(
      controller: ctrl,
      keyboardType: TextInputType.numberWithOptions(decimal: isDecimal),
      textAlign: TextAlign.left,
      style: const TextStyle(
        fontSize: 16,
        fontWeight: FontWeight.bold,
        color: Color(0xFF0F172A),
      ),
      decoration: InputDecoration(
        labelText: label,
        labelStyle: const TextStyle(
          fontSize: 14.5,
          fontWeight: FontWeight.bold,
          color: Color(0xFF1E293B),
        ),
        floatingLabelBehavior: FloatingLabelBehavior.always,
        helperText: helper,
        helperStyle: const TextStyle(
          fontSize: 12,
          fontWeight: FontWeight.w600,
          color: Color(0xFF475569),
        ),
        helperMaxLines: 2,
        contentPadding:
            const EdgeInsets.symmetric(horizontal: 12, vertical: 14),
        border: OutlineInputBorder(borderRadius: BorderRadius.circular(10)),
        enabledBorder: OutlineInputBorder(
          borderRadius: BorderRadius.circular(10),
          borderSide: const BorderSide(color: Color(0xFF94A3B8), width: 1.2),
        ),
        filled: true,
        fillColor: Colors.white,
      ),
    );
  }
  @override
  Widget build(BuildContext context) {
    final List<int> continuousMonths = List.generate(
      (_maxMonthLimit - 3) + 1,
      (index) => 3 + index,
    );
    return SingleChildScrollView(
      padding: const EdgeInsets.all(14),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          Container(
            padding: const EdgeInsets.all(12),
            decoration: BoxDecoration(
              color: Colors.teal.shade50,
              borderRadius: BorderRadius.circular(10),
              border: Border.all(color: AppColors.primaryEmerald.withAlpha(80)),
            ),
            child: const Row(
              children: [
                Icon(Icons.sync_alt, color: AppColors.primaryEmerald),
                SizedBox(width: 8),
                Expanded(
                  child: Text(
                    'یہاں سے محفوظ کی گئی شرائط فوری طور پر دکان کی POS کیلکولیٹر ایپ پر لاگو ہو جائیں گی۔',
                    style:
                        TextStyle(fontSize: 13.5, fontWeight: FontWeight.bold),
                  ),
                ),
              ],
            ),
          ),
          const SizedBox(height: 16),
          Row(
            children: [
              Expanded(
                child: _buildNumberField(
                  'ایڈوانس شرح (Advance %)',
                  _advanceCtrl,
                  helper: 'مثلاً 0.8 = 20% ایڈوانس',
                ),
              ),
              const SizedBox(width: 10),
              Expanded(
                child: _buildNumberField(
                  'ماہانہ اضافہ (Increment)',
                  _incrementCtrl,
                  helper: 'مثلاً 0.05 = 5% فی ماہ',
                ),
              ),
            ],
          ),
          const SizedBox(height: 14),
          Row(
            children: [
              Expanded(
                child: _buildNumberField(
                  'منافع مع چیک',
                  _profitCheckCtrl,
                  helper: 'مثلاً 0.25 = 25%',
                ),
              ),
              const SizedBox(width: 10),
              Expanded(
                child: _buildNumberField(
                  'منافع بغیر چیک',
                  _profitNoCheckCtrl,
                  helper: 'مثلاً 0.35 = 35%',
                ),
              ),
            ],
          ),
          const SizedBox(height: 14),
          Row(
            children: [
              Expanded(
                child: _buildNumberField(
                  'قسط کی مقررہ تاریخ',
                  _dueDayCtrl,
                  helper: 'ہر ماہ کی تاریخ (مثلاً 5)',
                  isDecimal: false,
                ),
              ),
              const SizedBox(width: 10),
              Expanded(
                child: _buildNumberField(
                  'رعایتی دن (Grace Days)',
                  _graceDaysCtrl,
                  helper: 'مثلاً 15 دن',
                  isDecimal: false,
                ),
              ),
            ],
          ),
          const SizedBox(height: 14),
          Row(
            children: [
              Expanded(
                child: _buildNumberField(
                  'پروسیسنگ فیس (روپے)',
                  _feeCtrl,
                  isDecimal: false,
                ),
              ),
              const SizedBox(width: 10),
              Expanded(
                child: _buildNumberField(
                  'راؤنڈ آف (Round To)',
                  _roundCtrl,
                  helper: 'مثلاً 100 روپے',
                  isDecimal: false,
                ),
              ),
            ],
          ),
          const SizedBox(height: 16),
          Container(
            padding: const EdgeInsets.all(12),
            decoration: BoxDecoration(
              color: const Color(0xFFFFFBEB),
              borderRadius: BorderRadius.circular(12),
              border: Border.all(color: Colors.amber.shade600, width: 1.3),
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  children: [
                    Icon(Icons.shield_outlined,
                        color: Colors.amber.shade900, size: 20),
                    const SizedBox(width: 6),
                    Text(
                      'سیکیورٹی لاک، کٹوتی اور زیادہ سے زیادہ رسک حد:',
                      style: TextStyle(
                        fontWeight: FontWeight.bold,
                        fontSize: 15,
                        color: Colors.amber.shade900,
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 12),
                Row(
                  children: [
                    Expanded(
                      child: _buildNumberField(
                        'MDM لاک فیس (روپے)',
                        _mdmFeeCtrl,
                        helper: 'فی موبائل لاک فیس (مثلاً 1000)',
                        isDecimal: false,
                      ),
                    ),
                    const SizedBox(width: 10),
                    Expanded(
                      child: _buildNumberField(
                        'زیادہ سے زیادہ رسک حد (Max Risk Limit)',
                        _maxRiskLimitCtrl,
                        helper: '(قیمت - ایڈوانس) اس سے اوپر منظوری لازمی (0 = کوئی حد نہیں)',
                        isDecimal: false,
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 14),
                Row(
                  children: [
                    Expanded(
                      flex: 3,
                      child: DropdownButtonFormField<String>(
                        initialValue: _openBoxType,
                        isExpanded: true,
                        decoration: InputDecoration(
                          labelText: 'ڈبہ کھلنے پر کٹوتی کی قسم',
                          labelStyle: const TextStyle(
                            fontSize: 14,
                            fontWeight: FontWeight.bold,
                            color: Color(0xFF1E293B),
                          ),
                          floatingLabelBehavior: FloatingLabelBehavior.always,
                          contentPadding: const EdgeInsets.symmetric(
                              horizontal: 12, vertical: 14),
                          border: OutlineInputBorder(
                              borderRadius: BorderRadius.circular(10)),
                          filled: true,
                          fillColor: Colors.white,
                        ),
                        items: const [
                          DropdownMenuItem(
                              value: 'PERCENT',
                              child: Text('فیصد (%) کٹوتی',
                                  style: TextStyle(
                                      fontSize: 14,
                                      fontWeight: FontWeight.bold))),
                          DropdownMenuItem(
                              value: 'FIXED',
                              child: Text('فکس روپے کٹوتی',
                                  style: TextStyle(
                                      fontSize: 14,
                                      fontWeight: FontWeight.bold))),
                        ],
                        onChanged: (v) {
                          if (v != null) setState(() => _openBoxType = v);
                        },
                      ),
                    ),
                    const SizedBox(width: 10),
                    Expanded(
                      flex: 2,
                      child: _buildNumberField(
                        _openBoxType == 'PERCENT'
                            ? 'کٹوتی شرح (%)'
                            : 'کٹوتی رقم (Rs)',
                        _openBoxValCtrl,
                        isDecimal: false,
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 14),
                _buildNumberField(
                  'انتظامی خصوصی منظوری خفیہ پن (Admin Override PIN)',
                  _adminPinCtrl,
                  helper:
                      'رسک حد سے زائد آرڈر موقع پر پاس کرنے کیلئے خفیہ کوڈ',
                  isDecimal: false,
                ),
              ],
            ),
          ),
          const SizedBox(height: 16),
          Container(
            padding: const EdgeInsets.all(12),
            decoration: BoxDecoration(
              color: Colors.white,
              borderRadius: BorderRadius.circular(12),
              border: Border.all(color: const Color(0xFF94A3B8), width: 1.2),
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  children: [
                    const Expanded(
                      child: Text(
                        'اجازت شدہ اقساط کے مہینے:',
                        style: TextStyle(
                          fontWeight: FontWeight.bold,
                          fontSize: 15,
                          color: Color(0xFF0F172A),
                        ),
                      ),
                    ),
                    Container(
                      decoration: BoxDecoration(
                        color: const Color(0xFFF1F5F9),
                        borderRadius: BorderRadius.circular(8),
                        border: Border.all(color: const Color(0xFFCBD5E1)),
                      ),
                      child: Row(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          IconButton(
                            icon: const Icon(Icons.remove, size: 18),
                            tooltip: 'کم کریں',
                            visualDensity: VisualDensity.compact,
                            onPressed: _maxMonthLimit > 6
                                ? () {
                                    setState(() {
                                      _maxMonthLimit--;
                                      _selectedDurations
                                          .removeWhere((m) => m > _maxMonthLimit);
                                    });
                                  }
                                : null,
                          ),
                          Text(
                            '3 تا $_maxMonthLimit ماہ',
                            style: const TextStyle(
                              fontSize: 12.5,
                              fontWeight: FontWeight.bold,
                              color: AppColors.primaryEmerald,
                            ),
                          ),
                          IconButton(
                            icon: const Icon(Icons.add, size: 18),
                            tooltip: 'مزید مہینے بڑھائیں',
                            visualDensity: VisualDensity.compact,
                            onPressed: _maxMonthLimit < 36
                                ? () {
                                    setState(() {
                                      _maxMonthLimit++;
                                    });
                                  }
                                : null,
                          ),
                        ],
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 10),
                Wrap(
                  spacing: 7,
                  runSpacing: 7,
                  children: continuousMonths.map((month) {
                    final isSelected = _selectedDurations.contains(month);
                    return FilterChip(
                      label: Text(
                        '$month ماہ',
                        style: TextStyle(
                          fontSize: 13.5,
                          fontWeight: FontWeight.bold,
                          color: isSelected
                              ? Colors.white
                              : const Color(0xFF0F172A),
                        ),
                      ),
                      selected: isSelected,
                      selectedColor: AppColors.primaryEmerald,
                      checkmarkColor: Colors.white,
                      backgroundColor: const Color(0xFFF1F5F9),
                      padding: const EdgeInsets.symmetric(
                          horizontal: 6, vertical: 4),
                      onSelected: (val) {
                        setState(() {
                          if (val) {
                            _selectedDurations.add(month);
                          } else {
                            _selectedDurations.remove(month);
                          }
                        });
                      },
                    );
                  }).toList(),
                ),
              ],
            ),
          ),
          const SizedBox(height: 12),
          SwitchListTile(
            title: const Text(
              'کمپاؤنڈنگ منافع (Compounding Profit)',
              style: TextStyle(
                  fontSize: 14.5,
                  fontWeight: FontWeight.bold,
                  color: Color(0xFF0F172A)),
            ),
            value: _isCompounding,
            activeTrackColor: AppColors.primaryEmerald,
            onChanged: (v) => setState(() => _isCompounding = v),
          ),
          SwitchListTile(
            title: const Text(
              'پروسیسنگ فیس اصل رقم میں شامل کریں',
              style: TextStyle(
                  fontSize: 14.5,
                  fontWeight: FontWeight.bold,
                  color: Color(0xFF0F172A)),
            ),
            value: _addFeeToPrincipal,
            activeTrackColor: AppColors.primaryEmerald,
            onChanged: (v) => setState(() => _addFeeToPrincipal = v),
          ),
          if (_inlineSaveMessage != null) ...[
            const SizedBox(height: 10),
            Container(
              padding: const EdgeInsets.all(11),
              decoration: BoxDecoration(
                color: _isSaveError
                    ? const Color(0xFFFEF2F2)
                    : const Color(0xFFECFDF5),
                borderRadius: BorderRadius.circular(10),
                border: Border.all(
                  color: _isSaveError
                      ? AppColors.errorRed
                      : AppColors.primaryEmerald,
                ),
              ),
              child: Text(
                _inlineSaveMessage!,
                style: TextStyle(
                  fontSize: 13,
                  fontWeight: FontWeight.bold,
                  color: _isSaveError
                      ? AppColors.errorRed
                      : AppColors.primaryEmerald,
                ),
              ),
            ),
          ],
          const SizedBox(height: 16),
          ElevatedButton.icon(
            onPressed: _saveConfig,
            icon: const Icon(Icons.cloud_upload_outlined),
            label: const Text(
              'کیلکولیٹر اور سیکیورٹی سیٹنگز محفوظ کریں',
              style: TextStyle(fontSize: 15.5, fontWeight: FontWeight.bold),
            ),
            style: ElevatedButton.styleFrom(
              backgroundColor: AppColors.primaryEmerald,
              foregroundColor: Colors.white,
              padding: const EdgeInsets.symmetric(vertical: 15),
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(10),
              ),
            ),
          ),
        ],
      ),
    );
  }
}
