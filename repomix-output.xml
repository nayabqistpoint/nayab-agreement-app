          children: [
            MobileScanner(
              controller: _controller,
              onDetect: (capture) {
                final barcodes = capture.barcodes;
                if (barcodes.isNotEmpty) {
                  final String? val = barcodes.first.rawValue;
                  if (val != null && val.trim().isNotEmpty) {
                    Navigator.pop(context, val.trim());
                  }
