<file path="lib/core/models/document_template_model.dart">
import 'overlay_box_model.dart';
enum DocumentMode {
  stampOverlay,
  plainDocument,
  formFiller,
}
class DocumentTemplateModel {
  final String id;
  final String title;
  final String content;
  final DocumentMode mode;
  final String paperSize;
  final double topMargin;
  final double subsequentTopMargin;
  final double bottomMargin;
  final double sideMargin;
  final double fontSize;
  final String? base64Pdf;
  final String? stampFileName;
  final List<OverlayBoxModel> floatingBoxes;
  final List<String> fields;
  final List<String> pages;
  DocumentTemplateModel({
    required this.id,
    required this.title,
    required this.content,
    required this.mode,
    required this.paperSize,
    required this.topMargin,
    required this.subsequentTopMargin,
    required this.bottomMargin,
    required this.sideMargin,
    required this.fontSize,
    this.base64Pdf,
    this.stampFileName,
    this.floatingBoxes = const [],
    this.fields = const [],
    this.pages = const [],
  });
  Map<String, dynamic> toMap() {
    return {
      'id': id,
      'title': title,
      'content': content,
      'mode': mode.name,
      'paperSize': paperSize,
      'topMargin': topMargin,
      'subsequentTopMargin': subsequentTopMargin,
      'bottomMargin': bottomMargin,
      'sideMargin': sideMargin,
      'fontSize': fontSize,
      'base64Pdf': base64Pdf,
      'stampFileName': stampFileName,
      'floatingBoxes': floatingBoxes.map((b) => b.toMap()).toList(),
      'fields': fields,
      'pages': pages,
    };
  }
  factory DocumentTemplateModel.fromMap(Map<dynamic, dynamic> map) {
    DocumentMode parsedMode = DocumentMode.stampOverlay;
    final modeStr = map['mode']?.toString();
    if (modeStr == DocumentMode.plainDocument.name) {
      parsedMode = DocumentMode.plainDocument;
    } else if (modeStr == DocumentMode.formFiller.name) {
      parsedMode = DocumentMode.formFiller;
    }
    List<OverlayBoxModel> boxes = [];
    if (map['floatingBoxes'] != null && map['floatingBoxes'] is List) {
      boxes = (map['floatingBoxes'] as List)
          .map((b) => OverlayBoxModel.fromMap(Map<String, dynamic>.from(b)))
          .toList();
    }
    List<String> parsedPages = [];
    if (map['pages'] != null && map['pages'] is List) {
      parsedPages = List<String>.from(map['pages'].map((e) => e.toString()));
    }
    return DocumentTemplateModel(
      id: map['id']?.toString() ?? '',
      title: map['title']?.toString() ?? '',
      content: map['content']?.toString() ?? '',
      mode: parsedMode,
      paperSize: map['paperSize']?.toString() ?? 'Legal',
      topMargin: (map['topMargin'] as num?)?.toDouble() ?? 320.0,
      subsequentTopMargin: (map['subsequentTopMargin'] as num?)?.toDouble() ?? 65.0,
      bottomMargin: (map['bottomMargin'] as num?)?.toDouble() ?? 270.0,
      sideMargin: (map['sideMargin'] as num?)?.toDouble() ?? 40.0,
      fontSize: (map['fontSize'] as num?)?.toDouble() ?? 13.5,
      base64Pdf: map['base64Pdf']?.toString(),
      stampFileName: map['stampFileName']?.toString(),
      floatingBoxes: boxes,
      fields: map['fields'] != null ? List<String>.from(map['fields']) : [],
      pages: parsedPages,
    );
  }
}
</file>

<file path="lib/core/utils/paper_pagination_helper.dart">
import 'package:flutter/material.dart';
class AgreementPaginationService {
  static List<String> paginate({
    required String fullText,
    required double fontSize,
    required double p1TopMargin,
    required double subsequentTopMargin,
    required double bottomMargin,
    required double sideMargin,
    String paperSize = 'Legal',
  }) {
    if (fullText.trim().isEmpty) return [""];
    final bool isA4 = paperSize.toUpperCase() == 'A4';
    final double sheetWidth = isA4 ? 595.0 : 612.0;
    final double sheetHeight = isA4 ? 842.0 : 1008.0;
    final double boxW = (sheetWidth - (sideMargin * 2)).clamp(100.0, sheetWidth);
    final double p1BoxH = (sheetHeight - p1TopMargin - bottomMargin).clamp(50.0, sheetHeight);
    final double subBoxH = (sheetHeight - subsequentTopMargin - bottomMargin).clamp(50.0, sheetHeight);
    final baseStyle = TextStyle(
      fontFamily: 'JameelNoori',
      fontSize: fontSize,
      height: 1.85,
      fontWeight: FontWeight.w600,
    );
    List<String> pages = [];
    String remainingText = fullText;
    bool isFirstPage = true;
    while (remainingText.trim().isNotEmpty) {
      final double targetH = isFirstPage ? p1BoxH : subBoxH;
      final textPainter = TextPainter(
        text: _parseStyledSpans(remainingText, baseStyle),
        textAlign: TextAlign.right,
        textDirection: TextDirection.rtl,
      );
      textPainter.layout(maxWidth: boxW - 12);
      final lines = textPainter.computeLineMetrics();
      if (lines.isEmpty) {
        pages.add(remainingText);
        break;
      }
      double currentHeight = 0;
      int fittedLinesCount = 0;
      for (var line in lines) {
        if (currentHeight + line.height <= targetH) {
          currentHeight += line.height;
          fittedLinesCount++;
        } else {
          break;
        }
      }
      if (fittedLinesCount == 0) fittedLinesCount = 1;
      // اگر تمام سطریں پیج میں سما گئی ہیں
      if (fittedLinesCount >= lines.length) {
        pages.add(remainingText);
        break;
      }
      // لائن بائی لائن حقیقی کٹ آف: ہم پچھلی فٹ شدہ لائن کے بالکل آخری کریکٹر کو پکڑتے ہیں
      // آفسیٹ کے بجائے سطر کی نچلی حد سے پوزیشن لیں
      final lastLineBottom = lines.take(fittedLinesCount).fold<double>(0.0, (sum, l) => sum + l.height);
      final pos = textPainter.getPositionForOffset(Offset(1.0, lastLineBottom - 2.0));
      int cutIndex = pos.offset;
      if (cutIndex <= 0 || cutIndex >= remainingText.length) {
        cutIndex = (remainingText.length * (fittedLinesCount / lines.length)).round();
      }
      // سطر یا لفظ کے درمیان کٹ کو محفوظ طریقے سے نیو لائن یا سپیس تک لے جانا
      int safeCut = cutIndex;
      while (safeCut > 0 && remainingText[safeCut] != '\n' && remainingText[safeCut] != ' ') {
        safeCut--;
      }
      if (safeCut > 0) {
        cutIndex = safeCut;
      }
      final pageContent = remainingText.substring(0, cutIndex);
      pages.add(pageContent.trimRight());
      // اہم ترین: کٹ انڈیکس کے بعد والی سپیس یا نیو لائن کو مکمل ختم کر کے اگلا صفحہ شروع کرنا
      remainingText = remainingText.substring(cutIndex);
      while (remainingText.startsWith('\n') || remainingText.startsWith(' ') || remainingText.startsWith('\r')) {
        remainingText = remainingText.substring(1);
      }
      isFirstPage = false;
    }
    return pages.isEmpty ? [""] : pages;
  }
  static TextSpan _parseStyledSpans(String text, TextStyle base) {
    final List<InlineSpan> spans = [];
    final regex = RegExp(r'(<b>.*?<\/b>|<u>.*?<\/u>)', dotAll: true);
    int lastMatchEnd = 0;
    for (final match in regex.allMatches(text)) {
      if (match.start > lastMatchEnd) {
        spans.add(TextSpan(text: text.substring(lastMatchEnd, match.start), style: base));
      }
      final matchedText = match.group(0)!;
      if (matchedText.startsWith('<b>')) {
        final content = matchedText.substring(3, matchedText.length - 4);
        spans.add(TextSpan(text: content, style: base.copyWith(fontWeight: FontWeight.bold)));
      } else if (matchedText.startsWith('<u>')) {
        final content = matchedText.substring(3, matchedText.length - 4);
        spans.add(TextSpan(text: content, style: base.copyWith(decoration: TextDecoration.underline)));
      }
      lastMatchEnd = match.end;
    }
    if (lastMatchEnd < text.length) {
      spans.add(TextSpan(text: text.substring(lastMatchEnd), style: base));
    }
    return TextSpan(children: spans);
  }
}
</file>

