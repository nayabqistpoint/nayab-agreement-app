import 'package:flutter/material.dart';
import '../../../core/constants/app_colors.dart';
class DirectCashSaleCardUi extends StatefulWidget {
  final String itemName;
  final int quantity;
  final int defaultUnitPrice;
  final List<String> allocatedStockIds;
  final List<String> allocatedImeis;
  final bool isLocked;
  final Future<void> Function({
    required int unitCashPrice,
    required String customerName,
    required String customerPhone,
  }) onCompleteCashSale;
  const DirectCashSaleCardUi({
    super.key,
    required this.itemName,
    required this.quantity,
    required this.defaultUnitPrice,
    required this.allocatedStockIds,
    required this.allocatedImeis,
    required this.isLocked,
    required this.onCompleteCashSale,
  });
  @override
  State<DirectCashSaleCardUi> createState() => _DirectCashSaleCardUiState();
}
class _DirectCashSaleCardUiState extends State<DirectCashSaleCardUi> {
  late final TextEditingController _unitPriceCtrl;
  final TextEditingController _custNameCtrl = TextEditingController();
  final TextEditingController _custPhoneCtrl = TextEditingController();
  bool _isSaving = false;
  @override
  void initState() {
    super.initState();
    _unitPriceCtrl =
        TextEditingController(text: widget.defaultUnitPrice.toString());
    _unitPriceCtrl.addListener(() {
      if (mounted) setState(() {});
    });
  }
  @override
  void didUpdateWidget(covariant DirectCashSaleCardUi oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (oldWidget.defaultUnitPrice != widget.defaultUnitPrice &&
        _unitPriceCtrl.text.trim().isEmpty) {
      _unitPriceCtrl.text = widget.defaultUnitPrice.toString();
    }
  }
  @override
  void dispose() {
    _unitPriceCtrl.dispose();
    _custNameCtrl.dispose();
    _custPhoneCtrl.dispose();
    super.dispose();
  }
  int get _unitPrice =>
      int.tryParse(_unitPriceCtrl.text.trim()) ?? widget.defaultUnitPrice;
  int get _grandTotal => _unitPrice * widget.quantity;
  Future<void> _submit() async {
    if (_unitPrice <= 0) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('براہ کرم درست نقد قیمت درج کریں!'),
          backgroundColor: AppColors.errorRed,
        ),
      );
      return;
    }
    setState(() => _isSaving = true);
    await widget.onCompleteCashSale(
      unitCashPrice: _unitPrice,
      customerName: _custNameCtrl.text.trim(),
      customerPhone: _custPhoneCtrl.text.trim(),
    );
    if (mounted) setState(() => _isSaving = false);
  }
  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        color: AppColors.cardSurface,
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: AppColors.primaryEmerald, width: 1.6),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          Row(
            children: [
              const Icon(
                Icons.payments_rounded,
                color: AppColors.primaryEmerald,
                size: 24,
              ),
              const SizedBox(width: 8),
              Expanded(
                child: Text(
                  'نقد فروخت (Direct Cash Sale) • ${widget.quantity} پیس',
                  style: const TextStyle(
                    fontSize: 16,
                    fontWeight: FontWeight.w900,
                    color: AppColors.primaryEmerald,
                  ),
                ),
              ),
            ],
          ),
          const SizedBox(height: 6),
          const Text(
            'نقد فروخت میں قسط معاہدہ، ضمانت یا پینڈنگ آرڈر کی ضرورت نہیں — آئٹم سیدھا اسٹاک سے مائنس ہو کر فروخت شدہ (Sold) ہو جائے گا۔',
            style: TextStyle(
              fontSize: 12.5,
              color: AppColors.textMuted,
              fontWeight: FontWeight.w700,
              height: 1.4,
            ),
          ),
          if (widget.allocatedStockIds.isNotEmpty) ...[
            const SizedBox(height: 8),
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 7),
              decoration: BoxDecoration(
                color: AppColors.warmTintEmerald,
                borderRadius: BorderRadius.circular(8),
                border: Border.all(color: AppColors.emeraldPillBorder),
              ),
              child: Text(
                '📦 منتخب یونٹس: ${widget.allocatedStockIds.join(", ")}${widget.allocatedImeis.isNotEmpty ? "\nIMEI: ${widget.allocatedImeis.join(", ")}" : ""}',
                style: const TextStyle(
                  fontSize: 12.5,
                  fontWeight: FontWeight.w900,
                  color: AppColors.primaryEmerald,
                ),
              ),
            ),
          ],
          const Divider(height: 20, color: AppColors.borderLight),
          TextField(
            controller: _unitPriceCtrl,
            keyboardType: TextInputType.number,
            textAlign: TextAlign.left,
            style: const TextStyle(
              fontSize: 17,
              fontWeight: FontWeight.w900,
              color: AppColors.textDark,
            ),
            decoration: InputDecoration(
              labelText: 'فی پیس نقد قیمت فروخت (کم یا زیادہ کر سکتے ہیں)*',
              labelStyle: const TextStyle(
                fontSize: 14,
                fontWeight: FontWeight.w900,
                color: AppColors.textDark,
              ),
              prefixText: 'Rs. ',
              filled: true,
              fillColor: Colors.white,
              border: OutlineInputBorder(
                borderRadius: BorderRadius.circular(10),
              ),
            ),
          ),
          const SizedBox(height: 10),
          Row(
            children: [
              Expanded(
                child: TextField(
                  controller: _custNameCtrl,
                  style: const TextStyle(
                      fontSize: 14.5, fontWeight: FontWeight.w800),
                  decoration: InputDecoration(
                    labelText: 'خریدار کا نام (اختیاری)',
                    filled: true,
                    fillColor: Colors.white,
                    border: OutlineInputBorder(
                      borderRadius: BorderRadius.circular(10),
                    ),
                  ),
                ),
              ),
              const SizedBox(width: 8),
              Expanded(
                child: TextField(
                  controller: _custPhoneCtrl,
                  keyboardType: TextInputType.phone,
                  textAlign: TextAlign.left,
                  style: const TextStyle(
                      fontSize: 14.5, fontWeight: FontWeight.w800),
                  decoration: InputDecoration(
                    labelText: 'فون نمبر (اختیاری)',
                    filled: true,
                    fillColor: Colors.white,
                    border: OutlineInputBorder(
                      borderRadius: BorderRadius.circular(10),
                    ),
                  ),
                ),
              ),
            ],
          ),
          const SizedBox(height: 12),
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
            decoration: BoxDecoration(
              color: AppColors.warmSubtleSurface,
              borderRadius: BorderRadius.circular(10),
              border: Border.all(color: AppColors.borderLight),
            ),
            child: Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Text(
                  'کل نقد وصولی (${widget.quantity} × Rs. $_unitPrice):',
                  style: const TextStyle(
                    fontSize: 14,
                    fontWeight: FontWeight.w900,
                    color: AppColors.textDark,
                  ),
                ),
                Text(
                  'Rs. $_grandTotal',
                  style: const TextStyle(
                    fontSize: 18,
                    fontWeight: FontWeight.w900,
                    color: AppColors.primaryEmerald,
                  ),
                ),
              ],
            ),
          ),
          const SizedBox(height: 14),
          ElevatedButton.icon(
            onPressed: (widget.isLocked || _isSaving) ? null : _submit,
            icon: const Icon(Icons.check_circle_rounded, size: 21),
            label: Text(
              _isSaving
                  ? 'محفوظ ہو رہا ہے...'
                  : '✅ نقد فروخت مکمل کریں (Direct Sold)',
              style: const TextStyle(
                fontSize: 15.5,
                fontWeight: FontWeight.w900,
              ),
            ),
            style: ElevatedButton.styleFrom(
              backgroundColor: AppColors.successGreen,
              foregroundColor: Colors.white,
              padding: const EdgeInsets.symmetric(vertical: 14),
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(10),
              ),
            ),
          ),
        ],
      ),
    );
  }
}
