import '../device_plan_detail/device_plan_detail_page.dart';
import 'services/market_card_parser_service.dart';
import 'services/market_cart_service.dart';
import 'services/market_filter_service.dart';
import 'services/purchase_market_storage_service.dart';
class PurchaseMarketController extends ChangeNotifier {
  int expandedCardIndex = -1;
  String selectedCategory = 'ALL';
  String selectedStatusFilter = 'ALL';
  String searchQuery = '';
  final TextEditingController searchController = TextEditingController();
  final Map<String, DataMap> selectedCartMap = {};
  bool get isMultiSelectMode => selectedCartMap.isNotEmpty;
  int get cartCount => selectedCartMap.length;
  int get cartBaseSum => selectedCartMap.values.fold<int>(
      0, (sum, d) => sum + ((d['baseValue'] as num?)?.toInt() ?? 0));
  ValueListenable<Box<dynamic>> get boxListenable =>
      PurchaseMarketStorageService.stockListenable;
  int get totalPlansCount => MarketCardParserService.getTotalPlansCount();
  String buildCartKeyForDevice(DataMap device) =>
      MarketCartService.buildCartKey(device);
  void toggleCartSelection(DataMap device) {
    if ((device['statusCode']?.toString() ?? 'AVAILABLE').toUpperCase() !=
        'AVAILABLE') {
      return;
    }
    final key = buildCartKeyForDevice(device);
    selectedCartMap.containsKey(key)
        ? selectedCartMap.remove(key)
        : selectedCartMap[key] = device;
    expandedCardIndex = -1;
    notifyListeners();
  }
  void clearCartSelection() {
    selectedCartMap.clear();
    notifyListeners();
  }
  void proceedWithCart(BuildContext context, String? customerPhone) {
    if (selectedCartMap.isEmpty) return;
    final list = selectedCartMap.values.toList();
    final target = list.length == 1
        ? list.first
        : MarketCartService.buildBundleDevice(list, cartBaseSum);
    clearCartSelection();
    navigateToPlanDetail(context, target, customerPhone);
  }
  List<DataMap> getAllUnfilteredStockDevices() =>
      MarketCardParserService.parseStockDevices(
          PurchaseMarketStorageService.getAllRawStock());
  List<DataMap> getCategoryFilteredDevices() =>
      MarketFilterService.filterByCategory(
          getAllUnfilteredStockDevices(), selectedCategory);
  List<DataMap> getStockDevices() => MarketFilterService.filterByStatusAndSearch(
        categoryList: getCategoryFilteredDevices(),
        statusFilter: selectedStatusFilter,
        searchQuery: searchQuery,
      );
  void setCategory(String cat) {
    selectedCategory = cat;
    expandedCardIndex = -1;
    notifyListeners();
  }
  void setStatusFilter(String status) {
    selectedStatusFilter = status;
    expandedCardIndex = -1;
    notifyListeners();
  }
  void updateSearch(String val) {
    searchQuery = val;
    expandedCardIndex = -1;
    notifyListeners();
  }
  void clearSearch() {
    searchController.clear();
    updateSearch('');
  }
  void toggleRibbon(int index) {
    expandedCardIndex = (expandedCardIndex == index) ? -1 : index;
    notifyListeners();
  }
  void navigateToPlanDetail(
      BuildContext context, DataMap device, String? phone) {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (_) => DevicePlanDetailPage(
          args: DevicePlanDetailArgs(device: device, customerPhone: phone),
        ),
      ),
    );
  }
  void handleCustomEstimateSubmit(BuildContext context, String name, int price,
      int adv, String zoneType, String cat, String? phone) {
    navigateToPlanDetail(
      context,
      MarketCardParserService.buildCustomEstimateDevice(
          name: name,
          price: price,
          adv: adv,
          zoneType: zoneType,
          productCategory: cat),
      phone,
    );
  }
  @override
  void dispose() {
    searchController.dispose();
    super.dispose();
  }
}
