import 'dart:typed_data';
import 'package:flutter/material.dart';
class StampCanvasSheet extends StatelessWidget {
  final double sheetWidth;
  final double sheetHeight;
  final double scaledTop;
  final double scaledBottom;
  final double scaledSide;
  final Uint8List? bgImage;
  final String pageLabel;
  final bool isFirstPage;
  final int pageIndex;
  final String textContent;
  final double fontSize;
  final TextEditingController? bodyController;
  final Function(String)? onTextChanged;
  final Function(double) onTopDrag;
  final Function(double) onBottomDrag;
  final Function(double) onSideDrag;
  const StampCanvasSheet({
    super.key,
    required this.sheetWidth,
    required this.sheetHeight,
    required this.scaledTop,
    required this.scaledBottom,
    required this.scaledSide,
    required this.bgImage,
    required this.pageLabel,
    required this.isFirstPage,
    this.pageIndex = 0,
    required this.textContent,
    required this.fontSize,
    this.bodyController,
    this.onTextChanged,
    required this.onTopDrag,
    required this.onBottomDrag,
    required this.onSideDrag,
  });
  @override
  Widget build(BuildContext context) {
    final double boxW = (sheetWidth - (scaledSide * 2)).clamp(50.0, sheetWidth);
    final double boxH = (sheetHeight - scaledTop - scaledBottom).clamp(40.0, sheetHeight);
    final textStyle = TextStyle(
      fontFamily: 'JameelNoori',
      fontSize: fontSize,
      height: 1.85,
      fontWeight: FontWeight.w600,
      color: const Color(0xFF111111),
    );
    return Column(
      children: [
        Text(
          pageLabel,
          style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 13, color: Colors.black87),
        ),
        const SizedBox(height: 6),
        Container(
          width: sheetWidth,
          height: sheetHeight,
          decoration: BoxDecoration(
            color: Colors.white,
            borderRadius: BorderRadius.circular(4),
            boxShadow: const [
              BoxShadow(color: Colors.black38, blurRadius: 10, spreadRadius: 2, offset: Offset(0, 4)),
            ],
          ),
          child: Stack(
            clipBehavior: Clip.none,
            children: [
              if (bgImage != null)
                Positioned.fill(
                  child: IgnorePointer(
                    child: Image.memory(
                      bgImage!,
                      fit: BoxFit.fill,
                      filterQuality: FilterQuality.high,
                      isAntiAlias: true,
                    ),
                  ),
                )
              else
                Center(
                  child: IgnorePointer(
                    child: Opacity(
                      opacity: 0.06,
                      child: Text(
                        isFirstPage ? "سرکاری ای-اسٹامپ پیپر" : "اضافی سادہ ورق",
                        style: const TextStyle(fontSize: 24, fontWeight: FontWeight.bold),
                      ),
                    ),
                  ),
                ),
              Positioned(
                top: 0,
                left: 0,
                right: 0,
                height: scaledTop,
                child: IgnorePointer(
                  child: Container(
                    color: Colors.amber.withAlpha(12),
                    alignment: Alignment.center,
                    child: Opacity(
                      opacity: 0.25,
                      child: Text(
                        isFirstPage ? "حاشیہ برائے سرکاری مونوگرام" : "اوپری حاشیہ",
                        style: const TextStyle(fontSize: 11, fontWeight: FontWeight.bold),
                      ),
                    ),
                  ),
                ),
              ),
              Positioned(
                bottom: 0,
                left: 0,
                right: 0,
                height: scaledBottom,
                child: IgnorePointer(
                  child: Container(
                    color: Colors.amber.withAlpha(12),
                    alignment: Alignment.center,
                    child: Opacity(
                      opacity: 0.25,
                      child: Text(
                        isFirstPage ? "حاشیہ برائے کیو آر کوڈ" : "نچلا حاشیہ",
                        style: const TextStyle(fontSize: 11, fontWeight: FontWeight.bold),
                      ),
                    ),
                  ),
                ),
              ),
              Positioned(
                top: scaledTop,
                left: scaledSide,
                width: boxW,
                height: boxH,
                child: Padding(
                  padding: const EdgeInsets.symmetric(horizontal: 14.0, vertical: 6.0),
                  child: isFirstPage && bodyController != null
                      ? TextField(
                          controller: bodyController,
                          maxLines: null,
                          scrollPhysics: const NeverScrollableScrollPhysics(),
                          textAlign: TextAlign.right,
                          textDirection: TextDirection.rtl,
                          style: textStyle,
                          cursorWidth: 2.5,
                          cursorColor: Colors.blue.shade900,
                          decoration: const InputDecoration(
                            border: InputBorder.none,
                            isDense: true,
                            contentPadding: EdgeInsets.zero,
                            hintText: 'یہاں لکھیں یا پیسٹ کریں...',
                          ),
                          onChanged: onTextChanged,
                        )
                      : SelectableText(
                          textContent,
                          textAlign: TextAlign.right,
                          textDirection: TextDirection.rtl,
                          style: textStyle,
                        ),
                ),
              ),
              Positioned(
                top: scaledTop,
                left: scaledSide,
                width: boxW,
                child: IgnorePointer(child: Container(height: 1.5, color: Colors.blue.shade600)),
              ),
              Positioned(
                bottom: scaledBottom,
                left: scaledSide,
                width: boxW,
                child: IgnorePointer(child: Container(height: 1.5, color: Colors.blue.shade600)),
              ),
              Positioned(
                top: scaledTop,
                right: scaledSide,
                height: boxH,
                child: IgnorePointer(child: Container(width: 1.5, color: Colors.blue.shade600)),
              ),
              Positioned(
                top: scaledTop,
                left: scaledSide,
                height: boxH,
                child: IgnorePointer(child: Container(width: 1.5, color: Colors.blue.shade600)),
              ),
              Positioned(
                top: scaledTop - 14,
                right: scaledSide - 14,
                child: _buildCornerHandle(
                  onPanUpdate: (d) {
                    onTopDrag(d.delta.dy);
                    onSideDrag(d.delta.dx);
                  },
                ),
              ),
              Positioned(
                top: scaledTop - 14,
                left: scaledSide - 14,
                child: _buildCornerHandle(
                  onPanUpdate: (d) {
                    onTopDrag(d.delta.dy);
                    onSideDrag(-d.delta.dx);
                  },
                ),
              ),
              Positioned(
                bottom: scaledBottom - 14,
                right: scaledSide - 14,
                child: _buildCornerHandle(
                  onPanUpdate: (d) {
                    onBottomDrag(d.delta.dy);
                    onSideDrag(d.delta.dx);
                  },
                ),
              ),
              Positioned(
                bottom: scaledBottom - 14,
                left: scaledSide - 14,
                child: _buildCornerHandle(
                  onPanUpdate: (d) {
                    onBottomDrag(d.delta.dy);
                    onSideDrag(-d.delta.dx);
                  },
                ),
              ),
            ],
          ),
        ),
      ],
    );
  }
  Widget _buildCornerHandle({required Function(DragUpdateDetails) onPanUpdate}) {
    return GestureDetector(
      behavior: HitTestBehavior.opaque,
      onPanUpdate: onPanUpdate,
      child: Container(
        width: 28,
        height: 28,
        decoration: BoxDecoration(
          color: Colors.blue.shade700,
          shape: BoxShape.circle,
          boxShadow: const [
            BoxShadow(color: Colors.black38, blurRadius: 4, offset: Offset(0, 2)),
          ],
          border: Border.all(color: Colors.white, width: 2),
        ),
        child: const Icon(Icons.open_with, size: 14, color: Colors.white),
      ),
    );
  }
}
