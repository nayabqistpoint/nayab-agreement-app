import '../../device_plan_detail/models/calculator_config_model.dart';
import '../components/security_barrier_checklist_card_ui.dart';
class SecurityBarrierService {
  static List<SecurityBarrierItem> buildChecklist({
    required CalculatorConfigModel config,
    required String zoneType,
    required bool isGeneral,
    required bool isCustomEstimate,
    required bool isChequePlan,
    required bool isZeroAdvance,
    required bool isBoxPackNew,
    required String openBoxDeductionText,
    required Set<String> checkedIds,
  }) {
    final List<SecurityBarrierItem> list = [];
    final int activeMdmFee = config.mdmFeeForZone(zoneType);
    if (isGeneral) {
      if (config.generalRequireCustomerMobileMdm) {
        list.add(
          SecurityBarrierItem(
            id: 'customer_personal_mobile_mdm',
            text:
                'جنرل آئٹم کی سیکیورٹی کیلئے گاہک کے ذاتی اینڈرائیڈ موبائل پر MDM سیکیورٹی لاک نصب کیا جائے گا، اور لاک فیس Rs. $activeMdmFee ناقابلِ واپسی ہوگی۔',
            isChecked: checkedIds.contains('customer_personal_mobile_mdm'),
          ),
        );
      }
    } else if (isCustomEstimate) {
      if (config.customRequireCustomerMobileMdm) {
        list.add(
          SecurityBarrierItem(
            id: 'custom_customer_mobile_mdm',
            text:
                'کسٹم آرڈر کی سیکیورٹی کیلئے گاہک کے ذاتی یا خریدے گئے اینڈرائیڈ موبائل پر MDM سیکیورٹی لاک نصب کیا جائے گا، اور لاک فیس Rs. $activeMdmFee ناقابلِ واپسی ہوگی۔',
            isChecked: checkedIds.contains('custom_customer_mobile_mdm'),
          ),
        );
      }
    } else {
      list.add(
        SecurityBarrierItem(
          id: 'mdm_lock',
          text:
              'قسط کی عدم ادائیگی یا تاخیر کی صورت میں موبائل پر نصب MDM سیکیورٹی لاک فعال کر دیا جائے گا، اور لاک فیس Rs. $activeMdmFee ناقابلِ واپسی ہوگی۔',
          isChecked: checkedIds.contains('mdm_lock'),
        ),
      );
    }
    if (isChequePlan && isZeroAdvance) {
      list.add(
        SecurityBarrierItem(
          id: 'salary_slip',
          text:
              'بغیر ایڈوانس مع چیک پیکج صرف تنخواہ دار ملازمین کیلئے ہے؛ گاہک کا اپنا ذاتی بینک چیک اور تازہ سیلری سلپ (Salary Slip) جمع کرانا لازمی ہے۔',
          isChecked: checkedIds.contains('salary_slip'),
        ),
      );
    } else if (!isChequePlan && isZeroAdvance) {
      list.add(
        SecurityBarrierItem(
          id: 'double_mdm_guarantor',
          text:
              'بغیر ایڈوانس و بغیر چیک کی صورت میں مستند شخصی ضامن کے مکمل کوائف اور ضامن کے ذاتی اینڈرائیڈ موبائل پر بھی MDM لاک لگے گا (الگ فیس Rs. $activeMdmFee لاگو ہوگی)۔',
          isChecked: checkedIds.contains('double_mdm_guarantor'),
        ),
      );
    } else if (!isChequePlan && !isZeroAdvance) {
      list.add(
        SecurityBarrierItem(
          id: 'stamp_guarantor',
          text:
              'قانونی ای-اسٹامپ و پرنوٹ کے ساتھ ایک مستند شخصی ضامن کے مکمل کوائف فراہم کرنا لازمی ہوگا۔',
          isChecked: checkedIds.contains('stamp_guarantor'),
        ),
      );
    }
    if (isBoxPackNew || isGeneral || isCustomEstimate) {
      list.add(
        SecurityBarrierItem(
          id: 'open_box_policy',
          text:
              'ڈبہ پیک آئٹم کی سیل کھلنے یا استعمال شروع ہونے کے بعد معاہدہ منسوخ کرنے یا واپسی کی صورت میں $openBoxDeductionText گاہک ادا کرنے کا پابند ہوگا۔',
          isChecked: checkedIds.contains('open_box_policy'),
        ),
      );
    }
    list.add(
      SecurityBarrierItem(
        id: 'guardian_consent',
        text:
            'یہ خریداری گاہک کے والدین / سرپرست کے مکمل علم میں ہے اور نیچے سرپرست کے نمبر پر واٹس ایپ اطلاع بھیجی جا رہی ہے۔',
        isChecked: checkedIds.contains('guardian_consent'),
      ),
    );
    return list;
  }
}
