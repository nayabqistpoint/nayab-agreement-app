<file path="lib/core/utils/paper_pagination_helper.dart">
import 'package:flutter/material.dart';
class AgreementPaginationService {
  static List<String> paginate({
    required String fullText,
    required double fontSize,
    required double p1TopMargin,
    required double subsequentTopMargin,
    required double bottomMargin,
    double? subsequentBottomMargin,
    required double sideMargin,
    String paperSize = 'Legal',
  }) {
    if (fullText.trim().isEmpty) return [""];
    final bool isA4 = paperSize.toUpperCase() == 'A4';
    final double sheetWidth = isA4 ? 595.0 : 612.0;
    final double sheetHeight = isA4 ? 842.0 : 1008.0;
    final double effectiveSubBottom = subsequentBottomMargin ?? 65.0;
    const double innerHorizontalPadding = 24.0;
    const double innerVerticalPadding = 16.0;
    final double boxW = (sheetWidth - (sideMargin * 2) - innerHorizontalPadding).clamp(80.0, sheetWidth);
    final double p1BoxH = (sheetHeight - p1TopMargin - bottomMargin - innerVerticalPadding).clamp(40.0, sheetHeight);
    final double subBoxH = (sheetHeight - subsequentTopMargin - effectiveSubBottom - innerVerticalPadding).clamp(40.0, sheetHeight);
    final baseStyle = TextStyle(
      fontFamily: 'JameelNoori',
      fontSize: fontSize,
      height: 1.85,
      fontWeight: FontWeight.w600,
    );
    final paragraphs = fullText.split('\n');
    final List<String> pages = [];
    StringBuffer currentPageBuffer = StringBuffer();
    double currentHeight = 0.0;
    bool isFirstPage = true;
    for (int pIdx = 0; pIdx < paragraphs.length; pIdx++) {
      final para = paragraphs[pIdx];
      final double targetH = isFirstPage ? p1BoxH : subBoxH;
      if (para.trim().isEmpty) {
        const double emptyLineH = 24.0;
        if (currentHeight + emptyLineH <= targetH || currentPageBuffer.isEmpty) {
          if (currentPageBuffer.isNotEmpty) currentPageBuffer.write('\n');
          currentPageBuffer.write('');
          currentHeight += emptyLineH;
        } else {
          pages.add(currentPageBuffer.toString());
          currentPageBuffer.clear();
          currentHeight = emptyLineH;
          isFirstPage = false;
        }
        continue;
      }
      final textPainter = TextPainter(
        text: TextSpan(text: para, style: baseStyle),
        textAlign: TextAlign.right,
        textDirection: TextDirection.rtl,
      );
      textPainter.layout(maxWidth: boxW);
      if (currentHeight + textPainter.height <= targetH || currentPageBuffer.isEmpty) {
        if (currentPageBuffer.isNotEmpty) currentPageBuffer.write('\n');
        currentPageBuffer.write(para);
        currentHeight += textPainter.height;
      } else {
        final words = para.split(' ');
        StringBuffer currentParaBuffer = StringBuffer();
        for (int wIdx = 0; wIdx < words.length; wIdx++) {
          final testText = currentParaBuffer.isEmpty
              ? words[wIdx]
              : '${currentParaBuffer.toString()} ${words[wIdx]}';
          final testPainter = TextPainter(
            text: TextSpan(text: testText, style: baseStyle),
            textAlign: TextAlign.right,
            textDirection: TextDirection.rtl,
          );
          testPainter.layout(maxWidth: boxW);
          if (currentHeight + testPainter.height <= targetH || currentPageBuffer.isEmpty) {
            currentParaBuffer.clear();
            currentParaBuffer.write(testText);
          } else {
            if (currentPageBuffer.isNotEmpty) currentPageBuffer.write('\n');
            currentPageBuffer.write(currentParaBuffer.toString());
            pages.add(currentPageBuffer.toString());
            currentPageBuffer.clear();
            currentParaBuffer.clear();
            currentParaBuffer.write(words[wIdx]);
            isFirstPage = false;
            final nextPainter = TextPainter(
              text: TextSpan(text: words[wIdx], style: baseStyle),
              textAlign: TextAlign.right,
              textDirection: TextDirection.rtl,
            );
            nextPainter.layout(maxWidth: boxW);
            currentHeight = nextPainter.height;
          }
        }
        if (currentParaBuffer.isNotEmpty) {
          if (currentPageBuffer.isNotEmpty) currentPageBuffer.write('\n');
          currentPageBuffer.write(currentParaBuffer.toString());
          final finalPainter = TextPainter(
            text: TextSpan(text: currentParaBuffer.toString(), style: baseStyle),
            textAlign: TextAlign.right,
            textDirection: TextDirection.rtl,
          );
          finalPainter.layout(maxWidth: boxW);
          currentHeight += finalPainter.height;
        }
      }
    }
    if (currentPageBuffer.isNotEmpty) {
      pages.add(currentPageBuffer.toString());
    }
    return pages.isEmpty ? [""] : pages;
  }
}
</file>

<file path="lib/features/agreement_bucket_view/bucket_view_controller.dart">
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:url_launcher/url_launcher.dart';
import '../../core/constants/box_names.dart';
import '../../core/database/hive_box_manager.dart';
import '../../core/models/document_template_model.dart';
import 'services/bucket_payload_builder.dart';
import 'services/bucket_storage_handler_service.dart';
class BucketViewController extends ChangeNotifier {
  final TextEditingController phoneController = TextEditingController();
  final Map<String, TextEditingController> controllers = {};
  List<String> fields = [];
  String? qrSourceData;
  String selectedTemplateTitle = '';
  List<String> selectedTemplatesBundle = [];
  String paperSize = 'Legal';
  double fontSize = 13.5;
  String? stampFileName;
  bool isLoading = false;
  void init() {
    loadFromDraft();
  }
  void loadFromDraft() {
    isLoading = true;
    notifyListeners();
    final draft = BucketStorageHandlerService.getDraft();
    selectedTemplateTitle = draft['selectedTemplateTitle']?.toString() ?? '';
    paperSize = draft['paperSize']?.toString() ?? 'Legal';
    fontSize = (draft['fontSize'] as num?)?.toDouble() ?? 13.5;
    stampFileName = draft['stampFileName']?.toString();
    qrSourceData = draft['qrSourceData']?.toString();
    if (draft.containsKey('selected_templates_bundle') && draft['selected_templates_bundle'] is List) {
      selectedTemplatesBundle = List<String>.from(draft['selected_templates_bundle']);
    } else if (selectedTemplateTitle.isNotEmpty) {
      selectedTemplatesBundle = [selectedTemplateTitle];
    }
    final Set<String> templateRequiredFields = {};
    final templatesBox = HiveBoxManager.getBox(BoxNames.templatesBox);
    for (final title in selectedTemplatesBundle) {
      final raw = templatesBox.get(title);
      if (raw != null && raw is Map) {
        final doc = DocumentTemplateModel.fromMap(Map<String, dynamic>.from(raw));
        for (final f in doc.fields) {
          if (f.trim().isNotEmpty) {
            templateRequiredFields.add(f.trim());
          }
        }
      }
    }
    final Map<String, String> existingValues = {};
    if (draft.containsKey('fieldValues') && draft['fieldValues'] is Map) {
      final Map rawFields = draft['fieldValues'] as Map;
      for (var entry in rawFields.entries) {
        existingValues[entry.key.toString()] = entry.value?.toString() ?? '';
      }
    }
    controllers.clear();
    fields.clear();
    // اگر ٹیمپلیٹس سے فیلڈز مل گئی ہیں تو وہ پہلی ترجیح ہوں گی
    final List<String> allKeys = templateRequiredFields.isNotEmpty
        ? templateRequiredFields.toList()
        : existingValues.keys.toList();
    for (var key in allKeys) {
      fields.add(key);
      final val = existingValues[key] ?? '';
      controllers[key] = TextEditingController(text: val);
    }
    if (draft.containsKey('phone')) {
      phoneController.text = draft['phone'].toString();
    }
    isLoading = false;
    notifyListeners();
  }
  void updateField(String key, String value) {
    if (!controllers.containsKey(key)) {
      controllers[key] = TextEditingController(text: value);
      if (!fields.contains(key)) fields.add(key);
    } else {
      controllers[key]!.text = value;
    }
    persistDraft();
    notifyListeners();
  }
  void removeField(String key) {
    fields.remove(key);
    controllers[key]?.dispose();
    controllers.remove(key);
    persistDraft();
    notifyListeners();
  }
  void clearAllFields() {
    for (var c in controllers.values) {
      c.clear();
    }
    persistDraft();
    notifyListeners();
  }
  Map<String, String> get currentFieldValues {
    final Map<String, String> map = {};
    for (var entry in controllers.entries) {
      map[entry.key] = entry.value.text.trim();
    }
    return map;
  }
  void persistDraft() {
    final payload = BucketPayloadBuilder.buildDraft(
      fieldValues: currentFieldValues,
      templateTitle: selectedTemplateTitle,
      paperSize: paperSize,
      fontSize: fontSize,
      stampFileName: stampFileName,
    );
    if (selectedTemplatesBundle.isNotEmpty) {
      payload['selected_templates_bundle'] = selectedTemplatesBundle;
    }
    if (phoneController.text.trim().isNotEmpty) {
      payload['phone'] = phoneController.text.trim();
    }
    if (qrSourceData != null) {
      payload['qrSourceData'] = qrSourceData;
    }
    BucketStorageHandlerService.saveDraftBatch(payload);
  }
  Future<void> sendQuestionsOnWhatsapp() async {
    final phone = phoneController.text.trim().replaceAll(RegExp(r'[^0-9]'), '');
    if (phone.isEmpty) return;
    final formattedPhone = phone.startsWith('0') ? '92${phone.substring(1)}' : phone;
    final buffer = StringBuffer('السلام علیکم! برائے مہربانی درج ذیل معلومات فراہم کریں:\n\n');
    for (var f in fields) {
      final val = controllers[f]?.text.trim() ?? '';
      buffer.writeln('$f: ${val.isNotEmpty ? val : "______"}');
    }
    final url = Uri.parse('https:
    if (await canLaunchUrl(url)) {
      await launchUrl(url, mode: LaunchMode.externalApplication);
    }
  }
  Future<void> pasteAndParseFromClipboard() async {
    final data = await Clipboard.getData('text/plain');
    if (data == null || data.text == null || data.text!.trim().isEmpty) return;
    final lines = data.text!.split('\n');
    for (var line in lines) {
      if (line.contains(':') || line.contains('-')) {
        final parts = line.split(RegExp(r'[:\-]'));
        if (parts.length >= 2) {
          final k = parts[0].trim();
          final v = parts.sublist(1).join(':').trim();
          if (k.isNotEmpty && v.isNotEmpty && v != "______") {
            updateField(k, v);
          }
        }
      }
    }
    persistDraft();
    notifyListeners();
  }
  @override
  void dispose() {
    phoneController.dispose();
    for (var c in controllers.values) {
      c.dispose();
    }
    super.dispose();
  }
}
</file>

<file path="lib/features/agreement_counter/services/counter_navigation_service.dart">
import 'package:flutter/material.dart';
import '../../../core/constants/box_names.dart';
import '../../../core/database/hive_box_manager.dart';
import '../../../core/models/document_template_model.dart';
import '../../pdf_editor/pdf_editor_page.dart';
import '../../stamp_agreement/stamp_studio_page.dart';
class CounterNavigationService {
  static Future<T?> openStudio<T>(BuildContext context, Widget page) {
    return Navigator.push<T>(
      context,
      MaterialPageRoute(builder: (_) => page),
    );
  }
  static Future<T?> openEditor<T>(BuildContext context, String templateTitle) async {
    bool isOverlay = false;
    try {
      final box = HiveBoxManager.getBox(BoxNames.templatesBox);
      final raw = box.get(templateTitle.trim());
      if (raw is Map) {
        final doc = DocumentTemplateModel.fromMap(Map<String, dynamic>.from(raw));
        if (doc.mode == DocumentMode.formFiller) {
          isOverlay = true;
        }
      }
    } catch (_) {}
    if (isOverlay) {
      return Navigator.push<T>(
        context,
        MaterialPageRoute(
          builder: (_) => PdfEditorPage(initialTitle: templateTitle),
        ),
      );
    } else {
      return Navigator.push<T>(
        context,
        MaterialPageRoute(
          builder: (_) => StampStudioPage(initialTitle: templateTitle),
        ),
      );
    }
  }
  static Future<T?> openPdfEditor<T>(BuildContext context, {String? initialTitle}) {
    return Navigator.push<T>(
      context,
      MaterialPageRoute(
        builder: (_) => PdfEditorPage(initialTitle: initialTitle),
      ),
    );
  }
}
