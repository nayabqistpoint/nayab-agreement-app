<file path="../nayab_shop_pos/lib/core/widgets/portable_image_ui.dart">
import 'dart:convert';
import 'dart:io';
import 'package:flutter/foundation.dart';
import 'package:flutter/material.dart';
import '../constants/app_colors.dart';
import '../services/permanent_image_cache_service.dart';
class PortableImageUi extends StatefulWidget {
  final String? pathOrUrl;
  final BoxFit fit;
  final IconData fallbackIcon;
  final double fallbackIconSize;
  final Color fallbackColor;
  final bool showLoader;
  const PortableImageUi({
    super.key,
    required this.pathOrUrl,
    this.fit = BoxFit.cover,
    this.fallbackIcon = Icons.image_outlined,
    this.fallbackIconSize = 36,
    this.fallbackColor = AppColors.primaryEmerald,
    this.showLoader = false,
  });
  @override
  State<PortableImageUi> createState() => _PortableImageUiState();
}
class _PortableImageUiState extends State<PortableImageUi> {
  File? _cachedLocalFile;
  String? _cachedWebDataUrl;
  @override
  void initState() {
    super.initState();
    _resolveCache();
  }
  @override
  void didUpdateWidget(covariant PortableImageUi oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (oldWidget.pathOrUrl != widget.pathOrUrl) {
      _cachedLocalFile = null;
      _cachedWebDataUrl = null;
      _resolveCache();
    }
  }
  void _resolveCache() {
    final clean = widget.pathOrUrl?.trim() ?? '';
    if (!clean.startsWith('http:
    if (kIsWeb) {
      final syncWeb = PermanentImageCacheService.getCachedWebDataUrlSync(clean);
      if (syncWeb != null) {
        _cachedWebDataUrl = syncWeb;
        return;
      }
      PermanentImageCacheService.downloadAndCache(clean).then((ok) {
        if (ok && mounted) {
          setState(() {
            _cachedWebDataUrl =
                PermanentImageCacheService.getCachedWebDataUrlSync(clean);
          });
        }
      });
    } else {
      final syncFile = PermanentImageCacheService.getCachedFileSync(clean);
      if (syncFile != null) {
        _cachedLocalFile = syncFile;
        return;
      }
      PermanentImageCacheService.downloadAndCache(clean).then((ok) {
        if (ok && mounted) {
          setState(() {
            _cachedLocalFile =
                PermanentImageCacheService.getCachedFileSync(clean);
          });
        }
      });
    }
  }
  Widget _fallback() {
    return Center(
      child: Icon(
        widget.fallbackIcon,
        size: widget.fallbackIconSize,
        color: widget.fallbackColor,
      ),
    );
  }
  Widget _renderBase64(String dataUrl) {
    try {
      final commaIdx = dataUrl.indexOf(',');
      if (commaIdx == -1) return _fallback();
      final bytes = base64Decode(dataUrl.substring(commaIdx + 1));
      return Image.memory(
        bytes,
        fit: widget.fit,
        errorBuilder: (_, _, _) => _fallback(),
      );
    } catch (_) {
      return _fallback();
    }
  }
  @override
  Widget build(BuildContext context) {
    final clean = widget.pathOrUrl?.trim() ?? '';
    if (clean.isEmpty || clean == 'null') {
      return _fallback();
    }
    if (clean.startsWith('data:image')) {
      return _renderBase64(clean);
    }
    if (kIsWeb && _cachedWebDataUrl != null) {
      return _renderBase64(_cachedWebDataUrl!);
    }
    if (!kIsWeb && _cachedLocalFile != null && _cachedLocalFile!.existsSync()) {
      return Image.file(
        _cachedLocalFile!,
        fit: widget.fit,
        errorBuilder: (_, _, _) => _fallback(),
      );
    }
    if (clean.startsWith('http://') || clean.startsWith('https://')) {
      return Image.network(
        clean,
        fit: widget.fit,
        loadingBuilder: widget.showLoader
            ? (ctx, child, progress) {
                if (progress == null) return child;
                return const Center(
                  child: SizedBox(
                    width: 22,
                    height: 22,
                    child: CircularProgressIndicator(
                      strokeWidth: 2,
                      color: AppColors.primaryEmerald,
                    ),
                  ),
                );
              }
            : null,
        errorBuilder: (_, _, _) => _fallback(),
      );
    }
    if (!kIsWeb) {
      final file = File(clean);
      if (file.existsSync()) {
        return Image.file(
          file,
          fit: widget.fit,
          errorBuilder: (_, _, _) => _fallback(),
        );
      }
    }
    return _fallback();
  }
}
</file>

