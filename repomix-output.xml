import '../../../core/constants/app_colors.dart';
import '../../../core/constants/box_names.dart';
import '../../../core/database/hive_box_manager.dart';
import '../../device_plan_detail/services/calculator_config_service.dart';
import '../../device_plan_detail/services/plan_math_service.dart';
class PurchaseMarketCalculationService {
  static int getTotalPlansCount() {
    final config = CalculatorConfigService().getConfig();
    return config.allowedDurations.length * 4;
  }
  static int calculateRoundedMinAdvance(
    int price, {
    String zoneType = 'CUSTOM_ESTIMATE',
  }) {
    if (price <= 0) return 0;
    final config = CalculatorConfigService().getConfig();
    final durations = config.durationsForZone(zoneType);
    final int baseDur = durations.isNotEmpty ? durations.first : 6;
    final int principal = PlanMathService.calculatePrincipal(
      baseValue: price,
      config: config,
      zoneType: zoneType,
    );
    final int total = PlanMathService.calculateTotalContractPrice(
      principal: principal,
      months: baseDur,
      isCheque: true,
      config: config,
      zoneType: zoneType,
    );
    return PlanMathService.calculateMinAdvance(
      totalContractPrice: total,
      months: baseDur,
      config: config,
      zoneType: zoneType,
    );
  }
  static String _extractShortNumber(String stockId) {
    final match = RegExp(r'(\d+)').firstMatch(stockId);
    if (match != null) {
      final numVal = int.tryParse(match.group(1) ?? '');
      if (numVal != null) return '$numVal';
    }
    return stockId.trim();
  }
  static String formatHashBadgeFromIds(List<String> stockIds) {
    final cleanIds =
        stockIds.map((e) => e.trim()).where((e) => e.isNotEmpty).toList();
    if (cleanIds.isEmpty) return '';
    if (cleanIds.length == 1) {
      final numStr = _extractShortNumber(cleanIds.first);
      return numStr.isNotEmpty ? '#$numStr' : '';
    }
    final firstNum = _extractShortNumber(cleanIds.first);
    final lastNum = _extractShortNumber(cleanIds.last);
    if (firstNum.isNotEmpty && lastNum.isNotEmpty) {
      return firstNum == lastNum ? '#$firstNum' : '#$firstNum-$lastNum';
    }
    return '';
  }
  static String _cleanModelName(String rawName, String ramRom) {
    String cleaned = rawName.trim();
    if (cleaned.isEmpty) return '';
    cleaned = cleaned.replaceAll(
      RegExp(
        r'\s*\(\s*\d+\s*GB\s*[/\-+|,]?\s*\d+\s*GB\s*\)\s*$',
        caseSensitive: false,
      ),
      '',
    );
    if (ramRom.trim().isNotEmpty) {
      final escaped = RegExp.escape(ramRom.trim());
      cleaned = cleaned.replaceAll(
        RegExp('\\s*\\(\\s*$escaped\\s*\\)\\s*\$', caseSensitive: false),
        '',
      );
    }
    return cleaned.trim();
  }
  static String _formatOrderSummaryFromMap(Map orderMap) {
    final int months = (orderMap['totalMonths'] as num?)?.toInt() ?? 0;
    final int adv = (orderMap['advance'] as num?)?.toInt() ?? 0;
    final int monthly = (orderMap['monthlyAmount'] as num?)?.toInt() ?? 0;
    final String gType =
        (orderMap['guaranteeType']?.toString() ?? '') == 'BANK_CHEQUE'
            ? 'بینک چیک'
            : 'اشٹام پرنوٹ';
    final String advText = adv > 0 ? 'ایڈوانس: Rs. $adv' : '⭐ بغیر ایڈوانس';
    if (months > 0 && monthly > 0) {
      return '$months ماہ • $advText • قسط: Rs. $monthly/ماہ ($gType)';
    }
    return '';
  }
  static String _resolveOrderPlanSummary(
    Map rawStock, {
    required bool isSold,
    required String stockId,
  }) {
    final directKey = isSold ? 'soldPlanSummary' : 'reservedPlanSummary';
    final directSummary = rawStock[directKey]?.toString().trim() ?? '';
    if (directSummary.isNotEmpty && directSummary != 'null') {
      return directSummary;
    }
    try {
      final ordersBox = HiveBoxManager.getBox(BoxNames.shopOrdersBox);
      final orderId = rawStock['reservedOrderId']?.toString().trim() ?? '';
      if (orderId.isNotEmpty && orderId != 'null') {
        final rawOrder = ordersBox.get(orderId);
        if (rawOrder is Map) {
          final formatted = _formatOrderSummaryFromMap(rawOrder);
          if (formatted.isNotEmpty) return formatted;
        }
      }
      final soldCnic = rawStock['soldToCnic']?.toString().trim() ?? '';
      for (final k in ordersBox.keys) {
        final rawOrder = ordersBox.get(k);
        if (rawOrder is Map && rawOrder['isDeleted'] != true) {
          final oStockId = rawOrder['stockId']?.toString().trim() ?? '';
          final oCnic = rawOrder['customerCnic']?.toString().trim() ?? '';
          if ((stockId.isNotEmpty && oStockId == stockId) ||
              (soldCnic.isNotEmpty && oCnic == soldCnic)) {
            final formatted = _formatOrderSummaryFromMap(rawOrder);
            if (formatted.isNotEmpty) return formatted;
          }
        }
      }
    } catch (_) {}
    return '';
  }
  static List<String> _extractDynamicSpecs(Map rawStock, bool isGeneral) {
    final List<String> specs = [];
    try {
      final cfgBox = HiveBoxManager.getBox(BoxNames.appConfigBox);
      final rawCfg = cfgBox.get('calculator_config');
      if (rawCfg is Map) {
        final keyName = isGeneral ? 'generalCustomFields' : 'mobileCustomFields';
        final rawList = rawCfg[keyName];
        if (rawList is List) {
          for (final item in rawList) {
            if (item is Map) {
              final k = item['key']?.toString().trim() ?? '';
              final label = item['urduLabel']?.toString().trim() ?? '';
              final val = rawStock[k]?.toString().trim() ?? '';
              if (k.isNotEmpty &&
                  label.isNotEmpty &&
                  val.isNotEmpty &&
                  val != 'null') {
                specs.add('$label: $val');
              }
            }
          }
        }
      }
    } catch (_) {}
    return specs;
  }
  static String _resolveImeiOrSerial(DataMap dev, Map rawStock) {
    final candidates = [
      rawStock['imeiNo'],
      rawStock['imei'],
      dev['imeiNo'],
      rawStock['serialNo'],
      rawStock['serial'],
      dev['serialNo'],
    ];
    for (final c in candidates) {
      final s = (c?.toString() ?? '').trim();
      if (s.isNotEmpty && s.toLowerCase() != 'null') {
        return s.toLowerCase();
      }
    }
    return 'stk_${dev['stockId'].toString().trim().toLowerCase()}';
  }
  static String _buildDynamicGroupKey(
    DataMap dev,
    Map rawStock,
    List<String> groupingMatchKeys,
  ) {
    final List<String> parts = [
      dev['productCategory'].toString().trim().toUpperCase(),
    ];
    for (final ruleKey in groupingMatchKeys) {
      if (ruleKey == 'images') {
        final imgs = (dev['images'] as List?)
                ?.map((e) => e.toString().trim())
                .where((e) => e.isNotEmpty && e != 'null')
                .toList() ??
            const <String>[];
        parts.add('imgs:${imgs.join(",")}');
      } else if (ruleKey == 'itemName') {
        parts.add('name:${dev['name'].toString().trim().toLowerCase()}');
      } else if (ruleKey == 'imeiNo' ||
          ruleKey == 'imei' ||
          ruleKey == 'serialNo' ||
          ruleKey == 'serial' ||
          ruleKey == 'imeiOrSerial') {
        parts.add('code:${_resolveImeiOrSerial(dev, rawStock)}');
      } else if (ruleKey == 'purchasePrice') {
        final pPrice = (rawStock['purchasePrice']?.toString() ?? '0').trim();
        parts.add('pPrice:$pPrice');
      } else if (ruleKey == 'salePrice') {
        parts.add('sPrice:${dev['baseValue']}');
      } else if (ruleKey == 'supplier') {
        final sup =
            (rawStock['supplierInfo']?.toString() ?? '').trim().toLowerCase();
        parts.add('sup:$sup');
      } else if (ruleKey == 'specs') {
        parts.add('specs:${dev['ramRom'].toString().trim().toLowerCase()}');
      } else if (ruleKey == 'color') {
        parts.add('color:${dev['color'].toString().trim().toLowerCase()}');
      } else if (ruleKey == 'condition') {
        parts.add('cond:${dev['condition'].toString().trim().toLowerCase()}');
      } else if (ruleKey == 'warranty') {
        parts.add('war:${dev['warranty'].toString().trim().toLowerCase()}');
      } else {
        final dynVal =
            (rawStock[ruleKey]?.toString() ?? '').trim().toLowerCase();
        parts.add('$ruleKey:$dynVal');
      }
    }
    return parts.join('|');
  }
  static List<DataMap> parseStockDevices(List<dynamic> rawStockEntries) {
    try {
      final config = CalculatorConfigService().getConfig();
      final List<DataMap> individualDevices = [];
      final Map<String, Map> rawStockById = {};
      for (final entry in rawStockEntries) {
        if (entry is! Map) continue;
        final raw = entry['data'];
        final key = entry['key'];
        if (raw is! Map) continue;
        if (raw['isDeleted'] == true) continue;
        final String statusUpper =
            (raw['status']?.toString() ?? 'AVAILABLE').trim().toUpperCase();
        if (statusUpper == 'DELETED') continue;
        if (statusUpper == 'RESERVED' && !config.showReservedItems) continue;
        if (statusUpper == 'SOLD' && !config.showSoldItems) continue;
        if (statusUpper == 'ON_ORDER' && !config.showOnOrderItems) continue;
        final String productCategory =
            (raw['productCategory']?.toString() ?? 'MOBILE').toUpperCase();
        final bool isGeneral = productCategory == 'ELECTRONICS';
        if (isGeneral && !config.generalEnabled) continue;
        final String zoneType = isGeneral ? 'ELECTRONICS' : 'MOBILE';
        final bool isReserved = statusUpper == 'RESERVED';
        final bool isSold = statusUpper == 'SOLD';
        final bool isOnOrder = statusUpper == 'ON_ORDER';
        final String stockId =
            raw['stockId']?.toString() ?? raw['id']?.toString() ?? key.toString();
        rawStockById[stockId] = raw;
        final String reservedCustomerInfo =
            raw['reservedCustomerInfo']?.toString().trim() ?? '';
        final String soldToName = raw['soldToName']?.toString().trim() ?? '';
        final String reservedPlanSummary = isReserved
            ? _resolveOrderPlanSummary(raw, isSold: false, stockId: stockId)
            : '';
        final String soldPlanSummary = isSold
            ? _resolveOrderPlanSummary(raw, isSold: true, stockId: stockId)
            : '';
        final int baseValue = (raw['salePrice'] as num?)?.toInt() ?? 0;
        final String specsOrRam =
            (raw['specsSummary']?.toString().trim().isNotEmpty == true)
                ? raw['specsSummary'].toString().trim()
                : (raw['ramRom']?.toString().trim() ?? '');
        final String cleanedName = _cleanModelName(
          raw['itemName']?.toString() ?? '',
          specsOrRam,
        );
        final String conditionType =
            raw['conditionType']?.toString().toUpperCase() ?? '';
        final String conditionRating =
            raw['conditionRating']?.toString() ?? '';
        String conditionText = '';
        if (conditionType == 'NEW') {
          conditionText = isGeneral ? 'نیا (Brand New)' : 'ڈبہ پیک (نیا)';
        } else if (conditionType == 'USED') {
          conditionText = conditionRating.isNotEmpty
              ? 'استعمال شدہ ($conditionRating)'
              : 'استعمال شدہ';
        } else if (raw['condition'] != null &&
            raw['condition'].toString().isNotEmpty) {
          conditionText = raw['condition'].toString();
        }
        final int warrantyMonths = (raw['warranty'] as num?)?.toInt() ?? 0;
        final String warrantyText = warrantyMonths > 0
            ? '$warrantyMonths ماہ آفیشل وارنٹی'
            : 'بغیر وارنٹی';
        List<String> imagesList = [];
        if (raw['images'] is List) {
          imagesList = (raw['images'] as List)
              .map((e) => e.toString().trim())
              .where((e) => e.isNotEmpty && e != 'null')
              .toList();
        } else if (raw['images'] is String &&
            (raw['images'] as String).trim().isNotEmpty) {
          imagesList = [(raw['images'] as String).trim()];
        }
        final List<String> dynamicSpecs = _extractDynamicSpecs(raw, isGeneral);
        final int principal = PlanMathService.calculatePrincipal(
          baseValue: baseValue,
          config: config,
          zoneType: zoneType,
        );
        final durationsList = config.durationsForZone(zoneType);
        final int baseDuration =
            durationsList.isNotEmpty ? durationsList.first : 6;
        final int chequeTotal = PlanMathService.calculateTotalContractPrice(
          principal: principal,
          months: baseDuration,
          isCheque: true,
          config: config,
          zoneType: zoneType,
        );
        final int minAdv = PlanMathService.calculateMinAdvance(
          totalContractPrice: chequeTotal,
          months: baseDuration,
          config: config,
          zoneType: zoneType,
        );
        final int zeroAdvMonthly = PlanMathService.calculateMonthlyEmi(
          totalContractPrice: chequeTotal,
          advancePaid: 0,
          months: baseDuration,
          config: config,
          zoneType: zoneType,
        );
        final int minMonthlyWithAdv = PlanMathService.calculateMonthlyEmi(
          totalContractPrice: chequeTotal,
          advancePaid: minAdv,
          months: baseDuration,
          config: config,
          zoneType: zoneType,
        );
        String statusLabel = '1 دستیاب';
        if (isReserved) {
          statusLabel = 'بُک شدہ';
        } else if (isSold) {
          statusLabel = 'فروخت شدہ';
        } else if (isOnOrder) {
          statusLabel = 'آرڈر پر دستیاب';
        }
        individualDevices.add({
          'id': stockId,
          'stockId': stockId,
          'stockHashBadge': formatHashBadgeFromIds([stockId]),
          'productCategory': productCategory,
          'zoneType': zoneType,
          'isGeneral': isGeneral,
          'name': cleanedName,
          'baseValue': baseValue,
          'ramRom': specsOrRam,
          'condition': conditionText,
          'statusCode': statusUpper,
          'status': statusLabel,
          'isReserved': isReserved,
          'isSold': isSold,
          'isOnOrder': isOnOrder,
          'reservedCustomerInfo': reservedCustomerInfo,
          'reservedPlanSummary': reservedPlanSummary,
          'soldToName': soldToName,
          'soldPlanSummary': soldPlanSummary,
          'warranty': warrantyText,
          'color': raw['color']?.toString() ?? '',
          'imeiNo': (raw['imeiNo'] ?? raw['imei'] ?? '').toString(),
          'serialNo': (raw['serialNo'] ?? raw['serial'] ?? '').toString(),
          'dynamicSpecs': dynamicSpecs,
          'baseDuration': baseDuration,
          'itemPlansCount': durationsList.length * 4,
          'minAdvance': minAdv,
          'zeroAdvMonthly': zeroAdvMonthly,
          'minMonthlyWithAdv': minMonthlyWithAdv,
          'images': imagesList,
          'isCustomEstimate': false,
          'availableQty': 1,
          'availableStockIds': [stockId],
        });
      }
      individualDevices.sort((a, b) {
        final idA = a['stockId']?.toString() ?? '';
        final idB = b['stockId']?.toString() ?? '';
        return idA.compareTo(idB);
      });
      final Map<String, DataMap> groupedAvailable = {};
      final List<DataMap> result = [];
      for (final dev in individualDevices) {
        final code = dev['statusCode']?.toString() ?? 'AVAILABLE';
        if (code == 'AVAILABLE') {
          final stkId = dev['stockId'].toString();
          final rawStock = rawStockById[stkId] ?? const {};
          final activeKeys = dev['isGeneral'] == true
              ? config.generalGroupingMatchKeys
              : config.mobileGroupingMatchKeys;
          final groupKey = _buildDynamicGroupKey(
            dev,
            rawStock,
            activeKeys,
          );
          if (!groupedAvailable.containsKey(groupKey)) {
            groupedAvailable[groupKey] = {
              ...dev,
              'availableQty': 1,
              'availableStockIds': [stkId],
              'stockHashBadge': formatHashBadgeFromIds([stkId]),
              'status': '1 دستیاب',
              'images': List<String>.from(dev['images'] as List? ?? const []),
            };
          } else {
            final existing = groupedAvailable[groupKey]!;
            final nextQty = ((existing['availableQty'] as int?) ?? 1) + 1;
            final ids = List<String>.from(
                existing['availableStockIds'] as List? ?? [])
              ..add(stkId);
            existing['availableQty'] = nextQty;
            existing['availableStockIds'] = ids;
            existing['stockHashBadge'] = formatHashBadgeFromIds(ids);
            existing['status'] = '$nextQty دستیاب';
            final mergedImages = List<String>.from(
                existing['images'] as List? ?? const []);
            final nextUnitImages =
                (dev['images'] as List?)?.map((e) => e.toString().trim()) ??
                    const <String>[];
            for (final imgUrl in nextUnitImages) {
              if (imgUrl.isNotEmpty &&
                  imgUrl != 'null' &&
                  !mergedImages.contains(imgUrl) &&
                  mergedImages.length < 15) {
                mergedImages.add(imgUrl);
              }
            }
            existing['images'] = mergedImages;
          }
        } else {
          result.add(dev);
        }
      }
      result.addAll(groupedAvailable.values);
      int statusWeight(String code) {
        if (code == 'AVAILABLE') return 0;
        if (code == 'ON_ORDER') return 1;
        if (code == 'RESERVED') return 2;
        return 3;
      }
      result.sort((a, b) {
        final wA = statusWeight(a['statusCode']?.toString() ?? 'AVAILABLE');
        final wB = statusWeight(b['statusCode']?.toString() ?? 'AVAILABLE');
        if (wA != wB) return wA.compareTo(wB);
        final idA = a['stockId']?.toString() ?? '';
        final idB = b['stockId']?.toString() ?? '';
        return idA.compareTo(idB);
      });
      return result;
    } catch (_) {
      return const [];
    }
  }
  static DataMap buildCustomEstimateDevice({
    required String name,
    required int price,
    required int adv,
    String zoneType = 'CUSTOM_ESTIMATE',
    String productCategory = 'MOBILE',
  }) {
    final int dynamicMinAdv = calculateRoundedMinAdvance(
      price,
      zoneType: zoneType,
    );
    final int finalUserAdv =
        adv == 0 ? 0 : (adv < dynamicMinAdv ? dynamicMinAdv : adv);
    final effectiveCat =
        zoneType == 'ELECTRONICS' ? 'ELECTRONICS' : productCategory;
    return {
      'name': name.trim().isEmpty ? 'کسٹم آئٹم تخمینہ' : name.trim(),
      'baseValue': price,
      'ramRom': 'کسٹمر ڈیمانڈ',
      'condition': 'نئی یا طلب کے مطابق',
      'warranty': '12 ماہ وارنٹی',
      'minAdvanceRequired': dynamicMinAdv,
      'userCustomAdvance': finalUserAdv,
      'isCustomEstimate': true,
      'zoneType': zoneType,
      'productCategory': effectiveCat,
      'isGeneral': effectiveCat == 'ELECTRONICS',
      'images': <String>[],
    };
  }
}
