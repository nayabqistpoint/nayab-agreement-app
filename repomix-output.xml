import 'package:flutter/material.dart';
import '../../../core/constants/app_colors.dart';
import '../../../core/constants/box_names.dart';
import '../../../core/database/hive_box_manager.dart';
import '../../../core/time/time_status_service.dart';
import '../order_receipt/args/order_receipt_args.dart';
import '../order_receipt/order_receipt_page.dart';
import 'models/calculator_config_model.dart';
import 'services/device_plan_detail_storage_handler_service.dart';
import 'services/plan_filter_sort_service.dart';
import 'services/plan_generator_service.dart';
import 'services/plan_math_service.dart';
import 'services/plan_schedule_service.dart';
import 'services/stock_live_status_service.dart';
class DevicePlanDetailController extends ChangeNotifier {
  int selectedDuration = 0;
  String selectedGuaranteeFilter = 'ALL';
  String selectedAdvanceFilter = 'ALL';
  int userCustomAdvance = 0;
  String activeSort = 'DEFAULT';
  int selectedQuantity = 1;
  bool isCashSaleMode = false;
  final TextEditingController customAdvanceCtrl = TextEditingController();
  CalculatorConfigModel get config =>
      DevicePlanDetailStorageHandlerService.getCalculatorConfig();
  void init(int initialAdvance) {
    userCustomAdvance = initialAdvance;
    customAdvanceCtrl.text = initialAdvance > 0 ? initialAdvance.toString() : '';
  }
  void setQuantity(int qty, int maxAvailable) {
    final safeMax = maxAvailable > 0 ? maxAvailable : 1;
    final clamped = qty.clamp(1, safeMax);
    if (selectedQuantity != clamped) {
      selectedQuantity = clamped;
      notifyListeners();
    }
  }
  void setCashSaleMode(bool isCash) {
    isCashSaleMode = isCash;
    notifyListeners();
  }
  void setGuaranteeFilter(String filter) {
    selectedGuaranteeFilter = filter;
    notifyListeners();
  }
  void setAdvanceFilter(String filter) {
    selectedAdvanceFilter = filter;
    notifyListeners();
  }
  void setDuration(int duration) {
    selectedDuration = duration;
    notifyListeners();
  }
  void updateCustomAdvance(int amount) {
    userCustomAdvance = amount;
    notifyListeners();
  }
  void setSort(String sortKey) {
    activeSort = sortKey;
    notifyListeners();
  }
  int getDynamicMinAdvance(int baseValue, {String zoneType = 'MOBILE'}) {
    final currentConfig = config;
    final int principal = PlanMathService.calculatePrincipal(
      baseValue: baseValue,
      config: currentConfig,
      zoneType: zoneType,
    );
    final durations = currentConfig.durationsForZone(zoneType);
    final int minDuration = durations.isNotEmpty ? durations.first : 6;
    final int total = PlanMathService.calculateTotalContractPrice(
      principal: principal,
      months: minDuration,
      isCheque: true,
      config: currentConfig,
      zoneType: zoneType,
    );
    return PlanMathService.calculateMinAdvance(
      totalContractPrice: total,
      months: minDuration,
      config: currentConfig,
      zoneType: zoneType,
    );
  }
  List<DataMap> getAllRawPlans(int totalBaseValue, {String zoneType = 'MOBILE'}) {
    return PlanGeneratorService.generateAllPlans(
      baseValue: totalBaseValue,
      userCustomAdvance: userCustomAdvance,
      config: config,
      zoneType: zoneType,
    );
  }
  List<DataMap> getFilteredPlans(List<DataMap> allPlans) {
    return PlanFilterSortService.filterAndSort(
      allPlans: allPlans,
      guaranteeFilter: selectedGuaranteeFilter,
      advanceFilter: selectedAdvanceFilter,
      durationFilter: selectedDuration,
      sortKey: activeSort,
    );
  }
  Future<bool> completeDirectCashSale({
    required StockUnitList allocatedUnits,
    required int unitCashPrice,
    required String customerName,
    required String customerPhone,
  }) async {
    if (allocatedUnits.isEmpty) return false;
    try {
      final stockBox = HiveBoxManager.getBox(BoxNames.stockBox);
      final now = TimeStatusService.nowUtcIso();
      final DataMap updates = {};
      final buyerLabel = customerName.isNotEmpty
          ? (customerPhone.isNotEmpty
              ? '$customerName ($customerPhone) - نقد'
              : '$customerName - نقد')
          : 'نقد کسٹمر (Cash Sale)';
      for (final unit in allocatedUnits) {
        final sid = unit['stockId']?.toString().trim() ??
            unit['id']?.toString().trim() ??
            '';
        if (sid.isEmpty) continue;
        final raw = stockBox.get(sid);
        if (raw is Map) {
          final stMap = DataMap.from(raw);
          if ((stMap['status']?.toString() ?? '').toUpperCase() != 'ON_ORDER' &&
              stMap['isOnOrder'] != true) {
            stMap['status'] = 'SOLD';
          }
          stMap['soldToName'] = buyerLabel;
          stMap['soldPlanSummary'] =
              '💵 نقد فروخت (Cash): Rs. $unitCashPrice';
          stMap['cashSalePrice'] = unitCashPrice;
          stMap['updatedAt'] = now;
          stMap['isSynced'] = false;
          updates[sid] = stMap;
        }
      }
      if (updates.isNotEmpty) {
        await HiveBoxManager.putBatch(
          boxName: BoxNames.stockBox,
          entries: updates,
        );
      }
      return true;
    } catch (_) {
      return false;
    }
  }
  void openOrderReceiptPage({
    required BuildContext context,
    required DataMap plan,
    required DataMap device,
    required StockUnitList allocatedUnits,
    required String? customerPhone,
  }) {
    final schedule = PlanScheduleService.generateSchedule(
      totalMonths: plan['months'],
      monthlyAmount: plan['monthly'],
      advancePaid: plan['advance'],
      config: config,
    );
    final int qty = allocatedUnits.isNotEmpty
        ? allocatedUnits.length
        : selectedQuantity;
    final int unitBaseVal = (device['baseValue'] as num?)?.toInt() ?? 0;
    final int totalBaseVal = unitBaseVal * qty;
    final List<String> stockIds = allocatedUnits
        .map((u) => (u['stockId']?.toString() ?? u['id']?.toString() ?? '').trim())
        .where((id) => id.isNotEmpty)
        .toList();
    final List<String> imeis = allocatedUnits
        .map((u) => (u['imeiNo']?.toString() ?? '').trim())
        .where((im) => im.isNotEmpty && im != 'null')
        .toList();
    final List<String> serials = allocatedUnits
        .map((u) => (u['serialNo']?.toString() ?? '').trim())
        .where((sr) => sr.isNotEmpty && sr != 'null')
        .toList();
    final String primaryStockId = stockIds.isNotEmpty
        ? stockIds.first
        : (device['stockId']?.toString() ?? device['id']?.toString() ?? '');
    final String joinedImeis = imeis.join(', ');
    final String joinedSerials = serials.join(', ');
    final String condStr = device['condition']?.toString() ?? '';
    final bool isCustomEst = device['isCustomEstimate'] == true;
    final String zoneType = device['zoneType']?.toString() ??
        ((device['isGeneral'] == true ||
                (device['productCategory']?.toString() ?? '') == 'ELECTRONICS')
            ? 'ELECTRONICS'
            : (isCustomEst ? 'CUSTOM_ESTIMATE' : 'MOBILE'));
    final String productCategory =
        (device['productCategory']?.toString() ?? '').toUpperCase().isNotEmpty
            ? device['productCategory'].toString().toUpperCase()
            : (zoneType == 'ELECTRONICS' ? 'ELECTRONICS' : 'MOBILE');
    final bool isGeneral = productCategory == 'ELECTRONICS';
    final bool isNewBox = !isGeneral && !condStr.contains('استعمال شدہ');
    final String rawName = device['name']?.toString() ?? 'آئٹم';
    final String displayItemName = qty > 1 ? '$rawName (×$qty پیس)' : rawName;
    final args = OrderReceiptArgs(
      plan: {
        ...plan,
        'baseValue': totalBaseVal,
        'unitBaseValue': unitBaseVal,
        'quantity': qty,
        'stockIds': stockIds,
        'imeisList': imeis,
        'serialsList': serials,
        'isGeneral': isGeneral,
        'isCustomEstimate': isCustomEst,
        'zoneType': zoneType,
        'productCategory': productCategory,
      },
      deviceName: displayItemName,
      customerPhone: customerPhone,
      installmentSchedule: schedule,
      sourceMode: isCustomEst
          ? 'CUSTOM_ESTIMATE'
          : (device['isOnOrder'] == true ? 'ON_ORDER' : 'STOCK'),
      stockId: primaryStockId,
      imeiNo: joinedImeis,
      serialNo: joinedSerials,
      baseValue: totalBaseVal,
      isBoxPackNew: isNewBox,
    );
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (_) => OrderReceiptPage(args: args),
      ),
    );
  }
  @override
  void dispose() {
    customAdvanceCtrl.dispose();
    super.dispose();
  }
}
