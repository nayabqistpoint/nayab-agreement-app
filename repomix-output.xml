import 'device_plan_detail_controller.dart';
class DevicePlanDetailPage extends StatefulWidget {
  final DevicePlanDetailArgs? args;
  const DevicePlanDetailPage({super.key, this.args});
  @override
  State<DevicePlanDetailPage> createState() => _DevicePlanDetailPageState();
}
class _DevicePlanDetailPageState extends State<DevicePlanDetailPage> {
  late final DevicePlanDetailController _controller;
  DataMap _device = const {};
  String? _customerPhone;
  @override
  void initState() {
    super.initState();
    _controller = DevicePlanDetailController();
    if (widget.args != null) {
      _device = widget.args!.device;
      _customerPhone = widget.args!.customerPhone;
      _controller.init((_device['userCustomAdvance'] as num?)?.toInt() ??
          (_device['minAdvanceRequired'] as num?)?.toInt() ??
          (_device['minAdvance'] as num?)?.toInt() ??
          0);
    }
  }
  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }
  String _resolveZone() {
    if (_device['zoneType']?.toString().trim().isNotEmpty == true) {
      return _device['zoneType'].toString().trim().toUpperCase();
    }
    if (_device['isGeneral'] == true ||
        (_device['productCategory']?.toString() ?? '') == 'ELECTRONICS') {
      return 'ELECTRONICS';
    }
    return _device['isCustomEstimate'] == true ? 'CUSTOM_ESTIMATE' : 'MOBILE';
  }
  @override
  Widget build(BuildContext context) {
    final isCustom = _device['isCustomEstimate'] == true;
    final isMultiCart = _device['isMultiCart'] == true;
    final zone = _resolveZone();
    return Directionality(
      textDirection: TextDirection.rtl,
      child: ValueListenableBuilder(
        valueListenable: HiveBoxManager.listenToBox(BoxNames.appConfigBox),
        builder: (_, _, _) => ValueListenableBuilder(
          valueListenable: HiveBoxManager.listenToBox(BoxNames.stockBox),
          builder: (_, _, _) => AnimatedBuilder(
            animation: _controller,
            builder: (context, _) {
              final st = _controller.resolveState(_device, zone);
              final allowed = _controller.config.durationsForZone(zone);
              if (_controller.selectedDuration != 0 &&
                  !allowed.contains(_controller.selectedDuration)) {
                _controller.selectedDuration = 0;
              }
              final rawPlans =
                  _controller.getAllRawPlans(st.totalBaseValue, zoneType: zone);
              final plans = _controller.getFilteredPlans(rawPlans);
              final minAdv = _controller.getDynamicMinAdvance(st.totalBaseValue,
                  zoneType: zone);
              final canShowCash = _controller.config.cashSaleEnabled &&
                  st.isTrulyAvailableInShop;
              final totalQty = isMultiCart
                  ? st.allocatedUnits.length
                  : _controller.selectedQuantity;
              return Scaffold(
                backgroundColor: AppColors.backgroundLight,
                appBar: ShopBrandedAppBarUi(
                  title: _device['name'] ?? 'اقساطی پلان',
                  subtitle:
                      '${_controller.config.shopName} • ${rawPlans.length} سمارٹ اقساطی پیکجز',
                ),
                body: SingleChildScrollView(
                  physics: const BouncingScrollPhysics(),
                  padding: const EdgeInsets.fromLTRB(5, 8, 5, 16),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.stretch,
                    children: [
                      if (st.isStockLocked && st.liveLockMessage != null)
                        Container(
                          margin: const EdgeInsets.only(bottom: 8),
                          padding: const EdgeInsets.all(10),
                          decoration: BoxDecoration(
                            color: AppColors.reservedCardBg,
                            borderRadius: BorderRadius.circular(10),
                            border:
                                Border.all(color: AppColors.reservedCardBorder),
                          ),
                          child: Text(st.liveLockMessage!,
                              style: const TextStyle(
                                  fontSize: 13.5,
                                  fontWeight: FontWeight.w900,
                                  color: AppColors.reservedAccent)),
                        ),
                      if (!isCustom)
                        StockDeviceHeroCardUi(
                            device: st.activeDevice,
                            images: st.heroImages,
                            imageLabels: st.heroImageLabels)
                      else
                        CustomEstimateHeroCardUi(
                          title: _device['name'] ?? 'اپنی مرضی کی قیمت کا تخمینہ',
                          baseValue: st.totalBaseValue,
                          displayedAdvance: _controller.userCustomAdvance > 0
                              ? _controller.userCustomAdvance
                              : minAdv,
                        ),
                      if (isMultiCart) ...[
                        const SizedBox(height: 8),
                        MultiCartBundleCardUi(
                          items: st.multiCartRows,
                          allocatedIds: st.allocatedIds,
                          onQuantityChanged: (idx, newQ) =>
                              _controller.updateBundleItemQuantity(
                                  idx, newQ, st.multiCartRows, zone),
                        ),
                      ],
                      QuantityAndCashToggleUi(
                        showQuantityStepper: !isMultiCart &&
                            (isCustom || st.maxAvailableQty > 1),
                        isCustomEstimate: isCustom,
                        selectedQuantity: _controller.selectedQuantity,
                        maxAvailableQty: st.maxAvailableQty,
                        allocatedIds: st.allocatedIds,
                        onQuantityChanged: (q) => _controller.setQuantity(
                            q, st.maxAvailableQty,
                            unitBaseValue: st.unitBaseValue, zoneType: zone),
                        showCashToggle: canShowCash,
                        isCashSaleMode: _controller.isCashSaleMode,
                        onCashSaleChanged: _controller.setCashSaleMode,
                      ),
                      const SizedBox(height: 9),
                      if (_controller.isCashSaleMode && canShowCash)
                        DirectCashSaleCardUi(
                          lineItems: st.cashSaleLines,
                          allowPriceEdit: _controller.config.allowCashPriceEdit,
                          sellerLabel:
                              DeviceLicenseService.getCurrentSellerLabel(),
                          isLocked: st.isStockLocked,
                          onCompleteCashSale: ({
                            required pricedLines,
                            required totalCashPrice,
                            required customerName,
                            required customerPhone,
                          }) =>
                              _controller.handleCashSaleSubmit(
                            context: context,
                            pricedLines: pricedLines,
                            totalCashPrice: totalCashPrice,
                            customerName: customerName,
                            customerPhone: customerPhone,
                            totalQty: totalQty,
                          ),
                        )
                      else
                        PlansScheduleSectionUi(
                          controller: _controller,
                          zoneType: zone,
                          rawPlans: rawPlans,
                          filteredPlans: plans,
                          calculatedMinAdv: minAdv,
                          isStockLocked: st.isStockLocked,
                          lockButtonLabel: st.lockButtonLabel,
                          onPlanSelected: (p) => _controller.openOrderReceiptPage(
                            context: context,
                            plan: p,
                            device: st.activeDevice,
                            allocatedUnits: st.allocatedUnits,
                            customerPhone: _customerPhone,
                            customDisplayName: isMultiCart
                                ? st.bundleTitleParts.join(' + ')
                                : null,
                            customTotalBaseVal:
                                isMultiCart ? st.totalBaseValue : null,
                          ),
                        ),
                      const SizedBox(height: 40),
                    ],
                  ),
                ),
              );
            },
          ),
        ),
      ),
    );
  }
}
