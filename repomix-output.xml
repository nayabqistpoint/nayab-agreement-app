import 'package:firebase_core/firebase_core.dart';
import 'package:flutter/material.dart';
import 'core/constants/app_colors.dart';
import 'core/database/hive_box_manager.dart';
import 'core/security/screen_protector_service.dart';
import 'features/purchase_market/purchase_market_page.dart';
import 'firebase_options.dart';
import 'sync/master_sync_hub.dart';
void main() async {
  WidgetsFlutterBinding.ensureInitialized();
  await Firebase.initializeApp(
    options: DefaultFirebaseOptions.currentPlatform,
  );
  await HiveBoxManager.initialize();
  await ScreenProtectorService.enableSecureFlag();
  MasterSyncHub.startWatcher();
  await MasterSyncHub.syncAll();
  runApp(const NayabShopPosApp());
}
class NayabShopPosApp extends StatelessWidget {
  const NayabShopPosApp({super.key});
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'نایاب قسط پوائنٹ - شاپ پلانز',
      debugShowCheckedModeBanner: false,
      builder: (context, child) {
        final mediaQuery = MediaQuery.of(context);
        return MediaQuery(
          data: mediaQuery.copyWith(
            textScaler: const TextScaler.linear(1.22),
          ),
          child: child ?? const SizedBox.shrink(),
        );
      },
      theme: ThemeData(
        fontFamily: 'JameelNoori',
        primaryColor: AppColors.primaryEmerald,
        scaffoldBackgroundColor: AppColors.backgroundLight,
        colorScheme: ColorScheme.fromSeed(
          seedColor: AppColors.primaryEmerald,
          primary: AppColors.primaryEmerald,
        ),
        textTheme: const TextTheme(
          bodyLarge: TextStyle(
            fontSize: 16,
            fontWeight: FontWeight.w700,
            color: AppColors.textDark,
          ),
          bodyMedium: TextStyle(
            fontSize: 14.5,
            fontWeight: FontWeight.w700,
            color: AppColors.textDark,
          ),
          bodySmall: TextStyle(
            fontSize: 13,
            fontWeight: FontWeight.w600,
            color: AppColors.textDark,
          ),
          titleMedium: TextStyle(
            fontSize: 16.5,
            fontWeight: FontWeight.w900,
            color: AppColors.textDark,
          ),
        ),
        useMaterial3: true,
      ),
      home: const PurchaseMarketPage(),
    );
  }
}
