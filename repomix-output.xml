  factory CalculatorConfigModel.fallback() {
    return const CalculatorConfigModel(
      addProcessingFeeToPrincipal: false,
      advancePercentage: 0.8,
      allowedDurations: [6, 7, 8, 9, 10, 11, 12],
      gracePeriodDays: 15,
      installmentDueDay: 5,
      isCompoundingProfit: false,
      perMonthIncrement: 0.05,
      processingFee: 0,
      profitWithCheck: 0.25,
      profitWithoutCheck: 0.35,
      roundToNearest: 100,
      status: 'approved',
    );
  }
  static List<int> _parseDurations(dynamic raw, List<int> fallbackList) {
    if (raw is List) {
      final parsed = raw
          .map((e) => int.tryParse(e.toString()) ?? 0)
          .where((e) => e > 0)
          .toList();
      if (parsed.isNotEmpty) return parsed;
    }
    return fallbackList;
  }
  static List<String> _parseZones(dynamic raw) {
    if (raw is List) {
      final parsed = raw
          .map((e) => e.toString().trim().toUpperCase())
          .where((e) => e.isNotEmpty)
          .toList();
      if (parsed.isNotEmpty) return parsed;
    }
    return const ['MOBILE', 'ELECTRONICS', 'CUSTOM_ESTIMATE'];
  }
  static List<CustomFieldDef> _parseCustomFields(dynamic raw) {
    if (raw is List) {
      final List<CustomFieldDef> list = [];
      for (final item in raw) {
        if (item is Map) {
          final k = item['key']?.toString().trim() ?? '';
          final label = item['urduLabel']?.toString().trim() ?? '';
          if (k.isNotEmpty && label.isNotEmpty) {
            list.add(CustomFieldDef(key: k, urduLabel: label));
          }
        }
      }
      return list;
    }
    return const [];
  }
