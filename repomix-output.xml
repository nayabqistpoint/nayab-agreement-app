  final String phone;
  final String address;
  final String role;
  final bool isSynced;
  final String updatedAt;
  final String createdAt;
  final bool isDeleted;
  CustomerProfileModel({
    required this.id,
    required this.fullName,
    required this.fatherName,
    required this.cnic,
    required this.phone,
    required this.address,
    this.role = 'گاہک',
    this.isSynced = false,
    required this.updatedAt,
    required this.createdAt,
    this.isDeleted = false,
  });
  Map<String, dynamic> toMap() {
    return {
      'id': id,
      'fullName': fullName,
      'fatherName': fatherName,
      'cnic': cnic,
      'phone': phone,
      'address': address,
      'role': role,
      'isSynced': isSynced,
      'updatedAt': updatedAt,
      'createdAt': createdAt,
      'isDeleted': isDeleted,
    };
