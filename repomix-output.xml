import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:flutter/foundation.dart';
import '../../core/constants/app_colors.dart';
import '../../core/constants/box_names.dart';
import '../../core/database/hive_box_manager.dart';
import '../../core/time/time_status_service.dart';
class OrdersPushService {
  static Future<void> pushUnsyncedOrders() async {
    try {
      final box = HiveBoxManager.getBox(BoxNames.shopOrdersBox);
      final Map<String, DataMap> pendingPayloads = {};
      for (final key in box.keys) {
        final raw = box.get(key);
        if (raw is Map) {
          final data = Map<String, dynamic>.from(raw);
          if (data['isSynced'] != true) {
            final docId = key.toString();
            data['id'] = docId;
            data['isSynced'] = true;
            data['syncedAt'] = TimeStatusService.nowUtcIso();
            pendingPayloads[docId] = data;
          }
        }
      }
      if (pendingPayloads.isEmpty) return;
      final collection =
          FirebaseFirestore.instance.collection(BoxNames.shopOrdersBox);
      final WriteBatch firestoreBatch = FirebaseFirestore.instance.batch();
      pendingPayloads.forEach((docId, payload) {
        firestoreBatch.set(
          collection.doc(docId),
          payload,
          SetOptions(merge: true),
        );
      });
      await firestoreBatch.commit();
      await HiveBoxManager.putBatch(
        boxName: BoxNames.shopOrdersBox,
        entries: pendingPayloads,
      );
      debugPrint(
        'OrdersPushService: Atomic batch pushed ${pendingPayloads.length} orders to Firestore',
      );
    } catch (e) {
      debugPrint('OrdersPushService Error: $e');
    }
  }
}
