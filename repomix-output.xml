import '../../../core/constants/app_colors.dart';
class OrderReceiptArgs {
  final DataMap plan;
  final String deviceName;
  final String? customerPhone;
  final List<DataMap> installmentSchedule;
  final String? sourceMode;
  final String? stockId;
  final String? imeiNo;
  final String? serialNo;
  final int baseValue;
  final bool isBoxPackNew;
  const OrderReceiptArgs({
    required this.plan,
    required this.deviceName,
    this.customerPhone,
    required this.installmentSchedule,
    this.sourceMode,
    this.stockId,
    this.imeiNo,
    this.serialNo,
    this.baseValue = 0,
    this.isBoxPackNew = true,
  });
  DataMap toMap() {
    return {
      'plan': plan,
      'deviceName': deviceName,
      'customerPhone': customerPhone,
      'installmentSchedule': installmentSchedule,
      'sourceMode': sourceMode,
      'stockId': stockId,
      'imeiNo': imeiNo,
      'serialNo': serialNo,
      'baseValue': baseValue,
      'isBoxPackNew': isBoxPackNew,
    };
  }
  factory OrderReceiptArgs.fromMap(DataMap? map) {
    if (map == null) {
      return const OrderReceiptArgs(
        plan: {},
        deviceName: '',
        installmentSchedule: [],
      );
    }
    return OrderReceiptArgs(
      plan: (map['plan'] as Map?)?.cast<String, dynamic>() ?? {},
      deviceName: map['deviceName']?.toString() ?? '',
      customerPhone: map['customerPhone']?.toString(),
      installmentSchedule: (map['installmentSchedule'] as List?)
              ?.map((e) => (e as Map).cast<String, dynamic>())
              .toList() ??
          [],
      sourceMode: map['sourceMode']?.toString(),
      stockId: map['stockId']?.toString(),
      imeiNo: map['imeiNo']?.toString(),
      serialNo: map['serialNo']?.toString(),
      baseValue: (map['baseValue'] as num?)?.toInt() ?? 0,
      isBoxPackNew: map['isBoxPackNew'] != false,
    );
  }
}
