      final Map<String, DataMap> pendingUpdates = {};
      for (final key in box.keys) {
        final raw = box.get(key);
        if (raw is Map) {
          final data = Map<String, dynamic>.from(raw);
          if (data['isSynced'] != true) {
            final docId = key.toString();
            data['id'] = docId;
            data['isSynced'] = true;
            data['syncedAt'] = TimeStatusService.nowUtcIso();
            pendingUpdates[docId] = data;
          }
        }
      }
      if (pendingUpdates.isEmpty) return;
      final collection =
          FirebaseFirestore.instance.collection(BoxNames.stockBox);
      final WriteBatch batch = FirebaseFirestore.instance.batch();
      pendingUpdates.forEach((docId, payload) {
        batch.set(
          collection.doc(docId),
          payload,
          SetOptions(merge: true),
        );
      });
      await batch.commit();
      await HiveBoxManager.putBatch(
        boxName: BoxNames.stockBox,
        entries: pendingUpdates,
      );
      debugPrint(
        'StockPushService: Pushed ${pendingUpdates.length} stock status updates to Firestore',
      );
    } catch (e) {
      debugPrint('StockPushService Error: $e');
    }
  }
}
