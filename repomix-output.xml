import '../../../../core/constants/app_colors.dart';
import '../../../../core/time/time_status_service.dart';
import '../../../device_plan_detail/models/calculator_config_model.dart';
import '../../../device_plan_detail/services/plan_schedule_service.dart';
class PurchaseOrderPayloadBuilder {
  static DataMap buildOrderPayload({
    required String docId,
    required String customerName,
    String customerFatherName = '',
    String customerCaste = '',
    required String customerPhone,
    required String customerCnic,
    String customerAddress = '',
    String? customerPhotoUrl,
    required String guarantorName,
    String guarantorFatherName = '',
    String guarantorCaste = '',
    required String guarantorPhone,
    String guarantorCnic = '',
    String guarantorAddress = '',
    String guarantorRelation = '',
    String? guarantorPhotoUrl,
    String? guardianPhone,
    required String sourceMode,
    String? stockId,
    required String itemName,
    String? imeiNo,
    String? serialNo,
    required String guaranteeType,
    String? bankName,
    String? chequeNo,
    required int totalMonths,
    required int advance,
    required int monthlyAmount,
    required int totalContractAmount,
    required DateTime orderDateTime,
    List<String> acceptedSecurityConditions = const [],
    int mdmLockFee = 1000,
    String openBoxDeductionRule = '',
    bool adminOverrideApplied = false,
    CalculatorConfigModel? config,
  }) {
    final bool isCheque = guaranteeType == 'BANK_CHEQUE';
    final effectiveConfig = config ?? CalculatorConfigModel.fallback();
    final nowIso = TimeStatusService.nowUtcIso();
    final generatedSchedule = PlanScheduleService.generateSchedule(
      totalMonths: totalMonths,
      monthlyAmount: monthlyAmount,
      advancePaid: advance,
      config: effectiveConfig,
      requestDate: orderDateTime,
    );
    final List<DataMap> finalInstallments = [];
    for (int i = 0; i < generatedSchedule.length; i++) {
      final item = generatedSchedule[i];
      final int instNo = (item['no'] as num?)?.toInt() ?? (i + 1);
      final int amt = (item['amount'] as num?)?.toInt() ?? 0;
      final bool isFirst = instNo == 1;
      final bool isZeroAdv = isFirst && advance == 0;
      finalInstallments.add({
        'installmentNo': instNo,
        'title': isFirst
            ? (advance > 0
                ? 'ایڈوانس قسط (قسط نمبر 1)'
                : 'زیرو ایڈوانس (قسط نمبر 1)')
            : 'ماہانہ قسط نمبر $instNo',
        'dueDate': item['dueDate']?.toString() ?? '',
        'dueAmount': amt,
        'paidAmount': 0,
        'remainingAmount': amt,
        'paymentPercentage': isZeroAdv ? 100 : 0,
        'status': isZeroAdv ? 'PAID' : 'PENDING',
        'verificationStatus': isZeroAdv ? 'VERIFIED' : 'UNDER_REVIEW',
      });
    }
    return {
      'id': docId,
      'docId': docId,
      'stockId': (stockId != null && stockId.trim().isNotEmpty)
          ? stockId.trim()
          : null,
      'customerName': customerName.trim(),
      'customerFatherName': customerFatherName.trim(),
      'customerCaste': customerCaste.trim(),
      'customerPhone': customerPhone.trim(),
      'customerCnic': customerCnic.trim(),
      'customerAddress': customerAddress.trim(),
      'customerPhotoUrl':
          (customerPhotoUrl != null && customerPhotoUrl.trim().isNotEmpty)
              ? customerPhotoUrl.trim()
              : null,
      'guarantorName': guarantorName.trim(),
      'guarantorFatherName': guarantorFatherName.trim(),
      'guarantorCaste': guarantorCaste.trim(),
      'guarantorPhone': guarantorPhone.trim(),
      'guarantorCnic': guarantorCnic.trim(),
      'guarantorAddress': guarantorAddress.trim(),
      'guarantorRelation': guarantorRelation.trim(),
      'guarantorPhotoUrl':
          (guarantorPhotoUrl != null && guarantorPhotoUrl.trim().isNotEmpty)
              ? guarantorPhotoUrl.trim()
              : null,
      'guardianPhone': guardianPhone?.trim() ?? '',
      'sourceMode': sourceMode,
      'itemName': itemName,
      'imeiNo': (imeiNo != null && imeiNo.trim().isNotEmpty)
          ? imeiNo.trim()
          : null,
      'serialNo': (serialNo != null && serialNo.trim().isNotEmpty)
          ? serialNo.trim()
          : null,
      'guaranteeType': guaranteeType,
      'bankName': isCheque ? (bankName?.trim() ?? '') : null,
      'chequeNo': isCheque ? (chequeNo?.trim() ?? '') : null,
      'totalMonths': totalMonths,
      'advance': advance,
      'monthlyAmount': monthlyAmount,
      'totalContractAmount': totalContractAmount,
      'mdmLockFee': mdmLockFee,
      'openBoxDeductionRule': openBoxDeductionRule,
      'securityConditionsSummary': acceptedSecurityConditions.join(' | '),
      'adminOverrideApplied': adminOverrideApplied,
      'status': 'PENDING_AGREEMENT',
      'installments': finalInstallments,
      'isSynced': false,
      'updatedAt': nowIso,
      'createdAt': nowIso,
      'isDeleted': false,
    };
  }
}
