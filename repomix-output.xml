import '../../core/constants/app_colors.dart';
import '../device_plan_detail/args/device_plan_detail_args.dart';
import '../device_plan_detail/device_plan_detail_page.dart';
import 'services/purchase_market_calculation_service.dart';
import 'services/purchase_market_storage_handler_service.dart';
class PurchaseMarketController extends ChangeNotifier {
  int expandedCardIndex = -1;
  ValueListenable<Box<dynamic>> get boxListenable =>
      PurchaseMarketStorageHandlerService.stockListenable;
  int get totalPlansCount =>
      PurchaseMarketCalculationService.getTotalPlansCount();
  List<DataMap> getStockDevices() {
    final rawEntries = PurchaseMarketStorageHandlerService.getAllRawStock();
    return PurchaseMarketCalculationService.parseStockDevices(rawEntries);
  }
  void toggleRibbon(int index) {
    expandedCardIndex = (expandedCardIndex == index) ? -1 : index;
    notifyListeners();
  }
  void navigateToPlanDetail(
    BuildContext context,
    DataMap device,
    String? customerPhone,
  ) {
    final args = DevicePlanDetailArgs(
      device: device,
      customerPhone: customerPhone,
    );
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (_) => DevicePlanDetailPage(args: args),
      ),
    );
  }
  void handleCustomEstimateSubmit(
    BuildContext context,
    String name,
    int price,
    int adv,
    String? customerPhone,
  ) {
    final device = PurchaseMarketCalculationService.buildCustomEstimateDevice(
      name: name,
      price: price,
      adv: adv,
    );
    navigateToPlanDetail(context, device, customerPhone);
  }
}
