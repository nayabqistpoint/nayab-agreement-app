  final bool showShopLogo;
  final bool showOwnerPhoto;
  final bool tickerEnabled;
  final String tickerText;
  final bool showReservedItems;
  final bool showSoldItems;
  final bool showOnOrderItems;
  final List<CustomFieldDef> mobileCustomFields;
  final List<CustomFieldDef> generalCustomFields;
  const CalculatorConfigModel({
    required this.addProcessingFeeToPrincipal,
    required this.advancePercentage,
    required this.allowedDurations,
    required this.gracePeriodDays,
    required this.installmentDueDay,
    required this.isCompoundingProfit,
    required this.perMonthIncrement,
    required this.processingFee,
    required this.profitWithCheck,
    required this.profitWithoutCheck,
    required this.roundToNearest,
    required this.status,
    this.mdmLockFee = 1000,
    this.openBoxDeductionType = 'PERCENT',
    this.openBoxDeductionValue = 10,
    this.maxRiskLimit = 0,
    this.adminOverridePin = '7860',
    this.generalEnabled = true,
    this.generalAdvancePercentage = 0.75,
    this.generalProfitWithCheck = 0.25,
    this.generalProfitWithoutCheck = 0.35,
    this.generalPerMonthIncrement = 0.05,
    this.generalInstallmentDueDay = 5,
    this.generalGracePeriodDays = 15,
    this.generalProcessingFee = 0,
    this.generalRoundToNearest = 100,
    this.generalIsCompoundingProfit = false,
    this.generalAddProcessingFeeToPrincipal = false,
    this.generalAllowedDurations = const [6, 8, 10, 12, 15, 18],
    this.generalMaxRiskLimit = 0,
    this.generalMdmLockFee = 1000,
    this.generalOpenBoxDeductionType = 'PERCENT',
    this.generalOpenBoxDeductionValue = 10,
    this.generalAdminOverridePin = '7860',
    this.generalRequireCustomerMobileMdm = true,
    this.customAdvancePercentage = 0.8,
    this.customProfitWithCheck = 0.25,
    this.customProfitWithoutCheck = 0.35,
    this.customPerMonthIncrement = 0.05,
    this.customInstallmentDueDay = 5,
    this.customGracePeriodDays = 15,
    this.customProcessingFee = 0,
    this.customRoundToNearest = 100,
    this.customIsCompoundingProfit = false,
    this.customAddProcessingFeeToPrincipal = false,
    this.customAllowedDurations = const [6, 7, 8, 9, 10, 11, 12],
