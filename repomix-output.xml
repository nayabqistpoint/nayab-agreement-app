      'sourceMode': 'بکنگ کا ذریعہ',
      'itemName': 'موبائل ماڈل',
      'imeiNo': 'IMEI نمبر',
      'guaranteeType': 'ضمانت کی قسم',
      'bankName': 'بینک کا نام',
      'chequeNo': 'چیک نمبر',
      'totalMonths': 'کل مدت (ماہ)',
      'advance': 'ایڈوانس رقم',
      'monthlyAmount': 'ماہانہ قسط',
      'totalContractAmount': 'کل معاہدہ رقم',
      'status': 'اسٹیٹس',
