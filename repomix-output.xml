import 'dart:async';
import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:flutter/foundation.dart';
import '../../core/constants/app_colors.dart';
import '../../core/constants/box_names.dart';
import '../../core/database/hive_box_manager.dart';
import '../../core/network/connectivity_service.dart';
import '../../core/time/time_status_service.dart';
import '../status/sync_status_service.dart';
class ConfigPullService {
  static const String configDocKey = 'calculator_config';
  static StreamSubscription? _configSub;
  static DataMap _defaultConfigPayload() {
    return {
      'id': configDocKey,
      'addProcessingFeeToPrincipal': false,
      'advancePercentage': 0.8,
      'allowedDurations': [6, 7, 8, 9, 10, 11, 12],
      'gracePeriodDays': 15,
      'installmentDueDay': 5,
      'isCompoundingProfit': false,
      'perMonthIncrement': 0.05,
      'processingFee': 0,
      'profitWithCheck': 0.25,
      'profitWithoutCheck': 0.35,
      'roundToNearest': 100,
      'status': 'approved',
      'isSynced': true,
      'updatedAt': TimeStatusService.nowUtcIso(),
    };
  }
  static Future<void> pullConfig() async {
    try {
      final box = HiveBoxManager.getBox(BoxNames.appConfigBox);
      if (!box.containsKey(configDocKey)) {
        await HiveBoxManager.putBatch(
          boxName: BoxNames.appConfigBox,
          entries: {configDocKey: _defaultConfigPayload()},
        );
      }
      if (!await ConnectivityService.isOnline) return;
      final collection =
          FirebaseFirestore.instance.collection(BoxNames.appConfigBox);
      final docRef = collection.doc(configDocKey);
      final snapshot = await docRef.get();
      if (snapshot.exists && snapshot.data() != null) {
        final cloudData = Map<String, dynamic>.from(snapshot.data()!);
        cloudData['id'] = configDocKey;
        cloudData['isSynced'] = true;
        await HiveBoxManager.putBatch(
          boxName: BoxNames.appConfigBox,
          entries: {configDocKey: cloudData},
        );
      } else {
        final rawLocal = box.get(configDocKey);
        final payload = rawLocal is Map
            ? Map<String, dynamic>.from(rawLocal)
            : _defaultConfigPayload();
        payload['isSynced'] = true;
        final batch = FirebaseFirestore.instance.batch();
        batch.set(docRef, payload, SetOptions(merge: true));
        await batch.commit();
      }
    } catch (e) {
      debugPrint('ConfigPullService Error: $e');
    }
  }
  static void startRealtimeListener() {
    _configSub?.cancel();
    _configSub = FirebaseFirestore.instance
        .collection(BoxNames.appConfigBox)
        .snapshots()
        .listen(
      (snapshot) async {
        try {
          if (snapshot.docs.isEmpty) return;
          final Map<String, DataMap> fullBatch = {};
          for (final doc in snapshot.docs) {
            final data = Map<String, dynamic>.from(doc.data());
            data['id'] = doc.id;
            data['isSynced'] = true;
            fullBatch[doc.id] = data;
          }
          if (fullBatch.isNotEmpty) {
            await HiveBoxManager.putBatch(
              boxName: BoxNames.appConfigBox,
              entries: fullBatch,
            );
            SyncStatusService.setState(SyncState.synced);
            debugPrint(
              'ConfigPullService [LIVE]: Updated ${fullBatch.length} config docs in Hive',
            );
          }
        } catch (e) {
          debugPrint('ConfigPullService Snapshot Parse Error: $e');
        }
      },
      onError: (e) {
        debugPrint('ConfigPullService Stream Error: $e');
        SyncStatusService.setState(SyncState.offline);
      },
    );
  }
  static Future<void> stopRealtimeListener() async {
    await _configSub?.cancel();
    _configSub = null;
  }
}
