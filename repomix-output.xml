import 'dart:async';
import '../core/constants/box_names.dart';
import '../core/database/hive_box_manager.dart';
import '../core/network/connectivity_service.dart';
import '../core/security/device_license_service.dart';
import 'pull/config_pull_service.dart';
import 'pull/stock_pull_service.dart';
import 'push/orders_push_service.dart';
import 'push/stock_push_service.dart';
import 'status/sync_status_service.dart';
class MasterSyncHub {
  static bool _watcherStarted = false;
  static bool _isSyncing = false;
  static bool _hasQueuedPush = false;
  static StreamSubscription? _ordersWatchSub;
  static StreamSubscription? _stockWatchSub;
  static StreamSubscription? _connectivitySub;
  static void startWatcher() {
    if (_watcherStarted) return;
    _watcherStarted = true;
    _ordersWatchSub =
        HiveBoxManager.getBox(BoxNames.shopOrdersBox).watch().listen((event) {
      final val = event.value;
      if (val is Map && val['isSynced'] == false) pushOnlyUnsynced();
    });
    _stockWatchSub =
        HiveBoxManager.getBox(BoxNames.stockBox).watch().listen((event) {
      final val = event.value;
      if (val is Map && val['isSynced'] == false) pushOnlyUnsynced();
    });
    _connectivitySub =
        ConnectivityService.onConnectivityChanged.listen((online) {
      if (online) {
        syncAll();
      } else {
        SyncStatusService.setState(SyncState.offline);
      }
    });
    ConfigPullService.startRealtimeListener();
    StockPullService.startRealtimeListener();
  }
  static Future<void> pushOnlyUnsynced() async {
    if (_isSyncing) {
      _hasQueuedPush = true;
      return;
    }
    _isSyncing = true;
    try {
      do {
        _hasQueuedPush = false;
        if (!await ConnectivityService.isOnline) {
          SyncStatusService.setState(SyncState.offline);
          break;
        }
        SyncStatusService.setState(SyncState.syncing);
        await OrdersPushService.pushUnsyncedOrders()
            .timeout(const Duration(seconds: 15));
        await StockPushService.pushUnsyncedStockUpdates()
            .timeout(const Duration(seconds: 15));
        SyncStatusService.setState(SyncState.synced);
      } while (_hasQueuedPush);
    } catch (_) {
      SyncStatusService.setState(SyncState.offline);
    } finally {
      _isSyncing = false;
    }
  }
  static Future<void> syncAll() async {
    if (_isSyncing) {
      _hasQueuedPush = true;
      return;
    }
    _isSyncing = true;
    try {
      final online = await ConnectivityService.isOnline;
      if (!online) {
        await ConfigPullService.pullConfig();
        SyncStatusService.setState(SyncState.offline);
        return;
      }
      SyncStatusService.setState(SyncState.syncing);
      await OrdersPushService.pushUnsyncedOrders()
          .timeout(const Duration(seconds: 15));
      await StockPushService.pushUnsyncedStockUpdates()
          .timeout(const Duration(seconds: 15));
      await ConfigPullService.pullConfig();
      await StockPullService.pullStock();
      unawaited(DeviceLicenseService.registerOrHeartbeatDevice());
      SyncStatusService.setState(SyncState.synced);
    } catch (_) {
      SyncStatusService.setState(SyncState.offline);
    } finally {
      _isSyncing = false;
      if (_hasQueuedPush) unawaited(pushOnlyUnsynced());
    }
  }
  static Future<void> dispose() async {
    await _ordersWatchSub?.cancel();
    await _stockWatchSub?.cancel();
    await _connectivitySub?.cancel();
    await ConfigPullService.stopRealtimeListener();
    await StockPullService.stopRealtimeListener();
    _watcherStarted = false;
  }
}
