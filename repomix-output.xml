class OrderValidationService {
  static ({bool isValid, String? errorMessage, bool showFieldErrors}) validate({
    required bool isBarrierSatisfied,
    required bool isChequePlan,
    required String bankName,
    required String chequeNo,
    required String customerName,
    required String customerFatherName,
    required String customerCaste,
    required String customerPhone,
    required String customerCnic,
    required String customerAddress,
    required bool isGuarantorMandatory,
    required String guarantorName,
    required String guarantorFatherName,
    required String guarantorCaste,
    required String guarantorPhone,
    required String guarantorCnic,
    required String guarantorRelation,
    required String guarantorAddress,
  }) {
    if (!isBarrierSatisfied) {
      return (
        isValid: false,
        errorMessage:
            'برائے مہربانی تمام سیکیورٹی شرائط پر ٹِک لگائیں اور سرپرست کے نمبر پر واٹس ایپ اطلاع مکمل کریں!',
        showFieldErrors: false,
      );
    }
    if (isChequePlan && (bankName.trim().isEmpty || chequeNo.trim().isEmpty)) {
      return (
        isValid: false,
        errorMessage: 'برائے مہربانی بینک کا نام اور چیک نمبر درج کریں!',
        showFieldErrors: true,
      );
    }
    if (customerName.trim().isEmpty ||
        customerFatherName.trim().isEmpty ||
        customerCaste.trim().isEmpty ||
        customerPhone.trim().isEmpty ||
        customerCnic.trim().isEmpty ||
        customerAddress.trim().isEmpty) {
      return (
        isValid: false,
        errorMessage:
            'برائے مہربانی خریدار کے تمام کوائف (نام، ولدیت، قوم، فون، شناختی کارڈ اور پتہ) مکمل درج کریں!',
        showFieldErrors: true,
      );
    }
    if (isGuarantorMandatory &&
        (guarantorName.trim().isEmpty ||
            guarantorFatherName.trim().isEmpty ||
            guarantorCaste.trim().isEmpty ||
            guarantorPhone.trim().isEmpty ||
            guarantorCnic.trim().isEmpty ||
            guarantorRelation.trim().isEmpty ||
            guarantorAddress.trim().isEmpty)) {
      return (
        isValid: false,
        errorMessage:
            'اشٹام پرنوٹ پیکج کیلئے ضامن کے تمام کوائف (نام، ولدیت، قوم، فون، شناختی کارڈ، تعلق اور پتہ) درج کرنا لازمی ہے!',
        showFieldErrors: true,
      );
    }
    return (isValid: true, errorMessage: null, showFieldErrors: false);
  }
}
