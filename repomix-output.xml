  Future<void> _deleteCustomTag(TagBankItemModel item) async {
    await TagsBankService.saveTagItem(
      TagBankItemModel(
        id: item.id,
        urduName: item.urduName,
        source: item.source,
        rawKey: item.rawKey,
        isEnabled: false,
        valueTranslations: item.valueTranslations,
        isSynced: false,
        updatedAt: TimeStatusService.nowUtcIso(),
        isDeleted: true,
      ),
    );
  }
