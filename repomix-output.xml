<file path="../nayab_shop_pos/lib/features/device_plan_detail/services/detail_state_resolver_service.dart">
import '../../../core/constants/app_colors.dart';
import '../components/direct_cash_sale_card_ui.dart';
import '../components/multi_cart_bundle_card_ui.dart';
import '../models/calculator_config_model.dart';
import 'stock_live_status_service.dart';
class DetailResolvedState {
  final StockUnitList allocatedUnits;
  final List<String> allocatedIds;
  final List<CashSaleLineItem> cashSaleLines;
  final List<MultiCartItemRowData> multiCartRows;
  final List<String> bundleTitleParts;
  final List<String> heroImages;
  final List<String> heroImageLabels;
  final int totalBaseValue;
  final int unitBaseValue;
  final int maxAvailableQty;
  final bool isStockLocked;
  final String? liveLockMessage;
  final String lockButtonLabel;
  final bool isTrulyAvailableInShop;
  final DataMap activeDevice;
  const DetailResolvedState({
    required this.allocatedUnits,
    required this.allocatedIds,
    required this.cashSaleLines,
    required this.multiCartRows,
    required this.bundleTitleParts,
    required this.heroImages,
    required this.heroImageLabels,
    required this.totalBaseValue,
    required this.unitBaseValue,
    required this.maxAvailableQty,
    required this.isStockLocked,
    required this.liveLockMessage,
    required this.lockButtonLabel,
    required this.isTrulyAvailableInShop,
    required this.activeDevice,
  });
}
class DetailStateResolverService {
  static DetailResolvedState resolve({
    required DataMap device,
    required String zoneType,
    required CalculatorConfigModel config,
    required int selectedQuantity,
    required int Function(int index) getCartQty,
  }) {
    final int initialBase = (device['baseValue'] as num?)?.toInt() ?? 0;
    final bool isCustom = device['isCustomEstimate'] == true;
    final bool isMultiCart = device['isMultiCart'] == true;
    final StockUnitList allocatedUnits = [];
    final List<CashSaleLineItem> cashLines = [];
    final List<MultiCartItemRowData> cartRows = [];
    final List<String> titleParts = [];
    final List<String> heroImages = [];
    final List<String> heroLabels = [];
    int totalBase = 0;
    int maxQty = 1;
    bool isLocked = false;
    String? lockMsg;
    String lockBtn = '';
    bool isTrulyAvail = false;
    String activeId =
        device['stockId']?.toString() ?? device['id']?.toString() ?? '';
    int unitBase = initialBase;
    if (isMultiCart) {
      final cartList = ((device['cartDevices'] as List?)
              ?.map((e) => DataMap.from(e as Map))
              .toList() ??
          const []);
      for (int i = 0; i < cartList.length; i++) {
        final item = cartList[i];
        final name = item['name']?.toString() ?? 'آئٹم';
        final avail = StockLiveStatusService.resolveAllAvailableUnitsForGroup(item)
            .where((u) =>
                (u['status']?.toString() ?? 'AVAILABLE').toUpperCase() ==
                'AVAILABLE')
            .toList();
        final maxForItem = avail.isNotEmpty ? avail.length : 1;
        final chosen = getCartQty(i).clamp(1, maxForItem);
        final taken = avail.take(chosen).toList();
        allocatedUnits.addAll(taken);
        final itemUnitBase = (item['baseValue'] as num?)?.toInt() ?? 0;
        totalBase += itemUnitBase * chosen;
        cartRows.add(MultiCartItemRowData(
          name: name,
          unitBasePrice: itemUnitBase,
          chosenQty: chosen,
          maxAvailable: maxForItem,
        ));
        titleParts.add(chosen > 1 ? '$name (×$chosen)' : name);
        if (taken.isNotEmpty) {
          cashLines.add(CashSaleLineItem(
            itemName: name,
            quantity: taken.length,
            defaultUnitCashPrice:
                config.computeEffectiveCashUnitPrice(itemUnitBase),
            stockIds: taken
                .map((u) => (u['stockId']?.toString() ?? '').trim())
                .where((e) => e.isNotEmpty)
                .toList(),
            imeis: taken
                .map((u) => (u['imeiNo']?.toString() ?? '').trim())
                .where((e) => e.isNotEmpty && e != 'null')
                .toList(),
          ));
        }
        for (final img in ((item['images'] as List?)?.cast<String>() ?? [])) {
          final clean = img.trim();
          if (clean.isNotEmpty && clean != 'null' && !heroImages.contains(clean)) {
            heroImages.add(clean);
            heroLabels.add(name);
          }
        }
      }
      isTrulyAvail = allocatedUnits.isNotEmpty;
      isLocked = allocatedUnits.isEmpty;
      if (isLocked) {
        lockMsg = '🔒 منتخب کردہ آئٹمز اب اسٹاک میں دستیاب نہیں ہیں۔';
        lockBtn = '🔒 دستیاب نہیں';
      }
    } else {
      final allAvail = isCustom
          ? const <DataMap>[]
          : StockLiveStatusService.resolveAllAvailableUnitsForGroup(device);
      final readyUnits = allAvail
          .where((u) =>
              (u['status']?.toString() ?? 'AVAILABLE').toUpperCase() ==
              'AVAILABLE')
          .toList();
      maxQty = isCustom ? 20 : (allAvail.isNotEmpty ? allAvail.length : 1);
      final first = allAvail.isNotEmpty ? allAvail.first : null;
      activeId = first != null
          ? (first['stockId']?.toString() ?? first['id']?.toString() ?? activeId)
          : activeId;
      unitBase = isCustom
          ? initialBase
          : StockLiveStatusService.resolveLiveBaseValue(initialBase, activeId);
      final lockState = isCustom
          ? (message: null, buttonLabel: '')
          : StockLiveStatusService.checkLiveStockLock(activeId,
              deviceGroup: device);
      lockMsg = lockState.message;
      lockBtn = lockState.buttonLabel;
      isLocked = lockMsg != null;
      final stCode =
          (device['statusCode']?.toString() ?? 'AVAILABLE').toUpperCase();
      isTrulyAvail = !isCustom &&
          !isLocked &&
          device['isOnOrder'] != true &&
          stCode == 'AVAILABLE' &&
          readyUnits.isNotEmpty;
      final safeQty = selectedQuantity.clamp(1, maxQty);
      allocatedUnits.addAll(allAvail.take(safeQty));
      totalBase = unitBase * safeQty;
      final singleName = device['name']?.toString() ?? 'آئٹم';
      for (final img in ((device['images'] as List?)?.cast<String>() ?? [])) {
        final clean = img.trim();
        if (clean.isNotEmpty && clean != 'null') {
          heroImages.add(clean);
          heroLabels.add(singleName);
        }
      }
      if (isTrulyAvail) {
        cashLines.add(CashSaleLineItem(
          itemName: singleName,
          quantity: allocatedUnits.length,
          defaultUnitCashPrice: config.computeEffectiveCashUnitPrice(unitBase),
          stockIds: allocatedUnits
              .map((u) => (u['stockId']?.toString() ?? '').trim())
              .where((e) => e.isNotEmpty)
              .toList(),
          imeis: allocatedUnits
              .map((u) => (u['imeiNo']?.toString() ?? '').trim())
              .where((e) => e.isNotEmpty && e != 'null')
              .toList(),
        ));
      }
    }
    final allocIds = allocatedUnits
        .map((u) => (u['stockId']?.toString() ?? '').trim())
        .where((e) => e.isNotEmpty)
        .toList();
    final allocImeis = allocatedUnits
        .map((u) => (u['imeiNo']?.toString() ?? '').trim())
        .where((e) => e.isNotEmpty && e != 'null')
        .toList();
    return DetailResolvedState(
      allocatedUnits: allocatedUnits,
      allocatedIds: allocIds,
      cashSaleLines: cashLines,
      multiCartRows: cartRows,
      bundleTitleParts: titleParts,
      heroImages: heroImages,
      heroImageLabels: heroLabels,
      totalBaseValue: totalBase,
      unitBaseValue: unitBase,
      maxAvailableQty: maxQty,
      isStockLocked: isLocked,
      liveLockMessage: lockMsg,
      lockButtonLabel: lockBtn,
      isTrulyAvailableInShop: isTrulyAvail,
      activeDevice: {
        ...device,
        'id': activeId,
        'stockId': activeId,
        'imeiNo': allocImeis.join(', '),
        'baseValue': unitBase,
        'zoneType': zoneType,
      },
    );
  }
}
