  void _showReservedWarning(BuildContext context, String reservedInfo) {
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(
          reservedInfo.isNotEmpty
              ? '🔒 یہ موبائل پہلے ہی "$reservedInfo" کے نام بُک (زیرِ معاہدہ) ہے!'
