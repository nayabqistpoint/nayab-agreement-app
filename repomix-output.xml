import '../../../core/constants/app_colors.dart';
import '../models/calculator_config_model.dart';
import 'plan_math_service.dart';
class PlanGeneratorService {
  static List<DataMap> generateAllPlans({
    required int baseValue,
    required int userCustomAdvance,
    required CalculatorConfigModel config,
    String zoneType = 'MOBILE',
    bool isGeneral = false,
  }) {
    final effectiveZone = isGeneral ? 'ELECTRONICS' : zoneType.toUpperCase();
    final List<DataMap> plans = [];
    final durations = config.durationsForZone(effectiveZone);
    final int principal = PlanMathService.calculatePrincipal(
      baseValue: baseValue,
      config: config,
      zoneType: effectiveZone,
    );
    for (final int m in durations) {
      final int remainingInstallments = (m - 1) > 0 ? (m - 1) : 1;
      final int rawChequeTotal = PlanMathService.calculateTotalContractPrice(
        principal: principal,
        months: m,
        isCheque: true,
        config: config,
        zoneType: effectiveZone,
      );
      final int chequeMinAdv = PlanMathService.calculateMinAdvance(
        totalContractPrice: rawChequeTotal,
        months: m,
        config: config,
        zoneType: effectiveZone,
      );
      final int effectiveChequeAdv = userCustomAdvance > 0
          ? (userCustomAdvance > rawChequeTotal
              ? rawChequeTotal
              : userCustomAdvance)
          : chequeMinAdv;
      final int chequeWithAdvMonthly = PlanMathService.calculateMonthlyEmi(
        totalContractPrice: rawChequeTotal,
        advancePaid: effectiveChequeAdv,
        months: m,
        config: config,
        zoneType: effectiveZone,
      );
      final int exactChequeWithAdvTotal =
          effectiveChequeAdv + (chequeWithAdvMonthly * remainingInstallments);
      plans.add({
        'months': m,
        'guarantee': 'BANK_CHEQUE',
        'hasAdvance': true,
        'advance': effectiveChequeAdv,
        'monthly': chequeWithAdvMonthly,
        'totalContract': exactChequeWithAdvTotal,
        'minAdvanceRequired': chequeMinAdv,
        'isGeneral': effectiveZone == 'ELECTRONICS',
        'zoneType': effectiveZone,
      });
      final int chequeZeroAdvMonthly = PlanMathService.calculateMonthlyEmi(
        totalContractPrice: rawChequeTotal,
        advancePaid: 0,
        months: m,
        config: config,
        zoneType: effectiveZone,
      );
      final int exactChequeZeroAdvTotal =
          chequeZeroAdvMonthly * remainingInstallments;
      plans.add({
        'months': m,
        'guarantee': 'BANK_CHEQUE',
        'hasAdvance': false,
        'advance': 0,
        'monthly': chequeZeroAdvMonthly,
        'totalContract': exactChequeZeroAdvTotal,
        'minAdvanceRequired': chequeMinAdv,
        'isGeneral': effectiveZone == 'ELECTRONICS',
        'zoneType': effectiveZone,
      });
      final int rawStampTotal = PlanMathService.calculateTotalContractPrice(
        principal: principal,
        months: m,
        isCheque: false,
        config: config,
        zoneType: effectiveZone,
      );
      final int stampMinAdv = PlanMathService.calculateMinAdvance(
        totalContractPrice: rawStampTotal,
        months: m,
        config: config,
        zoneType: effectiveZone,
      );
      final int effectiveStampAdv = userCustomAdvance > 0
          ? (userCustomAdvance > rawStampTotal
              ? rawStampTotal
              : userCustomAdvance)
          : stampMinAdv;
      final int stampWithAdvMonthly = PlanMathService.calculateMonthlyEmi(
        totalContractPrice: rawStampTotal,
        advancePaid: effectiveStampAdv,
        months: m,
        config: config,
        zoneType: effectiveZone,
      );
      final int exactStampWithAdvTotal =
          effectiveStampAdv + (stampWithAdvMonthly * remainingInstallments);
      plans.add({
        'months': m,
        'guarantee': 'LEGAL_STAMP',
        'hasAdvance': true,
        'advance': effectiveStampAdv,
        'monthly': stampWithAdvMonthly,
        'totalContract': exactStampWithAdvTotal,
        'minAdvanceRequired': stampMinAdv,
        'isGeneral': effectiveZone == 'ELECTRONICS',
        'zoneType': effectiveZone,
      });
      final int stampZeroAdvMonthly = PlanMathService.calculateMonthlyEmi(
        totalContractPrice: rawStampTotal,
        advancePaid: 0,
        months: m,
        config: config,
        zoneType: effectiveZone,
      );
      final int exactStampZeroAdvTotal =
          stampZeroAdvMonthly * remainingInstallments;
      plans.add({
        'months': m,
        'guarantee': 'LEGAL_STAMP',
        'hasAdvance': false,
        'advance': 0,
        'monthly': stampZeroAdvMonthly,
        'totalContract': exactStampZeroAdvTotal,
        'minAdvanceRequired': stampMinAdv,
        'isGeneral': effectiveZone == 'ELECTRONICS',
        'zoneType': effectiveZone,
      });
    }
    return plans;
  }
}
