class ZoneRateProfile {
  final double advancePercentage;
  final double profitWithCheck;
  final double profitWithoutCheck;
  final double perMonthIncrement;
  final int installmentDueDay;
  final int gracePeriodDays;
  final int processingFee;
  final int roundToNearest;
  final bool isCompoundingProfit;
  final bool addProcessingFeeToPrincipal;
  final List<int> allowedDurations;
  final int maxRiskLimit;
  final int mdmLockFee;
  final String openBoxDeductionType;
  final int openBoxDeductionValue;
  final String adminOverridePin;
  final bool requireCustomerMobileMdm;
  const ZoneRateProfile({
    this.advancePercentage = 0.8,
    this.profitWithCheck = 0.25,
    this.profitWithoutCheck = 0.35,
    this.perMonthIncrement = 0.05,
    this.installmentDueDay = 5,
    this.gracePeriodDays = 15,
    this.processingFee = 0,
    this.roundToNearest = 100,
    this.isCompoundingProfit = false,
    this.addProcessingFeeToPrincipal = false,
    this.allowedDurations = const [6, 7, 8, 9, 10, 11, 12],
    this.maxRiskLimit = 0,
    this.mdmLockFee = 1000,
    this.openBoxDeductionType = 'PERCENT',
    this.openBoxDeductionValue = 10,
    this.adminOverridePin = '7860',
    this.requireCustomerMobileMdm = true,
  });
  static List<int> parseDurations(dynamic raw, List<int> fallback) {
    if (raw is List) {
      final parsed = raw
          .map((e) => int.tryParse(e.toString()) ?? 0)
          .where((e) => e > 0)
          .toList();
      if (parsed.isNotEmpty) return parsed;
    }
    return fallback;
  }
  factory ZoneRateProfile.fromPrefixedMap(
    Map<dynamic, dynamic> map, {
    required String prefix,
    ZoneRateProfile? fallback,
    List<int> defaultDurations = const [6, 7, 8, 9, 10, 11, 12],
    double defaultAdvance = 0.8,
  }) {
    String k(String name) =>
        prefix.isEmpty ? name : '$prefix${name[0].toUpperCase()}${name.substring(1)}';
    final fb = fallback ?? const ZoneRateProfile();
    final rawOpenType =
        (map[k('openBoxDeductionType')]?.toString() ?? fb.openBoxDeductionType);
    return ZoneRateProfile(
      advancePercentage:
          (map[k('advancePercentage')] as num?)?.toDouble() ?? defaultAdvance,
      profitWithCheck: (map[k('profitWithCheck')] as num?)?.toDouble() ??
          fb.profitWithCheck,
      profitWithoutCheck: (map[k('profitWithoutCheck')] as num?)?.toDouble() ??
          fb.profitWithoutCheck,
      perMonthIncrement: (map[k('perMonthIncrement')] as num?)?.toDouble() ??
          fb.perMonthIncrement,
      installmentDueDay: (map[k('installmentDueDay')] as num?)?.toInt() ??
          fb.installmentDueDay,
      gracePeriodDays:
          (map[k('gracePeriodDays')] as num?)?.toInt() ?? fb.gracePeriodDays,
      processingFee:
          (map[k('processingFee')] as num?)?.toInt() ?? fb.processingFee,
      roundToNearest:
          (map[k('roundToNearest')] as num?)?.toInt() ?? fb.roundToNearest,
      isCompoundingProfit: map[k('isCompoundingProfit')] == true,
      addProcessingFeeToPrincipal:
          map[k('addProcessingFeeToPrincipal')] == true,
      allowedDurations:
          parseDurations(map[k('allowedDurations')], defaultDurations),
      maxRiskLimit:
          (map[k('maxRiskLimit')] as num?)?.toInt() ?? fb.maxRiskLimit,
      mdmLockFee: (map[k('mdmLockFee')] as num?)?.toInt() ?? fb.mdmLockFee,
      openBoxDeductionType: rawOpenType == 'FIXED' ? 'FIXED' : 'PERCENT',
      openBoxDeductionValue: (map[k('openBoxDeductionValue')] as num?)?.toInt() ??
          fb.openBoxDeductionValue,
      adminOverridePin:
          map[k('adminOverridePin')]?.toString() ?? fb.adminOverridePin,
      requireCustomerMobileMdm: map[k('requireCustomerMobileMdm')] != false,
    );
  }
}
