<file path="lib/sync/master_sync_hub.dart">
import 'dart:async';
import 'package:flutter/foundation.dart';
import '../core/constants/box_names.dart';
import '../core/database/hive_box_manager.dart';
import '../core/network/connectivity_service.dart';
import 'pull/customers_pull_service.dart';
import 'pull/pos_live_pull_service.dart';
import 'pull/templates_pull_service.dart';
import 'push/customers_push_service.dart';
import 'push/pos_atomic_push_service.dart';
import 'push/templates_push_service.dart';
class MasterSyncHub {
  static StreamSubscription? _connectivitySub;
  static final List<StreamSubscription> _boxSubs = [];
  static bool _isWatcherStarted = false;
  static bool _isSyncing = false;
  static bool _hasQueuedSync = false;
  static void startWatcher() {
    if (_isWatcherStarted) return;
    _isWatcherStarted = true;
    PosLivePullService.startRealtimeListeners();
    for (final boxName in [
      BoxNames.appConfigBox,
      BoxNames.stockBox,
      BoxNames.shopOrdersBox,
      BoxNames.tagsBox,
      BoxNames.posDevicesBox,
    ]) {
      _boxSubs.add(
        HiveBoxManager.getBox(boxName).watch().listen((event) {
          final val = event.value;
          if (val is Map && val['isSynced'] == false) {
            syncAll();
          }
        }),
      );
    }
    for (final boxName in [
      BoxNames.customersBox,
      BoxNames.customerDealsBox,
    ]) {
      _boxSubs.add(
        HiveBoxManager.getBox(boxName).watch().listen((event) {
          final val = event.value;
          if (val is Map && val['isSynced'] == false) {
            CustomersPushService.pushUnsynced();
          }
        }),
      );
    }
    _connectivitySub = ConnectivityService.onConnectivityChanged.listen((online) {
      if (online) {
        PosLivePullService.startRealtimeListeners();
        syncAll();
      }
    });
    syncAll();
  }
  static Future<void> syncAll() async {
    if (_isSyncing) {
      _hasQueuedSync = true;
      return;
    }
    _isSyncing = true;
    try {
      do {
        _hasQueuedSync = false;
        await PosAtomicPushService.pushAllUnsynced();
        await CustomersPushService.pushUnsynced();
        await TemplatesPushService.pushUnsynced();
        await TemplatesPullService.pullAll();
        await CustomersPullService.pullAll();
      } while (_hasQueuedSync);
    } catch (e) {
      debugPrint('MasterSyncHub Error: $e');
    } finally {
      _isSyncing = false;
    }
  }
  static void dispose() {
    _connectivitySub?.cancel();
    for (final sub in _boxSubs) {
      sub.cancel();
    }
    _boxSubs.clear();
    PosLivePullService.stopListeners();
    _isWatcherStarted = false;
  }
}
</file>

<file path="lib/features/stamp_agreement/services/stamp_payload_builder.dart">
import '../../../core/models/document_template_model.dart';
import '../../../core/models/overlay_box_model.dart';
import '../../../core/time/time_status_service.dart';
import '../../../core/utils/tag_extraction_helper.dart';
import '../models/stamp_overlay_field_model.dart';
class StampPayloadBuilder {
  static Map<String, dynamic> build({
    required String title,
    required String content,
    required String paperSize,
    required double topMargin,
    required double subsequentTopMargin,
    required double bottomMargin,
    required double subsequentBottomMargin,
    required double sideMargin,
    required double fontSize,
    required String? base64Pdf,
    required String? stampFileName,
    required List<String> pages,
    required List<StampOverlayFieldModel> overlayFields,
  }) {
    final now = TimeStatusService.nowUtcIso();
    final List<OverlayBoxModel> floatingBoxes = overlayFields.map((f) {
      return OverlayBoxModel(
        id: f.id,
        tag: f.tag,
        x: f.x,
        y: f.y,
        width: f.width,
        height: 35.0,
        pageIndex: f.pageIndex,
        fontSize: f.fontSize,
        isBold: f.isBold,
        isUnderline: f.isUnderline,
        isMultiLine: false,
      );
    }).toList();
    final Set<String> allExtractedFields = {};
    for (final tag in TemplateService.extractFields(content)) {
      allExtractedFields.add(tag);
    }
    for (final f in overlayFields) {
      if (!f.isStaticText) {
        for (final tag in TemplateService.extractFields(f.tag)) {
          if (tag.isNotEmpty) {
            allExtractedFields.add(tag);
          }
        }
      }
    }
    final doc = DocumentTemplateModel(
      id: title.trim(),
      title: title.trim(),
      content: content.trim(),
      mode: DocumentMode.stampOverlay,
      paperSize: paperSize,
      topMargin: topMargin,
      subsequentTopMargin: subsequentTopMargin,
      bottomMargin: bottomMargin,
      subsequentBottomMargin: subsequentBottomMargin,
      sideMargin: sideMargin,
      fontSize: fontSize,
      base64Pdf: base64Pdf,
      stampFileName: stampFileName,
      floatingBoxes: floatingBoxes,
      fields: allExtractedFields.toList(),
      pages: pages,
    );
    final map = doc.toMap();
    map['isSynced'] = false;
    map['updatedAt'] = now;
    map['createdAt'] = now;
    map['isDeleted'] = false;
    return map;
  }
}
</file>

