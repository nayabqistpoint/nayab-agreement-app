import 'dart:convert';
import 'package:flutter/foundation.dart';
import 'package:http/http.dart' as http;
import 'package:image_picker/image_picker.dart';
class PosCloudinaryService {
  static const String cloudName = 'snioixz8';
  static const String uploadPreset = 'nayab_unsigned';
  static const String rootFolder = 'nayab_qist_point';
  static Uri get _uploadUri =>
      Uri.parse('https://api.cloudinary.com/v1_1/$cloudName/image/upload');
  static Future<String?> uploadCustomerSelfie({
    required String customerCnic,
    required String pathOrDataUrl,
  }) async {
    final clean = pathOrDataUrl.trim();
    if (clean.isEmpty) return null;
    if (clean.startsWith('http://') || clean.startsWith('https://')) {
      return clean;
    }
    try {
      Uint8List bytes;
      if (clean.startsWith('data:image')) {
        final commaIdx = clean.indexOf(',');
        if (commaIdx == -1) return null;
        bytes = base64Decode(clean.substring(commaIdx + 1));
      } else {
        bytes = await XFile(clean).readAsBytes();
      }
      final cleanCnic = customerCnic.replaceAll(RegExp(r'[^0-9]'), '');
      final folderCnic = cleanCnic.isEmpty ? 'temp_customers' : cleanCnic;
      final fullFolder = '$rootFolder/customers/$folderCnic/profile';
      final request = http.MultipartRequest('POST', _uploadUri)
        ..fields['upload_preset'] = uploadPreset
        ..fields['folder'] = fullFolder
        ..fields['public_id'] =
            'selfie_${DateTime.now().millisecondsSinceEpoch}';
      request.files.add(
        http.MultipartFile.fromBytes(
          'file',
          bytes,
          filename: 'customer_selfie.jpg',
        ),
      );
      final streamed =
          await request.send().timeout(const Duration(seconds: 25));
      final body = await streamed.stream.bytesToString();
      if (streamed.statusCode >= 200 && streamed.statusCode < 300) {
        final decoded = jsonDecode(body);
        if (decoded is Map && decoded['secure_url'] != null) {
          return decoded['secure_url'].toString();
        }
      }
    } catch (e) {
      debugPrint('PosCloudinaryService Selfie Upload Error: $e');
    }
    return null;
  }
}
