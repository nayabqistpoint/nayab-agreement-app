              'serialsList': serials,
              'isGeneral': cat == 'ELECTRONICS',
              'isCustomEstimate': isCustom,
              'zoneType': zone,
              'productCategory': cat,
            },
            deviceName: customDisplayName ??
                (qty > 1 ? '$rawName (×$qty پیس)' : rawName),
