import 'package:flutter/foundation.dart';
import 'package:hive_flutter/hive_flutter.dart';
import '../constants/box_names.dart';
class HiveBoxManager {
  static Future<void> initialize() async {
    await Hive.initFlutter();
    await Future.wait([
      Hive.openBox<dynamic>(BoxNames.stockBox),
      Hive.openBox<dynamic>(BoxNames.appConfigBox),
      Hive.openBox<dynamic>(BoxNames.shopOrdersBox),
      Hive.openBox<dynamic>(BoxNames.syncStatusBox),
    ]);
  }
  static Box<dynamic> getBox(String boxName) {
    return Hive.box<dynamic>(boxName);
  }
  static Future<void> putBatch({
    required String boxName,
    required Map<String, dynamic> entries,
  }) async {
    final box = getBox(boxName);
    await box.putAll(entries);
    _logPayloadInUrdu(boxName, entries);
  }
  static void _logPayloadInUrdu(
    String boxName,
    Map<String, dynamic> entries,
  ) {
    debugPrint('══════════════════════════════════════════════════════');
    debugPrint('📦 ہائیو باکس میں نیا ڈیٹا محفوظ ہوا: [$boxName]');
    entries.forEach((key, value) {
      debugPrint('🔑 ریکارڈ ID / ٹوکن: $key');
      if (value is Map) {
        value.forEach((fieldKey, fieldVal) {
          final String urduLabel = _translateFieldToUrdu(fieldKey.toString());
          if (fieldKey == 'installments' && fieldVal is List) {
            debugPrint('   • $urduLabel: کل ${fieldVal.length} اقساط کا شیڈول');
          } else {
            debugPrint('   • $urduLabel ($fieldKey): $fieldVal');
          }
        });
      } else {
        debugPrint('   • تفصیل: $value');
      }
    });
    debugPrint('══════════════════════════════════════════════════════');
  }
  static String _translateFieldToUrdu(String key) {
    const Map<String, String> labels = {
      'id': 'شناختی کوڈ',
      'docId': 'دستاویز نمبر',
      'customerName': 'کسٹمر کا نام',
      'customerPhone': 'کسٹمر موبائل نمبر',
      'customerCnic': 'کسٹمر شناختی کارڈ',
      'guarantorName': 'ضامن کا نام',
      'guarantorPhone': 'ضامن موبائل نمبر',
      'sourceMode': 'بکنگ کا ذریعہ',
      'itemName': 'موبائل ماڈل',
      'imeiNo': 'IMEI نمبر',
      'guaranteeType': 'ضمانت کی قسم',
      'bankName': 'بینک کا نام',
      'chequeNo': 'چیک نمبر',
      'totalMonths': 'کل مدت (ماہ)',
      'advance': 'ایڈوانس رقم',
      'monthlyAmount': 'ماہانہ قسط',
      'totalContractAmount': 'کل معاہدہ رقم',
      'status': 'اسٹیٹس',
      'installments': 'اقساط کا شیڈول',
      'isSynced': 'کلاؤڈ سنک اسٹیٹس',
      'updatedAt': 'آخری اپڈیٹ وقت',
      'createdAt': 'تیاری کا وقت',
      'syncedAt': 'کلاؤڈ اپلوڈ وقت',
      'isDeleted': 'حذف شدہ اسٹیٹس',
      'purchasePrice': 'قیمت خرید',
      'salePrice': 'نقد قیمت فروخت',
      'supplierInfo': 'سپلائر معلومات',
      'ramRom': 'میموری (RAM/ROM)',
      'conditionType': 'حالت (نیا/استعمال شدہ)',
      'warranty': 'وارنٹی (ماہ)',
      'color': 'رنگ',
      'reservedOrderId': 'بکنگ آرڈر ID',
      'reservedCustomerInfo': 'بُک برائے کسٹمر',
      'soldToName': 'خریدار کا نام',
      'soldToCnic': 'خریدار شناختی کارڈ',
      'soldDealId': 'معاہدہ نمبر',
    };
    return labels[key] ?? key;
  }
  static Future<void> deleteKey({
    required String boxName,
    required String key,
  }) async {
    final box = getBox(boxName);
    await box.delete(key);
  }
  static Future<void> clearBox(String boxName) async {
    final box = getBox(boxName);
    await box.clear();
  }
  static ValueListenable<Box<dynamic>> listenToBox(
    String boxName, {
    List<dynamic>? keys,
  }) {
    return getBox(boxName).listenable(keys: keys);
  }
}
