<file path="../nayab_shop_pos/lib/features/purchase_market/components/market_stock_section_ui.dart">
import 'package:flutter/material.dart';
import 'package:hive_flutter/hive_flutter.dart';
import '../../../core/constants/box_names.dart';
import '../../../core/database/hive_box_manager.dart';
import '../purchase_market_controller.dart';
import 'market_category_filter_ui.dart';
import 'market_empty_stock_ui.dart';
import 'market_status_search_bar_ui.dart';
import 'market_stock_list_header_ui.dart';
import 'stock_phone_card_ui.dart';
class MarketStockSectionUi extends StatelessWidget {
  final PurchaseMarketController controller;
  final String? customerPhone;
  const MarketStockSectionUi({
    super.key,
    required this.controller,
    this.customerPhone,
  });
  @override
  Widget build(BuildContext context) {
    return ValueListenableBuilder<Box<dynamic>>(
      valueListenable: HiveBoxManager.listenToBox(BoxNames.appConfigBox),
      builder: (context, _, _) {
        return ValueListenableBuilder<Box<dynamic>>(
          valueListenable: controller.boxListenable,
          builder: (context, _, _) {
            return AnimatedBuilder(
              animation: controller,
              builder: (context, _) {
                final allDevices = controller.getAllUnfilteredStockDevices();
                final mobileCount = allDevices
                    .where((d) =>
                        (d['productCategory']?.toString() ?? 'MOBILE') ==
                        'MOBILE')
                    .length;
                final generalCount = allDevices
                    .where((d) =>
                        (d['productCategory']?.toString() ?? 'MOBILE') ==
                        'ELECTRONICS')
                    .length;
                final catDevices = controller.getCategoryFilteredDevices();
                final int availableCnt = catDevices
                    .where((d) =>
                        (d['statusCode']?.toString() ?? '') == 'AVAILABLE')
                    .length;
                final int onOrderCnt = catDevices
                    .where((d) =>
                        (d['statusCode']?.toString() ?? '') == 'ON_ORDER')
                    .length;
                final int reservedCnt = catDevices
                    .where((d) =>
                        (d['statusCode']?.toString() ?? '') == 'RESERVED')
                    .length;
                final int soldCnt = catDevices
                    .where(
                        (d) => (d['statusCode']?.toString() ?? '') == 'SOLD')
                    .length;
                final stockDevices = controller.getStockDevices();
                final readyCount = stockDevices
                    .where((d) =>
                        d['isReserved'] != true && d['isSold'] != true)
                    .length;
                return Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    MarketCategoryFilterUi(
                      selectedCategory: controller.selectedCategory,
                      totalCount: allDevices.length,
                      mobileCount: mobileCount,
                      generalCount: generalCount,
                      onSelect: controller.setCategory,
                    ),
                    MarketStatusSearchBarUi(
                      selectedStatus: controller.selectedStatusFilter,
                      onStatusChanged: controller.setStatusFilter,
                      searchController: controller.searchController,
                      searchQuery: controller.searchQuery,
                      onSearchChanged: controller.updateSearch,
                      onClearSearch: controller.clearSearch,
                      allCount: catDevices.length,
                      availableCount: availableCnt,
                      onOrderCount: onOrderCnt,
                      reservedCount: reservedCnt,
                      soldCount: soldCnt,
                    ),
                    MarketStockListHeaderUi(totalCount: readyCount),
                    const SizedBox(height: 10),
                    if (stockDevices.isEmpty)
                      const MarketEmptyStockUi()
                    else
                      ...List.generate(
                        stockDevices.length,
                        (idx) {
                          final item = stockDevices[idx];
                          return StockPhoneCardUi(
                            item: item,
                            isRibbonExpanded:
                                controller.expandedCardIndex == idx,
                            totalPlans: controller.totalPlansCount,
                            onCardTap: () => controller.navigateToPlanDetail(
                              context,
                              item,
                              customerPhone,
                            ),
                            onToggleRibbon: () => controller.toggleRibbon(idx),
                          );
                        },
                      ),
                  ],
                );
              },
            );
          },
        );
      },
    );
  }
}
</file>

<file path="../nayab_shop_pos/lib/features/purchase_market/components/stock_phone_card_ui.dart">
import 'package:flutter/material.dart';
import '../../../core/constants/app_colors.dart';
import '../../../core/services/cloudinary_image_helper.dart';
import '../../../core/widgets/portable_image_ui.dart';
import 'inline_quick_ribbon_trigger_ui.dart';
import 'inline_two_plan_drawer_ui.dart';
import 'zero_advance_pill_badge_ui.dart';
class StockPhoneCardUi extends StatelessWidget {
  final DataMap item;
  final bool isRibbonExpanded;
  final int totalPlans;
  final VoidCallback onCardTap;
  final VoidCallback onToggleRibbon;
  const StockPhoneCardUi({
    super.key,
    required this.item,
    required this.isRibbonExpanded,
    required this.totalPlans,
    required this.onCardTap,
    required this.onToggleRibbon,
  });
  void _showLockedWarning(
      BuildContext context, bool isSold, String ownerInfo) {
    final msg = isSold
        ? (ownerInfo.isNotEmpty
            ? '🔒 یہ آئٹم پہلے ہی "$ownerInfo" کو فروخت (Sold) ہو چکا ہے!'
            : '🔒 یہ آئٹم پہلے ہی فروخت (Sold) ہو چکا ہے!')
        : (ownerInfo.isNotEmpty
            ? '🔒 یہ آئٹم پہلے ہی "$ownerInfo" کے نام بُک (زیرِ معاہدہ) ہے!'
            : '🔒 یہ آئٹم پہلے ہی کسی گاہک کے نام بُک (زیرِ معاہدہ) ہے!');
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(msg, style: const TextStyle(fontWeight: FontWeight.bold)),
        backgroundColor:
            isSold ? AppColors.primaryEmerald : AppColors.errorRed,
      ),
    );
  }
  @override
  Widget build(BuildContext context) {
    final List images = (item['images'] as List?) ?? const [];
    final String firstImg = images.isNotEmpty
        ? CloudinaryImageHelper.toCardThumbnailUrl(images.first.toString())
        : '';
    final bool hasValidImage = firstImg.trim().isNotEmpty && firstImg != 'null';
    final String statusCode =
        (item['statusCode']?.toString() ?? 'AVAILABLE').toUpperCase();
    final bool isReserved = statusCode == 'RESERVED';
    final bool isSold = statusCode == 'SOLD';
    final bool isOnOrder = statusCode == 'ON_ORDER';
    final bool isLocked = isReserved || isSold;
    final String ownerInfo = isSold
        ? (item['soldToName']?.toString().trim() ?? '')
        : (item['reservedCustomerInfo']?.toString().trim() ?? '');
    final String planSummary = isSold
        ? (item['soldPlanSummary']?.toString().trim() ?? '')
        : (item['reservedPlanSummary']?.toString().trim() ?? '');
    final List<String> customSpecs = (item['dynamicSpecs'] as List?)
            ?.map((e) => e.toString())
            .toList() ??
        const [];
    Color cardBg = AppColors.cardSurface;
    Color borderColor = isRibbonExpanded
        ? AppColors.primaryEmerald
        : AppColors.borderLight;
    Color badgeColor = AppColors.primaryEmerald;
    if (isReserved) {
      cardBg = const Color(0xFFFEF2F2);
      borderColor = AppColors.errorRed.withValues(alpha: 0.55);
      badgeColor = AppColors.errorRed;
    } else if (isSold) {
      cardBg = AppColors.soldCardBg;
      borderColor = AppColors.primaryEmerald.withValues(alpha: 0.55);
      badgeColor = AppColors.primaryEmerald;
    } else if (isOnOrder) {
      badgeColor = const Color(0xFF0F766E);
    }
    final Color innerPillBg =
        isSold ? AppColors.warmTintEmerald : const Color(0xFFFEE2E2);
    final Color innerPillBorder =
        isSold ? AppColors.emeraldPillBorder : AppColors.errorRed.withValues(alpha: 0.4);
    final Color innerTextColor =
        isSold ? AppColors.primaryEmerald : AppColors.errorRed;
    return Container(
      margin: const EdgeInsets.only(bottom: 14),
      decoration: BoxDecoration(
        color: cardBg,
        borderRadius: BorderRadius.circular(14),
        border: Border.all(
          color: borderColor,
          width: isRibbonExpanded ? 1.6 : 1.3,
        ),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withValues(alpha: 0.04),
            blurRadius: 8,
            offset: const Offset(0, 2),
          ),
        ],
      ),
      child: Column(
        children: [
          InkWell(
            borderRadius: BorderRadius.circular(14),
            onTap: isLocked
                ? () => _showLockedWarning(context, isSold, ownerInfo)
                : onCardTap,
            child: Padding(
              padding: const EdgeInsets.all(12),
              child: Row(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  ClipRRect(
                    borderRadius: BorderRadius.circular(10),
                    child: Stack(
                      children: [
                        Container(
                          width: 92,
                          height: 102,
                          color: isReserved
                              ? const Color(0xFFFEE2E2)
                              : (isSold
                                  ? AppColors.warmTintEmerald
                                  : AppColors.warmSubtleSurface),
                          child: PortableImageUi(
                            pathOrUrl: firstImg,
                            fit: BoxFit.cover,
                            fallbackIcon: item['isGeneral'] == true
                                ? Icons.kitchen_outlined
                                : Icons.phone_android_rounded,
                            fallbackIconSize: 42,
                            fallbackColor: badgeColor,
                            showLoader: true,
                          ),
                        ),
                        if (hasValidImage && images.length > 1)
                          Positioned(
                            bottom: 4,
                            left: 4,
                            child: Container(
                              padding: const EdgeInsets.symmetric(
                                horizontal: 5,
                                vertical: 1.5,
                              ),
                              decoration: BoxDecoration(
                                color: Colors.black.withValues(alpha: 0.72),
                                borderRadius: BorderRadius.circular(5),
                              ),
                              child: Row(
                                mainAxisSize: MainAxisSize.min,
                                children: [
                                  const Icon(
                                    Icons.photo_library_rounded,
                                    size: 11,
                                    color: Colors.white,
                                  ),
                                  const SizedBox(width: 3),
                                  Text(
                                    '${images.length}',
                                    style: const TextStyle(
                                      color: Colors.white,
                                      fontSize: 10.5,
                                      fontWeight: FontWeight.bold,
                                    ),
                                  ),
                                ],
                              ),
                            ),
                          ),
                      ],
                    ),
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Row(
                          mainAxisAlignment: MainAxisAlignment.spaceBetween,
                          children: [
                            Expanded(
                              child: Text(
                                item['name'] ?? '',
                                maxLines: 1,
                                overflow: TextOverflow.ellipsis,
                                style: const TextStyle(
                                  fontSize: 16.5,
                                  fontWeight: FontWeight.w900,
                                  color: AppColors.textDark,
                                ),
                              ),
                            ),
                            const SizedBox(width: 6),
                            Container(
                              padding: const EdgeInsets.symmetric(
                                horizontal: 9,
                                vertical: 3.5,
                              ),
                              decoration: BoxDecoration(
                                color: isSold
                                    ? AppColors.warmTintEmerald
                                    : badgeColor,
                                borderRadius: BorderRadius.circular(6),
