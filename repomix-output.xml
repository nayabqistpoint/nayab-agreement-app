import '../../../core/constants/app_colors.dart';
import '../../../core/network/connectivity_service.dart';
import '../../../core/services/pos_cloudinary_service.dart';
import 'order_receipt_storage_handler_service.dart';
class OrderSubmissionService {
  static Future<({bool success, String? error})> submitFullOrder({
    required String tokenNo,
    required DataMap plan,
    required String deviceName,
    required String? stockId,
    required String? imeiNo,
    required String? serialNo,
    required String? sourceMode,
    required bool isCustomEstimate,
    required String zoneType,
    required String productCategory,
    required int effectiveBaseValue,
    required int months,
    required int advance,
    required int monthly,
    required int totalInstallmentSum,
    required int mdmLockFee,
    required String openBoxDeductionText,
    required bool adminOverrideApplied,
    required List<String> acceptedConditions,
    required String customerName,
    required String customerFatherName,
    required String customerCaste,
    required String customerPhone,
    required String customerCnic,
    required String customerAddress,
    required String? customerPhotoPath,
    required String guarantorName,
    required String guarantorFatherName,
    required String guarantorCaste,
    required String guarantorPhone,
    required String guarantorCnic,
    required String guarantorAddress,
    required String guarantorRelation,
    required String? guarantorPhotoPath,
    required String guardianPhone,
    required String bankName,
    required String chequeNo,
  }) async {
    final List<String> planStockIds = (plan['stockIds'] as List?)
            ?.map((e) => e.toString().trim())
            .where((e) => e.isNotEmpty)
            .toList() ??
        (stockId != null && stockId.trim().isNotEmpty
            ? [stockId.trim()]
            : <String>[]);
    final int orderQty = (plan['quantity'] as num?)?.toInt() ??
        (planStockIds.isNotEmpty ? planStockIds.length : 1);
    final availErr = OrderReceiptStorageHandlerService.checkStockAvailabilityError(
      stockId: stockId,
      stockIds: planStockIds,
    );
    if (availErr != null) return (success: false, error: availErr);
    try {
      final isOnline = await ConnectivityService.isOnline;
      String? finalCustPhoto = customerPhotoPath;
      if (finalCustPhoto != null &&
          finalCustPhoto.isNotEmpty &&
          !finalCustPhoto.startsWith('http') &&
          isOnline) {
        final up = await PosCloudinaryService.uploadCustomerSelfie(
          customerCnic: customerCnic,
          pathOrDataUrl: finalCustPhoto,
        );
        if (up != null) finalCustPhoto = up;
      }
      String? finalGuarPhoto = guarantorPhotoPath;
      if (finalGuarPhoto != null &&
          finalGuarPhoto.isNotEmpty &&
          !finalGuarPhoto.startsWith('http') &&
          isOnline) {
        final upG = await PosCloudinaryService.uploadCustomerSelfie(
          customerCnic: guarantorCnic,
          pathOrDataUrl: finalGuarPhoto,
        );
        if (upG != null) finalGuarPhoto = upG;
      }
      final payload = OrderReceiptStorageHandlerService.buildOrderPayload(
        docId: tokenNo,
        customerName: customerName,
        customerFatherName: customerFatherName,
        customerCaste: customerCaste,
        customerPhone: customerPhone,
        customerCnic: customerCnic,
        customerAddress: customerAddress,
        customerPhotoUrl: finalCustPhoto,
        guarantorName: guarantorName,
        guarantorFatherName: guarantorFatherName,
        guarantorCaste: guarantorCaste,
        guarantorPhone: guarantorPhone,
        guarantorCnic: guarantorCnic,
        guarantorAddress: guarantorAddress,
        guarantorRelation: guarantorRelation,
        guarantorPhotoUrl: finalGuarPhoto,
        guardianPhone: guardianPhone,
        sourceMode:
            sourceMode ?? (isCustomEstimate ? 'CUSTOM_ESTIMATE' : 'STOCK'),
        stockId: stockId,
        itemName: deviceName,
        imeiNo: imeiNo,
        serialNo: serialNo,
        guaranteeType: plan['guarantee']?.toString() ?? 'LEGAL_STAMP',
        bankName: bankName,
        chequeNo: chequeNo,
        totalMonths: months,
        advance: advance,
        monthlyAmount: monthly,
        totalContractAmount: totalInstallmentSum,
        orderDateTime: DateTime.now(),
        acceptedSecurityConditions: acceptedConditions,
        mdmLockFee: mdmLockFee,
        openBoxDeductionRule: openBoxDeductionText,
        adminOverrideApplied: adminOverrideApplied,
      );
      payload['isCustomEstimate'] = isCustomEstimate;
      payload['zoneType'] = zoneType;
      payload['productCategory'] = productCategory;
      payload['baseValue'] = effectiveBaseValue;
      payload['quantity'] = orderQty;
      payload['stockIds'] = planStockIds;
      final saved = await OrderReceiptStorageHandlerService.saveOrderRecord(
        tokenNo: tokenNo,
        payload: payload,
      );
      return saved
          ? (success: true, error: null)
          : (
              success: false,
              error: 'آرڈر محفوظ کرتے وقت مسئلہ پیش آیا، دوبارہ کوشش کریں۔'
            );
    } catch (_) {
      return (
        success: false,
        error: 'غیر متوقع خرابی پیش آئی، دوبارہ کوشش کریں۔'
      );
    }
  }
}
