import '../../../core/constants/app_colors.dart';
import '../../device_plan_detail/models/calculator_config_model.dart';
class StockGroupingService {
  static String _extractShortNumber(String stockId) {
    final match = RegExp(r'(\d+)').firstMatch(stockId);
    if (match != null) {
      final numVal = int.tryParse(match.group(1) ?? '');
      if (numVal != null) return '$numVal';
    }
    return stockId.trim();
  }
  static String formatHashBadgeFromIds(List<String> stockIds) {
    final cleanIds =
        stockIds.map((e) => e.trim()).where((e) => e.isNotEmpty).toList();
    if (cleanIds.isEmpty) return '';
    if (cleanIds.length == 1) {
      final numStr = _extractShortNumber(cleanIds.first);
      return numStr.isNotEmpty ? '#$numStr' : '';
    }
    final firstNum = _extractShortNumber(cleanIds.first);
    final lastNum = _extractShortNumber(cleanIds.last);
    if (firstNum.isNotEmpty && lastNum.isNotEmpty) {
      return firstNum == lastNum ? '#$firstNum' : '#$firstNum-$lastNum';
    }
    return '';
  }
  static String _resolveImeiOrSerial(DataMap dev, Map rawStock) {
    final candidates = [
      rawStock['imeiNo'],
      rawStock['imei'],
      dev['imeiNo'],
      rawStock['serialNo'],
      rawStock['serial'],
      dev['serialNo'],
    ];
    for (final c in candidates) {
      final s = (c?.toString() ?? '').trim();
      if (s.isNotEmpty && s.toLowerCase() != 'null') {
        return s.toLowerCase();
      }
    }
    return 'stk_${dev['stockId'].toString().trim().toLowerCase()}';
  }
  static String buildDynamicGroupKey(
    DataMap dev,
    Map rawStock,
    List<String> groupingMatchKeys,
  ) {
    final List<String> parts = [
      dev['productCategory'].toString().trim().toUpperCase(),
    ];
    for (final ruleKey in groupingMatchKeys) {
      if (ruleKey == 'images') {
        final imgs = (dev['images'] as List?)
                ?.map((e) => e.toString().trim())
                .where((e) => e.isNotEmpty && e != 'null')
                .toList() ??
            const <String>[];
        parts.add('imgs:${imgs.join(",")}');
      } else if (ruleKey == 'itemName') {
        parts.add('name:${dev['name'].toString().trim().toLowerCase()}');
      } else if (ruleKey == 'imeiNo' ||
          ruleKey == 'imei' ||
          ruleKey == 'serialNo' ||
          ruleKey == 'serial' ||
          ruleKey == 'imeiOrSerial') {
        parts.add('code:${_resolveImeiOrSerial(dev, rawStock)}');
      } else if (ruleKey == 'purchasePrice') {
        final pPrice = (rawStock['purchasePrice']?.toString() ?? '0').trim();
        parts.add('pPrice:$pPrice');
      } else if (ruleKey == 'salePrice') {
        parts.add('sPrice:${dev['baseValue']}');
      } else if (ruleKey == 'supplier') {
        final sup =
            (rawStock['supplierInfo']?.toString() ?? '').trim().toLowerCase();
        parts.add('sup:$sup');
      } else if (ruleKey == 'specs') {
        parts.add('specs:${dev['ramRom'].toString().trim().toLowerCase()}');
      } else if (ruleKey == 'color') {
        parts.add('color:${dev['color'].toString().trim().toLowerCase()}');
      } else if (ruleKey == 'condition') {
        parts.add('cond:${dev['condition'].toString().trim().toLowerCase()}');
      } else if (ruleKey == 'warranty') {
        parts.add('war:${dev['warranty'].toString().trim().toLowerCase()}');
      } else {
        final dynVal =
            (rawStock[ruleKey]?.toString() ?? '').trim().toLowerCase();
        parts.add('$ruleKey:$dynVal');
      }
    }
    return parts.join('|');
  }
  static List<DataMap> groupAndSortDevices({
    required List<DataMap> individualDevices,
    required Map<String, Map> rawStockById,
    required CalculatorConfigModel config,
  }) {
    individualDevices.sort((a, b) {
      final idA = a['stockId']?.toString() ?? '';
      final idB = b['stockId']?.toString() ?? '';
      return idA.compareTo(idB);
    });
    final Map<String, DataMap> groupedAvailable = {};
    final List<DataMap> result = [];
    for (final dev in individualDevices) {
      final code = dev['statusCode']?.toString() ?? 'AVAILABLE';
      if (code == 'AVAILABLE') {
        final stkId = dev['stockId'].toString();
        final rawStock = rawStockById[stkId] ?? const {};
        final activeKeys = dev['isGeneral'] == true
            ? config.generalGroupingMatchKeys
            : config.mobileGroupingMatchKeys;
        final groupKey = buildDynamicGroupKey(dev, rawStock, activeKeys);
        if (!groupedAvailable.containsKey(groupKey)) {
          groupedAvailable[groupKey] = {
            ...dev,
            'availableQty': 1,
            'availableStockIds': [stkId],
            'stockHashBadge': formatHashBadgeFromIds([stkId]),
            'status': '1 دستیاب',
            'images': List<String>.from(dev['images'] as List? ?? const []),
          };
        } else {
          final existing = groupedAvailable[groupKey]!;
          final nextQty = ((existing['availableQty'] as int?) ?? 1) + 1;
          final ids =
              List<String>.from(existing['availableStockIds'] as List? ?? [])
                ..add(stkId);
          existing['availableQty'] = nextQty;
          existing['availableStockIds'] = ids;
          existing['stockHashBadge'] = formatHashBadgeFromIds(ids);
          existing['status'] = '$nextQty دستیاب';
          final mergedImages =
              List<String>.from(existing['images'] as List? ?? const []);
          final nextUnitImages =
              (dev['images'] as List?)?.map((e) => e.toString().trim()) ??
                  const <String>[];
          for (final imgUrl in nextUnitImages) {
            if (imgUrl.isNotEmpty &&
                imgUrl != 'null' &&
                !mergedImages.contains(imgUrl) &&
                mergedImages.length < 15) {
              mergedImages.add(imgUrl);
            }
          }
          existing['images'] = mergedImages;
        }
      } else {
        result.add(dev);
      }
    }
    result.addAll(groupedAvailable.values);
    int statusWeight(String code) {
      if (code == 'AVAILABLE') return 0;
      if (code == 'ON_ORDER') return 1;
      if (code == 'RESERVED') return 2;
      return 3;
    }
    result.sort((a, b) {
      final wA = statusWeight(a['statusCode']?.toString() ?? 'AVAILABLE');
      final wB = statusWeight(b['statusCode']?.toString() ?? 'AVAILABLE');
      if (wA != wB) return wA.compareTo(wB);
      final idA = a['stockId']?.toString() ?? '';
      final idB = b['stockId']?.toString() ?? '';
      return idA.compareTo(idB);
    });
    return result;
  }
}
