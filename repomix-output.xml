            ),
          ),
          const SizedBox(height: 6),
          ValueListenableBuilder(
            valueListenable: HiveBoxManager.listenToBox(BoxNames.tagsBox),
            builder: (context, box, _) {
              final allTags = TagsBankService.getAllActiveTags();
              return SizedBox(
                height: 36,
