import 'package:flutter/material.dart';
import '../../../core/constants/app_colors.dart';
import 'guardian_whatsapp_notice_ui.dart';
class SecurityBarrierItem {
  final String id;
  final String text;
  final bool isChecked;
  const SecurityBarrierItem({
    required this.id,
    required this.text,
    required this.isChecked,
  });
}
class SecurityBarrierChecklistCardUi extends StatelessWidget {
  final List<SecurityBarrierItem> items;
  final ValueChanged<String> onToggleItem;
  final bool isRiskOverLimit;
  final bool isAdminOverrideApproved;
  final int maxRiskLimit;
  final int baseValue;
  final int advancePaid;
  final int netRiskAmount;
  final TextEditingController guardianPhoneCtrl;
  final bool isGuardianNoticeSent;
  final VoidCallback onGuardianNoticeTriggered;
  final String customerName;
  final String deviceName;
  final VoidCallback onOpenAdminOverrideDialog;
  const SecurityBarrierChecklistCardUi({
    super.key,
    required this.items,
    required this.onToggleItem,
    required this.isRiskOverLimit,
    required this.isAdminOverrideApproved,
    required this.maxRiskLimit,
    required this.baseValue,
    required this.advancePaid,
    required this.netRiskAmount,
    required this.guardianPhoneCtrl,
    required this.isGuardianNoticeSent,
    required this.onGuardianNoticeTriggered,
    required this.customerName,
    required this.deviceName,
    required this.onOpenAdminOverrideDialog,
  });
  @override
  Widget build(BuildContext context) {
    final bool allChecked = items.every((e) => e.isChecked);
    final bool isEverythingComplete = allChecked && isGuardianNoticeSent;
    final bool isBlockedByLimit = isRiskOverLimit && !isAdminOverrideApproved;
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 10),
      decoration: BoxDecoration(
        color: isBlockedByLimit
            ? const Color(0xFFFEF2F2)
            : (isEverythingComplete
                ? AppColors.warmTintEmerald
                : const Color(0xFFFAF3DD)),
        borderRadius: BorderRadius.circular(11),
        border: Border.all(
          color: isBlockedByLimit
              ? AppColors.errorRed
              : (isEverythingComplete
                  ? AppColors.primaryEmerald
                  : Colors.amber.shade700),
          width: 1.2,
        ),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 2),
            child: Row(
              children: [
                Icon(
                  isBlockedByLimit
                      ? Icons.gpp_bad_rounded
                      : (isEverythingComplete
                          ? Icons.verified_user_rounded
                          : Icons.policy_outlined),
                  color: isBlockedByLimit
                      ? AppColors.errorRed
                      : (isEverythingComplete
                          ? AppColors.primaryEmerald
                          : Colors.amber.shade900),
                  size: 21,
                ),
                const SizedBox(width: 6),
                Expanded(
                  child: Text(
                    isBlockedByLimit
                        ? 'انتظامی منظوری درکار (نیٹ ادھار رسک حد سے زائد)'
                        : 'لازمی سیکیورٹی شرائط و سرپرست کی اطلاع (سب مکمل کرنا لازمی):',
                    style: TextStyle(
                      fontSize: 14,
                      fontWeight: FontWeight.w900,
                      color: isBlockedByLimit
                          ? AppColors.errorRed
                          : AppColors.textDark,
                    ),
                  ),
                ),
              ],
            ),
          ),
          const SizedBox(height: 8),
          if (isRiskOverLimit) ...[
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 9),
              margin: const EdgeInsets.only(bottom: 10),
              decoration: BoxDecoration(
                color: isAdminOverrideApproved
                    ? Colors.green.shade100
                    : Colors.red.shade100,
                borderRadius: BorderRadius.circular(9),
                border: Border.all(
                  color: isAdminOverrideApproved
                      ? Colors.green.shade700
                      : Colors.red.shade700,
                  width: 1.1,
                ),
              ),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    isAdminOverrideApproved
                        ? '✅ انتظامیہ کی خصوصی منظوری سے یہ آرڈر بحال کر دیا گیا ہے۔'
                        : '⚠️ اس سودے میں نیٹ ادھار رسک رقم (قیمت Rs. $baseValue - ایڈوانس Rs. $advancePaid = Rs. $netRiskAmount) مقررہ رسک حد (Rs. $maxRiskLimit) سے زیادہ ہے۔ برائے مہربانی ایڈوانس بڑھائیں یا انتظامیہ سے منظوری لیں۔',
                    style: TextStyle(
                      fontSize: 13.5,
                      fontWeight: FontWeight.w900,
                      color: isAdminOverrideApproved
                          ? Colors.green.shade900
                          : Colors.red.shade900,
                      height: 1.45,
                    ),
                  ),
                  if (!isAdminOverrideApproved) ...[
                    const SizedBox(height: 8),
                    SizedBox(
                      width: double.infinity,
                      child: ElevatedButton.icon(
                        onPressed: onOpenAdminOverrideDialog,
                        icon: const Icon(
                          Icons.admin_panel_settings_outlined,
                          size: 19,
                        ),
                        label: const Text(
                          'انتظامی خصوصی منظوری (Admin PIN)',
                          style: TextStyle(
                            fontSize: 13.5,
                            fontWeight: FontWeight.w900,
                          ),
                        ),
                        style: ElevatedButton.styleFrom(
                          backgroundColor: Colors.red.shade800,
                          foregroundColor: Colors.white,
                          padding: const EdgeInsets.symmetric(vertical: 10),
                          shape: RoundedRectangleBorder(
                            borderRadius: BorderRadius.circular(8),
                          ),
                        ),
                      ),
                    ),
                  ],
                ],
              ),
            ),
          ],
          ...items.map(
            (item) => InkWell(
              onTap: isBlockedByLimit ? null : () => onToggleItem(item.id),
              borderRadius: BorderRadius.circular(8),
              child: Padding(
                padding:
                    const EdgeInsets.symmetric(horizontal: 2, vertical: 4.5),
                child: Row(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    SizedBox(
                      width: 24,
                      height: 24,
                      child: Checkbox(
                        value: item.isChecked,
                        activeColor: AppColors.primaryEmerald,
                        onChanged: isBlockedByLimit
                            ? null
                            : (_) => onToggleItem(item.id),
                      ),
                    ),
                    const SizedBox(width: 7),
                    Expanded(
                      child: Text(
                        item.text,
                        style: TextStyle(
                          fontSize: 13.5,
                          fontWeight: item.isChecked
                              ? FontWeight.w900
                              : FontWeight.w700,
                          color: isBlockedByLimit
                              ? Colors.black38
                              : AppColors.textDark,
                          height: 1.4,
                        ),
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ),
          const Divider(height: 14, color: AppColors.borderLight),
          GuardianWhatsappNoticeUi(
            guardianPhoneCtrl: guardianPhoneCtrl,
            isBlockedByLimit: isBlockedByLimit,
            isGuardianNoticeSent: isGuardianNoticeSent,
            onGuardianNoticeTriggered: onGuardianNoticeTriggered,
            customerName: customerName,
            deviceName: deviceName,
          ),
        ],
      ),
    );
  }
}
