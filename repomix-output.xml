import 'package:firebase_core/firebase_core.dart';
import 'package:flutter/material.dart';
import 'core/constants/app_colors.dart';
import 'core/database/hive_box_manager.dart';
import 'core/security/device_activation_gate_ui.dart';
import 'core/security/device_license_service.dart';
import 'core/security/screen_protector_service.dart';
import 'core/services/permanent_image_cache_service.dart';
import 'features/purchase_market/purchase_market_page.dart';
import 'firebase_options.dart';
import 'sync/master_sync_hub.dart';
void main() async {
  WidgetsFlutterBinding.ensureInitialized();
  try {
    await Firebase.initializeApp(
      options: DefaultFirebaseOptions.currentPlatform,
    );
  } catch (_) {}
  await HiveBoxManager.initialize();
  await PermanentImageCacheService.initialize();
  await ScreenProtectorService.enableSecureFlag();
  MasterSyncHub.startWatcher();
  MasterSyncHub.syncAll();
  runApp(const NayabShopPosApp());
}
class NayabShopPosApp extends StatefulWidget {
  const NayabShopPosApp({super.key});
  @override
  State<NayabShopPosApp> createState() => _NayabShopPosAppState();
}
class _NayabShopPosAppState extends State<NayabShopPosApp>
    with WidgetsBindingObserver {
  @override
  void initState() {
    super.initState();
    WidgetsBinding.instance.addObserver(this);
    DeviceLicenseService.startPeriodicLocationTracking();
  }
  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    if (state == AppLifecycleState.resumed) {
      ScreenProtectorService.enableSecureFlag();
      DeviceLicenseService.registerOrHeartbeatDevice();
      MasterSyncHub.syncAll();
      if (mounted) setState(() {});
    }
  }
  @override
  void dispose() {
    WidgetsBinding.instance.removeObserver(this);
    super.dispose();
  }
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'نایاب قسط پوائنٹ - شاپ پلانز',
      debugShowCheckedModeBanner: false,
      builder: (context, child) {
        final mediaQuery = MediaQuery.of(context);
        return MediaQuery(
          data: mediaQuery.copyWith(
            textScaler: const TextScaler.linear(AppColors.globalTextScale),
          ),
          child: DeviceActivationGateUi(
            child: child ?? const SizedBox.shrink(),
          ),
        );
      },
      theme: AppColors.buildAppTheme(),
      home: const PurchaseMarketPage(),
    );
  }
}
