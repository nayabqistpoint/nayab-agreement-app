class AgreementQrPayloadService {
  static String buildJsonPayload({
    required String deviceName,
    String? imeiNo,
    required int totalContractAmount,
    required int advance,
    required int monthlyAmount,
    required int totalMonths,
    required String guaranteeType,
    String? bankName,
    String? chequeNo,
    String? customerName,
    String? customerPhone,
    String? customerCnic,
    String? guarantorName,
    String? guarantorPhone,
    String? firstDueDate,
  }) {
    final bool isCheque = guaranteeType == 'BANK_CHEQUE';
    final Map<String, String> payload = {
      'موبائل ماڈل': deviceName.trim(),
      'ٹوٹل رقم': totalContractAmount.toString(),
      'ایڈوانس رقم': advance.toString(),
      'ماہانہ قسط': monthlyAmount.toString(),
      'مدت': '$totalMonths ماہ',
      'ضمانت': isCheque ? 'بینک چیک گارنٹی' : 'قانونی اشٹام و پرنوٹ',
    };
    if (imeiNo != null && imeiNo.trim().isNotEmpty) {
      payload['IMEI نمبر'] = imeiNo.trim();
    }
    if (customerName != null && customerName.trim().isNotEmpty) {
      payload['کسٹمر کا نام'] = customerName.trim();
    }
    if (customerPhone != null && customerPhone.trim().isNotEmpty) {
      payload['رابطہ نمبر'] = customerPhone.trim();
    }
    if (customerCnic != null && customerCnic.trim().isNotEmpty) {
      payload['شناختی کارڈ'] = customerCnic.trim();
    }
    if (guarantorName != null && guarantorName.trim().isNotEmpty) {
      payload['ضامن کا نام'] = guarantorName.trim();
    }
    if (guarantorPhone != null && guarantorPhone.trim().isNotEmpty) {
      payload['ضامن کا فون'] = guarantorPhone.trim();
    }
    if (isCheque && bankName != null && bankName.trim().isNotEmpty) {
      payload['بینک کا نام'] = bankName.trim();
    }
    if (isCheque && chequeNo != null && chequeNo.trim().isNotEmpty) {
      payload['چیک نمبر'] = chequeNo.trim();
    }
    if (firstDueDate != null && firstDueDate.trim().isNotEmpty) {
      payload['تاریخ ادائیگی'] = firstDueDate.trim();
    }
    final encoded = jsonEncode(payload);
    debugPrint('══════════════════════════════════════════════════════');
    debugPrint('📲 آف لائن معاہدہ QR JSON پے لوڈ تیار ہوا:');
    payload.forEach((k, v) {
      debugPrint('   • $k: $v');
    });
    debugPrint('══════════════════════════════════════════════════════');
    return encoded;
  }
}
