<file path="lib/features/agreement_counter/services/counter_render_service.dart">
import 'dart:typed_data';
import 'dart:ui' as ui;
import 'package:file_picker/file_picker.dart';
import 'package:flutter/material.dart';
import 'package:flutter/rendering.dart';
import 'package:pdf/pdf.dart';
import 'package:pdf/widgets.dart' as pw;
import 'package:printing/printing.dart';
class CounterRenderService {
  static Future<List<Uint8List?>> renderPdfPages(Uint8List? pdfBytes) async {
    if (pdfBytes == null) return [];
    List<Uint8List?> pages = [];
    try {
      await for (final page in Printing.raster(pdfBytes, dpi: 300)) {
        pages.add(await page.toPng());
      }
    } catch (_) {}
    return pages;
  }
  static Future<PlatformFile?> pickStampFile() async {
    final res = await FilePicker.platform.pickFiles(
      type: FileType.custom,
      allowedExtensions: ['pdf'],
      withData: true,
    );
    if (res != null && res.files.isNotEmpty) {
      return res.files.single;
    }
    return null;
  }
  static Future<void> printSelectivePages({
    required List<GlobalKey> allKeys,
    required List<int> pageIndexesToPrint,
    required String docTitle,
    required PdfPageFormat targetFormat,
  }) async {
    if (pageIndexesToPrint.isEmpty) return;
    final pdfDocument = pw.Document(title: docTitle);
    for (final index in pageIndexesToPrint) {
      if (index >= allKeys.length) continue;
      final key = allKeys[index];
      final boundary = key.currentContext?.findRenderObject() as RenderRepaintBoundary?;
      if (boundary == null) continue;
      final ui.Image image = await boundary.toImage(pixelRatio: 3.5);
      final ByteData? byteData = await image.toByteData(format: ui.ImageByteFormat.png);
      if (byteData == null) continue;
      final Uint8List pngBytes = byteData.buffer.asUint8List();
      final pw.MemoryImage pdfImage = pw.MemoryImage(pngBytes);
      pdfDocument.addPage(
        pw.Page(
          pageFormat: targetFormat,
          margin: pw.EdgeInsets.zero,
          build: (pw.Context context) {
            return pw.FullPage(
              ignoreMargins: true,
              child: pw.Image(pdfImage, fit: pw.BoxFit.fill),
            );
          },
        ),
      );
    }
    final Uint8List generatedPdf = await pdfDocument.save();
    await Printing.layoutPdf(
      name: '$docTitle.pdf',
      onLayout: (PdfPageFormat format) async => generatedPdf,
    );
  }
}
</file>

<file path="lib/features/agreement_counter/services/counter_storage_handler_service.dart">
import 'package:flutter/foundation.dart';
import '../../../core/constants/box_names.dart';
import '../../../core/database/hive_box_manager.dart';
class CounterStorageHandlerService {
  static Map<dynamic, dynamic> getDraft() {
    try {
      final box = HiveBoxManager.getBox(BoxNames.agreementDraftBox);
      return box.toMap();
    } catch (_) {
      return {};
    }
  }
  static Future<void> saveDraftBatch(Map<String, dynamic> payload) async {
    try {
      final box = HiveBoxManager.getBox(BoxNames.agreementDraftBox);
      await box.putAll(payload);
    } catch (e) {
      debugPrint('CounterStorageHandlerService saveDraft Error: $e');
    }
  }
  static ValueListenable listenToDraft() {
    return HiveBoxManager.listenToBox(BoxNames.agreementDraftBox);
  }
  static ValueListenable listenToTemplates() {
    return HiveBoxManager.listenToBox(BoxNames.templatesBox);
  }
  static Map<String, Map<String, dynamic>> getAllTemplates() {
    try {
      final box = HiveBoxManager.getBox(BoxNames.templatesBox);
      final Map<String, Map<String, dynamic>> map = {};
      for (var key in box.keys) {
        final val = box.get(key);
        if (val is Map) {
          map[key.toString()] = Map<String, dynamic>.from(val);
        }
      }
      return map;
    } catch (_) {
      return {};
    }
  }
  static Future<bool> deleteTemplate(String title) async {
    try {
      final box = HiveBoxManager.getBox(BoxNames.templatesBox);
      await box.delete(title.trim());
      final draftBox = HiveBoxManager.getBox(BoxNames.agreementDraftBox);
      if (draftBox.get('selected_template') == title.trim()) {
        await draftBox.delete('selected_template');
      }
      return true;
    } catch (e) {
      debugPrint('CounterStorageHandlerService deleteTemplate Error: $e');
      return false;
    }
  }
}
</file>

<file path="lib/features/customer_directory/customer_directory_controller.dart">
import 'package:flutter/material.dart';
import '../../core/constants/box_names.dart';
import '../../core/database/hive_box_manager.dart';
import '../../core/models/customer_deal_model.dart';
import '../../core/models/customer_profile_model.dart';
import 'services/customer_deal_history_service.dart';
import 'services/customer_notice_generator_service.dart';
class CustomerDirectoryController extends ChangeNotifier {
  final TextEditingController searchController = TextEditingController();
  List<CustomerProfileModel> allCustomers = [];
  List<CustomerProfileModel> filteredCustomers = [];
  bool isLoading = false;
  List<CustomerProfileModel> get filteredProfiles => filteredCustomers;
  void init() {
    loadCustomers();
    searchController.addListener(_onSearchChanged);
  }
  void loadProfiles() => loadCustomers();
  void updateSearch(String query) {
    searchController.text = query;
  }
  void loadCustomers() {
    isLoading = true;
    notifyListeners();
    try {
      final box = HiveBoxManager.getBox(BoxNames.customersBox);
      final List<CustomerProfileModel> loaded = [];
      for (var key in box.keys) {
        final raw = box.get(key);
        if (raw is Map) {
          final profile = CustomerProfileModel.fromMap(Map<String, dynamic>.from(raw));
          if (!profile.isDeleted) {
            loaded.add(profile);
          }
        }
      }
      allCustomers = loaded;
      _applyFilter();
    } catch (e) {
      debugPrint('Error loading customers: $e');
    }
    isLoading = false;
    notifyListeners();
  }
  void _onSearchChanged() {
    _applyFilter();
    notifyListeners();
  }
  void _applyFilter() {
    final query = searchController.text.trim().toLowerCase();
    if (query.isEmpty) {
      filteredCustomers = List.from(allCustomers);
    } else {
      filteredCustomers = allCustomers.where((c) {
        final nameMatch = c.fullName.toLowerCase().contains(query);
        final cnicMatch = c.cnic.replaceAll('-', '').contains(query.replaceAll('-', ''));
        final phoneMatch = c.phone.contains(query);
        return nameMatch || cnicMatch || phoneMatch;
      }).toList();
    }
  }
  List<CustomerDealModel> fetchDealsForCustomer(String cnic) {
    return CustomerDealHistoryService.getCustomerDeals(cnic);
  }
  Future<void> createNoticeForDeal(CustomerDealModel deal) async {
    await CustomerNoticeGeneratorService.prepareNoticeInDraft(deal);
  }
  @override
  void dispose() {
    searchController.removeListener(_onSearchChanged);
    searchController.dispose();
    super.dispose();
  }
}
</file>

