<file path="../nayab_shop_pos/lib/sync/master_sync_hub.dart">
import 'package:flutter/foundation.dart';
import '../core/constants/box_names.dart';
import '../core/database/hive_box_manager.dart';
import '../core/network/connectivity_service.dart';
import 'pull/config_pull_service.dart';
import 'pull/stock_pull_service.dart';
import 'push/orders_push_service.dart';
import 'status/sync_status_service.dart';
class MasterSyncHub {
  static bool _watcherStarted = false;
  static bool _isSyncing = false;
  static void startWatcher() {
    if (_watcherStarted) return;
    _watcherStarted = true;
    HiveBoxManager.listenToBox(BoxNames.shopOrdersBox).addListener(() {
      syncAll();
    });
    ConfigPullService.startRealtimeListener();
    StockPullService.startRealtimeListener();
  }
  static Future<void> syncAll() async {
    if (_isSyncing) return;
    _isSyncing = true;
    try {
      SyncStatusService.setState(SyncState.syncing);
      await ConfigPullService.pullConfig();
      await StockPullService.pullStock();
      final online = await ConnectivityService.isOnline;
      if (!online) {
        SyncStatusService.setState(SyncState.offline);
        return;
      }
      await OrdersPushService.pushUnsyncedOrders();
      SyncStatusService.setState(SyncState.synced);
    } catch (e) {
      debugPrint('MasterSyncHub Error: $e');
      SyncStatusService.setState(SyncState.offline);
    } finally {
      _isSyncing = false;
    }
  }
  static Future<void> dispose() async {
    await ConfigPullService.stopRealtimeListener();
    await StockPullService.stopRealtimeListener();
    _watcherStarted = false;
  }
}
</file>

