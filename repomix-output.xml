class PurchaseMarketStorageService {
  static ValueListenable<Box<dynamic>> get stockListenable {
    return HiveBoxManager.listenToBox(BoxNames.stockBox);
  }
  static List<dynamic> getAllRawStock() {
    try {
      final currentBox = HiveBoxManager.getBox(BoxNames.stockBox);
      return currentBox.keys.map((k) {
        return {'key': k, 'data': currentBox.get(k)};
      }).toList();
    } catch (_) {
      return const [];
    }
  }
  static String resolveOrderSummaryFromHive(
    Map rawStock, {
    required bool isSold,
    required String stockId,
  }) {
    final directKey = isSold ? 'soldPlanSummary' : 'reservedPlanSummary';
    final directSummary = rawStock[directKey]?.toString().trim() ?? '';
    if (directSummary.isNotEmpty && directSummary != 'null') {
      return directSummary;
    }
    try {
      final ordersBox = HiveBoxManager.getBox(BoxNames.shopOrdersBox);
      final orderId = rawStock['reservedOrderId']?.toString().trim() ?? '';
      if (orderId.isNotEmpty && orderId != 'null') {
        final rawOrder = ordersBox.get(orderId);
        if (rawOrder is Map) {
          final formatted = _formatOrderSummary(rawOrder);
          if (formatted.isNotEmpty) return formatted;
        }
      }
      final soldCnic = rawStock['soldToCnic']?.toString().trim() ?? '';
      for (final k in ordersBox.keys) {
        final rawOrder = ordersBox.get(k);
        if (rawOrder is Map && rawOrder['isDeleted'] != true) {
          final oStockId = rawOrder['stockId']?.toString().trim() ?? '';
          final oCnic = rawOrder['customerCnic']?.toString().trim() ?? '';
          if ((stockId.isNotEmpty && oStockId == stockId) ||
              (soldCnic.isNotEmpty && oCnic == soldCnic)) {
            final formatted = _formatOrderSummary(rawOrder);
            if (formatted.isNotEmpty) return formatted;
          }
        }
      }
    } catch (_) {}
    return '';
  }
  static String _formatOrderSummary(Map orderMap) {
    final int months = (orderMap['totalMonths'] as num?)?.toInt() ?? 0;
    final int adv = (orderMap['advance'] as num?)?.toInt() ?? 0;
    final int monthly = (orderMap['monthlyAmount'] as num?)?.toInt() ?? 0;
    final String gType =
        (orderMap['guaranteeType']?.toString() ?? '') == 'BANK_CHEQUE'
            ? 'بینک چیک'
            : 'اشٹام پرنوٹ';
    final String advText = adv > 0 ? 'ایڈوانس: Rs. $adv' : '⭐ بغیر ایڈوانس';
    if (months > 0 && monthly > 0) {
      return '$months ماہ • $advText • قسط: Rs. $monthly/ماہ ($gType)';
    }
    return '';
  }
}
