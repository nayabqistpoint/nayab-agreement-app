import 'package:flutter/material.dart';
class DynamicPageSplitter {
  static const double legalWidth = 612.0;
  static const double legalHeight = 1008.0;
  static Map<String, List<String>> splitTextForPages({
    required String fullText,
    required TextStyle style,
    required double topMarginP1,
    required double bottomMarginP1,
    required double sideMargin,
    required double topMarginP2,
    required double bottomMarginP2,
  }) {
    final double usableWidth = legalWidth - (sideMargin * 2);
    final double p1UsableHeight = (legalHeight - topMarginP1 - bottomMarginP1).clamp(50.0, legalHeight);
    final double p2UsableHeight = (legalHeight - topMarginP2 - bottomMarginP2).clamp(50.0, legalHeight);
    final double lineHeight = (style.fontSize ?? 12.0) * 1.7;
    List<String> rawParagraphs = fullText.split('\n');
    List<String> allLines = [];
    for (var para in rawParagraphs) {
      if (para.trim().isEmpty) {
        allLines.add("");
        continue;
      }
      final textSpan = TextSpan(text: para, style: style);
      final textPainter = TextPainter(
        text: textSpan,
        textDirection: TextDirection.rtl,
      );
      textPainter.layout(maxWidth: usableWidth);
      final metrics = textPainter.computeLineMetrics();
      if (metrics.isEmpty) {
        allLines.add(para);
      } else {
        int charsPerLine = (para.length / metrics.length).ceil();
        int start = 0;
        for (int i = 0; i < metrics.length; i++) {
          int end = (start + charsPerLine > para.length) ? para.length : start + charsPerLine;
          allLines.add(para.substring(start, end));
          start = end;
        }
      }
    }
    final int maxLinesPage1 = (p1UsableHeight / lineHeight).floor();
    final int maxLinesPage2 = (p2UsableHeight / lineHeight).floor();
    List<String> page1Lines = [];
    List<String> page2Lines = [];
    for (int i = 0; i < allLines.length; i++) {
      if (i < maxLinesPage1) {
        page1Lines.add(allLines[i]);
      } else if (i < (maxLinesPage1 + maxLinesPage2)) {
        page2Lines.add(allLines[i]);
      }
    }
    return {
      "page1": page1Lines,
      "page2": page2Lines,
    };
  }
}
