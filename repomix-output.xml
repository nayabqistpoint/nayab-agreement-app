import 'package:flutter/material.dart';
import 'package:url_launcher/url_launcher.dart';
import '../../../core/constants/app_colors.dart';
class SecurityBarrierItem {
  final String id;
  final String text;
  final bool isChecked;
  const SecurityBarrierItem({
    required this.id,
    required this.text,
    required this.isChecked,
  });
}
class SecurityBarrierChecklistCardUi extends StatefulWidget {
  final List<SecurityBarrierItem> items;
  final ValueChanged<String> onToggleItem;
  final bool isRiskOverLimit;
  final bool isAdminOverrideApproved;
  final int maxRiskLimit;
  final int baseValue;
  final int advancePaid;
  final int netRiskAmount;
  final TextEditingController guardianPhoneCtrl;
  final bool isGuardianNoticeSent;
  final VoidCallback onGuardianNoticeTriggered;
  final String customerName;
  final String deviceName;
  final VoidCallback onOpenAdminOverrideDialog;
  const SecurityBarrierChecklistCardUi({
    super.key,
    required this.items,
    required this.onToggleItem,
    required this.isRiskOverLimit,
    required this.isAdminOverrideApproved,
    required this.maxRiskLimit,
    required this.baseValue,
    required this.advancePaid,
    required this.netRiskAmount,
    required this.guardianPhoneCtrl,
    required this.isGuardianNoticeSent,
    required this.onGuardianNoticeTriggered,
    required this.customerName,
    required this.deviceName,
    required this.onOpenAdminOverrideDialog,
  });
  @override
  State<SecurityBarrierChecklistCardUi> createState() =>
      _SecurityBarrierChecklistCardUiState();
}
class _SecurityBarrierChecklistCardUiState
    extends State<SecurityBarrierChecklistCardUi> {
  String? _inlineStatusMsg;
  String? _fallbackMessage;
  Future<void> _openGuardianWhatsAppChat() async {
    final cleanDigits =
        widget.guardianPhoneCtrl.text.trim().replaceAll(RegExp(r'[^0-9]'), '');
    if (cleanDigits.length < 10) {
      setState(() {
        _inlineStatusMsg =
            '⚠️ برائے مہربانی والد یا سرپرست کا درست 11 ہندسوں کا موبائل نمبر درج کریں!';
        _fallbackMessage = null;
      });
      return;
    }
    String formattedPhone = cleanDigits;
    if (formattedPhone.startsWith('0')) {
      formattedPhone = '92${formattedPhone.substring(1)}';
    } else if (!formattedPhone.startsWith('92')) {
      formattedPhone = '92$formattedPhone';
    }
    final cName = widget.customerName.trim().isEmpty
        ? 'آپ کے عزیز'
        : widget.customerName.trim();
    final dName = widget.deviceName.trim().isEmpty
        ? 'موبائل فون'
        : widget.deviceName.trim();
    final noticeText =
        'السلام علیکم! نایاب قسط پوائنٹ سے اطلاع دی جاتی ہے کہ $cName نے ہمارے شوروم سے $dName اقساط پر خریدنے کی درخواست دی ہے اور آپ کا نمبر بطور سرپرست درج کروایا ہے۔ شکریہ!';
    final encodedMsg = Uri.encodeComponent(noticeText);
    final waUri = Uri.parse('https://wa.me/$formattedPhone?text=$encodedMsg');
    widget.onGuardianNoticeTriggered();
    bool launched = false;
    try {
      launched = await launchUrl(
        waUri,
        mode: LaunchMode.externalApplication,
      );
    } catch (_) {
      launched = false;
    }
    if (!launched) {
      try {
        launched = await launchUrl(
          waUri,
          mode: LaunchMode.platformDefault,
        );
      } catch (_) {
        launched = false;
      }
    }
    if (!mounted) return;
    setState(() {
      if (launched) {
        _inlineStatusMsg =
            '✅ سرپرست ($cleanDigits) کی واٹس ایپ چیٹ کھول دی گئی ہے — پیغام سینڈ کر دیں۔';
        _fallbackMessage = null;
      } else {
        _inlineStatusMsg =
            '✅ سرپرست کا نمبر درج ہو گیا (اگر اس براؤزر پر واٹس ایپ ایپ نہ کھلے تو نیچے پیغام موجود ہے):';
        _fallbackMessage = noticeText;
      }
    });
  }
  @override
  Widget build(BuildContext context) {
    final bool allChecked = widget.items.every((e) => e.isChecked);
    final bool isEverythingComplete = allChecked && widget.isGuardianNoticeSent;
    final bool isBlockedByLimit =
        widget.isRiskOverLimit && !widget.isAdminOverrideApproved;
    return Container(
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: isBlockedByLimit
            ? const Color(0xFFFEF2F2)
            : (isEverythingComplete
                ? const Color(0xFFECFDF5)
                : const Color(0xFFFFFBEB)),
        borderRadius: BorderRadius.circular(12),
        border: Border.all(
          color: isBlockedByLimit
              ? AppColors.errorRed
              : (isEverythingComplete
                  ? AppColors.primaryEmerald
                  : Colors.amber.shade700),
          width: 1.5,
        ),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Icon(
                isBlockedByLimit
                    ? Icons.gpp_bad_rounded
                    : (isEverythingComplete
                        ? Icons.verified_user_rounded
                        : Icons.policy_outlined),
                color: isBlockedByLimit
                    ? AppColors.errorRed
                    : (isEverythingComplete
                        ? AppColors.primaryEmerald
                        : Colors.amber.shade900),
                size: 20,
              ),
              const SizedBox(width: 6),
              Expanded(
                child: Text(
                  isBlockedByLimit
                      ? 'انتظامی منظوری درکار (نیٹ ادھار رسک حد سے زائد)'
                      : 'لازمی سیکیورٹی شرائط و سرپرست کی اطلاع (سب مکمل کرنا لازمی):',
                  style: TextStyle(
                    fontSize: 12,
                    fontWeight: FontWeight.w900,
                    color: isBlockedByLimit
                        ? AppColors.errorRed
                        : AppColors.textDark,
                  ),
                ),
              ),
            ],
          ),
          const SizedBox(height: 8),
          if (widget.isRiskOverLimit) ...[
            Container(
              padding: const EdgeInsets.all(10),
              margin: const EdgeInsets.only(bottom: 10),
              decoration: BoxDecoration(
                color: widget.isAdminOverrideApproved
                    ? Colors.green.shade100
                    : Colors.red.shade100,
                borderRadius: BorderRadius.circular(8),
                border: Border.all(
                  color: widget.isAdminOverrideApproved
                      ? Colors.green.shade700
                      : Colors.red.shade700,
                ),
              ),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    widget.isAdminOverrideApproved
                        ? '✅ انتظامیہ (حافظ محمد صابر) کی خصوصی منظوری سے یہ آرڈر بحال کر دیا گیا ہے۔'
                        : '⚠️ اس سودے میں نیٹ ادھار رسک رقم (قیمت Rs. ${widget.baseValue} - ایڈوانس Rs. ${widget.advancePaid} = Rs. ${widget.netRiskAmount}) مقررہ رسک حد (Rs. ${widget.maxRiskLimit}) سے زیادہ ہے۔ برائے مہربانی ایڈوانس بڑھائیں یا نایاب قسط پوائنٹ کی انتظامیہ (حافظ محمد صابر) سے منظوری لیں۔',
                    style: TextStyle(
                      fontSize: 11.5,
                      fontWeight: FontWeight.bold,
                      color: widget.isAdminOverrideApproved
                          ? Colors.green.shade900
                          : Colors.red.shade900,
                      height: 1.4,
                    ),
                  ),
                  if (!widget.isAdminOverrideApproved) ...[
                    const SizedBox(height: 8),
                    SizedBox(
                      width: double.infinity,
                      child: ElevatedButton.icon(
                        onPressed: widget.onOpenAdminOverrideDialog,
                        icon: const Icon(Icons.admin_panel_settings_outlined,
                            size: 17),
                        label: const Text(
                          'انتظامی خصوصی منظوری (Admin PIN)',
                          style: TextStyle(
                              fontSize: 11.5, fontWeight: FontWeight.bold),
                        ),
                        style: ElevatedButton.styleFrom(
                          backgroundColor: Colors.red.shade800,
                          foregroundColor: Colors.white,
                          padding: const EdgeInsets.symmetric(vertical: 8),
                          shape: RoundedRectangleBorder(
                            borderRadius: BorderRadius.circular(8),
                          ),
                        ),
                      ),
                    ),
                  ],
                ],
              ),
            ),
          ],
          ...widget.items.map(
            (item) => InkWell(
              onTap:
                  isBlockedByLimit ? null : () => widget.onToggleItem(item.id),
              borderRadius: BorderRadius.circular(8),
              child: Padding(
                padding: const EdgeInsets.symmetric(vertical: 4),
                child: Row(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    SizedBox(
                      width: 24,
                      height: 24,
                      child: Checkbox(
                        value: item.isChecked,
                        activeColor: AppColors.primaryEmerald,
                        onChanged: isBlockedByLimit
                            ? null
                            : (_) => widget.onToggleItem(item.id),
                      ),
                    ),
                    const SizedBox(width: 6),
                    Expanded(
                      child: Text(
                        item.text,
                        style: TextStyle(
                          fontSize: 11.5,
                          fontWeight: item.isChecked
                              ? FontWeight.bold
                              : FontWeight.w600,
                          color: isBlockedByLimit
                              ? Colors.black38
                              : AppColors.textDark,
                          height: 1.35,
                        ),
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ),
          const Divider(height: 14),
          Row(
            children: [
              Expanded(
                child: TextField(
                  controller: widget.guardianPhoneCtrl,
                  keyboardType: TextInputType.phone,
                  enabled: !isBlockedByLimit,
                  style: const TextStyle(
                      fontSize: 12, fontWeight: FontWeight.bold),
                  decoration: InputDecoration(
                    isDense: true,
                    labelText: 'والد / سرپرست کا فون (لازمی)*',
                    labelStyle: const TextStyle(fontSize: 10.5),
                    prefixIcon: Icon(
                      widget.isGuardianNoticeSent
                          ? Icons.check_circle_rounded
                          : Icons.family_restroom_outlined,
                      size: 17,
                      color: widget.isGuardianNoticeSent
                          ? AppColors.primaryEmerald
                          : Colors.amber.shade900,
                    ),
                    filled: true,
                    fillColor: Colors.white,
                    border: OutlineInputBorder(
                        borderRadius: BorderRadius.circular(8)),
                    contentPadding: const EdgeInsets.symmetric(
                        horizontal: 8, vertical: 9),
                  ),
                ),
              ),
