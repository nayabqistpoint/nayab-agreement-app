import 'package:flutter/material.dart';
import '../../../core/constants/app_colors.dart';
class MultiCartItemRowData {
  final String name;
  final int unitBasePrice;
  final int chosenQty;
  final int maxAvailable;
  const MultiCartItemRowData({
    required this.name,
    required this.unitBasePrice,
    required this.chosenQty,
    required this.maxAvailable,
  });
}
class MultiCartBundleCardUi extends StatelessWidget {
  final List<MultiCartItemRowData> items;
  final List<String> allocatedIds;
  final void Function(int itemIndex, int newQty) onQuantityChanged;
  const MultiCartBundleCardUi({
    super.key,
    required this.items,
    required this.allocatedIds,
    required this.onQuantityChanged,
  });
  Widget _stepper({
    required int qty,
    required int maxQty,
    required ValueChanged<int> onChanged,
  }) {
    return Container(
      decoration: BoxDecoration(
        color: AppColors.warmTintEmerald,
        borderRadius: BorderRadius.circular(9),
        border: Border.all(color: AppColors.primaryEmerald),
      ),
      child: Row(
        mainAxisSize: MainAxisSize.min,
        children: [
          IconButton(
            icon: const Icon(Icons.remove_rounded, size: 19),
            color: AppColors.primaryEmerald,
            visualDensity: VisualDensity.compact,
            onPressed: qty > 1 ? () => onChanged(qty - 1) : null,
          ),
          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 8),
            child: Text(
              '$qty پیس',
              style: const TextStyle(
                fontSize: 14,
                fontWeight: FontWeight.w900,
                color: AppColors.primaryEmerald,
              ),
            ),
          ),
          IconButton(
            icon: const Icon(Icons.add_rounded, size: 19),
            color: AppColors.primaryEmerald,
            visualDensity: VisualDensity.compact,
            onPressed: qty < maxQty ? () => onChanged(qty + 1) : null,
          ),
        ],
      ),
    );
  }
  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.all(10),
      decoration: AppColors.primaryCardDecoration(
        borderColor: AppColors.primaryEmerald,
        borderWidth: 1.4,
        radius: 13,
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          Row(
            children: [
              const Icon(
                Icons.shopping_bag_outlined,
                color: AppColors.primaryEmerald,
                size: 20,
              ),
              const SizedBox(width: 6),
              Expanded(
                child: Text(
                  'منتخب آئٹمز و تعداد (${items.length} ماڈلز):',
                  style: const TextStyle(
                    fontSize: 14.5,
                    fontWeight: FontWeight.w900,
                    color: AppColors.primaryEmerald,
                  ),
                ),
              ),
            ],
          ),
          const Divider(height: 14),
          ...List.generate(items.length, (i) {
            final row = items[i];
            return Container(
              margin: const EdgeInsets.only(bottom: 7),
              padding: const EdgeInsets.all(8),
              decoration: BoxDecoration(
                color: AppColors.warmSubtleSurface,
                borderRadius: BorderRadius.circular(10),
                border: Border.all(color: AppColors.borderLight),
              ),
              child: Row(
                children: [
                  Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text(
                          row.name,
                          style: const TextStyle(
                            fontSize: 14.5,
                            fontWeight: FontWeight.w900,
                            color: AppColors.textDark,
                          ),
                        ),
                        Text(
                          'Rs. ${row.unitBasePrice} × ${row.chosenQty} = Rs. ${row.unitBasePrice * row.chosenQty} (دستیاب: ${row.maxAvailable})',
                          style: AppColors.mutedBoldStyle,
                        ),
                      ],
                    ),
                  ),
                  _stepper(
                    qty: row.chosenQty,
                    maxQty: row.maxAvailable,
                    onChanged: (newQ) => onQuantityChanged(i, newQ),
                  ),
                ],
              ),
            );
          }),
          if (allocatedIds.isNotEmpty) ...[
            const SizedBox(height: 3),
            Text(
              'منتخب Stock IDs: ${allocatedIds.join(" + ")}',
              style: const TextStyle(
                fontSize: 12,
                fontWeight: FontWeight.w800,
                color: AppColors.primaryEmerald,
              ),
            ),
          ],
        ],
      ),
    );
  }
}
