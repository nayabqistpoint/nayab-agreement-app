import '../models/calculator_config_model.dart';
class _ZoneRateParams {
  final double advancePct;
  final double profitWithCheck;
  final double profitWithoutCheck;
  final double perMonthIncrement;
  final int processingFee;
  final int roundToNearest;
  final bool isCompounding;
  final bool addFeeToPrincipal;
  final List<int> durations;
  const _ZoneRateParams({
    required this.advancePct,
    required this.profitWithCheck,
    required this.profitWithoutCheck,
    required this.perMonthIncrement,
    required this.processingFee,
    required this.roundToNearest,
    required this.isCompounding,
    required this.addFeeToPrincipal,
    required this.durations,
  });
}
class PlanMathService {
  static _ZoneRateParams _resolveZone(
    CalculatorConfigModel config, {
    String zoneType = 'MOBILE',
    bool isGeneral = false,
  }) {
    final z = isGeneral ? 'ELECTRONICS' : zoneType.toUpperCase();
    if (z == 'ELECTRONICS' || z == 'GENERAL') {
      return _ZoneRateParams(
        advancePct: config.generalAdvancePercentage,
        profitWithCheck: config.generalProfitWithCheck,
        profitWithoutCheck: config.generalProfitWithoutCheck,
        perMonthIncrement: config.generalPerMonthIncrement,
        processingFee: config.generalProcessingFee,
        roundToNearest: config.generalRoundToNearest,
        isCompounding: config.generalIsCompoundingProfit,
        addFeeToPrincipal: config.generalAddProcessingFeeToPrincipal,
        durations: config.generalAllowedDurations,
      );
    }
    if (z == 'CUSTOM_ESTIMATE' || z == 'CUSTOM') {
      return _ZoneRateParams(
        advancePct: config.customAdvancePercentage,
        profitWithCheck: config.customProfitWithCheck,
        profitWithoutCheck: config.customProfitWithoutCheck,
        perMonthIncrement: config.customPerMonthIncrement,
        processingFee: config.customProcessingFee,
        roundToNearest: config.customRoundToNearest,
        isCompounding: config.customIsCompoundingProfit,
        addFeeToPrincipal: config.customAddProcessingFeeToPrincipal,
        durations: config.customAllowedDurations,
      );
    }
    return _ZoneRateParams(
      advancePct: config.advancePercentage,
      profitWithCheck: config.profitWithCheck,
      profitWithoutCheck: config.profitWithoutCheck,
      perMonthIncrement: config.perMonthIncrement,
      processingFee: config.processingFee,
      roundToNearest: config.roundToNearest,
      isCompounding: config.isCompoundingProfit,
      addFeeToPrincipal: config.addProcessingFeeToPrincipal,
      durations: config.allowedDurations,
    );
  }
  static int ceilValue(num value, int roundToNearest) {
    if (roundToNearest <= 0) return value.ceil();
    final double remainder = (value % roundToNearest).toDouble();
    if (remainder == 0) return value.toInt();
    return (value + (roundToNearest - remainder)).toInt();
  }
  static int calculatePrincipal({
    required int baseValue,
    required CalculatorConfigModel config,
    String zoneType = 'MOBILE',
    bool isGeneral = false,
  }) {
    final z = _resolveZone(config, zoneType: zoneType, isGeneral: isGeneral);
    if (z.addFeeToPrincipal) {
      return baseValue + z.processingFee;
    }
    return baseValue;
  }
  static int calculateTotalContractPrice({
    required int principal,
    required int months,
    required bool isCheque,
    required CalculatorConfigModel config,
    String zoneType = 'MOBILE',
    bool isGeneral = false,
  }) {
    final z = _resolveZone(config, zoneType: zoneType, isGeneral: isGeneral);
    final int baseDuration = z.durations.isNotEmpty ? z.durations.first : 6;
    final double baseRate =
        isCheque ? z.profitWithCheck : z.profitWithoutCheck;
    final int extraMonths =
        (months - baseDuration) > 0 ? (months - baseDuration) : 0;
    double calculatedTotal = 0.0;
    if (!z.isCompounding) {
      final double totalRate = baseRate + (extraMonths * z.perMonthIncrement);
      calculatedTotal = principal * (1.0 + totalRate);
    } else {
      double runningTotal = principal * (1.0 + baseRate);
      for (int i = 0; i < extraMonths; i++) {
        runningTotal = runningTotal * (1.0 + z.perMonthIncrement);
      }
      calculatedTotal = runningTotal;
    }
    if (!z.addFeeToPrincipal && z.processingFee > 0) {
      calculatedTotal += z.processingFee;
    }
    return ceilValue(calculatedTotal, z.roundToNearest);
  }
  static int calculateMinAdvance({
    required int totalContractPrice,
    required int months,
    required CalculatorConfigModel config,
    String zoneType = 'MOBILE',
    bool isGeneral = false,
  }) {
    if (months <= 0) return 0;
    final z = _resolveZone(config, zoneType: zoneType, isGeneral: isGeneral);
    final double theoreticalEmi = totalContractPrice / months;
    final double rawMinAdv = theoreticalEmi * z.advancePct;
    return ceilValue(rawMinAdv, z.roundToNearest);
  }
  static int calculateMonthlyEmi({
    required int totalContractPrice,
    required int advancePaid,
    required int months,
    required CalculatorConfigModel config,
    String zoneType = 'MOBILE',
    bool isGeneral = false,
  }) {
    final z = _resolveZone(config, zoneType: zoneType, isGeneral: isGeneral);
    final int remainingInstallments = (months - 1) > 0 ? (months - 1) : 1;
    final int balance = totalContractPrice - advancePaid;
    if (balance <= 0) return 0;
    final double rawMonthly = balance / remainingInstallments;
    return ceilValue(rawMonthly, z.roundToNearest);
  }
}
