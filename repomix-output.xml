import 'package:flutter/material.dart';
import 'package:hive_flutter/hive_flutter.dart';
import '../../../core/constants/box_names.dart';
import '../../../core/database/hive_box_manager.dart';
import '../purchase_market_controller.dart';
import 'market_category_filter_ui.dart';
import 'market_empty_stock_ui.dart';
import 'market_status_search_bar_ui.dart';
import 'market_stock_list_header_ui.dart';
import 'stock_phone_card_ui.dart';
class MarketStockSectionUi extends StatelessWidget {
  final PurchaseMarketController controller;
  final String? customerPhone;
  const MarketStockSectionUi({
    super.key,
    required this.controller,
    this.customerPhone,
  });
  @override
  Widget build(BuildContext context) {
    return ValueListenableBuilder<Box<dynamic>>(
      valueListenable: HiveBoxManager.listenToBox(BoxNames.appConfigBox),
      builder: (context, _, _) {
        return ValueListenableBuilder<Box<dynamic>>(
          valueListenable: controller.boxListenable,
          builder: (context, _, _) {
            return AnimatedBuilder(
              animation: controller,
              builder: (context, _) {
                final allDevices = controller.getAllUnfilteredStockDevices();
                final mobileCount = allDevices
                    .where((d) =>
                        (d['productCategory']?.toString() ?? 'MOBILE') ==
                        'MOBILE')
                    .length;
                final generalCount = allDevices
                    .where((d) =>
                        (d['productCategory']?.toString() ?? 'MOBILE') ==
                        'ELECTRONICS')
                    .length;
                final catDevices = controller.getCategoryFilteredDevices();
                final int availableCnt = catDevices
                    .where((d) =>
                        (d['statusCode']?.toString() ?? '') == 'AVAILABLE')
                    .length;
                final int onOrderCnt = catDevices
                    .where((d) =>
                        (d['statusCode']?.toString() ?? '') == 'ON_ORDER')
                    .length;
                final int reservedCnt = catDevices
                    .where((d) =>
                        (d['statusCode']?.toString() ?? '') == 'RESERVED')
                    .length;
                final int soldCnt = catDevices
                    .where(
                        (d) => (d['statusCode']?.toString() ?? '') == 'SOLD')
                    .length;
                final stockDevices = controller.getStockDevices();
                final readyCount = stockDevices
                    .where((d) =>
                        d['isReserved'] != true && d['isSold'] != true)
                    .length;
                return Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    MarketCategoryFilterUi(
                      selectedCategory: controller.selectedCategory,
                      totalCount: allDevices.length,
                      mobileCount: mobileCount,
                      generalCount: generalCount,
                      onSelect: controller.setCategory,
                    ),
                    MarketStatusSearchBarUi(
                      selectedStatus: controller.selectedStatusFilter,
                      onStatusChanged: controller.setStatusFilter,
                      searchController: controller.searchController,
                      searchQuery: controller.searchQuery,
                      onSearchChanged: controller.updateSearch,
                      onClearSearch: controller.clearSearch,
                      allCount: catDevices.length,
                      availableCount: availableCnt,
                      onOrderCount: onOrderCnt,
                      reservedCount: reservedCnt,
                      soldCount: soldCnt,
                    ),
                    MarketStockListHeaderUi(totalCount: readyCount),
                    const SizedBox(height: 10),
                    if (stockDevices.isEmpty)
                      const MarketEmptyStockUi()
                    else
                      ...List.generate(
                        stockDevices.length,
                        (idx) {
                          final item = stockDevices[idx];
                          final String cardKey =
                              controller.buildCartKeyForDevice(item);
                          final bool isSelected = controller.isMultiSelectMode &&
                              controller.selectedCartMap.containsKey(cardKey);
                          return StockPhoneCardUi(
                            item: item,
                            isRibbonExpanded:
                                controller.expandedCardIndex == idx,
                            totalPlans: controller.totalPlansCount,
                            isMultiSelectMode: controller.isMultiSelectMode,
                            isSelectedInCart: isSelected,
                            onLongPress: () =>
                                controller.toggleCartSelection(item),
                            onCardTap: () {
                              if (controller.isMultiSelectMode) {
                                controller.toggleCartSelection(item);
                              } else {
                                controller.navigateToPlanDetail(
                                  context,
                                  item,
                                  customerPhone,
                                );
                              }
                            },
                            onToggleRibbon: () => controller.toggleRibbon(idx),
                          );
                        },
                      ),
                  ],
                );
              },
            );
          },
        );
      },
    );
  }
}
</file>

