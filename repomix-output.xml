import 'device_license_service.dart';
class DeviceActivationGateUi extends StatefulWidget {
  final Widget child;
  const DeviceActivationGateUi({super.key, required this.child});
  @override
  State<DeviceActivationGateUi> createState() => _DeviceActivationGateUiState();
}
class _DeviceActivationGateUiState extends State<DeviceActivationGateUi> {
  final TextEditingController _nameCtrl = TextEditingController();
  bool _isChecking = false;
  bool _isCopied = false;
  bool _isErrorNotice = false;
  String? _inlineNotice;
  @override
  void initState() {
    super.initState();
    DeviceLicenseService.registerOrHeartbeatDevice();
  }
  @override
  void dispose() {
    _nameCtrl.dispose();
    super.dispose();
  }
  Future<void> _sendRequest() async {
    final name = _nameCtrl.text.trim();
    if (name.isEmpty) {
      setState(() {
        _isErrorNotice = true;
        _inlineNotice =
            '⚠️ برائے مہربانی پہلے اپنا نام یا کاؤنٹر کا نام درج کریں (لازمی)!';
      });
      return;
    }
    setState(() {
      _isChecking = true;
      _inlineNotice = null;
      _isErrorNotice = false;
    });
    await DeviceLicenseService.registerOrHeartbeatDevice(
      employeeNote: name,
    );
    if (mounted) {
      setState(() {
        _isChecking = false;
        _isErrorNotice = false;
        _inlineNotice =
            '✅ رسائی کی درخواست "$name" کے نام سے ایڈمن کو بھیج دی گئی ہے!';
      });
    }
  }
  void _copyDeviceId(String deviceId) {
    Clipboard.setData(ClipboardData(text: deviceId));
    setState(() {
      _isCopied = true;
      _isErrorNotice = false;
      _inlineNotice = '✅ ڈیوائس ID کاپی ہو گئی: $deviceId';
    });
  }
  @override
  Widget build(BuildContext context) {
    return ValueListenableBuilder(
      valueListenable: HiveBoxManager.listenToBox(BoxNames.appConfigBox),
      builder: (context, _, _) {
        final bool lockRequired =
            DeviceLicenseService.isDeviceLockEnabledInConfig();
        if (!lockRequired) {
          return widget.child;
        }
        return ValueListenableBuilder(
          valueListenable: HiveBoxManager.listenToBox(BoxNames.posDevicesBox),
          builder: (context, _, _) {
            final status = DeviceLicenseService.getCurrentLicenseStatus();
            if (status == 'ACTIVE') {
              return widget.child;
            }
            final deviceId = DeviceLicenseService.getOrCreateDeviceId();
            final bool isRevoked = status == 'REVOKED';
            return Directionality(
              textDirection: TextDirection.rtl,
              child: Scaffold(
                backgroundColor: AppColors.backgroundLight,
                body: Center(
                  child: SingleChildScrollView(
                    padding: const EdgeInsets.all(18),
                    child: Container(
                      padding: const EdgeInsets.all(20),
                      decoration: BoxDecoration(
                        color: AppColors.cardSurface,
                        borderRadius: BorderRadius.circular(18),
                        border: Border.all(
                          color: isRevoked
                              ? AppColors.errorRed
                              : AppColors.primaryEmerald,
                          width: 2.0,
                        ),
                      ),
                      child: Column(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          Icon(
                            isRevoked
                                ? Icons.block_rounded
                                : Icons.phonelink_lock_rounded,
                            size: 64,
                            color: isRevoked
                                ? AppColors.errorRed
                                : AppColors.primaryEmerald,
                          ),
                          const SizedBox(height: 12),
                          Text(
                            isRevoked
                                ? 'اس ڈیوائس کی رسائی معطل کر دی گئی ہے'
                                : 'نایاب قسط پوائنٹ — ڈیوائس تصدیق درکار',
                            textAlign: TextAlign.center,
                            style: TextStyle(
                              fontSize: 19,
                              fontWeight: FontWeight.w900,
                              color: isRevoked
                                  ? AppColors.errorRed
                                  : AppColors.textDark,
                            ),
                          ),
                          const SizedBox(height: 8),
                          Text(
                            isRevoked
                                ? 'انتظامیہ نے اس موبائل کا لائسنس بلاک کر دیا ہے۔ مزید معلومات کے لیے ایڈمن سے رابطہ کریں۔'
                                : 'یہ ایپ صرف مجاز عملے کے موبائلز پر چل سکتی ہے۔ نیچے اپنا نام لکھیں اور ڈیوائس کوڈ ایڈمن کو بھیجیں:',
                            textAlign: TextAlign.center,
                            style: const TextStyle(
                              fontSize: 14,
                              fontWeight: FontWeight.bold,
                              color: AppColors.textMuted,
                              height: 1.45,
                            ),
                          ),
                          const SizedBox(height: 16),
                          Container(
                            padding: const EdgeInsets.symmetric(
                              horizontal: 14,
                              vertical: 12,
                            ),
                            decoration: BoxDecoration(
                              color: AppColors.warmTintEmerald,
                              borderRadius: BorderRadius.circular(12),
                              border: Border.all(
                                color: AppColors.emeraldPillBorder,
                                width: 1.5,
                              ),
                            ),
                            child: Row(
                              mainAxisAlignment: MainAxisAlignment.center,
                              children: [
                                Flexible(
                                  child: SelectableText(
                                    deviceId,
                                    style: const TextStyle(
                                      fontSize: 19,
                                      fontWeight: FontWeight.w900,
                                      letterSpacing: 1.2,
                                      color: AppColors.primaryEmerald,
                                    ),
                                  ),
                                ),
                                const SizedBox(width: 8),
                                InkWell(
                                  onTap: () => _copyDeviceId(deviceId),
                                  borderRadius: BorderRadius.circular(8),
                                  child: Container(
                                    padding: const EdgeInsets.all(7),
                                    decoration: BoxDecoration(
                                      color: Colors.white,
                                      borderRadius: BorderRadius.circular(8),
                                      border: Border.all(
                                        color: AppColors.emeraldPillBorder,
                                      ),
                                    ),
