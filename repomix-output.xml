<file path="../nayab_shop_pos/lib/features/purchase_market/purchase_market_controller.dart">
import 'package:flutter/foundation.dart';
import 'package:flutter/material.dart';
import 'package:hive_flutter/hive_flutter.dart';
import '../../core/constants/app_colors.dart';
import '../device_plan_detail/args/device_plan_detail_args.dart';
import '../device_plan_detail/device_plan_detail_page.dart';
import 'services/purchase_market_calculation_service.dart';
import 'services/purchase_market_storage_handler_service.dart';
class PurchaseMarketController extends ChangeNotifier {
  int expandedCardIndex = -1;
  String selectedCategory = 'ALL';
  String selectedStatusFilter = 'ALL';
  String searchQuery = '';
  final TextEditingController searchController = TextEditingController();
  ValueListenable<Box<dynamic>> get boxListenable =>
      PurchaseMarketStorageHandlerService.stockListenable;
  int get totalPlansCount =>
      PurchaseMarketCalculationService.getTotalPlansCount();
  List<DataMap> getAllUnfilteredStockDevices() {
    final rawEntries = PurchaseMarketStorageHandlerService.getAllRawStock();
    return PurchaseMarketCalculationService.parseStockDevices(rawEntries);
  }
  List<DataMap> getCategoryFilteredDevices() {
    final all = getAllUnfilteredStockDevices();
    if (selectedCategory == 'ALL') return all;
    return all.where((d) {
      final cat = (d['productCategory']?.toString() ?? 'MOBILE').toUpperCase();
      return cat == selectedCategory;
    }).toList();
  }
  List<DataMap> getStockDevices() {
    final catList = getCategoryFilteredDevices();
    final q = searchQuery.trim().toLowerCase();
    return catList.where((d) {
      final st = (d['statusCode']?.toString() ?? 'AVAILABLE').toUpperCase();
      if (selectedStatusFilter != 'ALL' && st != selectedStatusFilter) {
        return false;
      }
      if (q.isNotEmpty) {
        final name = (d['name']?.toString() ?? '').toLowerCase();
        final ram = (d['ramRom']?.toString() ?? '').toLowerCase();
        final color = (d['color']?.toString() ?? '').toLowerCase();
        final stockId = (d['stockId']?.toString() ?? '').toLowerCase();
        final idsStr = (d['availableStockIds'] is List)
            ? (d['availableStockIds'] as List).join(' ').toLowerCase()
            : '';
        final matches = name.contains(q) ||
            ram.contains(q) ||
            color.contains(q) ||
            stockId.contains(q) ||
            idsStr.contains(q);
        if (!matches) return false;
      }
      return true;
    }).toList();
  }
  void setCategory(String cat) {
    selectedCategory = cat;
    expandedCardIndex = -1;
    notifyListeners();
  }
  void setStatusFilter(String status) {
    selectedStatusFilter = status;
    expandedCardIndex = -1;
    notifyListeners();
  }
  void updateSearch(String val) {
    searchQuery = val;
    expandedCardIndex = -1;
    notifyListeners();
  }
  void clearSearch() {
    searchController.clear();
    searchQuery = '';
    expandedCardIndex = -1;
    notifyListeners();
  }
  void toggleRibbon(int index) {
    expandedCardIndex = (expandedCardIndex == index) ? -1 : index;
    notifyListeners();
  }
  void navigateToPlanDetail(
    BuildContext context,
    DataMap device,
    String? customerPhone,
  ) {
    final args = DevicePlanDetailArgs(
      device: device,
      customerPhone: customerPhone,
    );
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (_) => DevicePlanDetailPage(args: args),
      ),
    );
  }
  void handleCustomEstimateSubmit(
    BuildContext context,
    String name,
    int price,
    int adv,
    String zoneType,
    String productCategory,
    String? customerPhone,
  ) {
    final device = PurchaseMarketCalculationService.buildCustomEstimateDevice(
      name: name,
      price: price,
      adv: adv,
      zoneType: zoneType,
      productCategory: productCategory,
