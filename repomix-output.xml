import 'dart:typed_data';
import 'package:flutter/services.dart';
import 'package:pdf/pdf.dart';
import 'package:pdf/widgets.dart' as pw;
class StampPdfService {
  static Future<Uint8List> generateOverlayPdf({
    required List<String> page1Lines,
    required List<String> page2Lines,
    required double topMarginP1,
    required double bottomMarginP1,
    required double sideMargin,
    required double topMarginP2,
    required double bottomMarginP2,
    required double fontSize,
  }) async {
    final pdf = pw.Document();
    final fontData = await rootBundle.load("assets/fonts/jameel.ttf");
    final ttfFont = pw.Font.ttf(fontData);
    pdf.addPage(
      pw.Page(
        pageFormat: const PdfPageFormat(612.0, 1008.0),
        margin: pw.EdgeInsets.zero,
        theme: pw.ThemeData.withFont(base: ttfFont),
        build: (pw.Context context) {
          return pw.Container(
            padding: pw.EdgeInsets.only(
              top: topMarginP1,
              bottom: bottomMarginP1,
              left: sideMargin,
              right: sideMargin,
            ),
            child: pw.Column(
              crossAxisAlignment: pw.CrossAxisAlignment.stretch,
              children: page1Lines.map((line) {
                if (line.isEmpty) {
                  return pw.SizedBox(height: 6);
                }
                return pw.Text(
                  line,
                  textDirection: pw.TextDirection.rtl,
                  textAlign: pw.TextAlign.right,
                  style: pw.TextStyle(
                    font: ttfFont,
                    fontSize: fontSize,
                    lineSpacing: 1.6,
                  ),
                );
              }).toList(),
            ),
          );
        },
      ),
    );
    if (page2Lines.isNotEmpty) {
      pdf.addPage(
        pw.Page(
          pageFormat: const PdfPageFormat(612.0, 1008.0),
          margin: pw.EdgeInsets.zero,
          theme: pw.ThemeData.withFont(base: ttfFont),
          build: (pw.Context context) {
            return pw.Container(
              padding: pw.EdgeInsets.only(
                top: topMarginP2,
                bottom: bottomMarginP2,
                left: sideMargin,
                right: sideMargin,
              ),
              child: pw.Column(
                crossAxisAlignment: pw.CrossAxisAlignment.stretch,
                children: page2Lines.map((line) {
                  if (line.isEmpty) {
                    return pw.SizedBox(height: 6);
                  }
                  return pw.Text(
                    line,
                    textDirection: pw.TextDirection.rtl,
                    textAlign: pw.TextAlign.right,
                    style: pw.TextStyle(
                      font: ttfFont,
                      fontSize: fontSize,
                      lineSpacing: 1.6,
                    ),
                  );
                }).toList(),
              ),
            );
          },
        ),
      );
    }
    return await pdf.save();
  }
}
