import 'package:flutter/material.dart';
import '../../../core/constants/app_colors.dart';
import '../../device_plan_detail/services/calculator_config_service.dart';
import '../services/purchase_market_calculation_service.dart';
class EstimateSheetFormUi extends StatefulWidget {
  final int totalPlans;
  final Function(
    String name,
    int estimatePrice,
    int advance,
    String zoneType,
    String productCategory,
  ) onSubmit;
  const EstimateSheetFormUi({
    super.key,
    required this.totalPlans,
    required this.onSubmit,
  });
  @override
  State<EstimateSheetFormUi> createState() => _EstimateSheetFormUiState();
}
class _EstimateSheetFormUiState extends State<EstimateSheetFormUi> {
  final _nameCtrl = TextEditingController();
  final _priceCtrl = TextEditingController();
  final _advanceCtrl = TextEditingController(text: '0');
  String? _error;
  int _dynamicMinAdvance = 0;
  late String _selectedZone;
  @override
  void initState() {
    super.initState();
    final allowedZones = CalculatorConfigService().getConfig().customAllowedZones;
    _selectedZone =
        allowedZones.isNotEmpty ? allowedZones.first : 'CUSTOM_ESTIMATE';
    _priceCtrl.addListener(_onPriceChanged);
  }
  String get _resolvedProductCategory {
    if (_selectedZone == 'MOBILE') return 'MOBILE';
    return 'ELECTRONICS';
  }
  void _onPriceChanged() {
    final price = int.tryParse(_priceCtrl.text.trim()) ?? 0;
    final calculatedMin =
        PurchaseMarketCalculationService.calculateRoundedMinAdvance(
      price,
      zoneType: _selectedZone,
    );
    if (_dynamicMinAdvance != calculatedMin) {
      setState(() {
        _dynamicMinAdvance = calculatedMin;
      });
    }
  }
  @override
  void dispose() {
    _priceCtrl.removeListener(_onPriceChanged);
    _nameCtrl.dispose();
    _priceCtrl.dispose();
    _advanceCtrl.dispose();
    super.dispose();
  }
  void _validate() {
    final name = _nameCtrl.text.trim();
    final price = int.tryParse(_priceCtrl.text.trim()) ?? 0;
    final adv = int.tryParse(_advanceCtrl.text.trim()) ?? 0;
    if (name.isEmpty) {
      setState(() => _error = 'برائے مہربانی آئٹم یا ماڈل کا نام درج کریں');
      return;
    }
    if (price <= 0) {
      setState(() => _error = 'برائے مہربانی درست مالیت درج کریں');
      return;
    }
    final requiredMin =
        PurchaseMarketCalculationService.calculateRoundedMinAdvance(
      price,
      zoneType: _selectedZone,
    );
    if (adv > 0 && adv < requiredMin) {
      setState(
        () => _error =
            'ایڈوانس یا تو 0 ہو یا کم از کم Rs. $requiredMin ضروری ہے',
      );
      return;
    }
    if (adv > price) {
      setState(
        () => _error = 'ایڈوانس رقم کل قیمت سے زیادہ نہیں ہو سکتی',
      );
      return;
    }
    setState(() => _error = null);
    widget.onSubmit(
      name,
      price,
      adv,
      _selectedZone,
      _resolvedProductCategory,
    );
  }
  String _zoneLabel(String z) {
    switch (z) {
      case 'MOBILE':
        return '📱 موبائل ریٹ';
      case 'ELECTRONICS':
        return '🧊 جنرل آئٹم ریٹ';
      default:
        return '⭐ کسٹم تخمینہ ریٹ';
    }
  }
  @override
  Widget build(BuildContext context) {
    final config = CalculatorConfigService().getConfig();
    final allowedZones = config.customAllowedZones;
    final zonePlansCount = config.durationsForZone(_selectedZone).length * 4;
    final String advanceHint = _dynamicMinAdvance > 0
        ? '0 یا کم از کم Rs. $_dynamicMinAdvance'
        : 'بغیر ایڈوانس کیلئے 0 رکھیں';
    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 18, vertical: 16),
      child: Column(
        mainAxisSize: MainAxisSize.min,
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          if (allowedZones.length > 1) ...[
            const Text(
              'ریٹ کیٹگری منتخب کریں:',
              style: TextStyle(
                fontSize: 13.5,
                fontWeight: FontWeight.w900,
                color: AppColors.textDark,
              ),
            ),
            const SizedBox(height: 6),
            Wrap(
              spacing: 6,
              runSpacing: 6,
              children: allowedZones.map((z) {
                final active = _selectedZone == z;
                return ChoiceChip(
                  label: Text(
                    _zoneLabel(z),
                    style: TextStyle(
                      fontSize: 13,
                      fontWeight: FontWeight.w900,
                      color: active ? Colors.white : AppColors.textDark,
                    ),
                  ),
                  selected: active,
                  selectedColor: AppColors.primaryEmerald,
                  backgroundColor: AppColors.warmSubtleSurface,
                  onSelected: (_) {
                    setState(() {
                      _selectedZone = z;
                      _onPriceChanged();
                    });
                  },
                );
              }).toList(),
            ),
            const SizedBox(height: 12),
          ],
          _field(
            _nameCtrl,
            'آئٹم / ماڈل کا نام (لازمی)*',
            'مثلاً Vivo Y20، فریج، موٹرسائیکل، کھاد',
            TextInputType.text,
          ),
          const SizedBox(height: 12),
          _field(
            _priceCtrl,
            'کل مالیت کا تخمینہ (روپوں میں)*',
            'مثلاً 45000',
            TextInputType.number,
          ),
          const SizedBox(height: 12),
          _field(
            _advanceCtrl,
            'متوقع ایڈوانس رقم (بغیر ایڈوانس کیلئے 0 رکھیں)',
            advanceHint,
            TextInputType.number,
          ),
          if (_error != null) ...[
            const SizedBox(height: 8),
            Text(
              _error!,
              style: const TextStyle(
                fontSize: 12.5,
                color: AppColors.errorRed,
                fontWeight: FontWeight.bold,
              ),
            ),
          ],
          const SizedBox(height: 18),
          SizedBox(
            width: double.infinity,
            child: ElevatedButton(
              onPressed: _validate,
              style: ElevatedButton.styleFrom(
                backgroundColor: AppColors.primaryEmerald,
                foregroundColor: Colors.white,
                padding: const EdgeInsets.symmetric(vertical: 14),
                shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(10),
                ),
                elevation: 0,
              ),
              child: Text(
                '$zonePlansCount اقساطی پیکجز کا شیڈول دیکھیں',
                style: const TextStyle(
                  fontSize: 14.5,
                  fontWeight: FontWeight.w900,
                ),
              ),
            ),
          ),
          const SizedBox(height: 10),
        ],
      ),
    );
  }
  Widget _field(
    TextEditingController ctrl,
    String label,
    String hint,
    TextInputType type,
  ) {
    return TextField(
      controller: ctrl,
      keyboardType: type,
      style: const TextStyle(fontSize: 15, fontWeight: FontWeight.w900),
      decoration: InputDecoration(
        labelText: label,
        labelStyle: const TextStyle(
          fontSize: 13.5,
          color: AppColors.textMuted,
          fontWeight: FontWeight.w800,
        ),
        hintText: hint,
        hintStyle: const TextStyle(fontSize: 12, color: Color(0xFF94A3B8)),
        isDense: true,
        filled: true,
        fillColor: AppColors.warmSubtleSurface,
        border: OutlineInputBorder(
          borderRadius: BorderRadius.circular(10),
          borderSide: const BorderSide(color: AppColors.borderLight),
        ),
        focusedBorder: OutlineInputBorder(
          borderRadius: BorderRadius.circular(10),
          borderSide:
              const BorderSide(color: AppColors.primaryEmerald, width: 1.4),
        ),
        contentPadding: const EdgeInsets.symmetric(
          horizontal: 14,
          vertical: 13,
        ),
      ),
    );
  }
}
