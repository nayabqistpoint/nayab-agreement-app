              )
            else
              PortableImageUi(
                pathOrUrl: '',
                fit: BoxFit.cover,
                fallbackIcon: fallbackIcon,
                fallbackIconSize: 40,
                fallbackColor: widget.badgeColor,
              ),
            if (imgs.length > 1)
              Positioned(
