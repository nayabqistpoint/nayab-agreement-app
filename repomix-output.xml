import 'package:flutter/material.dart';
import '../../../core/constants/app_colors.dart';
import '../../../core/services/cloudinary_image_helper.dart';
import '../../../core/widgets/portable_image_ui.dart';
class StockCardThumbnailSwiperUi extends StatefulWidget {
  final List<String> validImages;
  final bool isGeneral;
  final bool isReserved;
  final bool isSold;
  final Color badgeColor;
  const StockCardThumbnailSwiperUi({
    super.key,
    required this.validImages,
    required this.isGeneral,
    required this.isReserved,
    required this.isSold,
    required this.badgeColor,
  });
  @override
  State<StockCardThumbnailSwiperUi> createState() =>
      _StockCardThumbnailSwiperUiState();
}
class _StockCardThumbnailSwiperUiState
    extends State<StockCardThumbnailSwiperUi> {
  int _activeIndex = 0;
  final PageController _pageCtrl = PageController();
  @override
  void didUpdateWidget(covariant StockCardThumbnailSwiperUi oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (_activeIndex >= widget.validImages.length && _activeIndex != 0) {
      _activeIndex = 0;
      if (_pageCtrl.hasClients) _pageCtrl.jumpToPage(0);
    }
  }
  @override
  void dispose() {
    _pageCtrl.dispose();
    super.dispose();
  }
  @override
  Widget build(BuildContext context) {
    final imgs = widget.validImages;
    final safeIdx = imgs.isEmpty ? 0 : _activeIndex.clamp(0, imgs.length - 1);
    final fallbackIcon = widget.isGeneral
        ? Icons.kitchen_outlined
        : Icons.phone_android_rounded;
    return ClipRRect(
      borderRadius: BorderRadius.circular(10),
      child: Container(
        width: 90,
        height: 100,
        color: widget.isReserved
            ? AppColors.reservedPillBg
            : (widget.isSold
                ? AppColors.warmTintEmerald
                : AppColors.warmSubtleSurface),
        child: Stack(
          children: [
            if (imgs.isNotEmpty)
              PageView.builder(
                controller: _pageCtrl,
                itemCount: imgs.length,
                onPageChanged: (idx) => setState(() => _activeIndex = idx),
                itemBuilder: (_, i) => PortableImageUi(
                  pathOrUrl: CloudinaryImageHelper.toCardThumbnailUrl(imgs[i]),
                  fit: BoxFit.cover,
                  fallbackIcon: fallbackIcon,
                  fallbackIconSize: 40,
                  fallbackColor: widget.badgeColor,
                  showLoader: true,
                ),
              )
            else
              PortableImageUi(
                pathOrUrl: '',
                fit: BoxFit.cover,
                fallbackIcon: fallbackIcon,
                fallbackIconSize: 40,
                fallbackColor: widget.badgeColor,
              ),
            if (imgs.length > 1)
              Positioned(
                bottom: 4,
                left: 4,
                right: 4,
                child: Center(
                  child: Container(
                    padding:
                        const EdgeInsets.symmetric(horizontal: 6, vertical: 1.5),
                    decoration: BoxDecoration(
                      color: Colors.black.withValues(alpha: 0.72),
                      borderRadius: BorderRadius.circular(6),
                    ),
                    child: Row(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        const Icon(Icons.photo_library_rounded,
                            size: 10.5, color: AppColors.goldHighlight),
                        const SizedBox(width: 3),
                        Text(
                          '${safeIdx + 1}/${imgs.length}',
                          style: const TextStyle(
                              color: Colors.white,
                              fontSize: 10,
                              fontWeight: FontWeight.w900),
                        ),
                      ],
                    ),
                  ),
                ),
              ),
          ],
        ),
      ),
    );
  }
}
</file>

