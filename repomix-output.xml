                                        bgImage: _cachedStampPage1,
                                        isFirstPage: true,
                                      ),
                                      if (hasPage2) ...[
                                        const SizedBox(height: 24),
                                        const Text("— صفحہ نمبر 2 (بقیہ شرائط) —",
                                            style: TextStyle(fontWeight: FontWeight.bold, fontSize: 13, color: Colors.black87)),
                                        const SizedBox(height: 6),
                                        _buildCounterSheet(
                                          topM: _controller.subsequentTopMargin,
                                          botM: _controller.bottomMargin,
                                          sideM: _controller.sideMargin,
                                          textContent: page2Content,
                                          bgImage: _cachedStampPage2,
                                          isFirstPage: false,
                                        ),
                                      ],
                                    ],
                                  ),
                                ),
                              ),
                      ),
                    ),
                  ),
                  const SizedBox(height: 8),
