import 'package:flutter/foundation.dart';
import 'package:hive_flutter/hive_flutter.dart';
import '../constants/box_names.dart';
class HiveBoxManager {
  static Future<void> initialize() async {
    await Hive.initFlutter();
    await Future.wait([
      Hive.openBox<dynamic>(BoxNames.stockBox),
      Hive.openBox<dynamic>(BoxNames.appConfigBox),
      Hive.openBox<dynamic>(BoxNames.shopOrdersBox),
      Hive.openBox<dynamic>(BoxNames.syncStatusBox),
    ]);
  }
  static Box<dynamic> getBox(String boxName) {
    return Hive.box<dynamic>(boxName);
  }
  static Future<void> putBatch({
    required String boxName,
    required Map<String, dynamic> entries,
  }) async {
    final box = getBox(boxName);
    await box.putAll(entries);
    _logPayloadInUrdu(boxName, entries);
  }
  static void _logPayloadInUrdu(
    String boxName,
    Map<String, dynamic> entries,
  ) {
    debugPrint('══════════════════════════════════════════════════════');
    debugPrint('📦 ہائیو باکس میں نیا ڈیٹا محفوظ ہوا: [$boxName]');
    entries.forEach((key, value) {
      debugPrint('🔑 ریکارڈ ID / ٹوکن: $key');
      if (value is Map) {
        value.forEach((fieldKey, fieldVal) {
          final String urduLabel = _translateFieldToUrdu(fieldKey.toString());
          if (fieldKey == 'installments' && fieldVal is List) {
            debugPrint('   • $urduLabel: کل ${fieldVal.length} اقساط کا شیڈول');
          } else {
            debugPrint('   • $urduLabel ($fieldKey): $fieldVal');
          }
        });
      } else {
        debugPrint('   • تفصیل: $value');
      }
    });
    debugPrint('══════════════════════════════════════════════════════');
  }
  static String _translateFieldToUrdu(String key) {
    const Map<String, String> labels = {
      'id': 'شناختی کوڈ',
      'docId': 'دستاویز نمبر',
