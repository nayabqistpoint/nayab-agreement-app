class CustomersPushService {
  static Future<void> pushUnsynced() async {
    try {
      final box = HiveBoxManager.getBox(BoxNames.customersBox);
      for (var key in box.keys) {
        final raw = box.get(key);
        if (raw is Map) {
          final data = Map<String, dynamic>.from(raw);
